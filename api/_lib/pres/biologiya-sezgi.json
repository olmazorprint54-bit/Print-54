{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"8","kind":"title","chars":30,"max":30,"perLine":10.0,"lines":3,"caps":true,"sz":78.0,"paras":2,"text":"SENSORY RECEPTORS\nIN ORGANISMS"}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"6","kind":"text","chars":89,"max":89,"perLine":17.8,"lines":5,"caps":false,"sz":41.0,"paras":1,"text":"The skin is your body's largest organ and contains more than 4 million sensory receptors."},{"id":"7","kind":"title","chars":13,"max":13,"perLine":13.4,"lines":1,"caps":false,"sz":131.0,"paras":1,"text":"Did you know?"}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"6","kind":"label","chars":43,"max":43,"perLine":14.3,"lines":3,"caps":false,"sz":27.99,"paras":1,"text":"An input is received by a sensory receptor."},{"id":"9","kind":"text","chars":69,"max":69,"perLine":17.2,"lines":4,"caps":false,"sz":27.99,"paras":1,"text":"Information is organised, interpreted & stored (memory) by the brain."},{"id":"12","kind":"label","chars":56,"max":56,"perLine":14.0,"lines":4,"caps":false,"sz":27.99,"paras":1,"text":"An appropriate response is generated based on the input."},{"id":"13","kind":"label","chars":8,"max":10,"perLine":9.6,"lines":1,"caps":true,"sz":53.4,"paras":1,"text":"RESPONSE"},{"id":"14","kind":"label","chars":10,"max":11,"perLine":11.1,"lines":1,"caps":true,"sz":53.38,"paras":1,"text":"PROCESSING"},{"id":"15","kind":"title","chars":5,"max":8,"perLine":6.3,"lines":1,"caps":true,"sz":53.4,"paras":1,"text":"INPUT"},{"id":"16","kind":"label","chars":30,"max":30,"perLine":10.0,"lines":3,"caps":true,"sz":45.93,"paras":1,"text":"SENSORY INFORMATION PROCESSING"}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"5","kind":"label","chars":15,"max":39,"perLine":19.6,"lines":2,"caps":true,"sz":41.0,"paras":1,"text":"ELECTROMAGNETIC"},{"id":"8","kind":"label","chars":10,"max":39,"perLine":19.6,"lines":2,"caps":true,"sz":41.0,"paras":1,"text":"MECHANICAL"},{"id":"11","kind":"label","chars":8,"max":39,"perLine":19.6,"lines":2,"caps":true,"sz":41.0,"paras":1,"text":"CHEMICAL"},{"id":"14","kind":"title","chars":22,"max":24,"perLine":23.9,"lines":1,"caps":true,"sz":76.0,"paras":1,"text":"SENSORY RECEPTOR TYPES"},{"id":"15","kind":"label","chars":58,"max":57,"perLine":56.8,"lines":1,"caps":false,"sz":39.99,"paras":1,"text":"Three of the main sensory receptor types in organisms are:"}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"5","kind":"label","chars":50,"max":50,"perLine":25.0,"lines":2,"caps":false,"sz":29.99,"paras":1,"text":"Electromagnetic receptors respond to light energy."},{"id":"6","kind":"title","chars":25,"max":25,"perLine":12.5,"lines":2,"caps":true,"sz":82.0,"paras":2,"text":"ELECTROMAGNETIC\nRECEPTORS"},{"id":"7","kind":"label","chars":43,"max":43,"perLine":14.3,"lines":3,"caps":true,"sz":35.0,"paras":1,"text":"THE EYE CONTAINS ELECTROMAGNETIC RECEPTORS."},{"id":"10","kind":"text","chars":134,"max":134,"perLine":33.5,"lines":4,"caps":false,"sz":29.99,"paras":1,"text":"Receptors in the eye respond to light by generating electrical impulses that travel from the eye through the optic nerve to the brain."}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"4","kind":"text","chars":61,"max":61,"perLine":20.3,"lines":3,"caps":false,"sz":29.99,"paras":1,"text":"Mechanical receptors respond to touch pressure and vibration."},{"id":"7","kind":"text","chars":107,"max":107,"perLine":26.8,"lines":4,"caps":false,"sz":29.99,"paras":1,"text":"Receptors in the skin convert mechanical pressure (touch) into electrical signals that travel to the brain."},{"id":"9","kind":"title","chars":20,"max":20,"perLine":10.0,"lines":2,"caps":true,"sz":95.99,"paras":2,"text":"MECHANICAL\nRECEPTORS"},{"id":"10","kind":"label","chars":44,"max":44,"perLine":14.7,"lines":3,"caps":true,"sz":35.0,"paras":1,"text":"THE SKIN CONTAINS MANY MECHANICAL RECEPTORS."}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"4","kind":"text","chars":67,"max":67,"perLine":22.3,"lines":3,"caps":false,"sz":29.99,"paras":1,"text":"Chemical receptors respond to chemical changes in their environment"},{"id":"7","kind":"text","chars":97,"max":97,"perLine":24.2,"lines":4,"caps":false,"sz":29.99,"paras":1,"text":"Receptors on the tongue convert chemical energy into electrical signals that travel to the brain."},{"id":"9","kind":"title","chars":18,"max":23,"perLine":11.6,"lines":2,"caps":true,"sz":100.0,"paras":2,"text":"CHEMICAL\nRECEPTORS"},{"id":"10","kind":"label","chars":57,"max":57,"perLine":19.0,"lines":3,"caps":true,"sz":35.0,"paras":1,"text":"THE TASTE BUDS ON YOUR TONGUE CONTAIN CHEMICAL RECEPTORS."}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"4","kind":"text","chars":92,"max":92,"perLine":30.7,"lines":3,"caps":false,"sz":37.0,"paras":1,"text":"The most sensitive mechanical receptors in humans are the hair cells found in the inner ear."},{"id":"6","kind":"title","chars":17,"max":20,"perLine":19.7,"lines":1,"caps":false,"sz":136.6,"paras":1,"text":"Another fun fact!"}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"4","kind":"title","chars":21,"max":21,"perLine":7.0,"lines":3,"caps":true,"sz":113.0,"paras":2,"text":"EXIT TICKET\nQUESTIONS"}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"2","kind":"title","chars":49,"max":49,"perLine":12.2,"lines":4,"caps":true,"sz":78.0,"paras":1,"text":"WHAT'S ONE THING YOU LEARNED FROM TODAY'S LESSON?"}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"content","slots":[{"id":"5","kind":"title","chars":61,"max":61,"perLine":15.2,"lines":4,"caps":true,"sz":57.0,"paras":2,"text":"WHAT'S ONE THING YOU\n DID NOT UNDERSTAND FROM TODAY'S LESSON?"}],"photos":[]},{"n":12,"part":"ppt/