     "max": 100,
     "perLine": 33.3,
     "lines": 3,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "Jamoat transporti va velosipeddan foydalaning\nChiqindi va barglarni yoqmang\nUy atrofiga daraxt eking",
     "font": "Segoe UI",
     "anchor": "t",
