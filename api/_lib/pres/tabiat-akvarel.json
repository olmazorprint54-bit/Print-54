{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"6","kind":"title","chars":51,"max":51,"perLine":17.0,"lines":3,"caps":true,"sz":42.0,"paras":1,"text":"URUG'LAR VA KURTAKLARNING TINIM DAVRI FIZIOLOGIYASI","font":"Times New Roman","anchor":"t","box":[1334859,3175000,8763000,1651000],"lineH":640080,"ins":0,"useW":0.949},{"id":"8","kind":"label","chars":22,"max":40,"perLine":40.2,"lines":1,"caps":false,"sz":36.0,"paras":1,"text":"va uni buzish yo'llari","font":"Times New Roman","anchor":"t","box":[1510456,5587999,7620000,635000],"lineH":548640,"ins":0,"useW":0.502},{"id":"9","kind":"label","chars":18,"max":33,"perLine":32.7,"lines":1,"caps":false,"sz":31.0,"paras":1,"text":"Xolmamatova Asolat","font":"Times New Roman","anchor":"t","box":[1504370,6921500,5334000,571500],"lineH":472440,"ins":0,"useW":0.629}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"4","kind":"title","chars":4,"max":8,"perLine":5.6,"lines":1,"caps":false,"sz":111.66,"paras":1,"text":"Reja","font":"Times New Roman","anchor":"t","box":[1440695,1763005,3270367,1436291],"lineH":1418082,"ins":0,"useW":0.794,"base":0.804,"tail":0.216,"below":[{"id":"5","gap":1.587,"cap":0.087},{"id":"7","gap":1.47,"cap":0.091}]},{"id":"5","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":68.45,"paras":1,"text":"01","font":"Times New Roman","anchor":"t","box":[1463823,4012827,878446,872034],"lineH":869315,"ins":0},{"id":"7","kind":"label","chars":35,"max":37,"perLine":37.5,"lines":1,"caps":false,"sz":33.5,"paras":1,"text":"Tinim davrining mohiyati va turlari","font":"Times New Roman","anchor":"t","box":[3546522,3848018,6604000,635000],"lineH":510540,"ins":0,"useW":0.916},{"id":"8","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":68.45,"paras":1,"text":"02","font":"Times New Roman","anchor":"t","box":[1461975,5353241,1142320,906755],"lineH":869315,"ins":0},{"id":"9","kind":"label","chars":37,"max":38,"perLine":38.0,"lines":1,"caps":false,"sz":33.0,"paras":1,"text":"Urug'lar va kurtaklar tinimi asoslari","font":"Times New Roman","anchor":"t","box":[3546522,5512380,6604000,635000],"lineH":502920,"ins":0,"useW":0.906},{"id":"10","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":68.45,"paras":1,"text":"03","font":"Times New Roman","anchor":"t","box":[1461707,6693656,1169104,906755],"lineH":869315,"ins":0},{"id":"11","kind":"label","chars":23,"max":35,"perLine":34.8,"lines":1,"caps":false,"sz":36.0,"paras":1,"text":"Tinimni buzish usullari","font":"Times New Roman","anchor":"t","box":[3546522,6837734,6604000,635000],"lineH":548640,"ins":0,"useW":0.647},{"id":"12","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":68.45,"paras":1,"text":"04","font":"Times New Roman","anchor":"t","box":[1461788,8019010,1161069,906755],"lineH":869315,"ins":0},{"id":"13","kind":"label","chars":26,"max":35,"perLine":34.8,"lines":1,"caps":false,"sz":36.0,"paras":1,"text":"Amaliy ahamiyati va xulosa","font":"Times New Roman","anchor":"t","box":[3546523,8163088,6604000,635000],"lineH":548640,"ins":0,"useW":0.778}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"4","kind":"title","chars":24,"max":24,"perLine":12.0,"lines":2,"caps":true,"sz":46.19,"paras":1,"text":"TINIM DAVRINING MOHIYATI","font":"Times New Roman","anchor":"t","box":[1159224,2502505,7307272,1201820],"lineH":586613,"ins":0,"useW":0.705},{"id":"6","kind":"text","chars":351,"max":351,"perLine":29.2,"lines":12,"caps":false,"sz":29.0,"paras":3,"text":"Tinim davri – o'simlik organlarida (urug', kurtak, tugunak, piyozbosh) o'sish vaqtincha to'xtab, moddalar almashinuvi keskin pasayadigan holat.\nU qish sovug'i va qurg'oqchilik kabi noqulay sharoitda omon qolishga moslashuv bo'lib, evolyutsiyada irsiy mustahkamlangan.\nTinimdagi to'qimalarda suv kam, nafas olish sust, zaxira moddalar tejab sarflanadi.","font":"Times New Roman","anchor":"t","box":[1211922,4571999,6858000,5334000],"lineH":441960,"ins":0}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"6","kind":"title","chars":13,"max":16,"perLine":15.9,"lines":1,"caps":true,"sz":48.55,"paras":1,"text":"TINIM TURLARI","font":"Times New Roman","anchor":"t","box":[1227798,1302252,5807721,799963],"lineH":863219,"ins":0,"useW":0.792},{"id":"9","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":79.91,"paras":1,"text":"01","font":"Times New Roman","anchor":"t","box":[1917281,3620517,1153168,1369191],"lineH":1420876,"ins":0},{"id":"11","kind":"text","chars":155,"max":155,"perLine":19.4,"lines":8,"caps":false,"sz":30.0,"paras":1,"text":"Majburiy (tashqi) tinim: past harorat, namlik yoki kislorod yetishmasligi sababli o'sish to'xtaydi. Qulay sharoit tug'ilishi bilan o'sish darhol tiklanadi.","font":"Times New Roman","anchor":"t","box":[1917699,5587999,6604000,3556000],"lineH":457200,"ins":0},{"id":"14","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":72.77,"paras":1,"text":"02","font":"Times New Roman","anchor":"t","box":[10061156,3692978,1153168,1243320],"lineH":1293876,"ins":0},{"id":"16","kind":"text","chars":159,"max":159,"perLine":19.9,"lines":8,"caps":false,"sz":30.0,"paras":1,"text":"Chuqur (ichki, fiziologik) tinim: sabab o'simlikning o'zida – ingibitorlar, yetilmagan murtak, qattiq po'st. Qulay sharoitda ham o'smaydi, maxsus ta'sir kerak.","font":"Times New Roman","anchor":"t","box":[10007599,5587999,6604000,3556000],"lineH":457200,"ins":0}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"4","kind":"title","chars":29,"max":29,"perLine":14.5,"lines":2,"caps":true,"sz":38.99,"paras":1,"text":"URUG'LAR TINIMINING SABABLARI","font":"Times New Roman","anchor":"t","box":[1159224,2502505,7307272,1000274],"lineH":495173,"ins":0,"useW":0.743},{"id":"6","kind":"text","chars":287,"max":287,"perLine":23.9,"lines":12,"caps":false,"sz":30.0,"paras":4,"text":"Qattiq urug' po'sti suv va kislorodni o'tkazmaydi (beda, sebarga, akatsiya).\nMurtak yetilmagan – morfologik tinim (jenshen, ayrim soyabonguldoshlar).\nO'sish ingibitorlari: absiz kislota (ABK), kumarin, fenol birikmalari.\nUrug' yetilgan bo'lsa ham, unishi uchun sovuq davr talab qilinadi.","font":"Times New Roman","anchor":"t","box":[1211922,4571999,6858000,5334000],"lineH":457200,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"6","kind":"title","chars":13,"max":16,"perLine":16.0,"lines":1,"caps":true,"sz":60.29,"paras":1,"text":"MURTAK TINIMI","font":"Times New Roman","anchor":"t","box":[1213658,2321622,7221722,769441],"lineH":765683,"ins":0,"useW":0.826},{"id":"8","kind":"text","chars":318,"max":318,"perLine":24.5,"lines":13,"caps":false,"sz":29.0,"paras":4,"text":"Murtak yetilmagan yoki unda ingibitorlar ko'p bo'lsa, urug' qulay sharoitda ham unmaydi.\nOlma, nok, o'rik urug'lari 2–5 °C da 2–4 oy sovuq stratifikatsiyadan keyin unadi.\nSovuq ta'sirida ABK parchalanadi, gibberellin miqdori ortadi.\nMurtakni ajratib o'stirish (embrion kulturasi) tinimni chetlab o'tishga imkon beradi.","font":"Times New Roman","anchor":"t","box":[1346199,4254500,7239000,5588000],"lineH":441960,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"4","kind":"title","chars":25,"max":25,"perLine":12.5,"lines":2,"caps":true,"sz":45.95,"paras":1,"text":"KURTAKLAR TINIMI ASOSLARI","font":"Times New Roman","anchor":"t","box":[1159224,2502505,7307272,1201820],"lineH":583565,"ins":0,"useW":0.768},{"id":"6","kind":"text","chars":308,"max":308,"perLine":23.7,"lines":13,"caps":false,"sz":26.5,"paras":4,"text":"Kuzda kun qisqarishi va harorat pasayishi bilan kurtaklarda tinim boshlanadi.\nFitoxrom tizimi yorug'lik davomiyligini sezadi: qisqa kun – tinim signali.\nHujayralarda suv kamayadi, kurtak tangachalari himoya qiladi, bo'linish to'xtaydi.\nTinimdan chiqish uchun sovuq davr kerak: olmada 0–7 °C da 800–1200 soat.","font":"Times New Roman","anchor":"t","box":[1211922,4571999,5969000,5334000],"lineH":403860,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"4","kind":"title","chars":22,"max":51,"perLine":25.5,"lines":2,"caps":false,"sz":53.0,"paras":1,"text":"Fitogormonlar nazorati","font":"Times New Roman","anchor":"t","box":[1440694,1763005,7112000,1524000],"lineH":807720,"ins":0,"useW":0.875},{"id":"5","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":68.45,"paras":1,"text":"01","font":"Times New Roman","anchor":"t","box":[1463823,4012827,878446,872034],"lineH":869315,"ins":0},{"id":"7","kind":"text","chars":66,"max":66,"perLine":22.0,"lines":3,"caps":false,"sz":29.0,"paras":1,"text":"Absiz kislota (ABK) tinimni saqlaydi: o'sish va unishni to'xtatadi","font":"Times New Roman","anchor":"t","box":[3546522,3892567,5715000,1143000],"lineH":441960,"ins":0},{"id":"8","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":68.45,"paras":1,"text":"02","font":"Times New Roman","anchor":"t","box":[1461975,5353241,1142320,906755],"lineH":869315,"ins":0},{"id":"9","kind":"label","chars":57,"max":57,"perLine":19.0,"lines":3,"caps":false,"sz":29.0,"paras":1,"text":"Gibberellin (GK) o'sishni qo'zg'atadi, tinimdan chiqaradi","font":"Times New Roman","anchor":"t","box":[3546522,5232981,5715000,1143000],"lineH":441960,"ins":0,"useW":0.961,"base":3.365,"tail":0.216,"below":[{"id":"11","gap":3.599,"cap":0.302}]},{"id":"10","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":68.45,"paras":1,"text":"03","font":"Times New Roman","anchor":"t","box":[1461707,6693656,1169104,906755],"lineH":869315,"ins":0},{"id":"11","kind":"label","chars":42,"max":42,"perLine":14.0,"lines":3,"caps":false,"sz":29.0,"paras":1,"text":"Sitokininlar hujayra bo'linishini tiklaydi","font":"Times New Roman","anchor":"t","box":[3546522,6558335,5715000,1143000],"lineH":441960,"ins":0,"useW":0.818,"base":3.365,"tail":0.216,"below":[{"id":"13","gap":3.599,"cap":0.302}]},{"id":"12","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":68.45,"paras":1,"text":"04","font":"Times New Roman","anchor":"t","box":[1461788,8019010,1161069,906755],"lineH":869315,"ins":0},{"id":"13","kind":"text","chars":61,"max":61,"perLine":20.3,"lines":3,"caps":false,"sz":29.0,"paras":1,"text":"ABK/GK nisbati hal qiladi: ABK ko'p – tinim, GK ko'p – o'sish","font":"Times New Roman","anchor":"t","box":[3546522,7883689,5715000,1143000],"lineH":441960,"ins":0}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"4","kind":"title","chars":23,"max":23,"perLine":11.5,"lines":2,"caps":false,"sz":53.0,"paras":1,"text":"Tinimni buzish usullari","font":"Times New Roman","anchor":"t","box":[1121649,1866104,4826000,1752600],"lineH":807720,"ins":0,"useW":0.849},{"id":"6","kind":"text","chars":180,"max":180,"perLine":15.0,"lines":12,"caps":false,"sz":29.0,"paras":4,"text":"Skarifikatsiya – qattiq po'stni mexanik zararlash.\nStratifikatsiya – nam qumda 0–5 °C da 1–3 oy saqlash.\nGibberellin (GK3) eritmasida ivitish.\nIssiq suvda (50–60 °C) qisqa ivitish.","font":"Times New Roman","anchor":"t","box":[1650999,4318000,4318000,5334000],"lineH":441960,"ins":0}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"6","kind":"title","chars":16,"max":20,"perLine":19.6,"lines":1,"caps":true,"sz":39.45,"paras":1,"text":"KIMYOVIY USULLAR","font":"Times New Roman","anchor":"t","box":[1227798,1302252,5807721,647613],"lineH":701421,"ins":0,"useW":0.863},{"id":"9","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":79.91,"paras":1,"text":"01","font":"Times New Roman","anchor":"t","box":[1917281,3620517,1153168,1369191],"lineH":1420876,"ins":0},{"id":"11","kind":"text","chars":103,"max":103,"perLine":12.9,"lines":8,"caps":false,"sz":30.0,"paras":1,"text":"Gibberellin (GK3) 100–500 mg/l eritmasida 12–24 soat ivitish – tinimni buzadi va unishni tezlashtiradi.","font":"Times New Roman","anchor":"t","box":[1917699,5587999,6604000,3556000],"lineH":457200,"ins":0},{"id":"14","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":72.77,"paras":1,"text":"02","font":"Times New Roman","anchor":"t","box":[10061156,3692978,1153168,1243320],"lineH":1293876,"ins":0},{"id":"16","kind":"text","chars":168,"max":168,"perLine":21.0,"lines":8,"caps":false,"sz":30.0,"paras":1,"text":"Sulfat kislota (H2SO4) bilan 5–30 daqiqa ishlov qattiq po'stni yupqalashtiradi, so'ng urug' yaxshilab yuviladi. Kaliy nitrat (KNO3, 0,2 %) ham unishni rag'batlantiradi.","font":"Times New Roman","anchor":"t","box":[10007599,5587999,6604000,3556000],"lineH":457200,"ins":0}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"content","slots":[{"id":"4","kind":"title","chars":21,"max":21,"perLine":10.5,"lines":2,"caps":false,"sz":53.0,"paras":1,"text":"Asosiy ko'rsatkichlar","font":"Times New Roman","anchor":"t","box":[1121649,1866104,4826000,1752600],"lineH":807720,"ins":0,"useW":0.752},{"id":"6","kind":"text","chars":118,"max":118,"perLine":10.7,"lines":11,"caps":false,"sz":31.0,"paras":5,"text":"Stratifikatsiya: 0–5 °C, 1–3 oy\nGK3 eritmasi: 100–500 mg/l\nKNO3 eritmasi: 0,2 %\nIssiq suv: 50–60 °C\nH2SO4: 5–30 daqiqa","font":"Times New Roman","anchor":"t","box":[1650999,4318000,4318000,5334000],"lineH":472440,"ins":0}],"photos":[]},{"n":12,"part":"ppt/slides/slide12.xml","role":"content","slots":[{"id":"4","kind":"title","chars":20,"max":21,"perLine":21.2,"lines":1,"caps":true,"sz":45.89,"paras":1,"text":"AMALIY QO'LLANILISHI","font":"Times New Roman","anchor":"t","box":[1159224,2502505,7307272,589905],"lineH":582803,"ins":0,"useW":0.909},{"id":"6","kind":"text","chars":279,"max":279,"perLine":23.2,"lines":12,"caps":false,"sz":30.0,"paras":4,"text":"Urug'chilik: urug'larni ekishga tayyorlash, bir tekis unishni ta'minlash.\nBog'dorchilik: mevali daraxt va uzum kurtaklarini o'z vaqtida uyg'otish.\nKartoshka: tugunaklarni ekishdan oldin yorug'likda undirish.\nO'rmonchilik: ko'chatlarni bir tekis undirish, urug'larni uzoq saqlash.","font":"Times New Roman","anchor":"t","box":[1211922,4571999,6858000,5334000],"lineH":457200,"ins":0}],"photos":[]},{"n":13,"part":"ppt/slides/slide13.xml","role":"content","slots":[{"id":"6","kind":"title","chars":6,"max":12,"perLine":11.6,"lines":1,"caps":true,"sz":83.08,"paras":1,"text":"XULOSA","font":"Times New Roman","anchor":"t","box":[1213658,2321622,7221722,1064394],"lineH":1055116,"ins":0,"useW":0.592},{"id":"8","kind":"text","chars":308,"max":308,"perLine":23.7,"lines":13,"caps":false,"sz":29.0,"paras":5,"text":"Tinim – o'simlikning noqulay sharoitda omon qolishga moslashuvi.\nTinim tashqi (majburiy) va ichki (chuqur) bo'ladi.\nUni fitogormonlar – ABK va gibberellin muvozanati boshqaradi.\nSkarifikatsiya, stratifikatsiya va kimyoviy usullar tinimni buzadi.\nTinimni boshqarish qishloq xo'jaligida hosildorlikni oshiradi.","font":"Times New Roman","anchor":"t","box":[1346199,4254500,7239000,5588000],"lineH":441960,"ins":0}],"photos":[]},{"n":14,"part":"ppt/slides/slide14.xml","role":"end","slots":[{"id":"4","kind":"title","chars":26,"max":26,"perLine":13.0,"lines":2,"caps":false,"sz":73.03,"paras":1,"text":"E'tiboringiz uchun rahmat!","font":"Times New Roman","anchor":"t","box":[1343009,2329577,7681142,1923604],"lineH":955675,"ins":0,"useW":0.89},{"id":"6","kind":"label","chars":9,"max":84,"perLine":42.2,"lines":2,"caps":false,"sz":32.0,"paras":1,"text":"Savollar?","font":"Times New Roman","anchor":"t","box":[1390994,5588000,7112000,558800],"lineH":354076,"ins":0,"useW":0.215,"base":1.572,"tail":0.216,"below":[{"id":"7","gap":1.75,"cap":0.038}]},{"id":"7","kind":"label","chars":18,"max":84,"perLine":42.2,"lines":2,"caps":false,"sz":32.0,"paras":1,"text":"Xolmamatova Asolat","font":"Times New Roman","anchor":"t","box":[1376595,6299200,7112000,558800],"lineH":354076,"ins":0,"useW":0.487,"base":1.572,"tail":0.216,"below":[{"id":"8","gap":1.75,"cap":0.038}]},{"id":"8","kind":"label","chars":25,"max":84,"perLine":42.2,"lines":2,"caps":false,"sz":32.0,"paras":1,"text":"Oʻsimliklar fiziologiyasi","font":"Times New Roman","anchor":"t","box":[1369092,7010400,7112000,558800],"lineH":354076,"ins":0,"useW":0.563,"base":1.572,"tail":0.216,"below":[{"id":"9","gap":1.75,"cap":0.038}]},{"id":"9","kind":"label","chars":28,"max":84,"perLine":42.2,"lines":2,"caps":false,"sz":32.0,"paras":1,"text":"Urug'lar va kurtaklar tinimi","font":"Times New Roman","anchor":"t","box":[1358127,7721600,7112000,558800],"lineH":354076,"ins":0,"useW":0.627}],"photos":[]}]}