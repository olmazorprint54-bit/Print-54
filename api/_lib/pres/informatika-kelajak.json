{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"7","kind":"title","chars":17,"max":31,"perLine":15.5,"lines":2,"caps":true,"sz":103.14,"paras":1,"text":"FUTURE TECHNOLOGY"},{"id":"8","kind":"label","chars":13,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"studio shodwe"},{"id":"9","kind":"label","chars":7,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"page 01"},{"id":"10","kind":"label","chars":57,"max":54,"perLine":53.7,"lines":1,"caps":false,"sz":23.75,"paras":1,"text":"Exploring innovations that will shape our world tomorrow."}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"7","kind":"label","chars":13,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"studio shodwe"},{"id":"8","kind":"label","chars":23,"max":24,"perLine":23.9,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"www.reallygreatsite.com"},{"id":"9","kind":"label","chars":7,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"page 02"},{"id":"10","kind":"title","chars":33,"max":33,"perLine":11.0,"lines":3,"caps":true,"sz":54.6,"paras":1,"text":"ARTIFICIAL INTELLIGENCE EVOLUTION"},{"id":"11","kind":"text","chars":381,"max":381,"perLine":38.1,"lines":10,"caps":false,"sz":27.77,"paras":1,"text":"Artificial Intelligence is rapidly advancing, bringing transformative changes across various industries. From healthcare to finance, AI is enhancing decision-making, automating tasks, and enabling machines to learn and adapt in ways that were previously unimaginable. This evolution is paving the way for smarter, more efficient systems that will redefine the way we live and work."}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"9","kind":"label","chars":13,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"studio shodwe"},{"id":"10","kind":"label","chars":23,"max":24,"perLine":23.9,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"www.reallygreatsite.com"},{"id":"11","kind":"label","chars":7,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"page 04"},{"id":"12","kind":"title","chars":17,"max":26,"perLine":25.7,"lines":1,"caps":true,"sz":54.6,"paras":1,"text":"QUANTUM COMPUTING"},{"id":"13","kind":"text","chars":451,"max":451,"perLine":75.2,"lines":6,"caps":false,"sz":27.77,"paras":1,"text":"Quantum computing represents a leap forward in computational power, harnessing the principles of quantum mechanics to perform complex calculations at unprecedented speeds. Unlike classical computers, which use bits as the basic unit of information, quantum computers use qubits, allowing them to process vast amounts of data simultaneously. This breakthrough could revolutionize fields like cryptography, material science, and artificial intelligence."}],"photos":[{"id":"8","w":11833983,"h":2444176,"area":0.154}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"10","kind":"label","chars":13,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"studio shodwe"},{"id":"11","kind":"label","chars":23,"max":24,"perLine":23.9,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"www.reallygreatsite.com"},{"id":"12","kind":"label","chars":7,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"page 02"},{"id":"13","kind":"title","chars":11,"max":16,"perLine":15.8,"lines":1,"caps":true,"sz":54.6,"paras":1,"text":"5G NETWORKS"},{"id":"14","kind":"text","chars":405,"max":405,"perLine":36.8,"lines":11,"caps":false,"sz":27.77,"paras":1,"text":"The deployment of 5G networks is revolutionizing how we connect and communicate. With significantly faster data speeds, lower latency, and the capacity to support a massive number of connected devices, 5G is enabling new applications like smart cities, autonomous vehicles, and advanced IoT (Internet of Things) solutions. This technology is laying the foundation for a more connected and efficient world."}],"photos":[{"id":"9","w":6526927,"h":2730483,"area":0.095}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"11","kind":"label","chars":13,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"studio shodwe"},{"id":"12","kind":"label","chars":23,"max":24,"perLine":23.9,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"www.reallygreatsite.com"},{"id":"13","kind":"label","chars":7,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"page 05"},{"id":"14","kind":"title","chars":19,"max":30,"perLine":15.0,"lines":2,"caps":true,"sz":54.6,"paras":1,"text":"AUTONOMOUS VEHICLES"},{"id":"15","kind":"text","chars":397,"max":397,"perLine":36.1,"lines":11,"caps":false,"sz":27.77,"paras":1,"text":"Autonomous vehicles, or self-driving cars, are set to transform the transportation industry. By leveraging advanced sensors, AI, and real-time data, these vehicles can navigate roads with minimal human intervention. The adoption of autonomous vehicles promises to enhance road safety, reduce traffic congestion, and provide greater mobility options, particularly for those who are unable to drive."}],"photos":[{"id":"10","w":5761446,"h":5735794,"area":0.176}]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"9","kind":"label","chars":13,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"studio shodwe"},{"id":"10","kind":"label","chars":23,"max":24,"perLine":23.9,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"www.reallygreatsite.com"},{"id":"11","kind":"label","chars":7,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"page 06"},{"id":"12","kind":"title","chars":12,"max":19,"perLine":18.9,"lines":1,"caps":true,"sz":54.6,"paras":1,"text":"SMART CITIES"},{"id":"13","kind":"label","chars":17,"max":23,"perLine":11.4,"lines":2,"caps":false,"sz":27.77,"paras":1,"text":"Energy Efficiency"},{"id":"14","kind":"text","chars":73,"max":73,"perLine":18.2,"lines":4,"caps":false,"sz":23.77,"paras":1,"text":"Optimizing energy use through smart grids and sustainable infrastructure."},{"id":"15","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":41.77,"paras":1,"text":"1."},{"id":"18","kind":"label","chars":21,"max":21,"perLine":10.5,"lines":2,"caps":false,"sz":27.77,"paras":1,"text":"Public Transportation"},{"id":"19","kind":"text","chars":70,"max":70,"perLine":17.5,"lines":4,"caps":false,"sz":23.77,"paras":1,"text":"Enhancing transit systems with real-time data and autonomous vehicles."},{"id":"20","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":41.77,"paras":1,"text":"2."},{"id":"23","kind":"label","chars":16,"max":26,"perLine":13.0,"lines":2,"caps":false,"sz":27.77,"paras":1,"text":"Waste Management"},{"id":"24","kind":"text","chars":77,"max":77,"perLine":19.2,"lines":4,"caps":false,"sz":23.77,"paras":1,"text":"Implementing smart waste collection and recycling systems for cleaner cities."},{"id":"25","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":41.77,"paras":1,"text":"3."}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"8","kind":"label","chars":13,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"studio shodwe"},{"id":"9","kind":"label","chars":23,"max":24,"perLine":23.9,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"www.reallygreatsite.com"},{"id":"10","kind":"label","chars":7,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"page 07"},{"id":"11","kind":"title","chars":16,"max":27,"perLine":13.5,"lines":2,"caps":true,"sz":54.6,"paras":1,"text":"RENEWABLE ENERGY"},{"id":"12","kind":"label","chars":11,"max":11,"perLine":11.4,"lines":1,"caps":false,"sz":27.77,"paras":1,"text":"Solar Power"},{"id":"13","kind":"text","chars":144,"max":144,"perLine":36.0,"lines":4,"caps":false,"sz":27.77,"paras":1,"text":"Utilizing photovoltaic panels to convert sunlight into electricity, providing a clean and renewable energy source that reduces carbon emissions."},{"id":"15","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":25.75,"paras":1,"text":"1."},{"id":"16","kind":"label","chars":13,"max":18,"perLine":17.7,"lines":1,"caps":false,"sz":27.77,"paras":1,"text":"Wind Turbines"},{"id":"17","kind":"text","chars":151,"max":151,"perLine":37.8,"lines":4,"caps":false,"sz":27.77,"paras":1,"text":"Capturing wind energy through large turbines to generate electricity, contributing to a sustainable energy mix and decreasing reliance on fossil fuels."},{"id":"19","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":25.75,"paras":1,"text":"2."}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"7","kind":"label","chars":13,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"studio shodwe"},{"id":"8","kind":"label","chars":23,"max":24,"perLine":23.9,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"www.reallygreatsite.com"},{"id":"9","kind":"label","chars":7,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"page 06"},{"id":"10","kind":"title","chars":15,"max":27,"perLine":26.6,"lines":1,"caps":true,"sz":54.6,"paras":1,"text":"VIRTUAL REALITY"},{"id":"11","kind":"text","chars":416,"max":416,"perLine":83.2,"lines":5,"caps":false,"sz":27.77,"paras":1,"text":"Virtual Reality (VR) is extending its reach beyond gaming into areas like education, healthcare, and entertainment. By creating immersive, interactive experiences, VR has the potential to revolutionize how we learn, train, and even treat medical conditions. As the technology continues to improve, VR is expected to become an integral part of various industries, offering new ways to engage and experience the world."}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"8","kind":"label","chars":13,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"studio shodwe"},{"id":"9","kind":"label","chars":23,"max":24,"perLine":23.9,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"www.reallygreatsite.com"},{"id":"10","kind":"label","chars":7,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"page 06"},{"id":"11","kind":"title","chars":17,"max":38,"perLine":18.9,"lines":2,"caps":true,"sz":54.6,"paras":1,"text":"SPACE EXPLORATION"},{"id":"12","kind":"text","chars":441,"max":441,"perLine":55.1,"lines":8,"caps":false,"sz":27.77,"paras":1,"text":"Space exploration is entering a new era, driven by advances in technology and a renewed interest in reaching beyond our planet. From ambitious missions to Mars to the development of space tourism, these efforts are expanding our understanding of the universe and pushing the boundaries of what humanity can achieve. The future of space exploration holds the promise of new discoveries and the potential for human settlement on other planets."}],"photos":[{"id":"16","w":3681855,"h":3665463,"area":0.072}]},{"n":10,"part":"ppt/slides/slide10.xml","role":"end","slots":[{"id":"7","kind":"label","chars":13,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"studio shodwe"},{"id":"8","kind":"label","chars":23,"max":24,"perLine":23.9,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"www.reallygreatsite.com"},{"id":"9","kind":"label","chars":7,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"page 10"},{"id":"10","kind":"title","chars":10,"max":15,"perLine":15.0,"lines":1,"caps":true,"sz":94.53,"paras":1,"text":"THANK YOU!"},{"id":"11","kind":"text","chars":120,"max":120,"perLine":60.0,"lines":2,"caps":false,"sz":27.77,"paras":1,"text":"As we look to the future, these technologies will play a crucial role in shaping a better world for generations to come."}],"photos":[]}]}