o","anchor":"t","box":[7981853,9073308,2324294,298328],"lineH":284607,"ins":0,"useW":0.375},{"id":"10","kind":"title","chars":10,"max":11,"perLine":11.4,"lines":1,"caps":true,"sz":94.53,"paras":1,"text":"THANK YOU!","font":"HK Modular","anchor":"t","box":[3818141,3648280,11183517,1495220],"lineH":1512697,"ins":0,"useW":0.829,"base":1.05,"tail":0.08,"below":[{"id":"11","gap":1.645,"cap":0.045}]},{"id":"11","kind":"text","chars":120,"max":120,"perLine":60.0,"lines":2,"caps":false,"sz":27.77,"paras":1,"text":"As we look to the future, these technologies will play a crucial role in shaping a better world for generations to come.","font":"Raleway","anchor":"t","box":[3818141,5623010,10916976,756707],"lineH":380873,"ins":0}],"photos":[]}]}