,"ins":0,"useW":0.39},{"id":"11","kind":"title","chars":16,"max":21,"perLine":10.3,"lines":2,"caps":true,"sz":54.6,"paras":1,"text":"RENEWABLE ENERGY","font":"HK Modular","anchor":"t","box":[1880681,4649546,5799109,1730042],"lineH":873760,"ins":0,"useW":0.947},{"id":"12","kind":"label","chars":11,"max":13,"perLine":13.0,"lines":1,"caps":false,"sz":27.77,"paras":1,"text":"Solar Power","font":"Raleway Bold","anchor":"t","box":[9603522,2942503,2254952,385232],"lineH":380873,"ins":0,"useW":0.907},{"id":"13","kind":"text","chars":144,"max":144,"perLine":36.0,"lines":4,"caps":false,"sz":27.77,"paras":1,"text":"Utilizing photovoltaic panels to convert sunlight into electricity, providing a clean and renewable energy source that reduces carbon emissions.","font":"Raleway","anchor":"t","box":[9603522,3643843,7001911,1499657],"lineH":380873,"ins":0},{"id":"15","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":25.75,"paras":1,"text":"1.","font":"Raleway Bold","anchor":"t","box":[8701750,2908178,420330,363011],"lineH":353187,"ins":0},{"id":"16","kind":"label","chars":13,"max":20,"perLine":20.2,"lines":1,"caps":false,"sz":27.77,"paras":1,"text":"Wind Turbines","font":"Raleway Bold","anchor":"t","box":[9603522,5951177,3500956,385232],"lineH":380873,"ins":0,"useW":0.706},{"id":"17","kind":"text","chars":151,"max":151,"perLine":37.8,"lines":4,"caps":false,"sz":27.77,"paras":1,"text":"Capturing wind energy through large turbines to generate electricity, contributing to a sustainable energy mix and decreasing reliance on fossil fuels.","font":"Raleway","anchor":"t","box":[9603522,6652517,7001911,1499657],"lineH":380873,"ins":0},{"id":"19","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":25.75,"paras":1,"text":"2.","font":"Raleway Bold","anchor":"t","box":[8701750,5916851,420330,363011],"lineH":353187,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"7","kind":"label","chars":13,"max":19,"perL