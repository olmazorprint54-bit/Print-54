ps":true,"sz":54.6,"paras":1,"text":"ARTIFICIAL INTELLIGENCE EVOLUTION","font":"HK Modular","anchor":"t","box":[1776071,3663448,8056247,2589421],"lineH":873760,"ins":0,"useW":0.909},{"id":"11","kind":"text","chars":381,"max":381,"perLine":38.1,"lines":10,"caps":false,"sz":27.77,"paras":1,"text":"Artificial Intelligence is rapidly advancing, bringing transformative changes across various industries. From healthcare to finance, AI is enhancing decision-making, automating tasks, and enabling machines to learn and adapt in ways that were previously unimaginable. This evolution is paving the way for smarter, more efficient systems that will redefine the way we live and work.","font":"Raleway Light","anchor":"t","box":[9901384,3127242,6704049,3728507],"lineH":380873,"ins":0}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"9","kind":"label","chars":13,"max":19,"perLine":19.1,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"studio shodwe","font":"Gruppo","anchor":"t","box":[2655994,1165379,2324294,298328],"lineH":284607,"ins":0,"useW":0.766},{"id":"10","kind":"label","chars":23,"max":26,"perLine":25.8,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"www.reallygreatsite.com","font":"Gruppo","anchor":"t","box":[13458263,9073308,3147170,298328],"lineH":284607,"ins":0,"useW":0.913},{"id":"11","kind":"label","chars":7,"max":19,"perLine":19.1,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"page 04","font":"Gruppo","anchor":"t","box":[7981853,9073308,2324294,298328],"lineH":284607,"ins":0,"useW":0.409},{"id":"12","kind":"title","chars":17,"max":20,"perLine":19.5,"lines":1,"caps":true,"sz":54.6,"paras":1,"text":"QUANTUM COMPUTING","font":"HK Modular","anchor":"t","box":[4003523,2235401,11028326,863267],"lineH":873760,"ins":0,"useW":0.913,"base":1.05,"tail":0.08,"below":[{"id":"13","gap":1.96,"cap":0.079}]},{"id":"13","kind":"text","chars":451,"max":451,"perLine":75.2,"lines":6,"caps":false,"sz":27.77,"paras":1,"text":"Quantum computing represents a leap forward in computational power, harnessing the principles of quantum mechanics to perform complex calculations at unprecedented speeds. Unlike classical computers, which use bits as the basic unit of information, quantum computers use qubits, allowing them to process vast amounts of data simultaneously. This breakthrough could revolutionize fields like cryptography, material science, and artificial intelligence.","font":"Raleway Light","anchor":"t","box":[2655994,3594274,13441159,2242607],"lineH":380873,"ins":0}],"photos":[{"id":"8","w":11833983,"h":2444176,"area":0.154}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"10","kind":"label","chars":13,"max":19,"perLine":19.1,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"studio shodwe","font":"Gruppo","anchor":"t","box":[2655994,1165379,2324294,298328],"lineH":284607,"ins":0,"useW":0.766},{"id":"11","kind":"label","chars":23,"max":26,"perLine":25.8,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"www.reallygreatsite.com","font":"Gruppo","anchor":"t","box":[13458263,9073308,3147170,298328],"lineH":284607,"ins":0,"useW":0.913},{"id":"12","kind":"label","chars":7,"max":19,"perLine":19.1,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"page 02","font":"Gruppo","anchor":"t","box":[7981853,9073308,2324294,298328],"lineH":284607,"ins":0,"useW":0.401},{"id":"13","kind":"title","chars":11,"max":12,"perLine":12.0,"lines":1,"caps":true,"sz":54.6,"paras":1,"text":"5G NETWORKS","font":"HK Modular","anchor":"t","box":[1776071,2237866,6802634,860801],"lineH":873760,"ins":0,"useW":0.942},{"id":"14","kind":"text","chars":405,"max":405,"perLine":36.8,"lines":11,"caps":false,"sz":27.77,"paras":1,"text":"The deployment of 5G networks is revolutionizing how we connect and communicate. With significantly faster data speeds, lower latency, and the capacity to support a massive number of connected devices, 5G is enabling new applications like smart cities, autonomous vehicles, and advanced IoT (Internet of Things) solutions. This technology is laying the foundation for a more connected and efficient world.","font":"Raleway Light","anchor":"t","box":[9901384,3127242,6704049,4099982],"lineH":380873,"ins":0}],"photos":[{"id":"9","w":6526927,"h":2730483,"area":0.095}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"11","kind":"label","chars":13,"max":19,"perLine":19.1,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"studio shodwe","font":"Gruppo","anchor":"t","box":[2655994,1165379,2324294,298328],"lineH":284607,"ins":0,"useW":0.766},{"id":"12","kind":"label","chars":23,"max":26,"perLine":25.8,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"www.reallygreatsite.com","font":"Gruppo","anchor":"t","box":[13458263,9073308,3147170,298328],"lineH":284607,"ins":0,"useW":0.913},{"id":"13","kind":"label","chars":7,"max":19,"perLine":19.1,"lines":1,"caps":false,"sz":20.75,"paras":1,"text":"page 05","font":"Gruppo","anchor":"t","box":[7981853,9073308,2324294,298328],"lineH":284607,"ins":0,"useW":0.398},{"id":"14","kind":"title","chars":19,"max":23,"perLine":11.4,"lines":2,"caps":true,"sz":54.6,"paras":1,"text":"AUTONOMOUS VEHICLES","font":"HK Modular","anchor":"t","box":[8573343,2064006,6458505,1725111],"lineH":873760,"ins":0,"useW":0.945,"base":2.31,"tail":0.08,"below":[{"id":"15","gap":2.93,"cap":0.079}]},{"id":"15","kind":"text","chars":397,"max":397,"perLine":36.1,"lines":11,"caps":false,"sz":27.77,"paras":1,"text":"Autonomous vehicles, or self-driving cars, are set to transform the transportation industry. By leveraging advanced sensors, AI, and real-time data, these vehicles can navigate roads with minimal human intervention. The adoption of autonomous vehicles promises to enhance road safety, reduce traffic congestion, and provide greater mobility options, particularly for those who are unable to drive.","font":"Raleway Light","anchor":"t","box":[8573343,4095726,6704049,4099982],"lineH":380873,"ins":0}],"photos":[{"id":"10","w":