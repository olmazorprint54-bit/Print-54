{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"24","kind":"title","chars":34,"max":34,"perLine":17.0,"lines":2,"caps":true,"sz":69.95,"paras":1,"text":"EVERYDAY MOMENTS, LIFELONG LESSONS","font":"Gulfs Display","anchor":"t","box":[3830466,2231462,10627067,1777130],"lineH":861695,"ins":0}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"20","kind":"text","chars":249,"max":249,"perLine":41.5,"lines":6,"caps":false,"sz":24.99,"paras":1,"text":"In the early stages of growth, the presence and attention of parents is everything. Moments of feeding, bathing, and playing with babies build a deep sense of trust and affection. Children feel loved not only through words, but through warm touches.","font":"Canva Sans","anchor":"t","box":[7563257,4636342,7599867,2781300],"lineH":476123,"ins":0},{"id":"21","kind":"title","chars":21,"max":21,"perLine":10.5,"lines":2,"caps":true,"sz":60.0,"paras":1,"text":"EARLY MOMENTS OF LIFE","font":"Gulfs Display","anchor":"t","box":[7720582,1554795,7285216,1527810],"lineH":739140,"ins":0}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"23","kind":"text","chars":210,"max":210,"perLine":42.0,"lines":5,"caps":false,"sz":24.99,"paras":1,"text":"Children never get tired of being hugged, loved, and praised. Show love through hugs, smiles, and warm embraces. This strengthens the child's sense of security and shapes the way they love others in the future.","font":"Canva Sans","anchor":"t","box":[1925338,6839631,7599867,2314575],"lineH":476123,"ins":0},{"id":"24","kind":"title","chars":23,"max":23,"perLine":11.5,"lines":2,"caps":true,"sz":60.0,"paras":1,"text":"EXPRESSION OF AFFECTION","font":"Gulfs Display","anchor":"t","box":[2082663,3414123,7285216,1527810],"lineH":739140,"ins":0}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"21","kind":"text","chars":204,"max":204,"perLine":40.8,"lines":5,"caps":false,"sz":24.99,"paras":1,"text":"Play is a natural way for children to learn. When parents play with them or read stories, children feel valued and cared for. This not only sharpens cognitive skills, but also strengthens emotional bonds.","font":"Canva Sans","anchor":"t","box":[7563257,4869704,7599867,2314575],"lineH":476123,"ins":0},{"id":"22","kind":"title","chars":23,"max":23,"perLine":11.5,"lines":2,"caps":true,"sz":60.0,"paras":1,"text":"PLAY AND LEARN TOGETHER","font":"Gulfs Display","anchor":"t","box":[7720582,1554795,7285216,1527810],"lineH":739140,"ins":0}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"21","kind":"text","chars":199,"max":199,"perLine":39.8,"lines":5,"caps":false,"sz":24.99,"paras":1,"text":"Encouraging children to help with sweeping, cooking, or gardening not only teaches life skills but also builds self confidence. They feel like they're part of a family whose contributions are valued.","font":"Canva Sans","anchor":"t","box":[1925338,6839631,7599867,2314575],"lineH":476123,"ins":0},{"id":"22","kind":"title","chars":26,"max":26,"perLine":13.0,"lines":2,"caps":true,"sz":60.0,"paras":1,"text":"INVOLVING CHILDREN AT HOME","font":"Gulfs Display","anchor":"t","box":[1481285,3414123,8487972,1527810],"lineH":739140,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"20","kind":"text","chars":194,"max":194,"perLine":38.8,"lines":5,"caps":false,"sz":24.99,"paras":1,"text":"Take the time to listen to your child's stories, even when the topics are simple. This way, your child learns that their voice and opinions are valuable. Warm communication builds two way trust.","font":"Canva Sans","anchor":"t","box":[9107381,4869704,6218694,2314575],"lineH":476123,"ins":0},{"id":"21","kind":"title","chars":18,"max":30,"perLine":14.9,"lines":2,"caps":true,"sz":60.0,"paras":1,"text":"WARM COMMUNICATION","font":"Gulfs Display","anchor":"t","box":[7720582,1554795,7285216,1527810],"lineH":739140,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"21","kind":"text","chars":186,"max":186,"perLine":37.2,"lines":5,"caps":false,"sz":24.99,"paras":1,"text":"Involving children in gardening, caring for animals, or recycling teaches empathy and environmental stewardship. They learn that they are part of a world that must be cared for together.","font":"Canva Sans","anchor":"t","box":[1925338,6839631,7599867,2314575],"lineH":476123,"ins":0},{"id":"22","kind":"title","chars":29,"max":29,"perLine":14.5,"lines":2,"caps":true,"sz":60.0,"paras":1,"text":"LEARNING FROM THE ENVIRONMENT","font":"Gulfs Display","anchor":"t","box":[1652434,3414123,8145673,1527810],"lineH":739140,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"20","kind":"text","chars":193,"max":193,"perLine":38.6,"lines":5,"caps":false,"sz":24.99,"paras":1,"text":"When your child faces difficulties, be patient with them. Don't rush to solve their problems; simply be there and offer support. This is how they learn resilience and courage to face the world.","font":"Canva Sans","anchor":"t","box":[9107381,4869704,6218694,2314575],"lineH":476123,"ins":0},{"id":"21","kind":"title","chars":26,"max":26,"perLine":13.0,"lines":2,"caps":true,"sz":55.0,"paras":1,"text":"FACING CHALLENGES TOGETHER","font":"Gulfs Display","anchor":"t","box":[6666619,1628772,9393142,1389380],"lineH":677545,"ins":0}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"21","kind":"text","chars":179,"max":179,"perLine":44.8,"lines":4,"caps":false,"sz":24.99,"paras":1,"text":"Watching TV, reading, or sitting together and having a light conversation all build closeness. Togetherness doesn't need to be complicated; it just comes through genuine presence.","font":"Canva Sans","anchor":"t","box":[1925338,6839631,7599867,1847850],"lineH":476123,"ins":0},{"id":"22","kind":"title","chars":27,"max":27,"perLine":13.5,"lines":2,"caps":true,"sz":55.0,"paras":1,"text":"MEANINGFUL RELAXING MOMENTS","font":"Gulfs Display","anchor":"t","box":[1736221,3488100,7978100,1389380],"lineH":677545,"ins":0}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"18","kind":"title","chars":26,"max":26,"perLine":13.0,"lines":2,"caps":true,"sz":69.95,"paras":1,"text":"FAMILY IS THE FIRST SCHOOL","font":"Gulfs Display","anchor":"t","box":[4168991,2231462,7863676,1777130],"lineH":861695,"ins":0}],"photos":[]}]}