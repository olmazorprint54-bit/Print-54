{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"6","kind":"label","chars":22,"max":34,"perLine":30.8,"lines":2,"caps":false,"sz":14.0,"paras":1,"text":"Adabiyotshunoslik fani","font":"TT Hazelnuts Bold","anchor":"ctr","box":[7734226,8932090,2819548,519567],"lineH":248920,"ins":101600,"useW":0.732},{"id":"16","kind":"title","chars":12,"max":14,"perLine":14.4,"lines":1,"caps":true,"sz":152.48,"paras":1,"text":"BADIIY ZAMON","font":"Girassol","anchor":"t","box":[3161318,4067428,12158649,3102611],"lineH":2711069,"ins":0,"useW":0.857},{"id":"17","kind":"label","chars":6,"max":11,"perLine":10.6,"lines":1,"caps":false,"sz":61.22,"paras":1,"text":"asarda","font":"Girassol","anchor":"t","box":[7429483,1829862,3429034,1230858],"lineH":1088517,"ins":0,"useW":0.628},{"id":"18","kind":"label","chars":30,"max":34,"perLine":55.7,"lines":1,"caps":false,"sz":23.3,"paras":1,"text":"Muallif: G'anijonova Mubinaxon","font":"TT Hazelnuts","anchor":"t","box":[5333999,9550400,7620000,508519],"lineH":429006,"ins":0,"useW":0.552}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"25","kind":"text","chars":120,"max":120,"perLine":8.0,"lines":15,"caps":false,"sz":40.0,"paras":6,"text":"Badiiy zamon tushunchasi\nZamon mohiyati\nBadiiy zamon shakllari\nZamon tasviri usullari\nZamonning asardagi vazifasi\nXulosa","font":"TT Hazelnuts Bold","anchor":"t","box":[10033000,1714500,6604000,7112000],"lineH":479044,"ins":0},{"id":"27","kind":"title","chars":4,"max":8,"perLine":7.5,"lines":1,"caps":false,"sz":105.13,"paras":1,"text":"reja","font":"Girassol","anchor":"t","box":[3315763,6399788,4153520,1809401],"lineH":1869313,"ins":0,"useW":0.598}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"5","kind":"title","chars":18,"max":26,"perLine":14.7,"lines":3,"caps":false,"sz":86.7,"paras":1,"text":"Badiiy zamon nima?","font":"Girassol","anchor":"t","box":[1681707,1730005,6723703,3347793],"lineH":1310259,"ins":0,"useW":0.834,"base":3.321,"tail":0.01,"below":[{"id":"6","gap":3.942,"cap":0.142}]},{"id":"6","kind":"text","chars":255,"max":255,"perLine":36.4,"lines":7,"caps":false,"sz":26.66,"paras":1,"text":"Badiiy zamon – asarda tasvirlangan voqealarning davomiyligi, ketma-ketligi va o'zaro bog'liqligini ifodalovchi adabiy kategoriya. U real vaqtdan farq qiladi: yozuvchi uni o'z niyatiga ko'ra quradi. M. Baxtin zamon va makon birligini «xronotop» deb atagan.","font":"TT Hazelnuts Bold","anchor":"t","box":[1681707,6070600,8065284,3302000],"lineH":494411,"ins":0}],"photos":[{"id":"4","w":4433006,"h":7236971,"area":0.171}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"5","kind":"text","chars":294,"max":294,"perLine":32.7,"lines":9,"caps":false,"sz":25.82,"paras":1,"text":"Badiiy zamon shartli va sub'ektiv xususiyatga ega: yozuvchi uni cho'zishi, siqishi, o'tmishga qaytishi yoki kelajakka sakrashi mumkin. Bir lahza sahifalar bo'yi tasvirlanishi, yillar esa bir jumlada o'tishi mumkin. Shu bois badiiy zamon qahramonning ichki holati va muallif niyatiga bo'ysunadi.","font":"TT Hazelnuts Bold","anchor":"t","box":[1791851,4432300,8343534,5080000],"lineH":560832,"ins":0},{"id":"9","kind":"title","chars":14,"max":25,"perLine":25.0,"lines":1,"caps":false,"sz":46.0,"paras":1,"text":"Zamon mohiyati","font":"Girassol","anchor":"t","box":[1849001,2195727,6057406,1088631],"lineH":1214755,"ins":0,"useW":0.599}],"photos":[{"id":"4","w":4433006,"h":7236971,"area":0.171}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"9","kind":"label","chars":15,"max":18,"perLine":15.6,"lines":1,"caps":false,"sz":28.83,"paras":1,"text":"Voqealar zamoni","font":"Girassol","anchor":"ctr","box":[2843006,4438426,2462883,1037315],"lineH":512699,"ins":101600,"useW":0.578},{"id":"10","kind":"text","chars":167,"max":167,"perLine":18.6,"lines":9,"caps":false,"sz":20.0,"paras":1,"text":"Asardagi voqealar sodir bo'lgan davr: tarixiy, zamonaviy yoki xayoliy. Masalan, Cho'lponning «Kecha va kunduz» romani XX asr boshidagi Turkiston hayotini aks ettiradi.","font":"TT Hazelnuts Bold","anchor":"t","box":[1876919,5727700,4439763,3302000],"lineH":368300,"ins":0},{"id":"11","kind":"text","chars":141,"max":141,"perLine":15.7,"lines":9,"caps":false,"sz":20.0,"paras":1,"text":"Fasllar, kun va tunning almashinuvi. U voqealarga fon bo'lib, kayfiyat yaratadi: kuz – g'am, bahor – uyg'onish ramzi sifatida kelishi mumkin.","font":"TT Hazelnuts Bold","anchor":"t","box":[6950996,5727700,4439763,3302000],"lineH":368300,"ins":0},{"id":"12","kind":"text","chars":128,"max":128,"perLine":14.2,"lines":9,"caps":false,"sz":20.0,"paras":1,"text":"Qahramon his qilgan vaqt: kutish damlari cho'zilib, baxtli onlar tez o'tadi. U ichki monolog, tush va xotiralar orqali ochiladi.","font":"TT Hazelnuts Bold","anchor":"t","box":[11970269,5727700,4439763,3302000],"lineH":368300,"ins":0},{"id":"13","kind":"title","chars":22,"max":26,"perLine":26.4,"lines":1,"caps":false,"sz":85.92,"paras":1,"text":"Badiiy zamon shakllari","font":"Girassol","anchor":"t","box":[3282028,2099972,11920995,1838124],"lineH":1527810,"ins":0,"useW":0.848},{"id":"16","kind":"label","chars":12,"max":18,"perLine":15.6,"lines":1,"caps":false,"sz":28.83,"paras":1,"text":"Tabiiy zamon","font":"Girassol","anchor":"ctr","box":[7917084,4438426,2462883,1037315],"lineH":512699,"ins":101600,"useW":0.792},{"id":"19","kind":"label","chars":16,"max":18,"perLine":15.6,"lines":1,"caps":false,"sz":28.83,"paras":1,"text":"Psixologik zamon","font":"Girassol","anchor":"ctr","box":[12982114,4438426,2462883,1101102],"lineH":512699,"ins":101600,"useW":0.653}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"5","kind":"title","chars":13,"max":22,"perLine":22.0,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"Retrospeksiya","font":"Girassol","anchor":"ctr","box":[4813926,1637349,3667081,1198262],"lineH":580517,"ins":101600,"useW":0.627},{"id":"14","kind":"label","chars":21,"max":18,"perLine":10.5,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"Prolepsis va ellipsis","font":"Girassol","anchor":"ctr","box":[4885465,5189907,3524006,1198262],"lineH":580517,"ins":101600,"useW":0.941},{"id":"16","kind":"text","chars":176,"max":176,"perLine":35.2,"lines":5,"caps":false,"sz":20.78,"paras":1,"text":"Retrospeksiya – o'tmishga qaytish. Qahramon xotirasi orqali oldingi voqealar ochiladi va xarakter chuqurroq ko'rsatiladi. Bu usul qissa va romanlarda ayniqsa ko'p qo'llaniladi.","font":"TT Hazelnuts Bold","anchor":"t","box":[1913246,3149599,8258227,2222500],"lineH":451485,"ins":0},{"id":"17","kind":"fixed","chars":2,"max":12,"perLine":4.9,"lines":1,"caps":false,"sz":30.4,"paras":1,"text":"01","font":"Girassol","anchor":"t","box":[1879012,2076396,788230,526465],"lineH":540512,"ins":0},{"id":"18","kind":"text","chars":172,"max":172,"perLine":34.4,"lines":5,"caps":false,"sz":20.78,"paras":1,"text":"Prolepsis – kelajakdagi voqeani oldindan aytib qo'yish; ellipsis – vaqtning bir qismini tushirib qoldirish («oradan uch yil o'tdi»). Ikkalasi ham asar sur'atini boshqaradi.","font":"TT Hazelnuts Bold","anchor":"t","box":[1913246,6654799,8258227,2222500],"lineH":451485,"ins":0},{"id":"19","kind":"fixed","chars":2,"max":12,"perLine":4.9,"lines":1,"caps":false,"sz":30.4,"paras":1,"text":"02","font":"Girassol","anchor":"t","box":[1879012,5607961,788230,526465],"lineH":540512,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"9","kind":"label","chars":14,"max":18,"perLine":13.6,"lines":1,"caps":false,"sz":52.54,"paras":1,"text":"Zamon vazifasi","font":"Girassol","anchor":"ctr","box":[9738150,1659177,4692912,1436932],"lineH":934085,"ins":101600,"useW":0.859,"base":2.507,"tail":0.01,"below":[{"id":"13","gap":2.633,"cap":0.259}]},{"id":"12","kind":"title","chars":13,"max":16,"perLine":15.9,"lines":1,"caps":false,"sz":54.99,"paras":1,"text":"Asardagi roli","font":"Girassol","anchor":"ctr","box":[9738149,5572750,4692913,1410237],"lineH":977773,"ins":101600,"useW":0.815,"base":1.107,"tail":0.01,"below":[{"id":"14","gap":1.858,"cap":0.247}]},{"id":"13","kind":"text","chars":221,"max":181,"perLine":36.2,"lines":5,"caps":false,"sz":20.61,"paras":1,"text":"Zamon syujetni rivojlantiradi, voqealar ketma-ketligini belgilaydi va kompozitsiyani yaxlit qiladi. Sabab va oqibat bog'lanishi aynan zamon orqali ko'rinadi. Voqealarning tez yoki sekin kechishi asar sur'atini belgilaydi.","font":"TT Hazelnuts Bold","anchor":"t","box":[7391693,3200400,9385824,2222500],"lineH":447675,"ins":0},{"id":"14","kind":"text","chars":232,"max":232,"perLine":38.7,"lines":6,"caps":false,"sz":20.61,"paras":1,"text":"Zamon qahramon xarakterini ochadi, davr ruhini ifodalaydi va o'quvchida muayyan kayfiyat uyg'otadi. Tarixiy asarlarda zamon davr manzarasini beradi, lirik she'rlarda esa lahzani abadiylashtiradi. Shu bilan g'oyaviy mazmun kuchayadi.","font":"TT Hazelnuts Bold","anchor":"t","box":[7391693,7086600,9385824,2540000],"lineH":447675,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"end","slots":[{"id":"7","kind":"title","chars":7,"max":11,"perLine":11.2,"lines":1,"caps":false,"sz":128.0,"paras":1,"text":"Rahmat!","font":"Girassol","anchor":"t","box":[9299157,2689522,7568267,1936428],"lineH":1912747,"ins":0,"useW":0.722,"base":0.93,"tail":0.01,"below":[{"id":"12","gap":1.471,"cap":0.056}]},{"id":"12","kind":"text","chars":86,"max":86,"perLine":17.2,"lines":5,"caps":false,"sz":36.0,"paras":2,"text":"E'tiboringiz uchun katta rahmat!\nSavollaringiz bo'lsa, mamnuniyat bilan javob beraman.","font":"Girassol","anchor":"t","box":[9652000,5080000,7366000,2921000],"lineH":548640,"ins":182880}],"photos":[]}]}