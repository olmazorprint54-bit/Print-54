     "max": 125,
     "perLine": 20.8,
     "lines": 6,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "Registon madrasalarining ulkan peshtoqlari\nKoshin, girih va yozuvlar bilan bezatiladi\nIchkarida chuqur ravoqli tokcha bo'ladi",
     "font": "Georgia",
     "anchor": "t",
