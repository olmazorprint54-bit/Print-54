     "max": 128,
     "perLine": 42.7,
     "lines": 3,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Peshtoq — binoning baland va hashamatli kirish qismi. U binoning «yuzi» hisoblanadi, eng boy bezaklar aynan shu yerga ishlanadi.",
     "font": "Georgia",
     "anchor": "t",
     "box": [
      6705600,
      2717800,
      4064000,
      792333
     ],
     "lineH": 243840,
     "ins": 0
    },
    {
     "id": "15",
     "kind": "text",
