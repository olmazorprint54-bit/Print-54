     "perLine": 26.8,
     "lines": 4,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "Minorai Kalon (Buxoro, 1127) — qariyb 46 m\nIchida aylanma zinapoya bo'ladi\nSirtiga g'ishtdan naqsh terilgan",
     "font": "Georgia",
