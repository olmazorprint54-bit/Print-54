     "max": 119,
     "perLine": 29.8,
     "lines": 4,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Minora — masjid yonidagi baland va ingichka inshoot. Undan azon aytilgan, karvonlar uchun esa mayoq vazifasini o'tagan.",
     "font": "Georgia",
     "anchor": "t",
     "box": [
      6705600,
      2717800,
      4064000,
      1063176
     ],
     "lineH": 243840,
