{"size":[12192000,6858000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"2","kind":"title","chars":18,"max":49,"perLine":21.6,"lines":3,"caps":false,"sz":54.0,"paras":1,"text":"Geodeziya asoslari","font":"Times New Roman","anchor":"t","box":[2417779,802298,7686131,2541431],"lineH":822960,"ins":182880,"useW":0.691,"base":3.365,"tail":0.216,"below":[{"id":"3","gap":3.979,"cap":0.101}]},{"id":"3","kind":"label","chars":41,"max":60,"perLine":35.9,"lines":2,"caps":false,"sz":18.0,"paras":2,"text":"Fan: Geodeziya\nMuallif: Keunimajev Bekzat","font":"Times New Roman","anchor":"t","box":[2417780,3531203,6350000,1016000],"lineH":274320,"ins":182880,"useW":0.424}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"2","kind":"title","chars":15,"max":44,"perLine":22.2,"lines":2,"caps":false,"sz":40.0,"paras":1,"text":"Taqdimot rejasi","font":"Times New Roman","anchor":"t","box":[1451579,804519,4848694,1049235],"lineH":609600,"ins":182880,"useW":0.686,"base":2.165,"tail":0.216,"below":[{"id":"3","gap":2.166,"cap":0.136}]},{"id":"3","kind":"text","chars":232,"max":232,"perLine":17.8,"lines":13,"caps":false,"sz":18.0,"paras":7,"text":"1. Geodeziya fanining mohiyati va vazifalari\n2. Geodezik o'lchash asboblari\n3. Koordinata tizimlari\n4. Balandlik tizimlari\n5. Geodezik tayanch tarmoqlar va ularni barpo etish usullari\n6. Topografik xarita va reja, masshtab\n7. Xulosa","font":"Times New Roman","anchor":"t","box":[1447800,1904999,9601200,3683000],"lineH":274320,"ins":182880}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"2","kind":"title","chars":23,"max":40,"perLine":11.5,"lines":2,"caps":false,"sz":35.1,"paras":1,"text":"Tayanch tarmoq usullari","font":"Times New Roman","anchor":"t","box":[1449217,804889,4849885,1059305],"lineH":534924,"ins":182880,"useW":0.932,"base":2.165,"tail":0.216,"below":[{"id":"3","gap":2.696,"cap":0.138}]},{"id":"3","kind":"text","chars":237,"max":237,"perLine":15.8,"lines":15,"caps":false,"sz":16.0,"paras":3,"text":"Triangulyatsiya: uchburchaklar tarmog'ida burchaklar o'lchanadi, bitta tomon (bazis) ma'lum bo'ladi.\nTrilateratsiya: uchburchaklarning tomonlari uzunligi o'lchanadi.\nPoligonometriya: ko'pburchak yo'llarida burchak va tomonlar o'lchanadi.","font":"Times New Roman","anchor":"t","box":[1447800,2006599,4648200,3556000],"lineH":243840,"ins":182880},{"id":"4","kind":"text","chars":208,"max":208,"perLine":13.9,"lines":15,"caps":false,"sz":16.0,"paras":3,"text":"Geometrik nivelirlash (I–IV sinflar) – davlat balandlik tarmog'i.\nGNSS tarmoqlari: doimiy ishlovchi tayanch stansiyalar orqali o'lchovlar.\nBarcha nuqtalarning koordinata va balandliklari katalogda yuritiladi.","font":"Times New Roman","anchor":"t","box":[6413500,2006600,4648200,3556000],"lineH":243840,"ins":182880}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"2","kind":"title","chars":29,"max":27,"perLine":9.8,"lines":2,"caps":false,"sz":35.05,"paras":1,"text":"Asosiy asboblar taqqoslanishi","font":"Times New Roman","anchor":"t","box":[1447191,804163,4850908,1056319],"lineH":534162,"ins":182880,"useW":0.611,"base":2.165,"tail":0.216,"below":[{"id":"3","gap":2.73,"cap":0.172}]},{"id":"3","kind":"label","chars":8,"max":18,"perLine":14.3,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"Teodolit","font":"Times New Roman","anchor":"t","box":[1447191,2019549,2411763,801943],"lineH":304800,"ins":182880,"useW":0.386,"base":3.365,"tail":0.216,"below":[{"id":"4","gap":3.149,"cap":0.242}]},{"id":"4","kind":"text","chars":240,"max":240,"perLine":21.8,"lines":11,"caps":false,"sz":16.0,"paras":4,"text":"Gorizontal va vertikal burchaklarni o'lchaydi.\nAniqlik sinflari: T05, T1, T2, T5, T30 (raqam – burchak o'lchash xatosi, sekundlarda).\nTriangulyatsiya va poligonometriyada ishlatiladi.\nAsosiy qismlari: limb, alidada, ko'rish trubasi, adilak.","font":"Times New Roman","anchor":"t","box":[1447800,2819399,4648200,2794000],"lineH":243840,"ins":182880},{"id":"5","kind":"label","chars":7,"max":18,"perLine":18.0,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"Nivelir","font":"Times New Roman","anchor":"t","box":[6412362,2023003,2411763,802237],"lineH":304800,"ins":182880,"useW":0.323,"base":3.365,"tail":0.216,"below":[{"id":"6","gap":3.135,"cap":0.242}]},{"id":"6","kind":"text","chars":205,"max":205,"perLine":18.6,"lines":11,"caps":false,"sz":16.0,"paras":4,"text":"Nuqtalar orasidagi balandlik farqini aniqlaydi.\nGeometrik nivelirlashda gorizontal ko'rish nuri bilan ishlaydi.\nReyka (shkalali taxta) bo'yicha hisob olinadi.\nTurlari: optik, raqamli va lazerli nivelirlar.","font":"Times New Roman","anchor":"t","box":[6413500,2819399,4648200,2794000],"lineH":243840,"ins":182880}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"2","kind":"title","chars":27,"max":40,"perLine":9.0,"lines":3,"caps":false,"sz":40.0,"paras":1,"text":"Geodeziya fanining mohiyati","font":"Times New Roman","anchor":"t","box":[1451206,1129513,4923219,1830584],"lineH":609600,"ins":182880,"useW":0.84,"base":3.365,"tail":0.216,"below":[{"id":"4","gap":3.927,"cap":0.121}]},{"id":"4","kind":"text","chars":375,"max":375,"perLine":37.5,"lines":10,"caps":false,"sz":16.0,"paras":3,"text":"Geodeziya (yunoncha geo – yer, daisis – bo'lish) – Yerning shakli va o'lchamlarini aniqlash, yer sirtidagi nuqtalar o'rnini o'lchash va xaritalar tuzish haqidagi fan.\nBo'limlari: oliy geodeziya, topografiya, muhandislik geodeziyasi, kosmik geodeziya va kartografiya.\nYerning haqiqiy shakli – geoid; hisoblashlarda unga yaqin aylanish ellipsoidi (masalan, WGS-84) ishlatiladi.","font":"Times New Roman","anchor":"t","box":[1447800,3124200,5969000,2489200],"lineH":243840,"ins":182880}],"photos":[{"id":"3","w":2791171,"h":3866327,"area":0.129}]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"2","kind":"title","chars":26,"max":40,"perLine":6.5,"lines":4,"caps":false,"sz":37.27,"paras":1,"text":"Geodezik tayanch tarmoqlar","font":"Times New Roman","anchor":"t","box":[1444671,798973,3273099,2247117],"lineH":567995,"ins":182880,"useW":0.594,"base":4.565,"tail":0.216,"below":[{"id":"4","gap":5.073,"cap":0.146}]},{"id":"3","kind":"text","chars":177,"max":177,"perLine":29.5,"lines":6,"caps":false,"sz":16.0,"paras":1,"text":"Tayanch tarmoqlar butun hudud uchun yagona koordinata va balandlik asosini yaratadi. Nuqtalar yer yuzasida maxsus belgilar bilan mustahkamlanadi va ularning katalogi yuritiladi.","font":"Times New Roman","anchor":"t","box":[5041900,800100,6007100,1524000],"lineH":243840,"ins":182880},{"id":"4","kind":"text","chars":64,"max":64,"perLine":7.1,"lines":9,"caps":false,"sz":18.0,"paras":1,"text":"Aniqlik yuqoridan pastga kamayadi, nuqtalar zichligi esa ortadi.","font":"Times New Roman","anchor":"t","box":[1447799,3200399,3276600,2349500],"lineH":274320,"ins":182880},{"id":"5","kind":"label","chars":39,"max":40,"perLine":40.0,"lines":2,"caps":false,"sz":16.0,"paras":1,"text":"Davlat geodezik tarmog'i (I–IV sinflar)","font":"Times New Roman","anchor":"ctr","box":[5041900,2540000,6007100,838200],"lineH":243840,"ins":203200,"useW":0.548},{"id":"6","kind":"label","chars":39,"max":36,"perLine":36.0,"lines":2,"caps":false,"sz":16.0,"paras":1,"text":"Zichlashtirish tarmoqlari (1–2 razryad)","font":"Times New Roman","anchor":"ctr","box":[5505450,3530600,5080000,838200],"lineH":243840,"ins":203200,"useW":0.648},{"id":"7","kind":"label","chars":23,"max":30,"perLine":30.0,"lines":2,"caps":false,"sz":16.0,"paras":1,"text":"O'quv-syomka tarmoqlari","font":"Times New Roman","anchor":"ctr","box":[5969000,4521200,4152900,838200],"lineH":243840,"ins":203200,"useW":0.527}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"2","kind":"title","chars":38,"max":40,"perLine":9.5,"lines":4,"caps":false,"sz":34.27,"paras":1,"text":"Xulosa: geodeziyaning amaliy ahamiyati","font":"Times New Roman","anchor":"t","box":[1454239,1756130,4867824,1887950],"lineH":522275,"ins":182880,"useW":0.853,"base":4.565,"tail":0.216,"below":[{"id":"3","gap":4.573,"cap":0.141}]},{"id":"3","kind":"text","chars":244,"max":244,"perLine":34.9,"lines":7,"caps":false,"sz":16.0,"paras":1,"text":"Geodeziya qurilish, yer tuzish, kadastr va xaritalashning asosidir. Zamonaviy asboblar (elektron taxeometr, GNSS) va tayanch tarmoqlar ishonchli va aniq ma'lumot beradi; geodezik o'lchovlarsiz birorta yirik inshoot loyihalanmaydi va qurilmaydi.","font":"Times New Roman","anchor":"t","box":[1460500,3746499,8636000,1778000],"lineH":243840,"ins":182880},{"id":"4","kind":"label","chars":8,"max":14,"perLine":8.6,"lines":2,"caps":false,"sz":17.0,"paras":1,"text":"Qurilish","font":"Times New Roman","anchor":"ctr","box":[7112000,1397000,1905000,711200],"lineH":259080,"ins":203200,"useW":0.416},{"id":"5","kind":"label","chars":10,"max":14,"perLine":8.6,"lines":2,"caps":false,"sz":17.0,"paras":1,"text":"Yer tuzish","font":"Times New Roman","anchor":"ctr","box":[9144000,1397000,1905000,711200],"lineH":259080,"ins":203200,"useW":0.524},{"id":"6","kind":"label","chars":7,"max":14,"perLine":8.6,"lines":2,"caps":false,"sz":17.0,"paras":1,"text":"Kadastr","font":"Times New Roman","anchor":"ctr","box":[7112000,2286000,1905000,711200],"lineH":259080,"ins":203200,"useW":0.393},{"id":"7","kind":"label","chars":10,"max":14,"perLine":8.6,"lines":2,"caps":false,"sz":17.0,"paras":1,"text":"Xaritalash","font":"Times New Roman","anchor":"ctr","box":[9144000,2286000,1905000,711200],"lineH":259080,"ins":203200,"useW":0.52}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"end","slots":[{"id":"2","kind":"title","chars":26,"max":89,"perLine":29.7,"lines":3,"caps":false,"sz":54.0,"paras":1,"text":"E'tiboringiz uchun rahmat!","font":"Times New Roman","anchor":"t","box":[2417779,802298,8637073,2541431],"lineH":822960,"ins":182880,"useW":0.87,"base":3.365,"tail":0.216,"below":[{"id":"3","gap":3.979,"cap":0.098}]},{"id":"3","kind":"text","chars":80,"max":80,"perLine":20.0,"lines":4,"caps":false,"sz":17.5,"paras":2,"text":"Savollaringiz bo'lsa, mamnuniyat bilan javob beraman.\nMuallif: Keunimajev Bekzat","font":"Times New Roman","anchor":"t","box":[2417780,3531203,7112000,1016000],"lineH":266700,"ins":182880}],"photos":[]}]}