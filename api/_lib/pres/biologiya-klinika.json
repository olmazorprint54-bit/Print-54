k, fizioterapiya va reabilitatsiya usullari yordamida amalga oshiriladi.","font":"Times New Roman","anchor":"t","box":[3746499,3797299,12763500,1701800],"lineH":381000,"ins":101600},{"id":"13","kind":"text","chars":212,"max":212,"perLine":70.7,"lines":3,"caps":false,"sz":25.0,"paras":1,"text":"Zamonaviy tashxis usullariga laboratoriya tahlillari, ultratovush, rentgen va kompyuter tomografiyasi kiradi. Davolash dori-darmon, jarrohlik, fizioterapiya va reabilitatsiya usullari yordamida amalga oshiriladi.","font":"Times New Roman","anchor":"t","box":[3746499,6248400,11468100,1320800],"lineH":381000,"ins":101600},{"id":"14","kind":"label","chars":6,"max":27,"perLine":26.7,"lines":1,"caps":false,"sz":30.52,"paras":1,"text":"Tarixi","font":"Times New Roman","anchor":"t","box":[3757319,3277564,4283072,513014],"lineH":542671,"ins":0,"useW":0.221,"base":1.126,"tail":0.216,"below":[{"id":"12","gap":1.341,"cap":0.248}]},{"id":"15","kind":"label","chars":7,"max":27,"perLine":26.7,"lines":1,"caps":false,"sz":30.52,"paras":1,"text":"Bosqich","font":"Times New Roman","anchor":"t","box":[3757319,5728970,4283072,513014],"lineH":542671,"ins":0,"useW":0.297,"base":1.126,"tail":0.216,"below":[{"id":"13","gap":1.34,"cap":0.248}]},{"id":"11","kind":"title","chars":12,"max":14,"perLine":14.5,"lines":1,"caps":false,"sz":75.7,"paras":1,"text":"Profilaktika","font":"Times New Roman","anchor":"t","box":[1834756,1553548,5770801,1360277],"lineH":1346073,"ins":0,"useW":0.786,"base":1.126,"tail":0.216,"below":[{"id":"14","gap":1.793,"cap":0.187}]}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"6","kind":"title","chars":6,"max":49,"perLine":24.6,"lines":2,"caps":false,"sz":69.78,"paras":1,"text":"Maqsad","font":"Times New Roman","anchor":"t","box":[1725874,838200,9036227,2489737],"lineH":1240790,"ins":0,"useW":0.31,"base":2.526,"tail":0.216,"below":[{"id":"8","gap":3.18,"cap":0.203}]},{"id":"7","kind":"text","chars":199,"max":199,"perLine":33.2,"lines":6,"caps":false,"sz":24.0,"paras":1,"text":"Davolash dori-darmon, jarrohlik, fizioterapiya va reabilitatsiya usullari yordamida amalga oshiriladi. Profilaktika — kasallikning oldini olish bo'lib, u davolashdan ko'ra samaraliroq va arzonroqdir.","font":"Times New Roman","anchor":"t","box":[4914900,4178299,7632700,2209800],"lineH":365760,"ins":101600},{"id":"8","kind":"label","chars":6,"max":27,"perLine":26.7,"lines":1,"caps":false,"sz":30.52,"paras":1,"text":"Vazifa","font":"Times New Roman","anchor":"t","box":[4860928,3656180,4283072,513014],"lineH":542671,"ins":0,"useW":0.24,"base":1.126,"tail":0.216,"below":[{"id":"7","gap":1.347,"cap":0.238}]},{"id":"9","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":96.25,"paras":1,"text":"01","font":"Times New Roman","anchor":"t","box":[2665681,3600103,1421591,1608873],"lineH":1711325,"ins":0},{"id":"13","kind":"text","chars":447,"max":447,"perLine":63.9,"lines":7,"caps":false,"sz":24.0,"paras":1,"text":"Profilaktika — kasallikning oldini olish bo'lib, u davolashdan ko'ra samaraliroq va arzonroqdir. Robot-jarrohlik, telemeditsina va sun'iy intellekt tibbiyotda yangi imkoniyatlar ochmoqda. Shifokor kasbi katta mas'uliyat, chuqur bilim va insonparvarlikni talab qiladi. Birinchi yordam ko'rsatishni bilish ko'pincha inson hayotini saqlab qolishga yordam beradi. Muntazam tibbiy ko'rikdan o'tish kasalliklarni erta bosqichda aniqlash imkonini beradi.","font":"Times New Roman","anchor":"t","box":[3975099,7200900,10274300,2527300],"lineH":365760,"ins":101600},{"id":"14","kind":"label","chars":4,"max":27,"perLine":26.7,"lines":1,"caps":false,"sz":30.52,"paras":1,"text":"Omil","font":"Times New Roman","anchor":"t","box":[3921122,6602847,4283072,513014],"lineH":542671,"ins":0,"useW":0.186,"base":1.126,"tail":0.216,"below":[{"id":"13","gap":1.543,"cap":0.238}]},{"id":"15","kind":"fixed","chars":2,"max":12,"perLine":4.1,"lines":1,"caps":false,"sz":96.25,"paras":1,"text":"02","font":"Times New Roman","anchor":"t","box":[1725