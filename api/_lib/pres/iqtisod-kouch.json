{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"10","kind":"label","chars":16,"max":24,"perLine":24.2,"lines":1,"caps":false,"sz":28.0,"paras":1,"text":"@reallygreatsite","font":"Montserrat","anchor":"t","box":[1143000,7720083,4456944,471772],"lineH":497840,"ins":0,"useW":0.651},{"id":"12","kind":"title","chars":13,"max":13,"perLine":12.7,"lines":1,"caps":false,"sz":83.3,"paras":1,"text":"Olivia Wilson","font":"Dream Avenue","anchor":"t","box":[942975,2404490,5638025,1430800],"lineH":1481201,"ins":0,"useW":0.529},{"id":"13","kind":"label","chars":10,"max":10,"perLine":10.0,"lines":1,"caps":true,"sz":31.93,"paras":1,"text":"LIFE COACH","font":"Montserrat","anchor":"t","box":[1028700,2037996,2539587,537944],"lineH":567690,"ins":0,"useW":1.0},{"id":"14","kind":"text","chars":238,"max":238,"perLine":39.7,"lines":6,"caps":false,"sz":28.0,"paras":2,"text":"Welcome to My Vision of Life\nText: Hello everyone! I'm Olivia Wilson, a Life Coach dedicated to guiding you to your fullest potential. Today we will explore together how to turn challenges into opportunities and achieve a fulfilling life.","font":"Montserrat","anchor":"t","box":[1028700,4114751,6987366,2948106],"lineH":497840,"ins":0}],"photos":[{"id":"9","w":9144000,"h":10287000,"area":0.5}]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"9","kind":"title","chars":8,"max":10,"perLine":10.0,"lines":1,"caps":false,"sz":83.3,"paras":1,"text":"About Me","font":"Dream Avenue","anchor":"t","box":[6928073,1952614,4431854,1436223],"lineH":1481201,"ins":0,"useW":0.621},{"id":"10","kind":"text","chars":242,"max":242,"perLine":80.7,"lines":3,"caps":false,"sz":28.0,"paras":1,"text":"With years of experience in the field of life coaching, I have helped individuals discover their authenticity, overcome obstacles and create a life aligned with their values. Each person is unique, and my approach adapts to your unique needs.","font":"Montserrat","anchor":"t","box":[1028700,3661654,15767202,1462306],"lineH":497840,"ins":0},{"id":"11","kind":"text","chars":195,"max":195,"perLine":94.4,"lines":2,"caps":false,"sz":28.0,"paras":1,"text":"I believe in a holistic approach to coaching that aims to balance all aspects of life. The key to lasting success is finding balance between career, relationships, well-being and personal growth.","font":"Montserrat","anchor":"t","box":[1260399,6105001,15767202,967039],"lineH":497840,"ins":0},{"id":"12","kind":"label","chars":23,"max":24,"perLine":24.2,"lines":1,"caps":false,"sz":28.0,"paras":1,"text":"Book an appointment now","font":"Montserrat","anchor":"t","box":[6915528,7614965,4456944,471772],"lineH":497840,"ins":0,"useW":0.885}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"13","kind":"title","chars":11,"max":12,"perLine":12.3,"lines":1,"caps":false,"sz":83.3,"paras":1,"text":"My services","font":"Dream Avenue","anchor":"t","box":[6412839,686995,5462323,1436223],"lineH":1481201,"ins":0,"useW":0.999},{"id":"14","kind":"text","chars":203,"max":203,"perLine":67.7,"lines":3,"caps":false,"sz":28.0,"paras":1,"text":"I offer personalized coaching sessions, interactive workshops and personal development programs. From stress management to enhancing leadership skills, my goal is to accompany you on your growth journey.","font":"Montserrat","anchor":"t","box":[1260399,7891244,15767202,1462306],"lineH":497840,"ins":0},{"id":"15","kind":"label","chars":17,"max":24,"perLine":24.2,"lines":1,"caps":false,"sz":28.0,"paras":1,"text":"coaching sessions","font":"Montserrat","anchor":"t","box":[789314,6643102,4456944,471772],"lineH":497840,"ins":0,"useW":0.723},{"id":"16","kind":"label","chars":21,"max":24,"perLine":24.2,"lines":1,"caps":false,"sz":28.0,"paras":1,"text":"interactive workshops","font":"Montserrat","anchor":"t","box":[6915528,6738352,4456944,471772],"lineH":497840,"ins":0,"useW":0.883},{"id":"17","kind":"label","chars":20,"max":24,"perLine":24.2,"lines":1,"caps":false,"sz":28.0,"paras":1,"text":"development programs","font":"Montserrat","anchor":"t","box":[13039347,6643102,4456944,471772],"lineH":497840,"ins":0,"useW":0.953}],"photos":[{"id":"10","w":6032500,"h":3900374,"area":0.125},{"id":"11","w":6032500,"h":3900374,"area":0.125},{"id":"12","w":6032500,"h":3900374,"area":0.125}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"8","kind":"title","chars":26,"max":26,"perLine":13.0,"lines":2,"caps":false,"sz":83.3,"paras":2,"text":"The Pillars of\nMy Approach","font":"Dream Avenue","anchor":"t","box":[10629756,1285875,6192325,1912298],"lineH":909828,"ins":0,"useW":0.999},{"id":"9","kind":"text","chars":358,"max":358,"perLine":35.8,"lines":10,"caps":false,"sz":28.0,"paras":2,"text":"My core principles include mindfulness, self-compassion, and mindful action. Through these pillars, we work together to create meaningful changes in your life.\n\nMy coaching approach is based on empathetic listening, deep reflection and purposeful action. Together, we will explore your goals, overcome challenges, and create practical strategies for success.","font":"Montserrat","anchor":"t","box":[10019466,3398255,7412904,4929174],"lineH":497840,"ins":0},{"id":"11","kind":"label","chars":23,"max":24,"perLine":24.2,"lines":1,"caps":false,"sz":28.0,"paras":1,"text":"Book an appointment now","font":"Montserrat","anchor":"t","box":[11497446,8786528,4456944,471772],"lineH":497840,"ins":0,"useW":0.885}],"photos":[{"id":"4","w":9144000,"h":10287000,"area":0.5}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"8","kind":"title","chars":36,"max":36,"perLine":18.0,"lines":2,"caps":false,"sz":83.3,"paras":2,"text":"One step at a time.\nYou'll get there","font":"Dream Avenue","anchor":"t","box":[4892559,4123316,8502882,2183244],"lineH":1057910,"ins":0,"useW":0.809},{"id":"9","kind":"label","chars":16,"max":24,"perLine":24.2,"lines":1,"caps":false,"sz":28.0,"paras":1,"text":"@reallygreatsite","font":"Montserrat","anchor":"t","box":[6912068,7720083,4456944,471772],"lineH":497840,"ins":0,"useW":0.651}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"10","kind":"title","chars":20,"max":21,"perLine":20.8,"lines":1,"caps":false,"sz":83.3,"paras":1,"text":"Success testimonials","font":"Dream Avenue","anchor":"t","box":[4773243,1474097,9197992,1436223],"lineH":1481201,"ins":0,"useW":0.999},{"id":"11","kind":"text","chars":309,"max":309,"perLine":77.2,"lines":4,"caps":false,"sz":28.0,"paras":1,"text":"I connected with Olivia Wilson during a time of great uncertainty in my life. About Her Her empathetic guidance and personalized coaching sessions have had a tremendous impact on me. Thanks to her focused approach, I gained surprising clarity about my priorities and learned to manage stress more effectively.","font":"Montserrat","anchor":"t","box":[1256939,3183137,15767202,1957572],"lineH":497840,"ins":0},{"id":"12","kind":"text","chars":237,"max":237,"perLine":79.0,"lines":3,"caps":false,"sz":28.0,"paras":1,"text":"His listening skills and constant encouragement inspired me to overcome my fears and actively pursue my dreams. With a practical approach and personalized strategies, Olivia Wilson helped me overcome obstacles that seemed insurmountable.","font":"Montserrat","anchor":"t","box":[1488639,6138085,15767202,1462306],"lineH":497840,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"8","kind":"title","chars":20,"max":25,"perLine":25.2,"lines":1,"caps":false,"sz":83.3,"paras":1,"text":"Workshops and Events","font":"Dream Avenue","anchor":"t","box":[6450845,1652353,11152221,1007423],"lineH":909828,"ins":0,"useW":0.954},{"id":"9","kind":"label","chars":33,"max":54,"perLine":54.4,"lines":1,"caps":false,"sz":28.0,"paras":1,"text":"Connections and Collective Growth","font":"Montserrat Italics","anchor":"t","box":[6935834,2612151,10182243,471772],"lineH":497840,"ins":0,"useW":0.622},{"id":"10","kind":"text","chars":157,"max":157,"perLine":52.3,"lines":3,"caps":false,"sz":28.0,"paras":1,"text":"Attend my interactive workshops and special events. Share experiences, learn from others, and discover new ways to elevate your life and the lives of others.","font":"Montserrat","anchor":"t","box":[7435048,3665367,9183815,1462306],"lineH":497840,"ins":0},{"id":"12","kind":"text","chars":191,"max":191,"perLine":47.8,"lines":4,"caps":false,"sz":28.0,"paras":1,"text":"Online Participation: If you are unable to attend in person, many of our events offer online participation options. Bring your virtual chair and join our community from anywhere in the world.","font":"Montserrat","anchor":"t","box":[7435048,5881453,9183815,1957572],"lineH":497840,"ins":0},{"id":"13","kind":"label","chars":23,"max":24,"perLine":24.2,"lines":1,"caps":false,"sz":28.0,"paras":1,"text":"www.reallygreatsite.com","font":"Montserrat","anchor":"t","box":[9798484,8420050,4456944,471772],"lineH":497840,"ins":0,"useW":0.993}],"photos":[{"id":"4","w":8229600,"h":8229600,"area":0.36}]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"9","kind":"title","chars":14,"max":15,"perLine":14.7,"lines":1,"caps":false,"sz":83.3,"paras":1,"text":"Collaborations","font":"Dream Avenue","anchor":"t","box":[962025,1365840,6533020,1430800],"lineH":1481201,"ins":0,"useW":1.0},{"id":"10","kind":"text","chars":167,"max":167,"perLine":33.4,"lines":5,"caps":false,"sz":28.0,"paras":1,"text":"I am open to collaborations with companies, educational institutions and groups interested in personal growth. Together we can create positive impact on a large scale.","font":"Montserrat","anchor":"t","box":[1028700,2981466,7102013,2452840],"lineH":497840,"ins":0},{"id":"11","kind":"text","chars":81,"max":81,"perLine":20.2,"lines":4,"caps":false,"sz":28.0,"paras":4,"text":"+123-456-7890\nwww.reallygreatsite.com\n123 Anywhere St., Any City\n@reallygreatsite","font":"Montserrat","anchor":"t","box":[1028700,6792137,7102013,1957572],"lineH":497840,"ins":0}],"photos":[{"id":"7","w":9144000,"h":10287000,"area":0.5}]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"8","kind":"title","chars":8,"max":10,"perLine":9.6,"lines":1,"caps":false,"sz":83.3,"paras":1,"text":"Contacts","font":"Dream Avenue","anchor":"t","box":[7250984,520347,4242511,1436223],"lineH":1481201,"ins":0,"useW":1.0},{"id":"9","kind":"text","chars":199,"max":199,"perLine":94.4,"lines":2,"caps":false,"sz":28.0,"paras":1,"text":"If you are ready to begin your transformation journey, I invite you to contact me. We are here to explore together the possibilities that the future has in store for you. Thanks for being here today!","font":"Montserrat","anchor":"t","box":[1256939,2122023,15767202,967039],"lineH":497840,"ins":0},{"id":"10","kind":"label","chars":23,"max":24,"perLine":24.2,"lines":1,"caps":false,"sz":28.0,"paras":1,"text":"Book an appointment now","font":"Montserrat","anchor":"t","box":[7036551,3531270,4456944,471772],"lineH":497840,"ins":0,"useW":0.885}],"photos":[{"id":"4","w":18288000,"h":5670301,"area":0.551}]},{"n":10,"part":"ppt/slides/slide10.xml","role":"end","slots":[{"id":"8","kind":"title","chars":10,"max":11,"perLine":10.9,"lines":1,"caps":false,"sz":83.3,"paras":1,"text":"Thank you!","font":"Dream Avenue","anchor":"t","box":[6725460,4651945,4837080,1125985],"lineH":1057910,"ins":0,"useW":0.999},{"id":"9","kind":"label","chars":16,"max":24,"perLine":24.2,"lines":1,"caps":false,"sz":28.0,"paras":1,"text":"@reallygreatsite","font":"Montserrat","anchor":"t","box":[6912068,7720083,4456944,471772],"lineH":497840,"ins":0,"useW":0.651}],"photos":[]}]}