{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"9","kind":"title","chars":55,"max":55,"perLine":13.8,"lines":4,"caps":true,"sz":48.0,"paras":1,"text":"ARAB XALIFALIGI DAVRIDA MOVAROUNNAHR VA XUROSON DAVLATI","font":"Times New Roman","anchor":"t","box":[1130300,1905000,8890000,2794000],"lineH":731520,"ins":0,"useW":0.928},{"id":"11","kind":"label","chars":18,"max":28,"perLine":28.0,"lines":1,"caps":false,"sz":26.5,"paras":1,"text":"O'zbekiston tarixi","font":"Times New Roman","anchor":"t","box":[1260285,5588000,5334000,558800],"lineH":403860,"ins":0,"useW":0.447}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"4","kind":"title","chars":4,"max":8,"perLine":7.6,"lines":1,"caps":false,"sz":79.94,"paras":1,"text":"Reja","font":"Times New Roman","anchor":"t","box":[1709265,1541861,3202377,1025922],"lineH":1015238,"ins":0,"useW":0.58},{"id":"7","kind":"text","chars":176,"max":176,"perLine":16.0,"lines":11,"caps":false,"sz":36.0,"paras":6,"text":"Istilo arafasida Movarounnahr\nArab yurishlari va Qutayba ibn Muslim\nXalifalik boshqaruvi va soliqlar\nXalq qo'zg'olonlari, Muqanna harakati\nIslom va madaniyat\nTohiriylar davlati","font":"Times New Roman","anchor":"t","box":[1714499,3873499,8382000,5969000],"lineH":548640,"ins":0}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"5","kind":"title","chars":14,"max":17,"perLine":17.1,"lines":1,"caps":true,"sz":60.31,"paras":1,"text":"ISTILO ARAFASI","font":"Times New Roman","anchor":"t","box":[1369281,2435722,7732795,769441],"lineH":765937,"ins":0,"useW":0.761},{"id":"7","kind":"label","chars":7,"max":28,"perLine":28.0,"lines":1,"caps":true,"sz":24.0,"paras":1,"text":"VII ASR","font":"Times New Roman","anchor":"t","box":[1424729,4318000,7112000,508000],"lineH":365760,"ins":0,"useW":0.153},{"id":"8","kind":"text","chars":360,"max":360,"perLine":30.0,"lines":12,"caps":false,"sz":27.5,"paras":4,"text":"VII asr o'rtalarida Movarounnahr mayda mulklarga bo'lingan edi: So'g'd, Choch, Farg'ona, Buxoro, Xorazm, Toxariston.\nG'arbiy Turk xoqonligi zaiflashgach, mahalliy hukmdorlar (ixshid, xudot, afshin) o'zaro kurashga berildi.\nO'lka Buyuk ipak yo'lidagi savdo, sug'orma dehqonchilik va hunarmandchilik tufayli boy edi.\nSiyosiy tarqoqlik arablarga qulaylik yaratdi.","font":"Times New Roman","anchor":"t","box":[1358900,5016500,7620000,4953000],"lineH":419100,"ins":0}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"5","kind":"title","chars":19,"max":30,"perLine":21.1,"lines":2,"caps":true,"sz":48.85,"paras":1,"text":"DASTLABKI YURISHLAR","font":"Times New Roman","anchor":"t","box":[1369281,2435722,7732795,1256754],"lineH":620395,"ins":0,"useW":0.933},{"id":"7","kind":"label","chars":14,"max":28,"perLine":28.0,"lines":1,"caps":true,"sz":24.0,"paras":1,"text":"651–705 YILLAR","font":"Times New Roman","anchor":"t","box":[1424729,4318000,7112000,508000],"lineH":365760,"ins":0,"useW":0.318},{"id":"8","kind":"text","chars":358,"max":358,"perLine":29.8,"lines":12,"caps":false,"sz":26.5,"paras":4,"text":"651-yilda arablar Sosoniylar davlatini tugatib, Marvni egalladi; Xuroson asosiy tayanch hududga aylandi.\n673–674-yillarda Ubaydulloh ibn Ziyod Amudaryodan o'tib, Poykand va Buxoroga yurish qildi; Buxoro malikasi Xutak xotun o'lpon to'ladi.\n676-yilda Said ibn Usmon Samarqandga hujum qildi.\nBu yurishlar asosan o'lja uchun bo'lib, o'lka hali bo'ysunmagan edi.","font":"Times New Roman","anchor":"t","box":[1358900,5016500,7620000,4953000],"lineH":403860,"ins":0}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"5","kind":"title","chars":18,"max":21,"perLine":20.9,"lines":1,"caps":true,"sz":49.38,"paras":1,"text":"QUTAYBA IBN MUSLIM","font":"Times New Roman","anchor":"t","box":[1369281,2422175,7732795,628377],"lineH":627126,"ins":0,"useW":0.9},{"id":"7","kind":"label","chars":14,"max":28,"perLine":28.0,"lines":1,"caps":true,"sz":24.0,"paras":1,"text":"705–715 YILLAR","font":"Times New Roman","anchor":"t","box":[1424729,4318000,7112000,508000],"lineH":365760,"ins":0,"useW":0.318},{"id":"8","kind":"text","chars":290,"max":290,"perLine":24.2,"lines":12,"caps":false,"sz":27.5,"paras":4,"text":"705-yilda Qutayba ibn Muslim Xuroson noibi etib tayinlandi.\n706–709-yillarda Poykand va Buxoro, 712-yilda Xorazm va Samarqand egallandi.\nShaharlarda masjidlar qurdirib, islomni yoyishga harakat qildi, arab qo'shinlarini joylashtirdi.\n715-yilda Farg'onada o'z askarlari tomonidan o'ldirildi.","font":"Times New Roman","anchor":"t","box":[1358900,5016500,7620000,4953000],"lineH":419100,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"5","kind":"title","chars":21,"max":21,"perLine":10.5,"lines":2,"caps":true,"sz":47.5,"paras":1,"text":"SAMARQAND VA FARGʻONA","font":"Times New Roman","anchor":"t","box":[1369281,2435722,7732795,1231106],"lineH":603250,"ins":0,"useW":0.634},{"id":"7","kind":"label","chars":14,"max":28,"perLine":28.0,"lines":1,"caps":true,"sz":24.0,"paras":1,"text":"712–715 YILLAR","font":"Times New Roman","anchor":"t","box":[1424729,4318000,7112000,508000],"lineH":365760,"ins":0,"useW":0.318},{"id":"8","kind":"text","chars":364,"max":364,"perLine":30.3,"lines":12,"caps":false,"sz":27.5,"paras":4,"text":"712-yilda uzoq qamaldan so'ng Samarqand taslim bo'ldi, So'g'd ixshidi G'urak bilan sulh tuzildi.\nSulh shartiga ko'ra samarqandliklar har yili katta o'lpon to'lashi va shaharda masjid qurilishi kerak edi.\n713–715-yillarda Qutayba Choch (Shosh) va Farg'onaga yurishlar qildi.\nMahalliy aholi va turklarning qarshiligi tufayli bu hududlar uzoq vaqt to'liq bo'ysunmadi.","font":"Times New Roman","anchor":"t","box":[1358900,5016500,7620000,4953000],"lineH":419100,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"5","kind":"title","chars":20,"max":20,"perLine":10.0,"lines":2,"caps":true,"sz":48.31,"paras":1,"text":"XALIFALIK BOSHQARUVI","font":"Times New Roman","anchor":"t","box":[1369281,2435722,7732795,1231106],"lineH":613537,"ins":0,"useW":0.962},{"id":"7","kind":"label","chars":23,"max":28,"perLine":28.0,"lines":1,"caps":true,"sz":24.0,"paras":1,"text":"UMAVIYLAR VA ABBOSIYLAR","font":"Times New Roman","anchor":"t","box":[1424729,4318000,7112000,508000],"lineH":365760,"ins":0,"useW":0.618},{"id":"8","kind":"text","chars":336,"max":336,"perLine":28.0,"lines":12,"caps":false,"sz":27.5,"paras":4,"text":"Movarounnahr Xuroson noibligi tarkibiga kiritildi, markaz Marv shahri edi.\nXalifa tayinlagan noib harbiy va moliyaviy hokimiyatni boshqargan.\nMahalliy hukmdorlar tobe holda saqlanib, soliq yig'ishda ishtirok etgan.\n750-yilda Umaviylar o'rniga Abbosiylar keldi; bunda Abu Muslim boshchiligidagi Xuroson qo'shini hal qiluvchi rol o'ynadi.","font":"Times New Roman","anchor":"t","box":[1358900,5016500,7620000,4953000],"lineH":419100,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"5","kind":"title","chars":12,"max":17,"perLine":17.1,"lines":1,"caps":true,"sz":60.31,"paras":1,"text":"SOLIQ TIZIMI","font":"Times New Roman","anchor":"t","box":[1369281,2422175,7732795,769441],"lineH":765937,"ins":0,"useW":0.623},{"id":"7","kind":"label","chars":19,"max":28,"perLine":28.0,"lines":1,"caps":true,"sz":24.0,"paras":1,"text":"XIROJ, JIZYA, ZAKOT","font":"Times New Roman","anchor":"t","box":[1424729,4318000,7112000,508000],"lineH":365760,"ins":0,"useW":0.428},{"id":"8","kind":"text","chars":258,"max":258,"perLine":21.5,"lines":12,"caps":false,"sz":27.5,"paras":4,"text":"Xiroj – yer va hosildan olinadigan asosiy soliq.\nJizya – islomni qabul qilmagan aholidan olinadigan jon solig'i.\nZakot – musulmonlar mol-mulkidan olinadigan diniy soliq.\nDastlab islomni qabul qilganlardan ham jizya undirilishi aholi noroziligini kuchaytirdi.","font":"Times New Roman","anchor":"t","box":[1358900,5016500,7620000,4953000],"lineH":419100,"ins":0}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"5","kind":"title","chars":15,"max":19,"perLine":19.3,"lines":1,"caps":false,"sz":48.59,"paras":1,"text":"Asosiy soliqlar","font":"Times New Roman","anchor":"t","box":[1370411,1247033,4940969,628377],"lineH":617093,"ins":0,"useW":0.753},{"id":"7","kind":"text","chars":222,"max":222,"perLine":15.9,"lines":14,"caps":false,"sz":29.0,"paras":5,"text":"Xiroj – yer va hosildan olinadigan soliq\nUshr – musulmonlar yeridan hosilning o'ndan bir qismi\nJizya – boshqa din vakillaridan jon solig'i\nZakot – mol-mulkdan diniy soliq\nMajburiy mehnat – kanal, qal'a va yo'llar qurilishi","font":"Times New Roman","anchor":"t","box":[1397000,3809999,7874000,5969000],"lineH":441960,"ins":0}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"5","kind":"title","chars":19,"max":23,"perLine":23.0,"lines":1,"caps":true,"sz":44.81,"paras":1,"text":"XALQ QOʻZGʻOLONLARI","font":"Times New Roman","anchor":"t","box":[1369281,2435722,7732795,577081],"lineH":569087,"ins":0,"useW":0.85},{"id":"7","kind":"label","chars":14,"max":28,"perLine":28.0,"lines":1,"caps":true,"sz":24.0,"paras":1,"text":"VIII–IX ASRLAR","font":"Times New Roman","anchor":"t","box":[1424729,4318000,7112000,508000],"lineH":365760,"ins":0,"useW":0.32},{"id":"8","kind":"text","chars":322,"max":322,"perLine":26.8,"lines":12,"caps":false,"sz":27.5,"paras":4,"text":"720–722-yillarda So'g'dda Devashtich boshchiligida qo'zg'olon bo'ldi; u Mug' qal'asida qamalib, 722-yilda qatl etildi.\nTurg'ash xoqoni Sulu arablarga qarshi kurashda mahalliy hukmdorlarni qo'llab-quvvatladi.\n806–810-yillarda Samarqandda Rofe ibn Lays qo'zg'oloni ko'tarildi.\nQo'zg'olonlar arab hukmronligini zaiflashtirdi.","font":"Times New Roman","anchor":"t","box":[1358900,5016500,7620000,4953000],"lineH":419100,"ins":0}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"content","slots":[{"id":"5","kind":"title","chars":19,"max":30,"perLine":21.7,"lines":2,"caps":true,"sz":47.47,"paras":1,"text":"MUQANNA QOʻZGʻOLONI","font":"Times New Roman","anchor":"t","box":[1369281,2435722,7732795,1205458],"lineH":602869,"ins":0,"useW":0.935},{"id":"7","kind":"label","chars":14,"max":28,"perLine":28.0,"lines":1,"caps":true,"sz":24.0,"paras":1,"text":"776–783 YILLAR","font":"Times New Roman","anchor":"t","box":[1424729,4318000,7112000,508000],"lineH":365760,"ins":0,"useW":0.318},{"id":"8","kind":"text","chars":337,"max":337,"perLine":28.1,"lines":12,"caps":false,"sz":27.5,"paras":4,"text":"Qo'zg'olonga marvlik Hoshim ibn Hakim boshchilik qildi; yuzini parda bilan yopgani uchun «Muqanna» (niqobli) deb atalgan.\nQo'zg'olonchilar «oq kiyimlilar» nomi bilan mashhur bo'lgan.\nAsosiy tayanch – Kesh yaqinidagi Som qal'asi; Buxoro, Narshax va So'g'd qishloqlari qo'shildi.\n783-yilda Som qal'asi qamal qilinib, qo'zg'olon bostirildi.","font":"Times New Roman","anchor":"t","box":[1358900,5016500,7620000,4953000],"lineH":419100,"ins":0}],"photos":[]},{"n":12,"part":"ppt/slides/slide12.xml","role":"content","slots":[{"id":"5","kind":"title","chars":18,"max":21,"perLine":20.9,"lines":1,"caps":true,"sz":49.38,"paras":1,"text":"ISLOM VA MADANIYAT","font":"Times New Roman","anchor":"t","box":[1369281,2435722,7732795,628377],"lineH":627126,"ins":0,"useW":0.908},{"id":"7","kind":"label","chars":14,"max":28,"perLine":28.0,"lines":1,"caps":true,"sz":24.0,"paras":1,"text":"VIII–IX ASRLAR","font":"Times New Roman","anchor":"t","box":[1424729,4318000,7112000,508000],"lineH":365760,"ins":0,"useW":0.32},{"id":"8","kind":"text","chars":288,"max":288,"perLine":24.0,"lines":12,"caps":false,"sz":27.5,"paras":4,"text":"Islom asta-sekin keng tarqaldi, arab tili ilm va davlat tiliga aylandi.\n751-yilgi Talas jangidan so'ng Samarqandda qog'oz ishlab chiqarish boshlandi.\nMuhammad al-Xorazmiy Bag'doddagi «Bayt ul-hikma»da algebra asoslarini yaratdi.\nImom al-Buxoriy (810–870) «Al-Jome as-sahih» asarini yozdi.","font":"Times New Roman","anchor":"t","box":[1358900,5016500,7620000,4953000],"lineH":419100,"ins":0}],"photos":[]},{"n":13,"part":"ppt/slides/slide13.xml","role":"content","slots":[{"id":"5","kind":"title","chars":18,"max":21,"perLine":21.2,"lines":1,"caps":true,"sz":48.59,"paras":1,"text":"TOHIRIYLAR DAVLATI","font":"Times New Roman","anchor":"t","box":[1369281,2435722,7732795,628377],"lineH":617093,"ins":0,"useW":0.86},{"id":"7","kind":"label","chars":14,"max":28,"perLine":28.0,"lines":1,"caps":true,"sz":24.0,"paras":1,"text":"821–873 YILLAR","font":"Times New Roman","anchor":"t","box":[1424729,4318000,7112000,508000],"lineH":365760,"ins":0,"useW":0.318},{"id":"8","kind":"text","chars":273,"max":273,"perLine":22.8,"lines":12,"caps":false,"sz":27.5,"paras":4,"text":"821-yilda Tohir ibn Husayn Xuroson noibi bo'lib, amalda mustaqil sulolaga asos soldi.\nPoytaxt avval Marv, keyin Nishopur bo'ldi.\nTohiriylar xalifaga rasman tobe bo'lib, unga xiroj yuborib turgan.\n873-yilda Safforiylar ularni tugatdi; Movarounnahrda esa Somoniylar kuchaydi.","font":"Times New Roman","anchor":"t","box":[1358900,5016500,7620000,4953000],"lineH":419100,"ins":0}],"photos":[]},{"n":14,"part":"ppt/slides/slide14.xml","role":"content","slots":[{"id":"5","kind":"title","chars":6,"max":12,"perLine":11.6,"lines":1,"caps":false,"sz":81.21,"paras":1,"text":"Xulosa","font":"Times New Roman","anchor":"t","box":[1370411,1247033,4940969,1038746],"lineH":1031367,"ins":0,"useW":0.591},{"id":"7","kind":"text","chars":252,"max":252,"perLine":18.0,"lines":14,"caps":false,"sz":29.0,"paras":4,"text":"Arab istilosi Movarounnahrni xalifalik tarkibiga qo'shdi.\nIslom dini va arab yozuvi madaniyatga chuqur ta'sir ko'rsatdi.\nXalq qo'zg'olonlari ozodlik uchun kurashni ko'rsatdi.\nIX asrda mahalliy sulolalar – Tohiriylar va Somoniylar mustaqillikni tikladi.","font":"Times New Roman","anchor":"t","box":[1397000,3809999,7874000,5969000],"lineH":441960,"ins":0}],"photos":[]},{"n":15,"part":"ppt/slides/slide15.xml","role":"end","slots":[{"id":"6","kind":"title","chars":26,"max":26,"perLine":13.0,"lines":2,"caps":false,"sz":66.52,"paras":1,"text":"Eʼtiboringiz uchun rahmat!","font":"Times New Roman","anchor":"t","box":[1400151,2317595,6518279,1744067],"lineH":861441,"ins":0,"useW":0.975},{"id":"8","kind":"text","chars":140,"max":140,"perLine":17.5,"lines":8,"caps":false,"sz":32.5,"paras":3,"text":"Savollaringiz bo'lsa, mamnuniyat bilan javob beraman.\nFan: O'zbekiston tarixi\nMavzu: Arab xalifaligi davrida Movarounnahr va Xuroson davlati","font":"Times New Roman","anchor":"t","box":[1397000,5587999,8636000,4064000],"lineH":495300,"ins":0}],"photos":[]}]}