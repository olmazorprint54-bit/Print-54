ars":16,"max":19,"perLine":19.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WARNER & SPENCER","font":"Cooper Hewitt Bold","anchor":"t","box":[1222072,787012,2616636,388126],"lineH":350139,"ins":0,"useW":0.907},{"id":"13","kind":"title","chars":26,"max":26,"perLine":8.7,"lines":3,"caps":true,"sz":75.68,"paras":1,"text":"ROLE OF MUSEUMS IN SOCIETY","font":"Cooper Hewitt Bold","anchor":"t","box":[1533899,2464847,5909570,3430265],"lineH":1066927,"ins":0,"useW":0.984},{"id":"14","kind":"text","chars":206,"max":206,"perLine":51.5,"lines":4,"caps":false,"sz":19.69,"paras":1,"text":"A museum is more than a building with collections—it is a living archive that preserves the legacy of humanity. Museums help societies understand their past, reflect on the present, and envision the future.","font":"DM Sans","anchor":"t","box":[1533899,6984441,6072236,1350151],"lineH":350139,"ins":0}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"5","kind":"label","chars":23,"max":32,"perLine":32.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WWW.REALLYGREATSITE.COM","font":"Cooper Hewitt Bold","anchor":"t","box":[12867950,787012,4391350,388126],"lineH":350139,"ins":0,"useW":0.806},{"id":"10","kind":"label","chars":16,"max":19,"perLine":19.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WARNER & SPENCER","font":"Cooper Hewitt Bold","anchor":"t","box":[1222072,787012,2616636,388126],"lineH":350139,"ins":0,"useW":0.907},{"id":"11","kind":"title","chars":22,"max":22,"perLine":11.0,"lines":2,"caps":true,"sz":75.68,"paras":1,"text":"THE HISTORY OF MUSEUMS","font":"Cooper Hewitt Bold","anchor":"t","box":[10190952,1841501,6781600,2382036],"lineH":1066927,"ins":0,"useW":0.894,"base":1.943,"tail":0.1,"below":[{"id":"13","gap":2.787,"cap":0.113}]},{"id":"12","kind":"label","chars":28,"max":28,"perLine":9.3,"lines":3,"caps":true,"sz":31.77,"paras":1,"text":"TRANSITION TO PUBLIC MUSEUMS","font":"Cooper Hewitt Bold","anchor":"t","box":[5587598,4935690,2691571,1761466],"lineH":564896,"ins":0,"useW":0.839},{"id":"13","kind":"label","chars":11,"max":15,"perLine":7.3,"lines":2,"caps":false,"sz":31.77,"paras":1,"text":"1980 - 2000","font":"Cooper Hewitt Bold","anchor":"t","box":[10190952,4520271,1391784,1205172],"lineH":564896,"ins":0,"useW":0.855},{"id":"14","kind":"label","chars":11,"max":15,"perLine":7.3,"lines":2,"caps":false,"sz":31.77,"paras":1,"text":"2000 - 2030","font":"Cooper Hewitt Bold","anchor":"t","box":[10190952,6178444,1391784,1205172],"lineH":564896,"ins":0,"useW":0.855},{"id":"17","kind":"text","chars":117,"max":117,"perLine":39.0,"lines":3,"caps":false,"sz":19.69,"paras":1,"text":"Museums originated from the curiosity of collectors who preserved rare artifacts, artworks, and scientific specimens.","font":"DM Sans","anchor":"t","box":[12080177,4653621,5043536,1007251],"lineH":350139,"ins":0},{"id":"18","kind":"text","chars":123,"max":123,"perLine":41.0,"lines":3,"caps":false,"sz":19.69,"paras":1,"text":"During the Renaissance, wealthy nobles kept “Cabinets of Curiosity” that displayed everything from fossils to ancient coins","font":"DM Sans","anchor":"t","box":[12080177,6311794,5043536,1007251],"lineH":350139,"ins":0},{"id":"22","kind":"label","chars":10,"max":17,"perLine":17.2,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"NEXT SLIDE","font":"Cooper Hewitt Bold","anchor":"t","box":[10435260,8125709,2352316,388126],"lineH":350139,"ins":0,"useW":0.566}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"5","kind":"label","chars":23,"max":32,"perLine":32.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WWW.REALLYGREATSITE.COM","font":"Cooper Hewitt Bold","anchor":"t","box":[12867950,787012,4391350,388126],"lineH":350139,"ins":0,"useW":0.806},{"id":"15","kind":"title","chars":16,"max":23,"perLine":23.2,"lines":1,"caps":true,"sz":75.68,"paras":1,"text":"TYPES OF MUSEUMS","font":"Cooper Hewitt Bold","anchor":"t","box":[3048376,1749645,12191247,1315236],"lineH":1066927,"ins":0,"useW":0.75},{"id":"16","kind":"label","chars":16,"max":19,"perLine":19.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WARNER & SPENCER","font":"Cooper Hewitt Bold","anchor":"t","box":[1222072,787012,2616636,388126],"lineH":350139,"ins":0,"useW":0.907},{"id":"17","kind":"text","chars":97,"max":97,"perLine":24.2,"lines":4,"caps":false,"sz":19.69,"paras":1,"text":"Different types of museums cater to different audiences. Art museums like The Metropolitan Museum","font":"DM Sans","anchor":"t","box":[1757905,7060670,3474686,1350151],"lineH":350139,"ins":0},{"id":"18","kind":"text","chars":81,"max":81,"perLine":20.2,"lines":4,"caps":false,"sz":19.69,"paras":1,"text":"Science museums like Exploratorium in San Francisco focus on interactive learning","font":"DM Sans","anchor":"t","box":[13305686,6489821,3032587,1350151],"lineH":350139,"ins":0},{"id":"19","kind":"label","chars":11,"max":22,"perLine":21.8,"lines":1,"caps":true,"sz":22.69,"paras":1,"text":"ART MUSEUMS","font":"Cooper Hewitt Bold","anchor":"t","box":[1896168,6491510,3440719,447181],"lineH":403479,"ins":0,"useW":0.579},{"id":"20","kind":"label","chars":19,"max":22,"perLine":21.8,"lines":1,"caps":true,"sz":22.69,"paras":1,"text":"SPECIALIZED MUSEUMS","font":"Cooper Hewitt Bold","anchor":"t","box":[12882996,5937002,3440719,447181],"lineH":403479,"ins":0,"useW":0.93}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"8","kind":"label","chars":23,"max":32,"perLine":32.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WWW.REALLYGREATSITE.COM","font":"Cooper Hewitt Bold","anchor":"t","box":[12867950,787012,4391350,388126],"lineH":350139,"ins":0,"useW":0.806},{"id":"11","kind":"label","chars":16,"max":19,"perLine":19.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WARNER & SPENCER","font":"Cooper Hewitt Bold","anchor":"t","box":[1222072,787012,2616636,388126],"lineH":350139,"ins":0,"useW":0.907},{"id":"12","kind":"title","chars":30,"max":30,"perLine":15.0,"lines":2,"caps":true,"sz":75.68,"paras":1,"text":"ARCHITECTURE AND MUSEUM DESIGN","font":"Cooper Hewitt Bold","anchor":"t","box":[1028700,2312428,9521155,2382036],"lineH":1066927,"ins":0,"useW":0.931},{"id":"13","kind":"label","chars":23,"max":27,"perLine":26.9,"lines":1,"caps":true,"sz":22.69,"paras":1,"text":"VISITOR-FRIENDLY SPACES","font":"Cooper Hewitt Bold","anchor":"t","box":[1028700,5189129,4230277,447181],"lineH":403479,"ins":0,"useW":0.849},{"id":"14","kind":"label","chars":23,"max":27,"perLine":26.9,"lines":1,"caps":true,"sz":22.69,"paras":1,"text":"ICONIC MUSEUM BUILDINGS","font":"Cooper Hewitt Bold","anchor":"t","box":[6127412,5189129,4230277,447181],"lineH":403479,"ins":0,"useW":0.877},{"id":"15","kind":"text","chars":113,"max":113,"perLine":28.2,"lines":4,"caps":false,"sz":19.69,"paras":1,"text":"Museum buildings themselves are works of art. Their architecture often symbolizes the mission of the institution.","font":"DM Sans","anchor":"t","box":[1263232,5965104,4187911,1350151],"lineH":350139,"ins":0},{"id":"16","kind":"text","chars":126,"max":126,"perLine":31.5,"lines":4,"caps":false,"sz":19.69,"paras":1,"text":"For instance, the Guggenheim Museum Bilbao by is celebrated for its futuristic design, representing innovation and creativity.","font":"DM Sans","anchor":"t","box":[6361944,5965104,4360788,1350151],"lineH":350139,"ins":0},{"id":"19","kind":"label","chars":7,"max":11,"perLine":10.6,"lines":1,"caps":true,"sz":54.52,"paras":1,"text":"78,000K","font":"Cooper Hewitt Bold","anchor":"t","box":[1028700,7511082,3995928,1092613],"lineH":969391,"ins":0,"useW":0.676},{"id":"20","kind":"label","chars":8,"max":12,"perLine":12.3,"lines":1,"caps":false,"sz":54.52,"paras":1,"text":"683,000+","font":"Cooper Hewitt Bold","anchor":"t","box":[6127412,7511082,3995928,1092613],"lineH":969391,"ins":0,"useW":0.775}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"5","kind":"label","chars":23,"max":32,"perLine":32.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WWW.REALLYGREATSITE.COM","font":"Cooper Hewitt Bold","anchor":"t","box":[12867950,787012,4391350,388126],"lineH":350139,"ins":0,"useW":0.806},{"id":"9","kind":"label","chars":16,"max":19,"perLine":19.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WARNER & SPENCER","font":"Cooper Hewitt Bold","anchor":"t","box":[1222072,787012,2616636,388126],"lineH":350139,"ins":0,"useW":0.907},{"id":"10","kind":"title","chars":21,"max":21,"perLine":7.0,"lines":3,"caps":true,"sz":75.68,"paras":1,"text":"FAMOUS GLOBAL MUSEUMS","font":"Cooper Hewitt Bold","anchor":"t","box":[11856058,2624143,5168011,3448836],"lineH":1066927,"ins":0,"useW":0.909,"base":3.053,"tail":0.1,"below":[{"id":"11","gap":3.736,"cap":0.095}]},{"id":"11","kind":"text","chars":142,"max":142,"perLine":35.5,"lines":4,"caps":false,"sz":19.69,"paras":1,"text":"Some museums have become landmarks that define cultural tourism. The Louvre holds the Mona Lisa and receives over 9 million visitors annually.","font":"DM Sans","anchor":"t","box":[11856058,6214538,4788585,1350151],"lineH":350139,"ins":0},{"id":"12","kind":"text","chars":138,"max":138,"perLine":27.6,"lines":5,"caps":false,"sz":19.69,"paras":1,"text":"A museum’s strength lies in its collections. Permanent collections, like the Egyptian mummies in the British Museum, become cultural icons","font":"DM Sans","anchor":"t","box":[1491018,7254079,3690559,1693051],"lineH":350139,"ins":0},{"id":"16","kind":"label","chars":10,"max":17,"perLine":17.2,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"NEXT SLIDE","font":"Cooper Hewitt Bold","anchor":"t","box":[12100366,8135642,2352316,388126],"lineH":350139,"ins":0,"useW":0.566},{"id":"18","kind":"label","chars":24,"max":24,"perLine":8.0,"lines":3,"caps":true,"sz":31.77,"paras":1,"text":"THE BLEND OF OLD AND NEW","font":"Cooper Hewitt Bold","anchor":"t","box":[3094072,3407775,2299365,1761466],"lineH":564896,"ins":0,"useW":0.956},{"id":"19","kind":"label","chars":5,"max":12,"perLine":12.1,"lines":1,"caps":false,"sz":31.77,"paras":1,"text":"39,4%","font":"Cooper Hewitt Bold","anchor":"t","box":[3374380,2602850,2299365,641303],"lineH":564896,"ins":0,"useW":0.535},{"id":"20","kind":"label","chars":14,"max":28,"perLine":27.9,"lines":1,"caps":true,"sz":22.69,"paras":1,"text":"RARE ARTIFACTS","font":"Cooper Hewitt Bold","anchor":"t","box":[1491018,6627923,4391350,447181],"lineH":403479,"ins":0,"useW":0.51}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"8","kind":"label","chars":23,"max":32,"perLine":32.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WWW.REALLYGREATSITE.COM","font":"Cooper Hewitt Bold","anchor":"t","box":[12867950,787012,4391350,388126],"lineH":350139,"ins":0,"useW":0.806},{"id":"12","kind":"label","chars":16,"max":19,"perLine":19.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WARNER & SPENCER","font":"Cooper Hewitt Bold","anchor":"t","box":[1222072,787012,2616636,388126],"lineH":350139,"ins":0,"useW":0.907},{"id":"13","kind":"title","chars":33,"max":33,"perLine":11.0,"lines":3,"caps":true,"sz":75.68,"paras":1,"text":"PRESERVATION AND THE CONSERVATION","font":"Cooper Hewitt Bold","anchor":"t","box":[10073109,2265709,7186191,3448836],"lineH":1066927,"ins":0,"useW":0.975,"base":3.053,"tail":0.1,"below":[{"id":"14","gap":3.866,"cap":0.095}]},{"id":"14","kind":"text","chars":207,"max":207,"perLine":51.8,"lines":4,"caps":false,"sz":19.69,"paras":1,"text":"Museums are guardians of history. They use climate control, advanced preservation techniques, and strict handling policies to protect artifacts. For instance, the Dead Sea Scrolls are preserved under special","font":"DM Sans","anchor":"t","box":[10073109,5981280,6961251,1350151],"lineH":350139,"ins":0},{"id":"15","kind":"text","chars":98,"max":98,"perLine":49.0,"lines":2,"caps":false,"sz":19.69,"paras":1,"text":"Conservators not only repair items but also study their materials to ensure longevity for future .","font":"DM Sans","anchor":"t","box":[11142367,7787477,6116933,664351],"lineH":350139,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"5","kind":"label","chars":23,"max":32,"perLine":32.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WWW.REALLYGREATSITE.COM","font":"Cooper Hewitt Bold","anchor":"t","box":[12867950,787012,4391350,388126],"lineH":350139,"ins":0,"useW":0.806},{"id":"18","kind":"label","chars":16,"max":19,"perLine":19.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WARNER & SPENCER","font":"Cooper Hewitt Bold","anchor":"t","box":[1222072,787012,2616636,388126],"lineH":350139,"ins":0,"useW":0.907},{"id":"19","kind":"title","chars":36,"max":36,"perLine":18.0,"lines":2,"caps":true,"sz":75.68,"paras":1,"text":"INTERACTIVE AND EDUCATIONAL PROGRAMS","font":"Cooper Hewitt Bold","anchor":"t","box":[2432415,2059683,13423170,2382036],"lineH":1066927,"ins":0,"useW":0.863},{"id":"20","kind":"label","chars":19,"max":26,"perLine":12.9,"lines":2,"caps":true,"sz":22.69,"paras":1,"text":"SCHOOL PARTNERSHIPS","font":"Cooper Hewitt Bold","anchor":"t","box":[1861952,6678444,2039146,847231],"lineH":403479,"ins":0,"useW":1.0},{"id":"21","kind":"label","chars":18,"max":26,"perLine":12.9,"lines":2,"caps":true,"sz":22.69,"paras":1,"text":"STORYTELLING TOURS","font":"Cooper Hewitt Bold","anchor":"t","box":[10369537,6678444,2039146,847231],"lineH":403479,"ins":0,"useW":0.976},{"id":"22","kind":"label","chars":18,"max":26,"perLine":12.9,"lines":2,"caps":true,"sz":22.69,"paras":1,"text":"HANDS-ON WORKSHOPS","font":"Cooper Hewitt Bold","anchor":"t","box":[6227049,6825892,2039146,847231],"lineH":403479,"ins":0,"useW":0.856},{"id":"23","kind":"label","chars":28,"max":28,"perLine":14.0,"lines":2,"caps":true,"sz":22.69,"paras":1,"text":"DIGITAL AND VIRTUAL LEARNING","font":"Cooper Hewitt Bold","anchor":"t","box":[14257054,6825892,2639109,847231],"lineH":403479,"ins":0,"useW":0.959}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"8","kind":"label","chars":23,"max":32,"perLine":32.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WWW.REALLYGREATSITE.COM","font":"Cooper Hewitt Bold","anchor":"t","box":[12867950,787012,4391350,388126],"lineH":350139,"ins":0,"useW":0.806},{"id":"14","kind":"label","chars":16,"max":19,"perLine":19.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WARNER & SPENCER","font":"Cooper Hewitt Bold","anchor":"t","box":[1222072,787012,2616636,388126],"lineH":350139,"ins":0,"useW":0.907},{"id":"15","kind":"title","chars":22,"max":22,"perLine":11.0,"lines":2,"caps":true,"sz":75.68,"paras":1,"text":"MUSEUMS AND TECHNOLOGY","font":"Cooper Hewitt Bold","anchor":"t","box":[1472215,2339568,7035750,2382036],"lineH":1066927,"ins":0,"useW":0.966},{"id":"16","kind":"label","chars":31,"max":31,"perLine":10.3,"lines":3,"caps":true,"sz":31.77,"paras":1,"text":"AUGMENTED REALITY (AR) EXHIBITS","font":"Cooper Hewitt Bold","anchor":"t","box":[12347683,3681089,2691571,1761466],"lineH":564896,"ins":0,"useW":0.902},{"id":"17","kind":"text","chars":160,"max":160,"perLine":53.3,"lines":3,"caps":false,"sz":19.69,"paras":1,"text":"Technology has revolutionized museums. Augmented reality allows visitors to see ancient ruins reconstructed, while VR brings remote museums into people’s homes.","font":"DM Sans","anchor":"t","box":[1472215,5833738,6910060,1007251],"lineH":350139,"ins":0},{"id":"18","kind":"text","chars":232,"max":232,"perLine":58.0,"lines":4,"caps":false,"sz":19.69,"paras":1,"text":"Interactive screens provide detailed insights, and AI helps in managing collections. For example, the Smithsonian offers VR tours, and the Museum of the Future in Dubai integrates futuristic technologies into its visitor experience.","font":"DM Sans","anchor":"t","box":[1472215,7118497,6910060,1350151],"lineH":350139,"ins":0},{"id":"19","kind":"label","chars":13,"max":27,"perLine":26.9,"lines":1,"caps":true,"sz":22.69,"paras":1,"text":"AI IN MUSEUMS","font":"Cooper Hewitt Bold","anchor":"t","box":[1472215,5160125,4230277,447181],"lineH":403479,"ins":0,"useW":0.488}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"8","kind":"label","chars":23,"max":32,"perLine":32.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WWW.REALLYGREATSITE.COM","font":"Cooper Hewitt Bold","anchor":"t","box":[12867950,787012,4391350,388126],"lineH":350139,"ins":0,"useW":0.806},{"id":"11","kind":"label","chars":16,"max":19,"perLine":19.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WARNER & SPENCER","font":"Cooper Hewitt Bold","anchor":"t","box":[1222072,787012,2616636,388126],"lineH":350139,"ins":0,"useW":0.907},{"id":"12","kind":"title","chars":28,"max":28,"perLine":14.0,"lines":2,"caps":true,"sz":75.68,"paras":1,"text":"MUSEUMS AS CULTURAL IDENTITY","font":"Cooper Hewitt Bold","anchor":"t","box":[1758881,6554340,9641484,2382036],"lineH":1066927,"ins":0,"useW":0.922},{"id":"13","kind":"text","chars":239,"max":239,"perLine":47.8,"lines":5,"caps":false,"sz":19.69,"paras":1,"text":"Museums serve as cultural ambassadors. They preserve and present the identity of a nation, showcasing its traditions, struggles, and triumphs. For instance, the National Museum of Indonesia displays the rich diversity of Indonesian culture","font":"DM Sans","anchor":"t","box":[11079392,6911797,6057444,1693051],"lineH":350139,"ins":0}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"end","slots":[{"id":"8","kind":"label","chars":23,"max":32,"perLine":32.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WWW.REALLYGREATSITE.COM","font":"Cooper Hewitt Bold","anchor":"t","box":[12867950,787012,4391350,388126],"lineH":350139,"ins":0,"useW":0.806},{"id":"12","kind":"label","chars":16,"max":19,"perLine":19.1,"lines":1,"caps":true,"sz":19.69,"paras":1,"text":"WARNER & SPENCER","font":"Cooper Hewitt Bold","anchor":"t","box":[1222072,787012,2616636,388126],"lineH":350139,"ins":0,"useW":0.907},{"id":"13","kind":"label","chars":9,"max":11,"perLine":10.8,"lines":1,