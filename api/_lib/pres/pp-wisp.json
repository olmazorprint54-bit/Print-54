{"size":[12192000,6858000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"2","kind":"label","chars":21,"max":54,"perLine":41.6,"lines":8,"caps":false,"sz":18.0,"paras":1,"text":"City and Village Life","font":"Times New Roman","anchor":"t","box":[2589213,2514600,8890000,2262781],"lineH":274320,"ins":182880,"useW":0.224,"base":9.365,"tail":0.216,"below":[{"id":"3","gap":9.898,"cap":0.403}]},{"id":"3","kind":"title","chars":58,"max":58,"perLine":19.3,"lines":3,"caps":false,"sz":24.0,"paras":2,"text":"Integrated Speech Skills\nPrepared by: Erkinboyeva Mehmonoy","font":"Times New Roman","anchor":"t","box":[2589213,4777378,7620000,1270000],"lineH":365760,"ins":182880,"useW":0.626}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"2","kind":"title","chars":24,"max":106,"perLine":53.2,"lines":2,"caps":false,"sz":32.0,"paras":1,"text":"Plan of the Presentation","font":"Times New Roman","anchor":"ctr","box":[2540000,279400,9144000,787400],"lineH":487680,"ins":182880,"useW":0.432},{"id":"3","kind":"text","chars":217,"max":217,"perLine":16.7,"lines":13,"caps":false,"sz":26.0,"paras":7,"text":"Defining city and village\nLifestyle and daily routine\nWork and education opportunities\nKey facts: city vs village\nAdvantages and disadvantages of city life\nAdvantages and disadvantages of village life\nWhich to choose?","font":"Times New Roman","anchor":"t","box":[2730500,1397000,8763000,5080000],"lineH":396240,"ins":182880}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"2","kind":"title","chars":25,"max":106,"perLine":53.2,"lines":2,"caps":false,"sz":32.0,"paras":1,"text":"Defining City and Village","font":"Times New Roman","anchor":"ctr","box":[2540000,279400,9144000,787400],"lineH":487680,"ins":182880,"useW":0.472},{"id":"12","kind":"label","chars":4,"max":14,"perLine":14.3,"lines":1,"caps":true,"sz":26.0,"paras":1,"text":"CITY","font":"Times New Roman","anchor":"t","box":[3746500,1651000,2794000,406400],"lineH":396240,"ins":0,"useW":0.275},{"id":"13","kind":"text","chars":266,"max":266,"perLine":20.5,"lines":13,"caps":false,"sz":19.0,"paras":5,"text":"A large, densely populated urban area.\nTall buildings, wide roads, shops and public services.\nMost people work in offices, factories, trade and services.\nTashkent, the capital of Uzbekistan, has over 3 million residents.\nLife is busy, fast and full of opportunities.","font":"Times New Roman","anchor":"t","box":[2882900,2438400,3683000,3873500],"lineH":289560,"ins":0},{"id":"17","kind":"label","chars":7,"max":14,"perLine":14.3,"lines":1,"caps":true,"sz":26.0,"paras":1,"text":"VILLAGE","font":"Times New Roman","anchor":"t","box":[8636000,1651000,2794000,406400],"lineH":396240,"ins":0,"useW":0.511},{"id":"18","kind":"text","chars":250,"max":250,"perLine":19.2,"lines":13,"caps":false,"sz":19.0,"paras":5,"text":"A small rural settlement in the countryside.\nSurrounded by fields, orchards, rivers and hills.\nMost villagers work in farming, gardening or livestock breeding.\nNeighbours know each other and help one another.\nLife is calm, simple and close to nature.","font":"Times New Roman","anchor":"t","box":[7772400,2438400,3683000,3873500],"lineH":289560,"ins":0},{"id":"19","kind":"label","chars":2,"max":9,"perLine":4.7,"lines":2,"caps":true,"sz":18.0,"paras":1,"text":"VS","font":"Times New Roman","anchor":"ctr","box":[6832600,3530600,635000,635000],"lineH":274320,"ins":0,"useW":0.461}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"2","kind":"title","chars":41,"max":122,"perLine":60.8,"lines":2,"caps":false,"sz":28.0,"paras":1,"text":"Advantages and Disadvantages of City Life","font":"Times New Roman","anchor":"ctr","box":[2540000,279400,9144000,787400],"lineH":426720,"ins":182880,"useW":0.692},{"id":"18","kind":"label","chars":10,"max":24,"perLine":23.7,"lines":1,"caps":false,"sz":25.5,"paras":1,"text":"Advantages","font":"Times New Roman","anchor":"t","box":[3556000,1600200,3175000,381000],"lineH":388620,"ins":0,"useW":0.48},{"id":"20","kind":"label","chars":29,"max":101,"perLine":33.8,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Many jobs and higher salaries","font":"Times New Roman","anchor":"t","box":[3238500,2413000,3556000,787400],"lineH":304800,"ins":0,"useW":0.856,"base":3.365,"tail":0.216,"below":[{"id":"22","gap":3.8,"cap":0.302}]},{"id":"22","kind":"label","chars":36,"max":36,"perLine":12.0,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Universities, hospitals and theatres","font":"Times New Roman","anchor":"t","box":[3238500,3378200,3556000,787400],"lineH":304800,"ins":0,"useW":0.995,"base":3.365,"tail":0.216,"below":[{"id":"24","gap":3.8,"cap":0.302}]},{"id":"24","kind":"label","chars":37,"max":37,"perLine":12.3,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Modern transport: metro, buses, taxis","font":"Times New Roman","anchor":"t","box":[3238500,4343400,3556000,787400],"lineH":304800,"ins":0,"useW":0.914,"base":3.365,"tail":0.216,"below":[{"id":"26","gap":3.8,"cap":0.302}]},{"id":"26","kind":"label","chars":34,"max":34,"perLine":11.3,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Shops and services open until late","font":"Times New Roman","anchor":"t","box":[3238500,5308600,3556000,787400],"lineH":304800,"ins":0,"useW":0.969},{"id":"30","kind":"label","chars":13,"max":24,"perLine":23.7,"lines":1,"caps":false,"sz":25.5,"paras":1,"text":"Disadvantages","font":"Times New Roman","anchor":"t","box":[8128000,1600200,3175000,381000],"lineH":388620,"ins":0,"useW":0.594},{"id":"32","kind":"label","chars":31,"max":31,"perLine":10.3,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Traffic jams and constant noise","font":"Times New Roman","anchor":"t","box":[7810500,2413000,3556000,787400],"lineH":304800,"ins":0,"useW":0.895,"base":3.365,"tail":0.216,"below":[{"id":"34","gap":3.8,"cap":0.302}]},{"id":"34","kind":"label","chars":24,"max":101,"perLine":33.8,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Air pollution and stress","font":"Times New Roman","anchor":"t","box":[7810500,3378200,3556000,787400],"lineH":304800,"ins":0,"useW":0.669,"base":3.365,"tail":0.216,"below":[{"id":"36","gap":3.8,"cap":0.302}]},{"id":"36","kind":"label","chars":26,"max":101,"perLine":33.8,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"High rent and living costs","font":"Times New Roman","anchor":"t","box":[7810500,4343400,3556000,787400],"lineH":304800,"ins":0,"useW":0.738,"base":3.365,"tail":0.216,"below":[{"id":"38","gap":3.8,"cap":0.302}]},{"id":"38","kind":"label","chars":34,"max":34,"perLine":11.3,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Few green spaces and little nature","font":"Times New Roman","anchor":"t","box":[7810500,5308600,3556000,787400],"lineH":304800,"ins":0,"useW":0.968}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"2","kind":"title","chars":11,"max":55,"perLine":55.1,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"A Busy City","font":"Times New Roman","anchor":"t","box":[2589213,3581400,8890000,558800],"lineH":457200,"ins":182880,"useW":0.219,"base":0.965,"tail":0.216,"below":[{"id":"4","gap":1.6,"cap":0.212}]},{"id":"4","kind":"text","chars":274,"max":274,"perLine":34.2,"lines":8,"caps":false,"sz":21.0,"paras":1,"text":"Skyscrapers, busy roads and crowded streets: a city never sleeps. Shops, cafés, banks and transport work from early morning till late at night. Big cities attract young people with jobs, universities and entertainment, but they also face traffic jams, noise and high prices.","font":"Times New Roman","anchor":"t","box":[2589213,4191000,8953500,2413000],"lineH":320040,"ins":182880}],"photos":[{"id":"3","w":8953500,"h":3327400,"area":0.356}]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"2","kind":"title","chars":16,"max":106,"perLine":53.2,"lines":2,"caps":false,"sz":32.0,"paras":1,"text":"Which to Choose?","font":"Times New Roman","anchor":"ctr","box":[2539999,279400,9144000,787400],"lineH":487680,"ins":182880,"useW":0.335},{"id":"12","kind":"label","chars":28,"max":33,"perLine":33.4,"lines":1,"caps":false,"sz":22.0,"paras":1,"text":"Choose the city if you want…","font":"Times New Roman","anchor":"t","box":[2857500,2286000,3873500,406400],"lineH":335280,"ins":0,"useW":0.867},{"id":"13","kind":"text","chars":85,"max":85,"perLine":14.2,"lines":6,"caps":false,"sz":21.0,"paras":3,"text":"a career and a higher income\na university education\nmodern services and entertainment","font":"Times New Roman","anchor":"t","box":[3048000,2895600,3619500,2032000],"lineH":320040,"ins":0},{"id":"17","kind":"label","chars":32,"max":34,"perLine":34.2,"lines":1,"caps":false,"sz":21.5,"paras":1,"text":"Choose the village if you value…","font":"Times New Roman","anchor":"t","box":[7429500,2286000,3873500,406400],"lineH":327660,"ins":0,"useW":0.949},{"id":"18","kind":"text","chars":61,"max":61,"perLine":10.2,"lines":6,"caps":false,"sz":21.0,"paras":3,"text":"peace and fresh air\nhealthy food and nature\nclose family ties","font":"Times New Roman","anchor":"t","box":[7620000,2895600,3619500,2032000],"lineH":320040,"ins":0},{"id":"20","kind":"text","chars":114,"max":114,"perLine":38.0,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Both ways of life are valuable. Many people combine them: they study and work in the city and rest in the village.","font":"Times New Roman","anchor":"t","box":[2857500,5461000,8445500,812800],"lineH":304800,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"end","slots":[{"id":"2","kind":"title","chars":29,"max":29,"perLine":9.7,"lines":3,"caps":false,"sz":48.0,"paras":1,"text":"Thank you for your attention!","font":"Times New Roman","anchor":"t","box":[2589213,2514600,8128000,2262781],"lineH":731520,"ins":182880,"useW":0.911,"base":3.365,"tail":0.216,"below":[{"id":"3","gap":3.712,"cap":0.151}]},{"id":"3","kind":"text","chars":71,"max":71,"perLine":17.8,"lines":4,"caps":false,"sz":24.0,"paras":1,"text":"Questions for discussion: Do you prefer city life or village life? Why?","font":"Times New Roman","anchor":"t","box":[2589213,4777378,8128000,1397000],"lineH":365760,"ins":182880}],"photos":[]}]}