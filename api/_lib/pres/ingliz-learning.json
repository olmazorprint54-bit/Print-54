,{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"10","kind":"label","chars":25,"max":30,"perLine":29.7,"lines":1,"caps":false,"sz":33.73,"paras":1,"text":"Reading Various Materials","font":"Agrandir Medium","anchor":"t","box":[2272000,5369283,6129311,631791],"lineH":556895,"ins":0},{"id":"11","kind":"label","chars":16,"max":21,"perLine":21.3,"lines":1,"caps":false,"sz":33.73,"paras":1,"text":"Writing Practice","font":"Agrandir Medium","anchor":"t","box":[10752998,5369283,4396691,631791],"lineH":556895,"ins":0},{"id":"12","kind":"title","chars":29,"max":29,"perLine":14.5,"lines":2,"caps":true,"sz":83.78,"paras":1,"text":"MASTERING READING AND WRITING","font":"210 클레이토이","anchor":"t","box":[3810307,1869473,10667386,1977683],"lineH":946912,"ins":0},{"id":"13","kind":"text","chars":99,"max":99,"perLine":49.5,"lines":2,"caps":false,"sz":23.06,"paras":1,"text":"How to master reading and writing skills in learning English can be done with the following things:","font":"Agrandir Medium","anchor":"t","box":[5227677,3972753,7832646,825030],"lineH":383667,"ins":0},{"id":"14","kind":"text","chars":99,"max":99,"perLine":33.0,"lines":3,"caps":false,"sz":26.74,"paras":1,"text":"Read various materials, including books, articles and news, to enrich understanding and vocabulary.","font":"Agrandir Medium","anchor":"t","box":[2364197,6592160,5944918,1392860],"lineH":444881,"ins":0},{"id":"15","kind":"text","chars":95,"max":95,"perLine":31.7,"lines":3,"caps":false,"sz":26.74,"paras":1,"text":"Do writing exercises, such as daily journaling or short essays, to improve your writing skills.","font":"Agrandir Medium","anchor":"t","box":[9978885,6592160,5944918,1392860],"lineH":444881,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"10","kind":"title","chars":10,"max":12,"perLine":12.0,"lines":1,"caps":true,"sz":83.78,"paras":1,"text":"CONCLUSION","font":"210 클레이토이","anchor":"t","box":[9357956,4274885,6742805,1033706],"lineH"