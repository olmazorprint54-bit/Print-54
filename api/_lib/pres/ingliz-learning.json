text":"Listen to\nEnglish podcasts"},{"id":"14","kind":"label","chars":16,"max":17,"perLine":16.9,"lines":1,"caps":false,"sz":21.79,"paras":1,"text":"Using Audiobooks"},{"id":"15","kind":"label","chars":33,"max":33,"perLine":16.5,"lines":2,"caps":false,"sz":21.79,"paras":1,"text":"Language Apps with an Audio Focus"}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"7","kind":"label","chars":32,"max":32,"perLine":16.0,"lines":2,"caps":false,"sz":36.39,"paras":1,"text":"Take Part in a Language Exchange"},{"id":"20","kind":"title","chars":25,"max":25,"perLine":12.5,"lines":2,"caps":false,"sz":83.23,"paras":1,"text":"Improving Speaking Skills"},{"id":"21","kind":"text","chars":84,"max":84,"perLine":39.4,"lines":2,"caps":false,"sz":24.33,"paras":1,"text":"Ways to improve speaking skills in English can be done through the following things:"},{"id":"22","kind":"label","chars":24,"max":24,"perLine":12.0,"lines":2,"caps":false,"sz":36.39,"paras":1,"text":"Do Conversation Practice"},{"id":"23","kind":"label","chars":20,"max":21,"perLine":20.8,"lines":1,"caps":false,"sz":36.39,"paras":1,"text":"Join a Speaking Club"}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"10","kind":"label","chars":25,"max":26,"perLine":25.6,"lines":1,"caps":false,"sz":33.73,"paras":1,"text":"Reading Various Materials"},{"id":"11","kind":"label","chars":16,"max":18,"perLine":18.3,"lines":1,"caps":false,"sz":33.73,"paras":1,"text":"Writing Practice"},{"id":"12","kind":"title","chars":29,"max":29,"perLine":14.5,"lines":2,"caps":true,"sz":83.78,"paras":1,"text":"MASTERING READING AND WRITING"},{"id":"13","kind":"text","chars":99,"max":99,"perLine":49.5,"lines":2,"caps":false,"sz":23.06,"paras":1,"text":"How to master reading and writing skills in learning English can be done with the following things:"},{"id":"14","kind":"text","chars":99,"max":99,"perLine":33.0,"lines":3,"caps":false,"sz":26.74,"paras":1,"text":"Read various materials, including books, articles and news, to enrich understanding and vocabulary."},{"id":"15","kind":"text","chars":95,"max":95,"perLine":31.7,"lines":3,"caps":false,"sz":26.74,"paras":1,"text":"Do writing exercises, such as daily journaling or short essays, to improve your writing skills."}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"10","kind":"title","chars":10,"max":10,"perLine":10.2,"lines":1,"caps":true,"sz":83.78,"paras":1,"text":"CONCLUSION"},{"id":"11","kind":"text","chars":187,"max":187,"perLine":46.8,"lines":4,"caps":false,"sz":23.06,"paras":1,"text":"In closing, let us continue to welcome this journey with an undying enthusiasm for learning. English is not just a skill, it is a wide open window to a world of knowledge and opportunity."}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"8","kind":"title","chars":26,"max":26,"perLine":13.0,"lines":2,"caps":true,"sz":114.47,"paras":1,"text":"DO YOU HAVE ANY QUESTIONS?"}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"end","slots":[{"id":"4","kind":"title","chars":10,"max":12,"perLine":5.9,"lines":2,"caps":true,"sz":149.25,"paras":1,"text":"THANK YOU!"}],"photos":[]}]}