{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"7","kind":"title","chars":16,"max":17,"perLine":8.6,"lines":2,"caps":true,"sz":141.54,"paras":1,"text":"LEARNING ENGLISH"},{"id":"8","kind":"label","chars":31,"max":31,"perLine":31.4,"lines":1,"caps":false,"sz":28.09,"paras":1,"text":"“A Journey of Language Mastery”"},{"id":"9","kind":"label","chars":29,"max":29,"perLine":29.3,"lines":1,"caps":false,"sz":28.09,"paras":1,"text":"Presentation by Olivia Wilson"}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"2","kind":"title","chars":16,"max":17,"perLine":8.6,"lines":2,"caps":true,"sz":128.77,"paras":1,"text":"LIST OF CONTENTS"},{"id":"14","kind":"text","chars":145,"max":145,"perLine":24.2,"lines":6,"caps":false,"sz":28.09,"paras":6,"text":"The Importance of English\nLanguage Skills Overview\nDeveloping Listening Skills\nImproving Speaking Skills\nMastering Reading and Writing\nConclusion"}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"15","kind":"text","chars":104,"max":104,"perLine":34.7,"lines":3,"caps":false,"sz":18.02,"paras":1,"text":"English is an international language used in many fields, including business, technology, and diplomacy."},{"id":"16","kind":"text","chars":121,"max":121,"perLine":40.3,"lines":3,"caps":false,"sz":18.02,"paras":1,"text":"By mastering English, a person can more easily adapt to global situations, whether traveling, working or studying abroad."},{"id":"17","kind":"text","chars":132,"max":132,"perLine":33.0,"lines":4,"caps":false,"sz":18.02,"paras":1,"text":"English dominates the digital and technological world. Many online resources, tutorials and technology documentation are in English."},{"id":"18","kind":"title","chars":25,"max":31,"perLine":31.4,"lines":1,"caps":false,"sz":80.56,"paras":1,"text":"The Importance of English"},{"id":"19","kind":"text","chars":138,"max":138,"perLine":69.0,"lines":2,"caps"