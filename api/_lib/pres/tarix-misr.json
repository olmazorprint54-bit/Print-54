:320040,"ins":0},{"id":"9","kind":"label","chars":27,"max":30,"perLine":30.2,"lines":1,"caps":true,"sz":18.0,"paras":1,"text":"LAND OF THE NILE AND DESERT","font":"Poppins Bold","anchor":"t","box":[8677082,971550,4091745,325755],"lineH":320040,"ins":0},{"id":"10","kind":"label","chars":8,"max":10,"perLine":10.1,"lines":1,"caps":false,"sz":23.99,"paras":1,"text":"Rimberio","font":"Free Serif","anchor":"t","box":[8677082,4431771,1273695,424815],"lineH":426593,"ins":0},{"id":"11","kind":"label","chars":2,"max":8,"perLine":4,"lines":1,"caps":false,"sz":137.94,"paras":1,"text":"of","font":"Lavonia Classy","anchor":"t","box":[866647,1692627,1508586,2461526],"lineH":2452624,"ins":0},{"id":"12","kind":"label","chars":6,"max":14,"perLine":14.0,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 2","font":"Poppins","anchor":"t","box":[15151651,760479,2107649,404940],"lineH":407162,"ins":0}],"photos":[{"id":"3","w":15176776,"h":3758382,"area":0.303},{"id":"5","w":3765457,"h":4903356,"area":0.098}]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"18","kind":"title","chars":19,"max":20,"perLine":9.8,"lines":2,"caps":false,"sz":121.58,"paras":1,"text":"Historical Timeline","font":"Free Serif","anchor":"t","box":[1028700,1297160,6284874,2746611],"lineH":1250696,"ins":0},{"id":"19","kind":"text","chars":63,"max":63,"perLine":31.5,"lines":2,"caps":false,"sz":17.05,"paras":1,"text":"Alexandria’s founding and the influence of Hellenistic culture.","font":"Poppins","anchor":"t","box":[12964052,2281491,3951846,609417],"lineH":303149,"ins":0},{"id":"20","kind":"label","chars":19,"max":22,"perLine":22.2,"lines":1,"caps":false,"sz":18.94,"paras":1,"text":"Greek & Roman Egypt","font":"Poppins Bold","anchor":"t","box":[12964052,1676746,2867063,342909],"lineH":336804,"ins":0},{"id":"21","kind":"text","chars":145,"max":145,"perLine":48.3,"lines":3,"caps":true,"sz":17.0,"paras":1,"text":"EGYPT’S HISTORY SPANS OVER 5,000 YEARS, FROM EARLY DYNASTIES THROUGH ROMAN RULE, ISLAMIC CALIPHATES, OTTOMAN GOVERNANCE, AND MODERN INDEPENDENCE.","font":"Poppins","anchor":"t","box":[1028700,8663174,5736851,899795],"lineH":302260,"ins":0},{"id":"22","kind":"text","chars":65,"max":65,"perLine":32.5,"lines":2,"caps":false,"sz":17.05,"paras":1,"text":"Independence movements, industrial development, and urban growth.","font":"Poppins","anchor":"t","box":[12964052,4565127,3951846,609417],"lineH":303149,"ins":0},{"id":"23","kind":"label","chars":10,"max":19,"perLine":19.4,"lines":1,"caps":false,"sz":18.94,"paras":1,"text":"Modern Era","font":"Poppins Bold","anchor":"t","box":[12964052,3960382,2508628,342909],"lineH":336804,"ins":0},{"id":"24","kind":"text","chars":66,"max":66,"perLine":33.0,"lines":2,"caps":false,"sz":17.05,"paras":1,"text":"Rise of pyramids, temples, and hieroglyphics between 3100–332 BCE.","font":"Poppins","anchor":"t","box":[8061453,2281491,3951846,609417],"lineH":303149,"ins":0},{"id":"25","kind":"label","chars":13,"max":19,"perLine":19.4,"lines":1,"caps":false,"sz":18.94,"paras":1,"text":"Ancient Egypt","font":"Poppins Bold","anchor":"t","box":[8061453,1676746,2508628,342909],"lineH":336804,"ins":0},{"id":"26","kind":"label","chars":47,"max":47,"perLine":23.5,"lines":2,"caps":false,"sz":17.05,"paras":1,"text":"Cairo’s growth as a center of learning and art.","font":"Poppins","anchor":"t","box":[8061453,4591365,3951846,609417],"lineH":303149,"ins":0},{"id":"27","kind":"label","chars":13,"max":19,"perLine":19.4,"lines":1,"caps":false,"sz":18.94,"paras":1,"text":"Islamic Egypt","font":"Poppins Bold","anchor":"t","box":[8061453,3986620,2508628,342909],"lineH":336804,"ins":0},{"id":"31","kind":"label","chars":6,"max":14,"perLine":14.0,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 3","font":"Poppins","anchor":"t","box":[15151651,760479,2107649,399017],"lineH":407162,"ins":0}],"photos":[{"id":"3","w":9541249,"h":3237760,"area":0.164},{"id":"5","w":5736851,"h":3536148,"area":0.108}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"23","kind":"title","chars":7,"max":8,"perLine":7.9,"lines":1,"caps":false,"sz":127.53,"paras":1,"text":"Ancient","font":"Free Serif","anchor":"t","box":[1028700,413601,5306684,2295447],"lineH":2267458,"ins":0},{"id":"24","kind":"label","chars":9,"max":12,"perLine":12.1,"lines":1,"caps":false,"sz":112.98,"paras":1,"text":"monuments","font":"Free Serif","anchor":"t","box":[1028700,1653264,7164070,2045247],"lineH":2008759,"ins":0},{"id":"25","kind":"text","chars":70,"max":70,"perLine":35.0,"lines":2,"caps":false,"sz":16.99,"paras":1,"text":"Iconic tombs of pharaohs, showcasing advanced construction techniques.","font":"Poppins","anchor":"t","box":[12960861,2214628,4125020,600726],"lineH":302133,"ins":0},{"id":"26","kind":"label","chars":16,"max":19,"perLine":18.7,"lines":1,"caps":false,"sz":19.11,"paras":1,"text":"Pyramids of Giza","font":"Poppins Bold","anchor":"t","box":[12960861,1602715,2441927,332901],"lineH":339852,"ins":0},{"id":"27","kind":"text","chars":96,"max":96,"perLine":48.0,"lines":2,"caps":true,"sz":16.0,"paras":1,"text":"EGYPT’S MONUMENTS STAND AS ENDURING SYMBOLS OF ITS ANCIENT POWER, SPIRITUALITY, AND ENGINEERING.","font":"Poppins","anchor":"t","box":[1028700,4081685,6481122,559435],"lineH":284480,"ins":0},{"id":"28","kind":"label","chars":54,"max":54,"perLine":27.0,"lines":2,"caps":false,"sz":16.99,"paras":1,"text":"Monumental limestone statue guarding the Giza Plateau.","font":"Poppins","anchor":"t","box":[12960861,4355106,4125020,600726],"lineH":302133,"ins":0},{"id":"29","kind":"label","chars":10,"max":19,"perLine":18.7,"lines":1,"caps":false,"sz":19.11,"paras":1,"text":"The Sphinx","font":"Poppins Bold","anchor":"t","box":[12960861,3743193,2441927,332901],"lineH":339852,"ins":0},{"id":"30","kind":"text","chars":64,"max":64,"perLine":32.0,"lines":2,"caps":false,"sz":16.99,"paras":1,"text":"Burial ground of New Kingdom rulers with richly decorated tombs.","font":"Poppins","anchor":"t","box":[9630490,6407153,4125020,600726],"lineH":302133,"ins":0},{"id":"31","kind":"label","chars":19,"max":19,"perLine":18.7,"lines":1,"caps":false,"sz":19.11,"paras":1,"text":"Valley of the Kings","font":"Poppins Bold","anchor":"t","box":[9630490,5795240,2441927,332901],"lineH":339852,"ins":0},{"id":"32","kind":"label","chars":57,"max":57,"perLine":28.5,"lines":2,"caps":false,"sz":16.99,"paras":1,"text":"Centers of worship and political power in ancient Thebes.","font":"Poppins","anchor":"t","box":[9630490,8547158,4125020,600726],"lineH":302133,"ins":0},{"id":"33","kind":"label","chars":27,"max":29,"perLine":28.5,"lines":1,"caps":false,"sz":19.11,"paras":1,"text":"Temples of Luxor and Karnak","font":"Poppins Bold","anchor":"t","box":[9630490,7935245,3717209,332901],"lineH":339852,"ins":0},{"id":"37","kind":"label","chars":6,"max":14,"perLine":14.0,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 4","font":"Poppins","anchor":"t","box":[15151651,760479,2107649,404940],"lineH":407162,"ins":0}],"photos":[{"id":"15","w":2695150,"h":3916300,"area":0.056},{"id":"17","w":2695150,"h":3916300,"area":0.056},{"id":"22","w":6525878,"h":3916300,"area":0.136}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"12","kind":"title","chars":12,"max":12,"perLine":11.6,"lines":1,"caps":false,"sz":141.84,"paras":1,"text":"Egyptian Art","font":"Free Serif","anchor":"t","box":[1028700,5341282,8651730,2544846],"lineH":2521839,"ins":0},{"id":"13","kind":"label","chars":12,"max":12,"perLine":12.0,"lines":1,"caps":false,"sz":114.25,"paras":1,"text":"Architecture","font":"Free Serif","anchor":"t","box":[3007045,7281733,7229899,2052954],"lineH":2031365,"ins":0},{"id":"14","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":113.9,"paras":1,"text":"&","font":"Free Serif","anchor":"t","box":[1261716,7211975,1245685,2046325],"lineH":2025269,"ins":0},{"id":"15","kind":"text","chars":172,"max":172,"perLine":28.7,"lines":6,"caps":false,"sz":18.0,"paras":1,"text":"Egyptian art and architecture are among the most recognizable in the world, reflecting thousands of years of cultural evolution, spiritual beliefs, and social organization.","font":"Poppins","anchor":"t","box":[13769238,7182210,3490062,1897380],"lineH":320040,"ins":0},{"id":"16","kind":"text","chars":242,"max":242,"perLine":60.5,"lines":4,"caps":false,"sz":18.0,"paras":1,"text":"From the monumental structures of the ancient world to the refined decorative arts of Islamic Cairo and today’s innovative urban developments, Egypt’s artistic expression has always been closely tied to its environment, religion, and society.","font":"Poppins","anchor":"t","box":[10011512,1405106,7247788,1268730],"lineH":320040,"ins":0},{"id":"17","kind":"label","chars":6,"max":14,"perLine":14.0,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 5","font":"Poppins","anchor":"t","box":[15151651,760479,2107649,404940],"lineH":407162,"ins":0}],"photos":[{"id":"3","w":7129605,"h":4400524,"area":0.167},{"id":"5","w":6516545,"h":3454043,"area":0.12},{"id":"7","w":2740412,"h":4294681,"area":0.063}]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"2","kind":"title","chars":7,"max":10,"perLine":9.8,"lines":1,"caps":false,"sz":168.59,"paras":1,"text":"Economy","font":"Free Serif","anchor":"t","box":[1028700,187543,8654706,3038860],"lineH":2997581,"ins":0},{"id":"8","kind":"label","chars":5,"max":8,"perLine":6.6,"lines":1,"caps":false,"sz":153.62,"paras":1,"text":"Egypt","font":"Free Serif","anchor":"t","box":[2768896,2012222,5306527,2753049],"lineH":2731389,"ins":0},{"id":"9","kind":"label","chars":2,"max":8,"perLine":4,"lines":1,"caps":false,"sz":143.08,"paras":1,"text":"of","font":"Lavonia Classy","anchor":"t","box":[1204114,1971877,1564782,2549262],"lineH":2544064,"ins":0},{"id":"10","kind":"text","chars":191,"max":191,"perLine":38.2,"lines":5,"caps":false,"sz":16.0,"paras":1,"text":"Agriculture remains vital to Egypt’s economy, centered along the fertile Nile Delta and Valley. Crops such as cotton, wheat, sugarcane, and rice support both domestic consumption and exports.","font":"Poppins","anchor":"t","box":[6617127,7558126,4166160,1388110],"lineH":284480,"ins":0},{"id":"11","kind":"text","chars":278,"max":278,"perLine":55.6,"lines":5,"caps":false,"sz":16.0,"paras":1,"text":"With its iconic pyramids, ancient temples, museums, Red Sea resorts, and desert adventures, tourism is a key source of employment and foreign currency. The sector also drives infrastructure improvements, from airports to hotels, creating a multiplier effect in other industries.","font":"Poppins","anchor":"t","box":[11822079,7558126,5437221,1388110],"lineH":284480,"ins":0},{"id":"12","kind":"label","chars":11,"max":18,"perLine":18.0,"lines":1,"caps":true,"sz":18.0,"paras":1,"text":"AGRICULTURE","font":"Poppins Bold","anchor":"t","box":[6617127,6831872,2433183,325755],"lineH":320040,"ins":0},{"id":"13","kind":"label","chars":7,"max":22,"perLine":22.0,"lines":1,"caps":true,"sz":18.0,"paras":1,"text":"TOURISM","font":"Poppins Bold","anchor":"t","box":[11822079,6831872,2970927,325755],"lineH":320040,"ins":0},{"id":"14","kind":"label","chars":6,"max":14,"perLine":14.0,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 6","font":"Poppins","anchor":"t","box":[15151651,760479,2107649,404940],"lineH":407162,"ins":0}],"photos":[{"id":"4","w":7790570,"h":4902164,"area":0.203},{"id":"6","w":4900442,"h":3817970,"area":0.099}]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"8","kind":"title","chars":21,"max":21,"perLine":10.5,"lines":2,"caps":false,"sz":124.89,"paras":1,"text":"Modern Infrastructure","font":"Free Serif","anchor":"t","box":[1028700,1229037,9714523,3153274],"lineH":1474978,"ins":0},{"id":"9","kind":"text","chars":140,"max":140,"perLine":23.3,"lines":6,"caps":false,"sz":16.93,"paras":1,"text":"Massive investments are being made to expand Egypt’s railways, build new metro lines in Cairo, and improve highways connecting major cities.","font":"Poppins","anchor":"t","box":[13758458,1919546,3170625,1788147],"lineH":300990,"ins":0},{"id":"10","kind":"text","chars":107,"max":107,"perLine":26.8,"lines":4,"caps":false,"sz":16.93,"paras":1,"text":"Egypt is planning and constructing new urban centers, including a new administrative capital east of Cairo.","font":"Poppins","anchor":"t","box":[13758458,8061487,3500842,1196813],"lineH":300990,"ins":0},{"id":"11","kind":"label","chars":23,"max":27,"perLine":27.2,"lines":1,"caps":false,"sz":18.81,"paras":1,"text":"Transportation Projects","font":"Poppins Bold","anchor":"t","box":[13758458,1460046,3486913,340871],"lineH":334391,"ins":0},{"id":"12","kind":"label","chars":17,"max":21,"perLine":21.5,"lines":1,"caps":false,"sz":18.81,"paras":1,"text":"Urban Development","font":"Poppins Bold","anchor":"t","box":[13758458,7601988,2750142,340871],"lineH":334391,"ins":0},{"id":"13","kind":"text","chars":163,"max":163,"perLine":27.2,"lines":6,"caps":false,"sz":16.93,"paras":1,"text":"The government is diversifying its energy portfolio by investing in solar, wind, and other renewable sources, alongside traditional oil and natural gas facilities.","font":"Poppins","anchor":"t","box":[13758458,4842683,3170625,1788147],"lineH":300990,"ins":0},{"id":"14","kind":"label","chars":18,"max":19,"perLine":19.4,"lines":1,"caps":false,"sz":18.81,"paras":1,"text":"Energy Initiatives","font":"Poppins Bold","anchor":"t","box":[13758458,4383183,2490735,340871],"lineH":334391,"ins":0},{"id":"18","kind":"label","chars":6,"max":14,"perLine":14.0,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 7","font":"Poppins","anchor":"t","box":[15151651,760479,2107649,404940],"lineH":407162,"ins":0}],"photos":[{"id":"3","w":2864074,"h":5445538,"area":0.083},{"id":"5","w":11222227,"h":3750347,"area":0.224},{"id":"7","w":2864074,"h":2456263,"area":0.037}]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"14","kind":"title","chars":7,"max":10,"perLine":9.8,"lines":1,"caps":false,"sz":149.37,"paras":1