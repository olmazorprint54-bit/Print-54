{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"2","kind":"title","chars":5,"max":8,"perLine":5.1,"lines":1,"caps":false,"sz":277.68,"paras":1,"text":"Egypt"},{"id":"12","kind":"label","chars":31,"max":85,"perLine":42.3,"lines":2,"caps":false,"sz":15.99,"paras":1,"text":"Presented by Mariana Napolitani"},{"id":"15","kind":"label","chars":13,"max":14,"perLine":14.5,"lines":1,"caps":false,"sz":48.9,"paras":1,"text":"the theory of"},{"id":"16","kind":"label","chars":50,"max":50,"perLine":16.7,"lines":3,"caps":false,"sz":34.95,"paras":1,"text":"A Journey Through History, Culture, and Landscapes"}],"photos":[{"id":"8","w":6831375,"h":8782736,"area":0.319}]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"6","kind":"label","chars":9,"max":10,"perLine":9.6,"lines":1,"caps":false,"sz":123.05,"paras":1,"text":"Geography"},{"id":"7","kind":"title","chars":5,"max":8,"perLine":5.4,"lines":1,"caps":false,"sz":179.93,"paras":1,"text":"Egypt"},{"id":"8","kind":"text","chars":207,"max":207,"perLine":34.5,"lines":6,"caps":false,"sz":18.0,"paras":1,"text":"Egypt occupies the northeastern corner of Africa and extends into the Sinai Peninsula of Asia. Its geography is dominated by the Nile River, deserts, and a long coastline along the Mediterranean and Red Sea."},{"id":"9","kind":"label","chars":27,"max":26,"perLine":26.3,"lines":1,"caps":true,"sz":18.0,"paras":1,"text":"LAND OF THE NILE AND DESERT"},{"id":"10","kind":"label","chars":8,"max":8,"perLine":8.4,"lines":1,"caps":false,"sz":23.99,"paras":1,"text":"Rimberio"},{"id":"11","kind":"label","chars":2,"max":8,"perLine":4,"lines":1,"caps":false,"sz":137.94,"paras":1,"text":"of"},{"id":"12","kind":"label","chars":6,"max":14,"perLine":14.5,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 2"}],"photos":[{"id":"3","w":15176776,"h":3758382,"area":0.303},{"id":"5","w":3765457,"h":4903356,"area":0.098}]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"18","kind":"title","chars":19,"max":16,"perLine":8.1,"lines":2,"caps":false,"sz":121.58,"paras":1,"text":"Historical Timeline"},{"id":"19","kind":"text","chars":63,"max":63,"perLine":31.5,"lines":2,"caps":false,"sz":17.05,"paras":1,"text":"Alexandria’s founding and the influence of Hellenistic culture."},{"id":"20","kind":"label","chars":19,"max":21,"perLine":21.3,"lines":1,"caps":false,"sz":18.94,"paras":1,"text":"Greek & Roman Egypt"},{"id":"21","kind":"text","chars":145,"max":145,"perLine":47.1,"lines":3,"caps":true,"sz":17.0,"paras":1,"text":"EGYPT’S HISTORY SPANS OVER 5,000 YEARS, FROM EARLY DYNASTIES THROUGH ROMAN RULE, ISLAMIC CALIPHATES, OTTOMAN GOVERNANCE, AND MODERN INDEPENDENCE."},{"id":"22","kind":"text","chars":65,"max":65,"perLine":32.5,"lines":2,"caps":false,"sz":17.05,"paras":1,"text":"Independence movements, industrial development, and urban growth."},{"id":"23","kind":"label","chars":10,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":18.94,"paras":1,"text":"Modern Era"},{"id":"24","kind":"text","chars":66,"max":66,"perLine":33.0,"lines":2,"caps":false,"sz":17.05,"paras":1,"text":"Rise of pyramids, temples, and hieroglyphics between 3100–332 BCE."},{"id":"25","kind":"label","chars":13,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":18.94,"paras":1,"text":"Ancient Egypt"},{"id":"26","kind":"label","chars":47,"max":47,"perLine":23.5,"lines":2,"caps":false,"sz":17.05,"paras":1,"text":"Cairo’s growth as a center of learning and art."},{"id":"27","kind":"label","chars":13,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":18.94,"paras":1,"text":"Islamic Egypt"},{"id":"31","kind":"label","chars":6,"max":14,"perLine":14.5,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 3"}],"photos":[{"id":"3","w":9541249,"h":3237760,"area":0.164},{"id":"5","w":5736851,"h":3536148,"area":0.108}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"23","kind":"title","chars":7,"max":8,"perLine":6.6,"lines":1,"caps":false,"sz":127.53,"paras":1,"text":"Ancient"},{"id":"24","kind":"label","chars":9,"max":10,"perLine":10.0,"lines":1,"caps":false,"sz":112.98,"paras":1,"text":"monuments"},{"id":"25","kind":"text","chars":70,"max":70,"perLine":35.0,"lines":2,"caps":false,"sz":16.99,"paras":1,"text":"Iconic tombs of pharaohs, showcasing advanced construction techniques."},{"id":"26","kind":"label","chars":16,"max":18,"perLine":18.0,"lines":1,"caps":false,"sz":19.11,"paras":1,"text":"Pyramids of Giza"},{"id":"27","kind":"text","chars":96,"max":96,"perLine":48.0,"lines":2,"caps":true,"sz":16.0,"paras":1,"text":"EGYPT’S MONUMENTS STAND AS ENDURING SYMBOLS OF ITS ANCIENT POWER, SPIRITUALITY, AND ENGINEERING."},{"id":"28","kind":"label","chars":54,"max":54,"perLine":27.0,"lines":2,"caps":false,"sz":16.99,"paras":1,"text":"Monumental limestone statue guarding the Giza Plateau."},{"id":"29","kind":"label","chars":10,"max":18,"perLine":18.0,"lines":1,"caps":false,"sz":19.11,"paras":1,"text":"The Sphinx"},{"id":"30","kind":"text","chars":64,"max":64,"perLine":32.0,"lines":2,"caps":false,"sz":16.99,"paras":1,"text":"Burial ground of New Kingdom rulers with richly decorated tombs."},{"id":"31","kind":"label","chars":19,"max":18,"perLine":18.0,"lines":1,"caps":false,"sz":19.11,"paras":1,"text":"Valley of the Kings"},{"id":"32","kind":"label","chars":57,"max":57,"perLine":28.5,"lines":2,"caps":false,"sz":16.99,"paras":1,"text":"Centers of worship and political power in ancient Thebes."},{"id":"33","kind":"label","chars":27,"max":27,"perLine":27.4,"lines":1,"caps":false,"sz":19.11,"paras":1,"text":"Temples of Luxor and Karnak"},{"id":"37","kind":"label","chars":6,"max":14,"perLine":14.5,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 4"}],"photos":[{"id":"15","w":2695150,"h":3916300,"area":0.056},{"id":"17","w":2695150,"h":3916300,"area":0.056},{"id":"22","w":6525878,"h":3916300,"area":0.136}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"12","kind":"title","chars":12,"max":10,"perLine":9.6,"lines":1,"caps":false,"sz":141.84,"paras":1,"text":"Egyptian Art"},{"id":"13","kind":"label","chars":12,"max":10,"perLine":10.0,"lines":1,"caps":false,"sz":114.25,"paras":1,"text":"Architecture"},{"id":"14","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":113.9,"paras":1,"text":"&"},{"id":"15","kind":"text","chars":172,"max":172,"perLine":28.7,"lines":6,"caps":false,"sz":18.0,"paras":1,"text":"Egyptian art and architecture are among the most recognizable in the world, reflecting thousands of years of cultural evolution, spiritual beliefs, and social organization."},{"id":"16","kind":"text","chars":242,"max":242,"perLine":60.5,"lines":4,"caps":false,"sz":18.0,"paras":1,"text":"From the monumental structures of the ancient world to the refined decorative arts of Islamic Cairo and today’s innovative urban developments, Egypt’s artistic expression has always been closely tied to its environment, religion, and society."},{"id":"17","kind":"label","chars":6,"max":14,"perLine":14.5,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 5"}],"photos":[{"id":"3","w":7129605,"h":4400524,"area":0.167},{"id":"5","w":6516545,"h":3454043,"area":0.12},{"id":"7","w":2740412,"h":4294681,"area":0.063}]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"2","kind":"title","chars":7,"max":8,"perLine":8.1,"lines":1,"caps":false,"sz":168.59,"paras":1,"text":"Economy"},{"id":"8","kind":"label","chars":5,"max":8,"perLine":5.4,"lines":1,"caps":false,"sz":153.62,"paras":1,"text":"Egypt"},{"id":"9","kind":"label","chars":2,"max":8,"perLine":4,"lines":1,"caps":false,"sz":143.08,"paras":1,"text":"of"},{"id":"10","kind":"text","chars":191,"max":191,"perLine":38.2,"lines":5,"caps":false,"sz":16.0,"paras":1,"text":"Agriculture remains vital to Egypt’s economy, centered along the fertile Nile Delta and Valley. Crops such as cotton, wheat, sugarcane, and rice support both domestic consumption and exports."},{"id":"11","kind":"text","chars":278,"max":278,"perLine":55.6,"lines":5,"caps":false,"sz":16.0,"paras":1,"text":"With its iconic pyramids, ancient temples, museums, Red Sea resorts, and desert adventures, tourism is a key source of employment and foreign currency. The sector also drives infrastructure improvements, from airports to hotels, creating a multiplier effect in other industries."},{"id":"12","kind":"label","chars":11,"max":16,"perLine":15.7,"lines":1,"caps":true,"sz":18.0,"paras":1,"text":"AGRICULTURE"},{"id":"13","kind":"label","chars":7,"max":19,"perLine":19.1,"lines":1,"caps":true,"sz":18.0,"paras":1,"text":"TOURISM"},{"id":"14","kind":"label","chars":6,"max":14,"perLine":14.5,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 6"}],"photos":[{"id":"4","w":7790570,"h":4902164,"area":0.203},{"id":"6","w":4900442,"h":3817970,"area":0.099}]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"8","kind":"title","chars":21,"max":21,"perLine":10.5,"lines":2,"caps":false,"sz":124.89,"paras":1,"text":"Modern Infrastructure"},{"id":"9","kind":"text","chars":140,"max":140,"perLine":23.3,"lines":6,"caps":false,"sz":16.93,"paras":1,"text":"Massive investments are being made to expand Egypt’s railways, build new metro lines in Cairo, and improve highways connecting major cities."},{"id":"10","kind":"text","chars":107,"max":107,"perLine":26.8,"lines":4,"caps":false,"sz":16.93,"paras":1,"text":"Egypt is planning and constructing new urban centers, including a new administrative capital east of Cairo."},{"id":"11","kind":"label","chars":23,"max":26,"perLine":26.1,"lines":1,"caps":false,"sz":18.81,"paras":1,"text":"Transportation Projects"},{"id":"12","kind":"label","chars":17,"max":21,"perLine":20.6,"lines":1,"caps":false,"sz":18.81,"paras":1,"text":"Urban Development"},{"id":"13","kind":"text","chars":163,"max":163,"perLine":27.2,"lines":6,"caps":false,"sz":16.93,"paras":1,"text":"The government is diversifying its energy portfolio by investing in solar, wind, and other renewable sources, alongside traditional oil and natural gas facilities."},{"id":"14","kind":"label","chars":18,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":18.81,"paras":1,"text":"Energy Initiatives"},{"id":"18","kind":"label","chars":6,"max":14,"perLine":14.5,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 7"}],"photos":[{"id":"3","w":2864074,"h":5445538,"area":0.083},{"id":"5","w":11222227,"h":3750347,"area":0.224},{"id":"7","w":2864074,"h":2456263,"area":0.037}]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"14","kind":"title","chars":7,"max":8,"perLine":8.1,"lines":1,"caps":false,"sz":149.37,"paras":1,"text":"Tourism"},{"id":"15","kind":"label","chars":8,"max":8,"perLine":7.9,"lines":1,"caps":false,"sz":130.88,"paras":1,"text":"Hotspots"},{"id":"16","kind":"label","chars":47,"max":47,"perLine":23.5,"lines":2,"caps":false,"sz":18.0,"paras":1,"text":"Iconic pyramids, museums, and bustling markets."},{"id":"17","kind":"label","chars":36,"max":36,"perLine":18.0,"lines":2,"caps":false,"sz":18.0,"paras":1,"text":"Temples, tombs, and the scenic Nile."},{"id":"18","kind":"label","chars":12,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":19.99,"paras":1,"text":"Cairo & Giza"},{"id":"19","kind":"label","chars":13,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":19.99,"paras":1,"text":"Luxor & Aswan"},{"id":"20","kind":"label","chars":59,"max":59,"perLine":19.7,"lines":3,"caps":false,"sz":18.0,"paras":1,"text":"Aaron Loeb and Claudia Alves offer diving and luxury stays."},{"id":"21","kind":"label","chars":21,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":19.99,"paras":1,"text":"Salford & Co. Resorts"},{"id":"22","kind":"text","chars":96,"max":96,"perLine":24.0,"lines":4,"caps":true,"sz":17.66,"paras":1,"text":"EGYPT’S DIVERSE DESTINATIONS APPEAL TO HISTORY BUFFS, BEACH LOVERS, AND ADVENTURE SEEKERS ALIKE."},{"id":"23","kind":"label","chars":6,"max":14,"perLine":14.5,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 8"}],"photos":[{"id":"3","w":4207115,"h":4085003,"area":0.091},{"id":"5","w":2923030,"h":2456263,"area":0.038},{"id":"7","w":5112448,"h":2443170,"area":0.066},{"id":"9","w":3460510,"h":7645643,"area":0.141}]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"6","kind":"title","chars":4,"max":8,"perLine":7.0,"lines":1,"caps":false,"sz":179.98,"paras":1,"text":"Arts"},{"id":"7","kind":"label","chars":15,"max":14,"perLine":13.6,"lines":1,"caps":false,"sz":118.74,"paras":1,"text":"Popular Culture"},{"id":"8","kind":"text","chars":130,"max":130,"perLine":26.0,"lines":5,"caps":true,"sz":19.99,"paras":1,"text":"EGYPT’S ARTS AND POPULAR CULTURE FORM A VIBRANT TAPESTRY THAT REFLECTS THE COUNTRY’S HISTORICAL DEPTH AND CONTEMPORARY CREATIVITY."},{"id":"9","kind":"text","chars":160,"max":160,"perLine":40.0,"lines":4,"caps":false,"sz":19.99,"paras":1,"text":"For more than a century, Egypt has been a cultural trendsetter in the Arab world, producing some of the region’s most iconic music, films, writers, and artists."},{"id":"10","kind":"label","chars":6,"max":14,"perLine":14.5,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 9"}],"photos":[{"id":"3","w":5002383,"h":7336479,"area":0.195},{"id":"5","w":6078725,"h":6229459,"area":0.201}]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"4","kind":"label","chars":31,"max":85,"perLine":42.3,"lines":2,"caps":false,"sz":15.99,"paras":1,"text":"Presented by Mariana Napolitani"},{"id":"13","kind":"label","chars":7,"max":14,"perLine":14.5,"lines":1,"caps":false,"sz":22.9,"paras":1,"text":"Page 10"},{"id":"14","kind":"title","chars":17,"max":15,"perLine":14.8,"lines":1,"caps":false,"sz":159.44,"paras":1,"text":"Egypt at a Glance"},{"id":"15","kind":"label","chars":30,"max":30,"perLine":15.0,"lines":2,"caps":false,"sz":30.73,"paras":1,"text":"Timeless Land, Endless Stories"},{"id":"16","kind":"label","chars":13,"max":20,"perLine":20.4,"lines":1,"caps":false,"sz":30.73,"paras":1,"text":"Get in Touch!"},{"id":"17","kind":"text","chars":184,"max":184,"perLine":46.0,"lines":4,"caps":false,"sz":15.99,"paras":1,"text":"Egypt’s journey from ancient civilization to modern nation offers lessons in resilience, diversity, and creativity. This overview only scratches the surface of what makes Egypt unique."},{"id":"18","kind":"text","chars":63,"max":63,"perLine":21.0,"lines":3,"caps":false,"sz":15.99,"paras":3,"text":"+123-456-7890\nwww.reallygreatsite.com\nhello@reallygreatsite.com"}],"photos":[{"id":"6","w":7591425,"h":4941115,"area":0.199}]}]}