     "perLine": 33.2,
     "lines": 4,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Kunduzi qum qizib ketdi, kechasi esa salqin tushdi. Barxanlar shamol bilan sekin siljiydi — cho'l har kuni o'z shaklini o'zgartiradi.",
     "font": "Segoe Print",
     "anchor": "t",
     "box": [
      6908800,
      2184400,
      3987800,
      984885
     ],
     "lineH": 243840,
     "ins": 0
    },
    {
