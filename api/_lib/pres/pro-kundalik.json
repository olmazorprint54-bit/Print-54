     "perLine": 18.3,
     "lines": 6,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "Archa — tog'larning doimiy yashil daraxti\nHar 100 m da havo ~0,6 °C soviydi\nSuv va issiq kiyim — eng muhim yuk",
     "font": "Segoe Print",
     "anchor": "t",
