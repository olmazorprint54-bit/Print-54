     "lines": 4,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Ertalab yo'lga chiqdik. Havo salqin, yo'l bo'ylab archazorlar. Tepaga ko'tarilgan sari nafas olish og'irlashdi — balandlik sezildi.",
     "font": "Segoe Print",
     "anchor": "t",
     "box": [
      6908800,
      2184400,
      3987800,
      984885
     ],
     "lineH": 243840,
