     "max": 95,
     "perLine": 19,
     "lines": 5,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "Barxan — o'roqsimon qum tepaligi\nSaksovul — qumni ushlab turadi\nKechasi osmon yulduzlarga to'la",
     "font": "Segoe Print",
     "anchor": "t",
