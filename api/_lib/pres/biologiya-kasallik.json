{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"3","kind":"title","chars":18,"max":21,"perLine":10.3,"lines":2,"caps":true,"sz":143.06,"paras":1,"text":"AUTOIMMUNE DISEASE"},{"id":"10","kind":"label","chars":8,"max":9,"perLine":9.3,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE"},{"id":"11","kind":"label","chars":10,"max":13,"perLine":12.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us"}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"13","kind":"label","chars":10,"max":13,"perLine":12.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us"},{"id":"14","kind":"text","chars":229,"max":229,"perLine":22.9,"lines":10,"caps":false,"sz":14.0,"paras":1,"text":"An autoimmune disease occurs when the immune system, which normally defends against harmful invaders, mistakenly attacks the body's own healthy cells, tissues, or organs. This malfunction leads to chronic inflammation and damage."},{"id":"15","kind":"title","chars":30,"max":30,"perLine":15.0,"lines":2,"caps":true,"sz":50.33,"paras":1,"text":"WHAT IS AN AUTOIMMUNE DISEASE?"},{"id":"16","kind":"label","chars":29,"max":38,"perLine":38.1,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"A Defense System in Confusion"},{"id":"17","kind":"text","chars":196,"max":196,"perLine":21.8,"lines":9,"caps":false,"sz":14.0,"paras":1,"text":"These diseases vary in how and where they strike, some are organ-specific, while others affect entire systems, making their identification and treatment complex yet essential for long-term health."},{"id":"19","kind":"label","chars":8,"max":9,"perLine":9.3,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE"}],"photos":[{"id":"5","w":8272396,"h":7121358,"area":0.313}]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"4","kind":"title","chars":35,"max":35,"perLine":11.7,"lines":3,"caps":true,"sz":63.74,"paras":1,"text":"COMMON TYPES OF AUTOIMMUNE DISEASES"},{"id":"11","kind":"label","chars":10,"max":13,"perLine":12.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us"},{"id":"12","kind":"text","chars":315,"max":315,"perLine":78.8,"lines":4,"caps":false,"sz":14.0,"paras":1,"text":"Autoimmune diseases include over 80 known conditions. Common examples are those affecting joints, the nervous system, skin, or endocrine glands. Though their targets differ, each is rooted in the immune system's failure to distinguish between self and threat, resulting in persistent inflammation and tissue damage."},{"id":"13","kind":"label","chars":35,"max":57,"perLine":56.7,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"A Broad Range of Chronic Conditions"},{"id":"17","kind":"label","chars":8,"max":9,"perLine":9.3,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE"}],"photos":[{"id":"15","w":7363675,"h":5342083,"area":0.209}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"4","kind":"label","chars":10,"max":13,"perLine":12.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us"},{"id":"8","kind":"text","chars":87,"max":87,"perLine":17.4,"lines":5,"caps":false,"sz":14.0,"paras":1,"text":"A family history of autoimmune disease increases risk due to inherited immune patterns."},{"id":"9","kind":"title","chars":23,"max":23,"perLine":11.5,"lines":2,"caps":true,"sz":85.87,"paras":1,"text":"CAUSES AND RISK FACTORS"},{"id":"10","kind":"label","chars":13,"max":18,"perLine":18.4,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Genetic Links"},{"id":"11","kind":"label","chars":35,"max":64,"perLine":63.5,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"Triggers Behind the Immune Response"},{"id":"12","kind":"text","chars":92,"max":92,"perLine":18.4,"lines":5,"caps":false,"sz":14.0,"paras":1,"text":"Toxins, pollutants, or infections may trigger immune malfunction in susceptible individuals."},{"id":"13","kind":"label","chars":22,"max":22,"perLine":11.0,"lines":2,"caps":false,"sz":14.0,"paras":1,"text":"Environmental Exposure"},{"id":"14","kind":"text","chars":87,"max":87,"perLine":17.4,"lines":5,"caps":false,"sz":14.0,"paras":1,"text":"Hormonal changes, especially in women, may influence immune behavior and disease onset."},{"id":"15","kind":"label","chars":16,"max":18,"perLine":18.4,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Hormonal Factors"},{"id":"16","kind":"text","chars":84,"max":84,"perLine":16.8,"lines":5,"caps":false,"sz":14.0,"paras":1,"text":"Chronic stress, poor diet, and lack of exercise may contribute to disease flare-ups."},{"id":"17","kind":"label","chars":18,"max":18,"perLine":18.4,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Lifestyle Elements"},{"id":"24","kind":"label","chars":8,"max":9,"perLine":9.3,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE"}],"photos":[{"id":"20","w":3159701,"h":3373873,"area":0.057},{"id":"22","w":7543948,"h":1647950,"area":0.066}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"4","kind":"label","chars":10,"max":13,"perLine":12.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us"},{"id":"5","kind":"title","chars":24,"max":24,"perLine":8.0,"lines":3,"caps":true,"sz":83.41,"paras":1,"text":"SYMPTOMS AND EARLY SIGNS"},{"id":"9","kind":"label","chars":25,"max":64,"perLine":63.5,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"Recognizing the Red Flags"},{"id":"15","kind":"text","chars":109,"max":109,"perLine":36.3,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Persistent tiredness is often one of the earliest and most common symptoms across many autoimmune conditions."},{"id":"16","kind":"label","chars":19,"max":36,"perLine":35.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Unexplained Fatigue"},{"id":"19","kind":"text","chars":97,"max":97,"perLine":32.3,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Swelling, stiffness, and discomfort can signal immune-related inflammation in the body's tissues."},{"id":"20","kind":"label","chars":20,"max":36,"perLine":35.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Joint or Muscle Pain"},{"id":"25","kind":"label","chars":8,"max":9,"perLine":9.3,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE"}],"photos":[{"id":"14","w":3548212,"h":3776537,"area":0.071},{"id":"18","w":3548212,"h":3776537,"area":0.071},{"id":"23","w":6813662,"h":3776537,"area":0.137}]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"4","kind":"label","chars":10,"max":13,"perLine":12.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us"},{"id":"5","kind":"title","chars":37,"max":37,"perLine":12.3,"lines":3,"caps":true,"sz":63.05,"paras":1,"text":"HOW AUTOIMMUNE DISEASES ARE DIAGNOSED"},{"id":"6","kind":"label","chars":30,"max":30,"perLine":7.5,"lines":4,"caps":false,"sz":21.99,"paras":1,"text":"Steps Toward a Clear Diagnosis"},{"id":"12","kind":"text","chars":75,"max":75,"perLine":37.5,"lines":2,"caps":false,"sz":14.0,"paras":1,"text":"Blood tests help identify specific autoantibodies and inflammation markers."},{"id":"13","kind":"label","chars":18,"max":51,"perLine":50.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Laboratory Testing"},{"id":"29","kind":"text","chars":75,"max":75,"perLine":37.5,"lines":2,"caps":false,"sz":14.0,"paras":1,"text":"A detailed review of symptoms and family history provides diagnostic clues."},{"id":"30","kind":"label","chars":15,"max":51,"perLine":50.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Patient History"},{"id":"31","kind":"text","chars":80,"max":80,"perLine":40.0,"lines":2,"caps":false,"sz":14.0,"paras":1,"text":"Visual and manual checks reveal joint swelling, rashes, or other external signs."},{"id":"32","kind":"label","chars":19,"max":51,"perLine":50.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Physical Evaluation"},{"id":"33","kind":"text","chars":75,"max":75,"perLine":37.5,"lines":2,"caps":false,"sz":14.0,"paras":1,"text":"Ultrasound, X-rays, and MRI help detect hidden damage to organs or tissues."},{"id":"34","kind":"label","chars":13,"max":51,"perLine":50.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Imaging Tools"},{"id":"39","kind":"label","chars":8,"max":9,"perLine":9.3,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE"}],"photos":[{"id":"37","w":4565453,"h":4095083,"area":0.099}]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"4","kind":"label","chars":10,"max":13,"perLine":12.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us"},{"id":"5","kind":"title","chars":20,"max":20,"perLine":10.0,"lines":2,"caps":true,"sz":92.4,"paras":1,"text":"TREATMENT APPROACHES"},{"id":"6","kind":"label","chars":25,"max":25,"perLine":12.5,"lines":2,"caps":false,"sz":21.99,"paras":1,"text":"Controlling the Condition"},{"id":"7","kind":"text","chars":79,"max":79,"perLine":26.3,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Medications are used to suppress the immune system and prevent further attacks."},{"id":"8","kind":"label","chars":24,"max":32,"perLine":32.4,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Immune System Moderation"},{"id":"9","kind":"text","chars":74,"max":74,"perLine":24.7,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Anti-inflammatory drugs reduce swelling and relieve pain during flare-ups."},{"id":"10","kind":"label","chars":23,"max":32,"perLine":32.4,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Inflammation Management"},{"id":"11","kind":"text","chars":89,"max":89,"perLine":29.7,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Stress reduction, proper nutrition, and regular exercise support overall disease control."},{"id":"12","kind":"label","chars":27,"max":32,"perLine":32.4,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Daily Lifestyle Adjustments"},{"id":"20","kind":"label","chars":8,"max":9,"perLine":9.3,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE"}],"photos":[{"id":"18","w":5916796,"h":5936987,"area":0.187}]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"12","kind":"label","chars":10,"max":13,"perLine":12.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us"},{"id":"13","kind":"text","chars":294,"max":294,"perLine":36.8,"lines":8,"caps":false,"sz":14.0,"paras":1,"text":"Living with an autoimmune disease requires ongoing care, adaptability, and a proactive mindset. Through consistent treatment, lifestyle adjustments, and emotional support, many patients maintain stability and achieve a good quality of life despite the daily challenges posed by their condition."},{"id":"14","kind":"title","chars":33,"max":33,"perLine":11.0,"lines":3,"caps":true,"sz":74.3,"paras":1,"text":"LIVING WITH AN AUTOIMMUNE DISEASE"},{"id":"15","kind":"label","chars":38,"max":38,"perLine":19.0,"lines":2,"caps":false,"sz":21.99,"paras":1,"text":"Managing Life with a Chronic Condition"},{"id":"17","kind":"label","chars":8,"max":9,"perLine":9.3,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE"}],"photos":[{"id":"9","w":5916796,"h":7535535,"area":0.237}]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"4","kind":"label","chars":10,"max":13,"perLine":12.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us"},{"id":"8","kind":"text","chars":282,"max":282,"perLine":56.4,"lines":5,"caps":false,"sz":14.0,"paras":1,"text":"Women experience autoimmune diseases at significantly higher rates, often developing symptoms during their reproductive years. Researchers link this to hormonal influences and genetic susceptibility. Diagnosis may be delayed due to symptom overlap with other female health concerns."},{"id":"9","kind":"title","chars":27,"max":27,"perLine":9.0,"lines":3,"caps":true,"sz":67.16,"paras":1,"text":"AUTOIMMUNE DISEASE IN WOMEN"},{"id":"10","kind":"label","chars":27,"max":41,"perLine":41.2,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"Why Women Are More Affected"},{"id":"11","kind":"text","chars":158,"max":158,"perLine":52.7,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Understanding this gender-specific pattern allows for more accurate diagnosis, timely treatment, and better patient outcomes through targeted medical support."},{"id":"18","kind":"label","chars":8,"max":9,"perLine":9.3,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE"}],"photos":[{"id":"13","w":5758955,"h":2797105,"area":0.086},{"id":"15","w":7363675,"h":3539940,"area":0.139}]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"4","kind":"label","chars":10,"max":13,"perLine":12.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us"},{"id":"5","kind":"title","chars":33,"max":33,"perLine":11.0,"lines":3,"caps":true,"sz":81.7,"paras":1,"text":"THE FUTURE OF AUTOIMMUNE RESEARCH"},{"id":"6","kind":"label","chars":37,"max":37,"perLine":12.3,"lines":3,"caps":false,"sz":21.99,"paras":1,"text":"Advancing Toward Better Understanding"},{"id":"13","kind":"text","chars":97,"max":97,"perLine":32.3,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Tailoring care based on individual immune profiles is becoming a key strategy in modern medicine."},{"id":"14","kind":"label","chars":23,"max":32,"perLine":32.4,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Personalized Approaches"},{"id":"22","kind":"text","chars":83,"max":83,"perLine":27.7,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"New drugs and therapies are being developed to specifically target immune pathways."},{"id":"23","kind":"label","chars":22,"max":32,"perLine":32.4,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Therapeutic Innovation"},{"id":"24","kind":"text","chars":86,"max":86,"perLine":28.7,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Research into gene markers offers hope for early detection and personalized treatment."},{"id":"25","kind":"label","chars":15,"max":32,"perLine":32.4,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Genetic Insight"},{"id":"32","kind":"label","chars":8,"max":9,"perLine":9.3,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE"}],"photos":[{"id":"16","w":3242651,"h":1790147,"area":0.031},{"id":"21","w":3242651,"h":1790147,"area":0.031},{"id":"27","w":3242651,"h":1790147,"area":0.031},{"id":"30","w":7363675,"h":3919940,"area":0.153}]},{"n":11,"part":"ppt/slides/slide11.xml","role":"end","slots":[{"id":"4","kind":"text","chars":166,"max":166,"perLine":83.0,"lines":2,"caps":false,"sz":14.0,"paras":1,"text":"Autoimmune diseases demand awareness, resilience, and informed care—but with research and support, better lives are possible. Thank you for joining this presentation."},{"id":"14","kind":"label","chars":10,"max":13,"perLine":12.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us"},{"id":"15","kind":"title","chars":9,"max":9,"perLine":9.0,"lines":1,"caps":true,"sz":107.68,"paras":1,"text":"THANK YOU"},{"id":"16","kind":"label","chars":12,"max":18,"perLine":18.1,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"Get In Touch"},{"id":"17","kind":"label","chars":13,"max":35,"perLine":35.4,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"+123-456-7890"},{"id":"18","kind":"label","chars":23,"max":35,"perLine":35.4,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"www.reallygreatsite.com"},{"id":"19","kind":"label","chars":25,"max":35,"perLine":35.4,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"hello@reallygreatsite.com"},{"id":"20","kind":"label","chars":36,"max":35,"perLine":35.4,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"123 Anywhere St., Any City, ST 12345"},{"id":"26","kind":"label","chars":8,"max":9,"perLine":9.3,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE"}],"photos":[{"id":"22","w":7363675,"h":4924925,"area":0.193},{"id":"24","w":7363675,"h":1913881,"area":0.075}]}]}