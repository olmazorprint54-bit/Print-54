{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"3","kind":"title","chars":18,"max":22,"perLine":10.9,"lines":2,"caps":true,"sz":143.06,"paras":1,"text":"AUTOIMMUNE DISEASE","font":"Telegraf Bold","anchor":"t","box":[2808188,3993193,12671625,3153961],"lineH":1417193,"ins":0,"useW":1.0},{"id":"10","kind":"label","chars":8,"max":10,"perLine":10.2,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE","font":"Open Sauce Bold","anchor":"t","box":[8691045,433750,1118821,240665],"lineH":248920,"ins":0,"useW":0.845},{"id":"11","kind":"label","chars":10,"max":13,"perLine":12.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us","font":"Open Sauce","anchor":"t","box":[16140479,430910,1118821,240665],"lineH":248920,"ins":0,"useW":0.861}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"13","kind":"label","chars":10,"max":13,"perLine":12.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us","font":"Open Sauce","anchor":"t","box":[16140479,430910,1118821,240665],"lineH":248920,"ins":0,"useW":0.861},{"id":"14","kind":"text","chars":229,"max":229,"perLine":22.9,"lines":10,"caps":false,"sz":14.0,"paras":1,"text":"An autoimmune disease occurs when the immune system, which normally defends against harmful invaders, mistakenly attacks the body's own healthy cells, tissues, or organs. This malfunction leads to chronic inflammation and damage.","font":"Open Sauce","anchor":"t","box":[1816010,4499259,2220683,2095169],"lineH":213360,"ins":0},{"id":"15","kind":"title","chars":30,"max":30,"perLine":15.0,"lines":2,"caps":true,"sz":50.33,"paras":1,"text":"WHAT IS AN AUTOIMMUNE DISEASE?","font":"Telegraf Bold","anchor":"t","box":[1028700,8384040,7748104,1108171],"lineH":498602,"ins":0,"useW":0.613},{"id":"16","kind":"label","chars":29,"max":39,"perLine":39.1,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"A Defense System in Confusion","font":"Open Sauce","anchor":"t","box":[1816010,2553949,5322342,333375],"lineH":335153,"ins":0,"useW":0.803},{"id":"17","kind":"text","chars":196,"max":196,"perLine":21.8,"lines":9,"caps":false,"sz":14.0,"paras":1,"text":"These diseases vary in how and where they strike, some are organ-specific, while others affect entire systems, making their identification and treatment complex yet essential for long-term health.","font":"Open Sauce","anchor":"t","box":[5384381,4499259,2220683,1885652],"lineH":213360,"ins":0},{"id":"19","kind":"label","chars":8,"max":10,"perLine":10.2,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE","font":"Open Sauce Bold","anchor":"t","box":[8691045,433750,1118821,240665],"lineH":248920,"ins":0,"useW":0.845}],"photos":[{"id":"5","w":8272396,"h":7121358,"area":0.313}]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"4","kind":"title","chars":35,"max":35,"perLine":11.7,"lines":3,"caps":true,"sz":63.74,"paras":1,"text":"COMMON TYPES OF AUTOIMMUNE DISEASES","font":"Telegraf Bold","anchor":"t","box":[1028700,2461748,8307515,2043519],"lineH":631444,"ins":0,"useW":0.997},{"id":"11","kind":"label","chars":10,"max":13,"perLine":12.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us","font":"Open Sauce","anchor":"t","box":[16140479,430910,1118821,240665],"lineH":248920,"ins":0,"useW":0.861},{"id":"12","kind":"text","chars":315,"max":315,"perLine":78.8,"lines":4,"caps":false,"sz":14.0,"paras":1,"text":"Autoimmune diseases include over 80 known conditions. Common examples are those affecting joints, the nervous system, skin, or endocrine glands. Though their targets differ, each is rooted in the immune system's failure to distinguish between self and threat, resulting in persistent inflammation and tissue damage.","font":"Open Sauce","anchor":"t","box":[10034534,7804043,6665355,838068],"lineH":213360,"ins":0},{"id":"13","kind":"label","chars":35,"max":58,"perLine":58.2,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"A Broad Range of Chronic Conditions","font":"Open Sauce","anchor":"t","box":[9336215,3072804,7923085,333375],"lineH":335153,"ins":0,"useW":0.635},{"id":"17","kind":"label","chars":8,"max":10,"perLine":10.2,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE","font":"Open Sauce Bold","anchor":"t","box":[8691045,433750,1118821,240665],"lineH":248920,"ins":0,"useW":0.845}],"photos":[{"id":"15","w":7363675,"h":5342083,"area":0.209}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"4","kind":"label","chars":10,"max":13,"perLine":12.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us","font":"Open Sauce","anchor":"t","box":[16140479,430910,1118821,240665],"lineH":248920,"ins":0,"useW":0.861},{"id":"8","kind":"text","chars":87,"max":87,"perLine":17.4,"lines":5,"caps":false,"sz":14.0,"paras":1,"text":"A family history of autoimmune disease increases risk due to inherited immune patterns.","font":"Open Sauce","anchor":"t","box":[1541412,7348333,1834701,1047585],"lineH":213360,"ins":0},{"id":"9","kind":"title","chars":23,"max":23,"perLine":11.5,"lines":2,"caps":true,"sz":85.87,"paras":1,"text":"CAUSES AND RISK FACTORS","font":"Telegraf Bold","anchor":"t","box":[9895625,2255241,8392375,1883616],"lineH":850519,"ins":0,"useW":0.872},{"id":"10","kind":"label","chars":13,"max":20,"perLine":20.5,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Genetic Links","font":"Open Sauce Bold Italics","anchor":"t","box":[1541412,6713555,1834701,209517],"lineH":213360,"ins":0,"useW":0.663},{"id":"11","kind":"label","chars":35,"max":65,"perLine":65.1,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"Triggers Behind the Immune Response","font":"Open Sauce","anchor":"t","box":[1028700,5089172,8866925,333375],"lineH":335153,"ins":0,"useW":0.593},{"id":"12","kind":"text","chars":92,"max":92,"perLine":18.4,"lines":5,"caps":false,"sz":14.0,"paras":1,"text":"Toxins, pollutants, or infections may trigger immune malfunction in susceptible individuals.","font":"Open Sauce","anchor":"t","box":[4139680,7348333,1834701,1047585],"lineH":213360,"ins":0},{"id":"13","kind":"label","chars":22,"max":22,"perLine":11.0,"lines":2,"caps":false,"sz":14.0,"paras":1,"text":"Environmental Exposure","font":"Open Sauce Bold Italics","anchor":"t","box":[4139680,6713555,1834701,419034],"lineH":213360,"ins":0,"useW":0.689},{"id":"14","kind":"text","chars":87,"max":87,"perLine":17.4,"lines":5,"caps":false,"sz":14.0,"paras":1,"text":"Hormonal changes, especially in women, may influence immune behavior and disease onset.","font":"Open Sauce","anchor":"t","box":[6737947,7348333,1834701,1047585],"lineH":213360,"ins":0},{"id":"15","kind":"label","chars":16,"max":20,"perLine":20.5,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Hormonal Factors","font":"Open Sauce Bold Italics","anchor":"t","box":[6737947,6713555,1834701,209517],"lineH":213360,"ins":0,"useW":0.864},{"id":"16","kind":"text","chars":84,"max":84,"perLine":16.8,"lines":5,"caps":false,"sz":14.0,"paras":1,"text":"Chronic stress, poor diet, and lack of exercise may contribute to disease flare-ups.","font":"Open Sauce","anchor":"t","box":[9336215,7348333,1834701,1047585],"lineH":213360,"ins":0},{"id":"17","kind":"label","chars":18,"max":20,"perLine":20.5,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Lifestyle Elements","font":"Open Sauce Bold Italics","anchor":"t","box":[9336215,6713555,1834701,209517],"lineH":213360,"ins":0,"useW":0.894},{"id":"24","kind":"label","chars":8,"max":10,"perLine":10.2,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE","font":"Open Sauce Bold","anchor":"t","box":[8691045,433750,1118821,240665],"lineH":248920,"ins":0,"useW":0.845}],"photos":[{"id":"20","w":3159701,"h":3373873,"area":0.057},{"id":"22","w":7543948,"h":1647950,"area":0.066}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"4","kind":"label","chars":10,"max":13,"perLine":12.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us","font":"Open Sauce","anchor":"t","box":[16140479,430910,1118821,240665],"lineH":248920,"ins":0,"useW":0.861},{"id":"5","kind":"title","chars":24,"max":24,"perLine":8.0,"lines":3,"caps":true,"sz":83.41,"paras":1,"text":"SYMPTOMS AND EARLY SIGNS","font":"Telegraf Bold","anchor":"t","box":[11555061,6816878,6732939,2672679],"lineH":826262,"ins":0,"useW":0.95},{"id":"9","kind":"label","chars":25,"max":65,"perLine":65.1,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"Recognizing the Red Flags","font":"Open Sauce","anchor":"t","box":[1028700,2208821,8866925,333375],"lineH":335153,"ins":0,"useW":0.408},{"id":"15","kind":"text","chars":109,"max":109,"perLine":36.3,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Persistent tiredness is often one of the earliest and most common symptoms across many autoimmune conditions.","font":"Open Sauce","anchor":"t","box":[1619231,8012674,3548212,628551],"lineH":213360,"ins":0},{"id":"16","kind":"label","chars":19,"max":40,"perLine":39.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Unexplained Fatigue","font":"Open Sauce Bold Italics","anchor":"t","box":[1619231,7678173,3548212,209517],"lineH":213360,"ins":0,"useW":0.513},{"id":"19","kind":"text","chars":97,"max":97,"perLine":32.3,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Swelling, stiffness, and discomfort can signal immune-related inflammation in the body's tissues.","font":"Open Sauce","anchor":"t","box":[5756882,8012674,3548212,628551],"lineH":213360,"ins":0},{"id":"20","kind":"label","chars":20,"max":40,"perLine":39.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Joint or Muscle Pain","font":"Open Sauce Bold Italics","anchor":"t","box":[5756882,7678173,3548212,209517],"lineH":213360,"ins":0,"useW":0.499},{"id":"25","kind":"label","chars":8,"max":10,"perLine":10.2,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE","font":"Open Sauce Bold","anchor":"t","box":[8691045,433750,1118821,240665],"lineH":248920,"ins":0,"useW":0.845}],"photos":[{"id":"14","w":3548212,"h":3776537,"area":0.071},{"id":"18","w":3548212,"h":3776537,"area":0.071},{"id":"23","w":6813662,"h":3776537,"area":0.137}]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"4","kind":"label","chars":10,"max":13,"perLine":12.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us","font":"Open Sauce","anchor":"t","box":[16140479,430910,1118821,240665],"lineH":248920,"ins":0,"useW":0.861},{"id":"5","kind":"title","chars":37,"max":37,"perLine":12.3,"lines":3,"caps":true,"sz":63.05,"paras":1,"text":"HOW AUTOIMMUNE DISEASES ARE DIAGNOSED","font":"Telegraf Bold","anchor":"t","box":[1028700,7477711,8866925,2028738],"lineH":624586,"ins":0,"useW":0.927},{"id":"6","kind":"label","chars":30,"max":30,"perLine":7.5,"lines":4,"caps":false,"sz":21.99,"paras":1,"text":"Steps Toward a Clear Diagnosis","font":"Open Sauce","anchor":"t","box":[7099103,2151232,1293272,1333500],"lineH":335153,"ins":0,"useW":1.0},{"id":"12","kind":"text","chars":75,"max":75,"perLine":37.5,"lines":2,"caps":false,"sz":14.0,"paras":1,"text":"Blood tests help identify specific autoantibodies and inflammation markers.","font":"Open Sauce","anchor":"t","box":[12193490,2910592,5065810,419034],"lineH":213360,"ins":0},{"id":"13","kind":"label","chars":18,"max":57,"perLine":56.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Laboratory Testing","font":"Open Sauce Bold Italics","anchor":"t","box":[12193490,2576092,5065810,209517],"lineH":213360,"ins":0,"useW":0.33},{"id":"29","kind":"text","chars":75,"max":75,"perLine":37.5,"lines":2,"caps":false,"sz":14.0,"paras":1,"text":"A detailed review of symptoms and family history provides diagnostic clues.","font":"Open Sauce","anchor":"t","box":[12193490,4747948,5065810,419034],"lineH":213360,"ins":0},{"id":"30","kind":"label","chars":15,"max":57,"perLine":56.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Patient History","font":"Open Sauce Bold Italics","anchor":"t","box":[12193490,4413448,5065810,209517],"lineH":213360,"ins":0,"useW":0.259},{"id":"31","kind":"text","chars":80,"max":80,"perLine":40.0,"lines":2,"caps":false,"sz":14.0,"paras":1,"text":"Visual and manual checks reveal joint swelling, rashes, or other external signs.","font":"Open Sauce","anchor":"t","box":[12193490,6580816,5065810,419034],"lineH":213360,"ins":0},{"id":"32","kind":"label","chars":19,"max":57,"perLine":56.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Physical Evaluation","font":"Open Sauce Bold Italics","anchor":"t","box":[12193490,6246316,5065810,209517],"lineH":213360,"ins":0,"useW":0.338},{"id":"33","kind":"text","chars":75,"max":75,"perLine":37.5,"lines":2,"caps":false,"sz":14.0,"paras":1,"text":"Ultrasound, X-rays, and MRI help detect hidden damage to organs or tissues.","font":"Open Sauce","anchor":"t","box":[12193490,8421180,5065810,419034],"lineH":213360,"ins":0},{"id":"34","kind":"label","chars":13,"max":57,"perLine":56.6,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Imaging Tools","font":"Open Sauce Bold Italics","anchor":"t","box":[12193490,8086680,5065810,209517],"lineH":213360,"ins":0,"useW":0.246},{"id":"39","kind":"label","chars":8,"max":10,"perLine":10.2,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE","font":"Open Sauce Bold","anchor":"t","box":[8691045,433750,1118821,240665],"lineH":248920,"ins":0,"useW":0.845}],"photos":[{"id":"37","w":4565453,"h":4095083,"area":0.099}]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"4","kind":"label","chars":10,"max":13,"perLine":12.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us","font":"Open Sauce","anchor":"t","box":[16140479,430910,1118821,240665],"lineH":248920,"ins":0,"useW":0.861},{"id":"5","kind":"title","chars":20,"max":20,"perLine":10.0,"lines":2,"caps":true,"sz":92.4,"paras":1,"text":"TREATMENT APPROACHES","font":"Telegraf Bold","anchor":"t","box":[1028700,2190440,8866925,2047303],"lineH":915289,"ins":0,"useW":0.937},{"id":"6","kind":"label","chars":25,"max":25,"perLine":12.5,"lines":2,"caps":false,"sz":21.99,"paras":1,"text":"Controlling the Condition","font":"Open Sauce","anchor":"t","box":[1028700,6874629,3227061,666750],"lineH":335153,"ins":0,"useW":0.622},{"id":"7","kind":"text","chars":79,"max":79,"perLine":26.3,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Medications are used to suppress the immune system and prevent further attacks.","font":"Open Sauce","anchor":"t","box":[5165314,6912829,3227061,628551],"lineH":213360,"ins":0},{"id":"8","kind":"label","chars":24,"max":36,"perLine":36.0,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Immune System Moderation","font":"Open Sauce Bold Italics","anchor":"t","box":[5165314,6578328,3227061,209517],"lineH":213360,"ins":0,"useW":0.771},{"id":"9","kind":"text","chars":74,"max":74,"perLine":24.7,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Anti-inflammatory drugs reduce swelling and relieve pain during flare-ups.","font":"Open Sauce","anchor":"t","box":[1028700,8629749,3227061,628551],"lineH":213360,"ins":0},{"id":"10","kind":"label","chars":23,"max":36,"perLine":36.0,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Inflammation Management","font":"Open Sauce Bold Italics","anchor":"t","box":[1028700,8295249,3227061,209517],"lineH":213360,"ins":0,"useW":0.729},{"id":"11","kind":"text","chars":89,"max":89,"perLine":29.7,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Stress reduction, proper nutrition, and regular exercise support overall disease control.","font":"Open Sauce","anchor":"t","box":[5165314,8629749,3227061,628551],"lineH":213360,"ins":0},{"id":"12","kind":"label","chars":27,"max":36,"perLine":36.0,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Daily Lifestyle Adjustments","font":"Open Sauce Bold Italics","anchor":"t","box":[5165314,8295249,3227061,209517],"lineH":213360,"ins":0,"useW":0.748},{"id":"20","kind":"label","chars":8,"max":10,"perLine":10.2,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE","font":"Open Sauce Bold","anchor":"t","box":[8691045,433750,1118821,240665],"lineH":248920,"ins":0,"useW":0.845}],"photos":[{"id":"18","w":5916796,"h":5936987,"area":0.187}]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"12","kind":"label","chars":10,"max":13,"perLine":12.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us","font":"Open Sauce","anchor":"t","box":[16140479,430910,1118821,240665],"lineH":248920,"ins":0,"useW":0.861},{"id":"13","kind":"text","chars":294,"max":294,"perLine":36.8,"lines":8,"caps":false,"sz":14.0,"paras":1,"text":"Living with an autoimmune disease requires ongoing care, adaptability, and a proactive mindset. Through consistent treatment, lifestyle adjustments, and emotional support, many patients maintain stability and achieve a good quality of life despite the daily challenges posed by their condition.","font":"Open Sauce","anchor":"t","box":[13747071,7582165,3512229,1676135],"lineH":213360,"ins":0},{"id":"14","kind":"title","chars":33,"max":33,"perLine":11.0,"lines":3,"caps":true,"sz":74.3,"paras":1,"text":"LIVING WITH AN AUTOIMMUNE DISEASE","font":"Telegraf Bold","anchor":"t","box":[9895625,2261114,8392375,2373630],"lineH":735965,"ins":0,"useW":0.993},{"id":"15","kind":"label","chars":38,"max":38,"perLine":19.0,"lines":2,"caps":false,"sz":21.99,"paras":1,"text":"Managing Life with a Chronic Condition","font":"Open Sauce","anchor":"t","box":[13747071,6412196,3512229,666750],"lineH":335153,"ins":0,"useW":0.786},{"id":"17","kind":"label","chars":8,"max":10,"perLine":10.2,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE","font":"Open Sauce Bold","anchor":"t","box":[8691045,433750,1118821,240665],"lineH":248920,"ins":0,"useW":0.845}],"photos":[{"id":"9","w":5916796,"h":7535535,"area":0.237}]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"4","kind":"label","chars":10,"max":13,"perLine":12.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us","font":"Open Sauce","anchor":"t","box":[16140479,430910,1118821,240665],"lineH":248920,"ins":0,"useW":0.861},{"id":"8","kind":"text","chars":282,"max":282,"perLine":56.4,"lines":5,"caps":false,"sz":14.0,"paras":1,"text":"Women experience autoimmune diseases at significantly higher rates, often developing symptoms during their reproductive years. Researchers link this to hormonal influences and genetic susceptibility. Diagnosis may be delayed due to symptom overlap with other female health concerns.","font":"Open Sauce","anchor":"t","box":[1831060,3563379,5758955,1047585],"lineH":213360,"ins":0},{"id":"9","kind":"title","chars":27,"max":27,"perLine":9.0,"lines":3,"caps":true,"sz":67.16,"paras":1,"text":"AUTOIMMUNE DISEASE IN WOMEN","font":"Telegraf Bold","anchor":"t","box":[11576567,7346027,6711433,2143531],"lineH":665226,"ins":0,"useW":0.944},{"id":"10","kind":"label","chars":27,"max":42,"perLine":42.3,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"Why Women Are More Affected","font":"Open Sauce","anchor":"t","box":[1831060,2877579,5758955,333375],"lineH":335153,"ins":0,"useW":0.756},{"id":"11","kind":"text","chars":158,"max":158,"perLine":52.7,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Understanding this gender-specific pattern allows for more accurate diagnosis, timely treatment, and better patient outcomes through targeted medical support.","font":"Open Sauce","anchor":"t","box":[1831060,4753872,5758955,628551],"lineH":213360,"ins":0},{"id":"18","kind":"label","chars":8,"max":10,"perLine":10.2,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE","font":"Open Sauce Bold","anchor":"t","box":[8691045,433750,1118821,240665],"lineH":248920,"ins":0,"useW":0.845}],"photos":[{"id":"13","w":5758955,"h":2797105,"area":0.086},{"id":"15","w":7363675,"h":3539940,"area":0.139}]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"4","kind":"label","chars":10,"max":13,"perLine":12.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us","font":"Open Sauce","anchor":"t","box":[16140479,430910,1118821,240665],"lineH":248920,"ins":0,"useW":0.861},{"id":"5","kind":"title","chars":33,"max":33,"perLine":11.0,"lines":3,"caps":true,"sz":81.7,"paras":1,"text":"THE FUTURE OF AUTOIMMUNE RESEARCH","font":"Telegraf Bold","anchor":"t","box":[1028700,6913266,8847875,2603554],"lineH":809371,"ins":0,"useW":0.93},{"id":"6","kind":"label","chars":37,"max":37,"perLine":12.3,"lines":3,"caps":false,"sz":21.99,"paras":1,"text":"Advancing Toward Better Understanding","font":"Open Sauce","anchor":"t","box":[9895625,1948817,2152766,1000125],"lineH":335153,"ins":0,"useW":0.917},{"id":"13","kind":"text","chars":97,"max":97,"perLine":32.3,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Tailoring care based on individual immune profiles is becoming a key strategy in modern medicine.","font":"Open Sauce","anchor":"t","box":[10342607,8216201,3227061,628551],"lineH":213360,"ins":0},{"id":"14","kind":"label","chars":23,"max":36,"perLine":36.0,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Personalized Approaches","font":"Open Sauce Bold Italics","anchor":"t","box":[10342607,7881701,3227061,209517],"lineH":213360,"ins":0,"useW":0.709},{"id":"22","kind":"text","chars":83,"max":83,"perLine":27.7,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"New drugs and therapies are being developed to specifically target immune pathways.","font":"Open Sauce","anchor":"t","box":[13585258,6203258,3227061,628551],"lineH":213360,"ins":0},{"id":"23","kind":"label","chars":22,"max":36,"perLine":36.0,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Therapeutic Innovation","font":"Open Sauce Bold Italics","anchor":"t","box":[13585258,5868757,3227061,209517],"lineH":213360,"ins":0,"useW":0.632},{"id":"24","kind":"text","chars":86,"max":86,"perLine":28.7,"lines":3,"caps":false,"sz":14.0,"paras":1,"text":"Research into gene markers offers hope for early detection and personalized treatment.","font":"Open Sauce","anchor":"t","box":[10350402,4194035,3227061,628551],"lineH":213360,"ins":0},{"id":"25","kind":"label","chars":15,"max":36,"perLine":36.0,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Genetic Insight","font":"Open Sauce Bold Italics","anchor":"t","box":[10350402,3859535,3227061,209517],"lineH":213360,"ins":0,"useW":0.419},{"id":"32","kind":"label","chars":8,"max":10,"perLine":10.2,"lines":1,"caps":true,"sz":14.0,"paras":1,"text":"BORCELLE","font":"Open Sauce Bold","anchor":"t","box":[8691045,433750,1118821,240665],"lineH":248920,"ins":0,"useW":0.845}],"photos":[{"id":"16","w":3242651,"h":1790147,"area":0.031},{"id":"21","w":3242651,"h":1790147,"area":0.031},{"id":"27","w":3242651,"h":1790147,"area":0.031},{"id":"30","w":7363675,"h":3919940,"area":0.153}]},{"n":11,"part":"ppt/slides/slide11.xml","role":"end","slots":[{"id":"4","kind":"text","chars":166,"max":166,"perLine":83.0,"lines":2,"caps":false,"sz":14.0,"paras":1,"text":"Autoimmune diseases demand awareness, resilience, and informed care—but with research and support, better lives are possible. Thank you for joining this presentation.","font":"Open Sauce","anchor":"t","box":[1038509,5128295,7353866,419034],"lineH":213360,"ins":0},{"id":"14","kind":"label","chars":10,"max":13,"perLine":12.9,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"Contact Us","font":"Open Sauce","anchor":"t","box":[16140479,430910,1118821,240665],"lineH":248920,"ins":0,"useW":0.861},{"id":"15","kind":"title","chars":9,"max":10,"perLine":9.6,"lines":1,"caps":true,"sz":107.68,"paras":1,"text":"THANK YOU","font":"Telegraf Bold","anchor":"t","box":[9895625,8374138,8392375,1311602],"lineH":1066673,"ins":0,"useW":0.987},{"id":"16","kind":"label","chars":12,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"Get In Touch","font":"Open Sauce","anchor":"t","box":[1038509,4552180,2531866,333375],"lineH":335153,"ins":0,"useW":0.687},{"id":"17","kind":"label","chars":13,"max":36,"perLine":36.3,"lines":1,"caps":false,"sz":14.0,"paras":1,"text":"+123-456-7890","font":"Open Sauce","anchor":"t","box":[4651013,6603113,3143933,209517],"lineH":213360,"ins":0,"u