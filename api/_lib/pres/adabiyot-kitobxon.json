{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"8","kind":"label","chars":42,"max":42,"perLine":21.0,"lines":2,"caps":false,"sz":35.53,"paras":1,"text":"Discover How Books Can Transform Your Life","font":"TT Interphases","anchor":"t","box":[6374628,6192773,5538744,1071745],"lineH":541528,"ins":0},{"id":"9","kind":"title","chars":20,"max":20,"perLine":10.0,"lines":2,"caps":false,"sz":108.56,"paras":1,"text":"The Power of Reading","font":"Portland Bold","anchor":"t","box":[5052390,2749317,8183220,2928660],"lineH":1433957,"ins":0}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"6","kind":"title","chars":19,"max":32,"perLine":10.7,"lines":3,"caps":false,"sz":72.17,"paras":1,"text":"Why Reading Matters","font":"Portland Bold","anchor":"t","box":[2400240,2380577,5440140,2927960],"lineH":953262,"ins":0},{"id":"7","kind":"text","chars":212,"max":212,"perLine":42.4,"lines":5,"caps":false,"sz":24.69,"paras":1,"text":"Reading is more than just a hobby. It's a gateway to knowledge, imagination, empathy, and personal growth. In this presentation, we’ll explore why reading is a powerful tool for lifelong learning and development.","font":"TT Interphases","anchor":"t","box":[8353441,6751237,6495000,1847760],"lineH":376301,"ins":0}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"5","kind":"title","chars":20,"max":20,"perLine":10.0,"lines":2,"caps":false,"sz":72.17,"paras":1,"text":"Stimulates the Brain","font":"Portland Bold","anchor":"t","box":[2605846,2062791,5440140,1965935],"lineH":953262,"ins":0},{"id":"6","kind":"text","chars":141,"max":141,"perLine":35.2,"lines":4,"caps":false,"sz":24.69,"paras":1,"text":"Reading keeps your brain active and engaged. It improves memory, focus, and cognitive function—reducing the risk of mental decline as we age.","font":"TT Interphases","anchor":"t","box":[9448205,6685505,6495000,1485900],"lineH":376301,"ins":0}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"6","kind":"title","chars":26,"max":26,"perLine":13.0,"lines":2,"caps":false,"sz":72.17,"paras":1,"text":"Expands Your Understanding","font":"Portland Bold","anchor":"t","box":[6703882,2802281,7001286,1965935],"lineH":953262,"ins":0},{"id":"7","kind":"text","chars":154,"max":154,"perLine":38.5,"lines":4,"caps":false,"sz":24.69,"paras":1,"text":"Books are packed with information. Whether it's fiction or non-fiction, each page contributes to your understanding of the world and diverse perspectives.","font":"TT Interphases","anchor":"t","box":[6703882,5485888,6495000,1485900],"lineH":376301,"ins":0}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"7","kind":"title","chars":24,"max":24,"perLine":8.0,"lines":3,"caps":false,"sz":72.17,"paras":1,"text":"Improves Language Skills","font":"Portland Bold","anchor":"t","box":[2400240,2380577,5440140,2927960],"lineH":953262,"ins":0},{"id":"8","kind":"text","chars":148,"max":148,"perLine":37.0,"lines":4,"caps":false,"sz":24.69,"paras":1,"text":"Regular reading enhances vocabulary, grammar, and writing ability. This directly improves how we communicate in both personal and professional life.","font":"TT Interphases","anchor":"t","box":[8353441,6751237,6495000,1478208],"lineH":376301,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"6","kind":"title","chars":20,"max":20,"perLine":10.0,"lines":2,"caps":false,"sz":72.17,"paras":1,"text":"A Form of Relaxation","font":"Portland Bold","anchor":"t","box":[2605846,2062791,5440140,1965935],"lineH":953262,"ins":0},{"id":"7","kind":"text","chars":140,"max":140,"perLine":46.7,"lines":3,"caps":false,"sz":24.69,"paras":1,"text":"Reading is a great way to escape daily stress. Immersing in a story calms the mind and helps reduce anxiety, even if just for a few minutes.","font":"TT Interphases","anchor":"t","box":[9448205,6685505,6495000,1114425],"lineH":376301,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"7","kind":"title","chars":18,"max":28,"perLine":13.8,"lines":2,"caps":false,"sz":72.17,"paras":1,"text":"Ignites Creativity","font":"Portland Bold","anchor":"t","box":[6703882,2802281,7001286,1965935],"lineH":953262,"ins":0},{"id":"8","kind":"text","chars":128,"max":128,"perLine":42.7,"lines":3,"caps":false,"sz":24.69,"paras":1,"text":"Fictional stories and descriptive writing open doors to new worlds. Reading fuels creativity and helps us think outside the box.","font":"TT Interphases","anchor":"t","box":[6703882,5258532,6495000,1114425],"lineH":376301,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"7","kind":"title","chars":24,"max":24,"perLine":8.0,"lines":3,"caps":false,"sz":63.34,"paras":1,"text":"Understand Others Better","font":"Portland Bold","anchor":"t","box":[2067284,2429815,4770124,2566274],"lineH":836549,"ins":0},{"id":"8","kind":"text","chars":151,"max":151,"perLine":37.8,"lines":4,"caps":false,"sz":24.69,"paras":1,"text":"Books allow us to walk in someone else's shoes. This enhances our ability to empathize and connect with people from different backgrounds and cultures.","font":"TT Interphases","anchor":"t","box":[8353441,6751237,6495000,1478208],"lineH":376301,"ins":0}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"6","kind":"title","chars":27,"max":27,"perLine":9.0,"lines":3,"caps":false,"sz":72.17,"paras":1,"text":"The Habit That Keeps Giving","font":"Portland Bold","anchor":"t","box":[2605846,2062791,5440140,2927960],"lineH":953262,"ins":0},{"id":"7","kind":"text","chars":148,"max":148,"perLine":37.0,"lines":4,"caps":false,"sz":24.69,"paras":1,"text":"Reading supports continuous growth. From self-help to science, every genre offers opportunities to learn and improve ourselves at any stage of life.","font":"TT Interphases","anchor":"t","box":[9448205,6685505,6495000,1485900],"lineH":376301,"ins":0}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"7","kind":"title","chars":19,"max":28,"perLine":13.8,"lines":2,"caps":false,"sz":72.17,"paras":1,"text":"Start Reading Today","font":"Portland Bold","anchor":"t","box":[6703882,2802281,7001286,1965935],"lineH":953262,"ins":0},{"id":"8","kind":"text","chars":127,"max":127,"perLine":42.3,"lines":3,"caps":false,"sz":24.69,"paras":1,"text":"Books have the power to change lives. Make reading a part of your daily routine and experience the lifelong benefits it brings.","font":"TT Interphases","anchor":"t","box":[6703882,5485888,6495000,1114258],"lineH":376301,"ins":0}],"photos":[]}]}