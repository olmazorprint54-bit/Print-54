{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"2","kind":"title","chars":79,"max":79,"perLine":13.2,"lines":6,"caps":false,"sz":60.0,"paras":1,"text":"Tuproq va suv ifloslanishida ion bog'lanishli birikmalarni aniqlash va tozalash","font":"Times New Roman","anchor":"t","box":[3683000,1905000,10922000,5080000],"lineH":914400,"ins":0,"useW":0.935,"base":6.965,"tail":0.216,"below":[{"id":"9","gap":7.5,"cap":0.201}]},{"id":"9","kind":"label","chars":17,"max":29,"perLine":29.0,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Sandiboyev Sardor","font":"Times New Roman","anchor":"t","box":[6096000,7620000,6096000,787400],"lineH":609600,"ins":0,"useW":0.636}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"4","kind":"title","chars":29,"max":68,"perLine":34.2,"lines":2,"caps":false,"sz":48.0,"paras":1,"text":"Ion bog'lanish va ifloslanish","font":"Times New Roman","anchor":"t","box":[1524000,1828800,8636000,1524000],"lineH":731520,"ins":0,"useW":0.795,"base":2.165,"tail":0.216,"below":[{"id":"5","gap":2.833,"cap":0.189}]},{"id":"5","kind":"text","chars":335,"max":335,"perLine":25.8,"lines":13,"caps":false,"sz":30.0,"paras":3,"text":"Ion bog'lanish – elektromanfiyligi keskin farq qiladigan (Δχ > 1,7) metall va metallmas atomlari orasida elektron to'liq o'tishi natijasida hosil bo'ladi.\nIonli birikmalar: NaCl, CaSO₄, Pb(NO₃)₂, CdCl₂ – kristall panjarali, ko'pi suvda yaxshi eriydi.\nSuvda dissotsiatsiyalanib, ionlar hosil qiladi va suv hamda tuproq tarkibini buzadi.","font":"Times New Roman","anchor":"t","box":[1524000,3555999,8509000,5842000],"lineH":457200,"ins":0},{"id":"7","kind":"label","chars":18,"max":87,"perLine":43.6,"lines":2,"caps":false,"sz":28.0,"paras":1,"text":"Ion hosil bo'lishi","font":"Times New Roman","anchor":"ctr","box":[10541000,3683000,6604000,812800],"lineH":426720,"ins":182880,"useW":0.37},{"id":"8","kind":"text","chars":93,"max":93,"perLine":10.3,"lines":9,"caps":false,"sz":30.0,"paras":5,"text":"Na → Na⁺ + e⁻\nCl + e⁻ → Cl⁻\nNa⁺ + Cl⁻ → NaCl\nNaCl → Na⁺ + Cl⁻ (suvda)\nPb(NO₃)₂ → Pb²⁺ + 2NO₃⁻","font":"Times New Roman","anchor":"t","box":[10820400,4699000,6045200,4114800],"lineH":457200,"ins":182880}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"4","kind":"title","chars":25,"max":56,"perLine":27.9,"lines":2,"caps":false,"sz":51.5,"paras":1,"text":"Suv ifloslanish manbalari","font":"Times New Roman","anchor":"t","box":[5515451,1816541,7554353,1561540],"lineH":784860,"ins":0,"useW":0.885,"base":2.165,"tail":0.216,"below":[{"id":"5","gap":2.854,"cap":0.164}]},{"id":"5","kind":"text","chars":171,"max":171,"perLine":28.5,"lines":6,"caps":false,"sz":28.0,"paras":1,"text":"Sanoat oqova suvlari: galvanik sexlar, tog'-kon va metallurgiya korxonalari og'ir metall ionlari (Pb²⁺, Cd²⁺, Cr³⁺, Cu²⁺) hamda sulfat va xlorid tuzlarini suvga tashlaydi.","font":"Times New Roman","anchor":"t","box":[10414000,3682999,6858000,2667000],"lineH":426720,"ins":0},{"id":"6","kind":"text","chars":159,"max":159,"perLine":26.5,"lines":6,"caps":false,"sz":28.0,"paras":1,"text":"Qishloq xo'jaligi: o'g'itlardan nitrat (NO₃⁻) va fosfat (PO₄³⁻) ionlari yuvilib, yer osti va ochiq suvlarni ifloslaydi; maishiy oqova suvlar ham ta'sir qiladi.","font":"Times New Roman","anchor":"t","box":[10414000,6540499,6858000,2667000],"lineH":426720,"ins":0},{"id":"7","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":85.03,"paras":1,"text":"1","font":"Times New Roman","anchor":"t","box":[8621243,4486801,1624130,1303804],"lineH":1295908,"ins":0},{"id":"8","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":85.03,"paras":1,"text":"2","font":"Times New Roman","anchor":"t","box":[8621243,7110513,1624130,1303804],"lineH":1295908,"ins":0}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"4","kind":"title","chars":30,"max":34,"perLine":15.0,"lines":2,"caps":false,"sz":48.0,"paras":1,"text":"Asosiy ifloslantiruvchi ionlar","font":"Times New Roman","anchor":"t","box":[5080000,1574800,8128000,1778000],"lineH":731520,"ins":0,"useW":0.879},{"id":"5","kind":"label","chars":9,"max":24,"perLine":24.1,"lines":1,"caps":false,"sz":32.0,"paras":1,"text":"Kationlar","font":"Times New Roman","anchor":"t","box":[3256859,3995303,4064000,635000],"lineH":487680,"ins":0,"useW":0.377},{"id":"6","kind":"label","chars":8,"max":24,"perLine":24.1,"lines":1,"caps":false,"sz":32.0,"paras":1,"text":"Anionlar","font":"Times New Roman","anchor":"t","box":[10765247,3929331,4064000,635000],"lineH":487680,"ins":0,"useW":0.355},{"id":"7","kind":"label","chars":14,"max":24,"perLine":24.1,"lines":1,"caps":false,"sz":32.0,"paras":1,"text":"Og'ir metallar","font":"Times New Roman","anchor":"t","box":[3256859,6829992,4064000,635000],"lineH":487680,"ins":0,"useW":0.553,"base":0.965,"tail":0.216,"below":[{"id":"11","gap":1.631,"cap":0.255}]},{"id":"8","kind":"label","chars":13,"max":24,"perLine":24.1,"lines":1,"caps":false,"sz":32.0,"paras":1,"text":"Biogen ionlar","font":"Times New Roman","anchor":"t","box":[10765247,6762235,4064000,635000],"lineH":487680,"ins":0,"useW":0.547},{"id":"9","kind":"text","chars":67,"max":67,"perLine":13.4,"lines":5,"caps":false,"sz":27.0,"paras":1,"text":"Na⁺, Ca²⁺, Mg²⁺, NH₄⁺ – suvning qattiqligi va sho'rligini oshiradi.","font":"Times New Roman","anchor":"t","box":[1778000,4698999,7112000,2032000],"lineH":411480,"ins":0},{"id":"10","kind":"text","chars":78,"max":78,"perLine":15.6,"lines":5,"caps":false,"sz":27.0,"paras":1,"text":"Cl⁻, SO₄²⁻, HCO₃⁻ – mineralizatsiyani oshirib, suvni ichishga yaroqsiz qiladi.","font":"Times New Roman","anchor":"t","box":[9398000,4698999,7112000,2032000],"lineH":411480,"ins":0},{"id":"11","kind":"text","chars":79,"max":79,"perLine":15.8,"lines":5,"caps":false,"sz":27.0,"paras":1,"text":"Pb²⁺, Cd²⁺, Hg²⁺, Cr(VI) – zaharli, organizmda to'planib kasalliklar keltiradi.","font":"Times New Roman","anchor":"t","box":[1778000,7492999,7112000,2032000],"lineH":411480,"ins":0},{"id":"12","kind":"text","chars":106,"max":106,"perLine":21.2,"lines":5,"caps":false,"sz":27.0,"paras":1,"text":"NO₃⁻ va PO₄³⁻ – suv havzalarida evtrofikatsiya, ya'ni suv o'tlarining haddan tashqari o'sishini chaqiradi.","font":"Times New Roman","anchor":"t","box":[9398000,7492999,7112000,2032000],"lineH":411480,"ins":0}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"4","kind":"text","chars":154,"max":154,"perLine":30.8,"lines":5,"caps":false,"sz":28.0,"paras":1,"text":"Ionlarni aniqlash sifat reaksiyalariga asoslanadi: reaksiyada cho'kma tushadi, rang o'zgaradi yoki gaz ajraladi. Ular oddiy laboratoriyada tez bajariladi.","font":"Times New Roman","anchor":"t","box":[1523999,2349499,7874000,2095500],"lineH":426720,"ins":0},{"id":"5","kind":"title","chars":18,"max":34,"perLine":30.7,"lines":1,"caps":false,"sz":44.0,"paras":1,"text":"Sifat reaksiyalari","font":"Times New Roman","anchor":"t","box":[1524000,1270000,7112000,889000],"lineH":670560,"ins":0,"useW":0.533},{"id":"6","kind":"text","chars":141,"max":141,"perLine":20.1,"lines":7,"caps":false,"sz":28.0,"paras":4,"text":"Cl⁻ + Ag⁺ → AgCl↓ (oq cho'kma)\nSO₄²⁻ + Ba²⁺ → BaSO₄↓ (oq cho'kma)\nPb²⁺ + 2I⁻ → PbI₂↓ (sariq cho'kma)\nFe³⁺ + 3SCN⁻ → Fe(SCN)₃ (qon-qizil rang)","font":"Times New Roman","anchor":"t","box":[9588499,6794499,7620000,2921000],"lineH":426720,"ins":0},{"id":"7","kind":"label","chars":8,"max":31,"perLine":30.7,"lines":1,"caps":false,"sz":44.0,"paras":1,"text":"Misollar","font":"Times New Roman","anchor":"t","box":[9588500,5969000,7112000,762000],"lineH":670560,"ins":0,"useW":0.266,"base":0.965,"tail":0.216,"below":[{"id":"6","gap":1.477,"cap":0.192}]}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"4","kind":"label","chars":8,"max":34,"perLine":33.5,"lines":1,"caps":false,"sz":36.0,"paras":1,"text":"Asboblar","font":"Times New Roman","anchor":"t","box":[5968999,7378699,6350000,635000],"lineH":548640,"ins":0,"useW":0.264,"base":0.965,"tail":0.216,"below":[{"id":"5","gap":1.472,"cap":0.218}]},{"id":"5","kind":"text","chars":131,"max":131,"perLine":43.7,"lines":3,"caps":false,"sz":26.0,"paras":1,"text":"Konduktometr suvning elektr o'tkazuvchanligini o'lchab, ionlar umumiy miqdorini baholaydi; pH-metr muhit kislotaliligini aniqlaydi.","font":"Times New Roman","anchor":"t","box":[2032000,8051800,14224000,1270000],"lineH":396240,"ins":0},{"id":"6","kind":"title","chars":17,"max":49,"perLine":24.7,"lines":2,"caps":false,"sz":60.0,"paras":1,"text":"Aniqlash usullari","font":"Times New Roman","anchor":"t","box":[5265481,1904615,7796245,1573089],"lineH":914400,"ins":0,"useW":0.67,"base":2.165,"tail":0.216,"below":[{"id":"7","gap":1.784,"cap":0.181},{"id":"9","gap":2.667,"cap":0.131}]},{"id":"7","kind":"label","chars":17,"max":34,"perLine":33.5,"lines":1,"caps":false,"sz":36.0,"paras":1,"text":"Fotokolorimetriya","font":"Times New Roman","anchor":"t","box":[5969000,3263899,6350000,635000],"lineH":548640,"ins":0,"useW":0.524,"base":0.965,"tail":0.216,"below":[{"id":"9","gap":1.472,"cap":0.218}]},{"id":"8","kind":"label","chars":14,"max":34,"perLine":33.5,"lines":1,"caps":false,"sz":36.0,"paras":1,"text":"Spektroskopiya","font":"Times New Roman","anchor":"t","box":[5968999,5333999,6350000,635000],"lineH":548640,"ins":0,"useW":0.448,"base":0.965,"tail":0.216,"below":[{"id":"10","gap":1.472,"cap":0.218}]},{"id":"9","kind":"text","chars":116,"max":116,"perLine":38.7,"lines":3,"caps":false,"sz":26.0,"paras":1,"text":"Fotokolorimetr eritma rangining intensivligi bo'yicha ion konsentratsiyasini aniqlaydi (masalan, Fe³⁺, NO₃⁻, PO₄³⁻).","font":"Times New Roman","anchor":"t","box":[2032000,3937000,14224000,1270000],"lineH":396240,"ins":0},{"id":"10","kind":"text","chars":113,"max":113,"perLine":37.7,"lines":3,"caps":false,"sz":26.0,"paras":1,"text":"Atom-absorbsion spektrometr og'ir metallarni (Pb, Cd, Hg) juda kam – mg/l ning ulushlari miqdorida ham aniqlaydi.","font":"Times New Roman","anchor":"t","box":[2032000,6007100,14224000,1270000],"lineH":396240,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"5","kind":"title","chars":20,"max":90,"perLine":22.5,"lines":4,"caps":false,"sz":60.0,"paras":1,"text":"Usullarni taqqoslash","font":"Times New Roman","anchor":"t","box":[4572000,1877085,7112000,3288023],"lineH":914400,"ins":0,"useW":0.877,"base":4.565,"tail":0.216,"below":[{"id":"6","gap":4.699,"cap":0.201},{"id":"7","gap":4.699,"cap":0.201}]},{"id":"6","kind":"label","chars":11,"max":22,"perLine":21.7,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Cho'ktirish","font":"Times New Roman","anchor":"t","box":[1376812,5457825,4572000,603698],"lineH":609600,"ins":0,"useW":0.49,"base":0.965,"tail":0.216,"below":[{"id":"9","gap":1.431,"cap":0.212}]},{"id":"7","kind":"label","chars":5,"max":22,"perLine":21.7,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Ionit","font":"Times New Roman","anchor":"t","box":[6839312,5457825,4572000,603698],"lineH":609600,"ins":0,"useW":0.21,"base":0.965,"tail":0.216,"below":[{"id":"10","gap":1.431,"cap":0.212}]},{"id":"8","kind":"label","chars":6,"max":22,"perLine":21.7,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Natija","font":"Times New Roman","anchor":"t","box":[12158936,5457825,4572000,603698],"lineH":609600,"ins":0,"useW":0.271,"base":0.965,"tail":0.216,"below":[{"id":"11","gap":1.431,"cap":0.212}]},{"id":"9","kind":"text","chars":94,"max":94,"perLine":11.8,"lines":8,"caps":false,"sz":28.0,"paras":1,"text":"Arzon, oddiy, katta hajmga mos; ammo ko'p loyqa cho'kma hosil bo'ladi va tozalash chuqur emas.","font":"Times New Roman","anchor":"t","box":[1371599,6184900,5080000,3302000],"lineH":426720,"ins":0},{"id":"10","kind":"text","chars":91,"max":91,"perLine":11.4,"lines":8,"caps":false,"sz":28.0,"paras":1,"text":"Yuqori tozalik beradi, ionlarni tanlab ushlaydi va qayta tiklanadi; uskuna va smola qimmat.","font":"Times New Roman","anchor":"t","box":[6845299,6184900,5080000,3302000],"lineH":426720,"ins":0},{"id":"11","kind":"text","chars":111,"max":111,"perLine":13.9,"lines":8,"caps":false,"sz":28.0,"paras":1,"text":"Eng yaxshi natija uchun ikki usul ketma-ket qo'llanadi: avval cho'ktirish, so'ng ionit orqali yakuniy tozalash.","font":"Times New Roman","anchor":"t","box":[12153899,6184900,5080000,3302000],"lineH":426720,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"2","kind":"text","chars":115,"max":115,"perLine":11.5,"lines":10,"caps":false,"sz":28.0,"paras":1,"text":"Chuqur tozalashni ta'minlaydi; ionit to'yingach kislota yoki ishqor bilan regeneratsiya qilinib, qayta ishlatiladi.","font":"Times New Roman","anchor":"t","box":[7289799,5080000,4572000,4114800],"lineH":426720,"ins":0},{"id":"7","kind":"title","chars":17,"max":34,"perLine":26.8,"lines":1,"caps":false,"sz":72.0,"paras":1,"text":"Tozalash usullari","font":"Times New Roman","anchor":"t","box":[2032000,1650999,10160000,1574800],"lineH":1097280,"ins":0,"useW":0.616},{"id":"8","kind":"label","chars":14,"max":23,"perLine":22.9,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Ion almashinuv","font":"Times New Roman","anchor":"t","box":[7289800,4051300,4826000,787400],"lineH":609600,"ins":0,"useW":0.652},{"id":"9","kind":"label","chars":11,"max":23,"perLine":22.9,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Cho'ktirish","font":"Times New Roman","anchor":"t","box":[2133600,4051300,4826000,787400],"lineH":609600,"ins":0,"useW":0.464},{"id":"10","kind":"text","chars":87,"max":87,"perLine":8.7,"lines":10,"caps":false,"sz":28.0,"paras":1,"text":"Katta hajmli oqava suvlarga mos va arzon; ionlar konsentratsiyasini keskin kamaytiradi.","font":"Times New Roman","anchor":"t","box":[2133599,5080000,4572000,4114800],"lineH":426720,"ins":0}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"4","kind":"title","chars":18,"max":55,"perLine":27.7,"lines":2,"caps":false,"sz":64.0,"paras":1,"text":"G'oyaning mohiyati","font":"Times New Roman","anchor":"t","box":[4473415,2531195,9347293,1573089],"lineH":975360,"ins":0,"useW":0.69,"base":2.165,"tail":0.216,"below":[{"id":"5","gap":2.09,"cap":0.189},{"id":"6","gap":2.09,"cap":0.189},{"id":"7","gap":2.135,"cap":0.189}]},{"id":"5","kind":"label","chars":8,"max":21,"perLine":20.5,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Nazariya","font":"Times New Roman","anchor":"t","box":[1701061,4229738,4318000,603698],"lineH":609600,"ins":0,"useW":0.422,"base":0.965,"tail":0.216,"below":[{"id":"8","gap":1.649,"cap":0.204}]},{"id":"6","kind":"label","chars":8,"max":21,"perLine":20.5,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Amaliyot","font":"Times New Roman","anchor":"t","box":[6988062,4229738,4318000,603698],"lineH":609600,"ins":0,"useW":0.445,"base":0.965,"tail":0.216,"below":[{"id":"9","gap":1.649,"cap":0.204}]},{"id":"7","kind":"label","chars":6,"max":21,"perLine":20.5,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Xulosa","font":"Times New Roman","anchor":"t","box":[12319687,4266200,4318000,603698],"lineH":609600,"ins":0,"useW":0.333,"base":0.965,"tail":0.216,"below":[{"id":"10","gap":1.577,"cap":0.204}]},{"id":"8","kind":"text","chars":118,"max":118,"perLine":11.8,"lines":10,"caps":false,"sz":27.0,"paras":1,"text":"Ionlarning kimyoviy xossalari ularni aniq reaksiyalar bilan aniqlash va cho'ktirish yoki almashtirish imkonini beradi.","font":"Times New Roman","anchor":"t","box":[1651000,5067299,4318000,4191000],"lineH":411480,"ins":0},{"id":"9","kind":"text","chars":115,"max":115,"perLine":11.5,"lines":10,"caps":false,"sz":27.0,"paras":1,"text":"Maktab laboratoriyasida AgNO₃, BaCl₂, KI va Ca(OH)₂ yordamida ionlarni aniqlash va cho'ktirishni ko'rsatish mumkin.","font":"Times New Roman","anchor":"t","box":[6921500,5067299,4318000,4191000],"lineH":411480,"ins":0},{"id":"10","kind":"text","chars":88,"max":88,"perLine":8.8,"lines":10,"caps":false,"sz":27.0,"paras":1,"text":"Aniqlash va tozalash birgalikda qo'llansa, suv va tuproq ifloslanishi samarali kamayadi.","font":"Times New Roman","anchor":"t","box":[12255500,5067299,4318000,4191000],"lineH":411480,"ins":0}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"4","kind":"text","chars":165,"max":165,"perLine":41.2,"lines":4,"caps":false,"sz":30.0,"paras":1,"text":"Ion bog'lanishli birikmalar suv va tuproqqa ion holida o'tadi. Ularni sifat reaksiyalari va asboblar bilan aniqlash tozalash usulini to'g'ri tanlashga yordam beradi.","font":"Times New Roman","anchor":"t","box":[2794000,4190999,12700000,1905000],"lineH":457200,"ins":0},{"id":"5","kind":"text","chars":151,"max":151,"perLine":37.8,"lines":4,"caps":false,"sz":30.0,"paras":1,"text":"Cho'ktirish va ion almashinuv usullari ketma-ket qo'llanganda eng yuqori natija beradi. Bu g'oya Orolbo'yi kabi sho'rlangan hududlarda ayniqsa foydali.","font":"Times New Roman","anchor":"t","box":[2794000,6349999,12700000,1905000],"lineH":457200,"ins":0},{"id":"6","kind":"title","chars":9,"max":34,"perLine":20.5,"lines":1,"caps":false,"sz":80.0,"paras":1,"text":"Xulosalar","font":"Times New Roman","anchor":"t","box":[4825999,2413000,8636000,1524000],"lineH":1219200,"ins":0,"useW":0.456,"base":0.965,"tail":0.216,"below":[{"id":"4","gap":1.75,"cap":0.113}]}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"end","slots":[{"id":"2","kind":"title","chars":26,"max":34,"perLine":8.7,"lines":3,"caps":false,"sz":110.0,"paras":1,"text":"E'tiboringiz uchun rahmat!","font":"Times New Roman","anchor":"t","box":[3187700,1498600,11899900,4318000],"lineH":1676400,"ins":0,"useW":0.865}],"photos":[]}]}