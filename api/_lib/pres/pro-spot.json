     "perLine": 44.5,
     "lines": 2,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Katta cho'qqi ham bitta qadamdan boshlanadi. Har kuni qo'rquvingizga bir oz yaqinlashing.",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      711200,
      2463800,
      4699000,
