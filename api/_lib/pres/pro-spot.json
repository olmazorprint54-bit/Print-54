     "perLine": 25,
     "lines": 4,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "Noma'lumlik va kutilmagan vaziyatlar\nMuvaffaqiyatsizlikdan qo'rqish\nBoshqalarning fikriga bog'liqlik",
     "font": "Segoe UI",
