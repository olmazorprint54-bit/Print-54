     "perLine": 35.3,
     "lines": 3,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Ko'pincha biz noma'lum narsadan qo'rqamiz: yangi joy, yangi odamlar, xato qilish yoki boshqalarning fikri.",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
