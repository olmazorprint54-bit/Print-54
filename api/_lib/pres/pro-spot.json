     "max": 74,
     "perLine": 18.5,
     "lines": 4,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "O'ziga ishonch ortadi\nYangi tajribalar ochiladi\nStress va xavotir kamayadi",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      6908800,
      3886200,
      4699000,
      1036181
     ],
