     "max": 89,
     "perLine": 44.5,
     "lines": 2,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Qo'rquvni yenggan inson o'ziga ishonadi va hayotida yangi imkoniyatlarni ko'ra boshlaydi.",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      6908800,
      2463800,
      4699000,
      520463
     ],
     "lineH": 243840,
     "ins": 0
    },
    {
