     "chars": 126,
     "max": 126,
     "perLine": 42,
     "lines": 3,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Qo'rquv — xavfga qarshi tabiiy himoya reaksiyasi. U bizni ehtiyotkor qiladi, lekin haddan oshsa, orzularimizga to'siq bo'ladi.",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      6908800,
      2463800,
      4699000,
      791307
     ],
     "lineH": 243840,
     "ins": 0
    },
    {
     "id": "7",
     "kind": "text",
     "chars": 98,
     "max": 98,
     "perLine": 24.5,
     "lines": 4,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "Yurak tez uradi, nafas tezlashadi\nDiqqat xavfga qaratiladi\nTana «kurash yoki qoch» holatiga o'tadi",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      6908800,
      3886200,
      4699000,
      1036181
     ],
     "lineH": 274320,
