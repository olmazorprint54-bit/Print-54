     "max": 74,
     "perLine": 18.5,
     "lines": 4,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "Kichik maqsad qo'ying\nHar bir yutuqni nishonlang\nXatoni tajriba deb biling",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      711200,
      3886200,
      4699000,
      1036181
     ],
     "lineH": 274320,
