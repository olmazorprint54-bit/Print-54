     "perLine": 17,
     "lines": 1,
     "caps": true,
     "sz": 48,
     "paras": 1,
     "text": "QO'RQUV NIMA?",
     "font": "Impact",
     "anchor": "b",
     "box": [
      6908800,
      914400,
      4699000,
      738664
     ],
