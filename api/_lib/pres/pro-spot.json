     "lines": 2,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Qo'rquvni butunlay yo'qotib bo'lmaydi, ammo uni boshqarishni o'rganish mumkin.",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
