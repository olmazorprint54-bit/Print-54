{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"22","kind":"label","chars":12,"max":14,"perLine":13.8,"lines":1,"caps":true,"sz":80.73,"paras":1,"text":"PRESENTATION","font":"Poppins Semi-Bold Italics","anchor":"t","box":[9720719,5098023,8336243,1146666],"lineH":1025271,"ins":0,"useW":0.904,"base":0.75,"tail":0.123,"below":[{"id":"23","gap":1.22,"cap":0.12}]},{"id":"23","kind":"label","chars":32,"max":59,"perLine":59.0,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Game On: Fueling the Fire Within","font":"Helvetica World","anchor":"t","box":[9720719,6348406,8336243,431762],"lineH":444500,"ins":0,"useW":0.556},{"id":"24","kind":"title","chars":6,"max":8,"perLine":7.1,"lines":1,"caps":true,"sz":154.2,"paras":1,"text":"SPORTS","font":"Poppins Bold Italics","anchor":"t","box":[9720719,3353848,8336243,2214643],"lineH":1958340,"ins":0,"useW":0.914,"base":0.75,"tail":0.12,"below":[{"id":"22","gap":0.891,"cap":0.027},{"id":"23","gap":1.529,"cap":0.063}]},{"id":"25","kind":"label","chars":9,"max":11,"perLine":11.3,"lines":1,"caps":true,"sz":25.0,"paras":1,"text":"JUNE 2025","font":"Poppins Bold","anchor":"t","box":[15338183,8994794,2119072,450812],"lineH":444500,"ins":0,"useW":0.785},{"id":"26","kind":"label","chars":24,"max":32,"perLine":31.6,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"wwww.reallygreatsite.com","font":"Helvetica World","anchor":"t","box":[13135178,245337,3576680,358701],"lineH":355600,"ins":0,"useW":0.819},{"id":"27","kind":"label","chars":8,"max":12,"perLine":12.3,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"Borcelle","font":"Helvetica World","anchor":"t","box":[9024314,232058,1392811,358701],"lineH":355600,"ins":0,"useW":0.658},{"id":"28","kind":"label","chars":12,"max":16,"perLine":16.3,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"123-456-7890","font":"Helvetica World","anchor":"t","box":[10983512,245337,1840583,358701],"lineH":355600,"ins":0,"useW":0.864},{"id":"29","kind":"text","chars":143,"max":143,"perLine":47.7,"lines":3,"caps":false,"sz":21.99,"paras":1,"text":"explores how internal motivation drives action, builds resilience, and sustains personal growth in any competitive or high-performance setting.","font":"Helvetica World","anchor":"t","box":[10251429,7375513,7007871,1009650],"lineH":335153,"ins":0}],"photos":[{"id":"11","w":10557092,"h":10349734,"area":0.581}]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"25","kind":"text","chars":594,"max":594,"perLine":59.4,"lines":10,"caps":false,"sz":21.99,"paras":1,"text":"The first step in any journey is a decision. Behind that decision lies a reason, a spark. This is your internal motivation, the fire that pushes you to show up, take the first step, and keep going. Unlike external rewards, inner motivation comes from a deeply personal place. It might stem from dreams, personal values, challenges you’ve faced, or a desire to grow into the best version of yourself. This fire cannot be handed to you; it has to be discovered, nurtured, and protected. When your drive is fueled from within, it can sustain effort even when times are tough or no one is watching.","font":"Helvetica World","anchor":"t","box":[807757,2911446,7730501,3343275],"lineH":335153,"ins":0},{"id":"26","kind":"title","chars":26,"max":26,"perLine":13.0,"lines":2,"caps":true,"sz":69.99,"paras":1,"text":"AWAKENING INNER MOTIVATION","font":"Poppins Bold Italics","anchor":"t","box":[807757,783973,9361758,1873027],"lineH":888873,"ins":0,"useW":0.907,"base":1.75,"tail":0.12,"below":[{"id":"25","gap":2.393,"cap":0.072}]},{"id":"27","kind":"label","chars":24,"max":32,"perLine":31.6,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"wwww.reallygreatsite.com","font":"Helvetica World","anchor":"t","box":[13135178,245337,3576680,358701],"lineH":355600,"ins":0,"useW":0.819}],"photos":[{"id":"7","w":8460539,"h":4816853,"area":0.217},{"id":"9","w":8460539,"h":4816853,"area":0.217}]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"15","kind":"title","chars":29,"max":29,"perLine":9.7,"lines":3,"caps":true,"sz":69.99,"paras":1,"text":"BUILDING A CHAMPION’S MINDSET","font":"Poppins Bold Italics","anchor":"t","box":[918228,783973,6638932,2758740],"lineH":888873,"ins":0,"useW":0.876},{"id":"16","kind":"text","chars":481,"max":481,"perLine":68.7,"lines":7,"caps":false,"sz":21.99,"paras":1,"text":"Performance begins with the mind. A champion’s mindset doesn’t mean arrogance; it means believing in the possibility of progress, being open to feedback, and refusing to let failure define you. Your mindset controls your reaction to challenges. When you learn to see obstacles as stepping stones instead of stop signs, your entire approach changes. The way you speak to yourself, the thoughts you repeat, and the perspective you maintain all shape how you perform and how you grow.","font":"Helvetica World","anchor":"t","box":[7557160,1115593,9812612,2343150],"lineH":335153,"ins":0},{"id":"17","kind":"label","chars":24,"max":32,"perLine":31.6,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"wwww.reallygreatsite.com","font":"Helvetica World","anchor":"t","box":[13135178,245337,3576680,358701],"lineH":355600,"ins":0,"useW":0.819},{"id":"24","kind":"label","chars":35,"max":35,"perLine":17.5,"lines":2,"caps":false,"sz":21.99,"paras":1,"text":"Mental Habits Guide Physical Action","font":"Helvetica World Bold","anchor":"t","box":[1098224,8329769,3708499,723900],"lineH":335153,"ins":0,"useW":0.731},{"id":"25","kind":"label","chars":33,"max":33,"perLine":16.5,"lines":2,"caps":false,"sz":21.99,"paras":1,"text":"Growth Mindset Embraces Challenge","font":"Helvetica World Bold","anchor":"t","box":[6411339,8985618,3439434,723900],"lineH":335153,"ins":0,"useW":0.805},{"id":"26","kind":"label","chars":36,"max":36,"perLine":18.0,"lines":2,"caps":false,"sz":21.99,"paras":1,"text":"Focused Thinking Improves Confidence","font":"Helvetica World Bold","anchor":"t","box":[11820886,8329769,3708499,723900],"lineH":335153,"ins":0,"useW":0.771}],"photos":[{"id":"4","w":6286130,"h":3578893,"area":0.12},{"id":"6","w":6286130,"h":3578893,"area":0.12},{"id":"8","w":6286130,"h":3578893,"area":0.12}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"12","kind":"title","chars":23,"max":23,"perLine":11.5,"lines":2,"caps":true,"sz":69.99,"paras":1,"text":"TURNING GOALS INTO FUEL","font":"Poppins Bold Italics","anchor":"t","box":[807757,783973,8016434,1873027],"lineH":888873,"ins":0,"useW":0.901,"base":1.75,"tail":0.12,"below":[{"id":"13","gap":2.393,"cap":0.072}]},{"id":"13","kind":"text","chars":410,"max":410,"perLine":58.6,"lines":7,"caps":false,"sz":21.99,"paras":1,"text":"Goals give your energy direction. Without them, it’s easy to feel lost or unmotivated. Clear, meaningful goals turn vague dreams into something specific and achievable. They help you plan, focus, and track progress over time. Goals should stretch you, but also feel attainable. When goals are set with intention and purpose, they become a strong motivational force that guides your daily actions and decisions.","font":"Helvetica World","anchor":"t","box":[807757,2911446,7443561,2343150],"lineH":335153,"ins":0},{"id":"14","kind":"label","chars":24,"max":32,"perLine":31.6,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"wwww.reallygreatsite.com","font":"Helvetica World","anchor":"t","box":[13135178,245337,3576680,358701],"lineH":355600,"ins":0,"useW":0.819},{"id":"15","kind":"label","chars":37,"max":50,"perLine":50.4,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"Goals Create Motivation and Momentum:","font":"Helvetica World Bold","anchor":"t","box":[10242893,7682792,6957646,366713],"lineH":335153,"ins":0,"useW":0.783,"base":0.983,"tail":0.217,"below":[{"id":"16","gap":1.447,"cap":0.23}]},{"id":"16","kind":"text","chars":229,"max":229,"perLine":57.2,"lines":4,"caps":false,"sz":21.99,"paras":1,"text":"A goal gives you something clear and meaningful to aim for. It provides direction, purpose, and focus. As you move closer to achieving it, your momentum builds naturally, and your motivation grows stronger with each step forward.","font":"Helvetica World","anchor":"t","box":[10242893,8086856,7705557,1343025],"lineH":335153,"ins":0}],"photos":[{"id":"4","w":12614243,"h":7169400,"area":0.481}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"18","kind":"title","chars":25,"max":25,"perLine":8.3,"lines":3,"caps":true,"sz":69.99,"paras":1,"text":"DISCIPLINE LIGHTS THE WAY","font":"Poppins Bold Italics","anchor":"t","box":[10371170,1254836,7186770,2758740],"lineH":888873,"ins":0,"useW":0.689,"base":2.75,"tail":0.12,"below":[{"id":"19","gap":3.597,"cap":0.072}]},{"id":"19","kind":"text","chars":407,"max":407,"perLine":50.9,"lines":8,"caps":false,"sz":21.99,"paras":1,"text":"Motivation is like a flame, it burns bright but can flicker. Discipline is what keeps the fire going when motivation weakens. Discipline is the habit of showing up, doing the work, and following your plan regardless of how you feel in the moment. It’s the ability to act according to what matters most, not what’s easiest. Discipline builds trust in yourself and proves that your commitment isn’t temporary.","font":"Helvetica World","anchor":"t","box":[10371170,4452223,6888130,2676525],"lineH":335153,"ins":0},{"id":"20","kind":"label","chars":24,"max":32,"perLine":31.6,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"wwww.reallygreatsite.com","font":"Helvetica World","anchor":"t","box":[13135178,245337,3576680,358701],"lineH":355600,"ins":0,"useW":0.819},{"id":"21","kind":"text","chars":158,"max":158,"perLine":52.7,"lines":3,"caps":false,"sz":21.99,"paras":1,"text":"Success doesn’t come from one big effort, it comes from what you do every day. Discipline helps you build powerful routines that carry you through any season.","font":"Helvetica World","anchor":"t","box":[9493841,7900273,7765459,1009650],"lineH":335153,"ins":0},{"id":"22","kind":"label","chars":34,"max":43,"perLine":43.2,"lines":1,"caps":false,"sz":21.99,"paras":1,"text":"Habits Grow from Daily Discipline:","font":"Helvetica World Bold","anchor":"t","box":[9493841,7566898,5971693,366713],"lineH":335153,"ins":0,"useW":0.769,"base":0.983,"tail":0.217,"below":[{"id":"21","gap":1.194,"cap":0.23}]}],"photos":[{"id":"7","w":5057893,"h":3793420,"area":0.102},{"id":"9","w":5057893,"h":3793420,"area":0.102},{"id":"11","w":2797749,"h":2098312,"area":0.031},{"id":"13","w":2797749,"h":2098312,"area":0.031}]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"3","kind":"title","chars":35,"max":35,"perLine":11.7,"lines":3,"caps":true,"sz":69.99,"paras":1,"text":"TRAINING WITH PASSION AND INTENSITY","font":"Poppins Bold Italics","anchor":"t","box":[807757,783973,7667985,2758740],"lineH":888873,"ins":0,"useW":0.897,"base":2.75,"tail":0.12,"below":[{"id":"4","gap":3.502,"cap":0.072}]},{"id":"4","kind":"text","chars":389,"max":389,"perLine":55.6,"lines":7,"caps":false,"sz":21.99,"paras":1,"text":"Great training isn’t just about how long you train; it’s about how present and intentional you are during training. Passion adds heart to your effort. Intensity adds focus to your movement. Training with both makes your sessions not only more effective but also more enjoyable. It's not about being aggressive or overworked; it's about being fully committed to improvement in every moment.","font":"Helvetica World","anchor":"t","box":[807757,3896600,7007871,2343150],"lineH":335153,"ins":0},{"id":"8","kind":"label","chars":24,"max":32,"perLine":31.6,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"wwww.reallygreatsite.com","font":"Helvetica World","anchor":"t","box":[13135178,245337,3576680,358701],"lineH":355600,"ins":0,"useW":0.819}],"photos":[{"id":"10","w":3423203,"h":2471831,"area":0.045},{"id":"12","w":3423203,"h":2471831,"area":0.045},{"id":"14","w":9267510,"h":6691894,"area":0.33}]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"3","kind":"title","chars":27,"max":27,"perLine":13.5,"lines":2,"caps":true,"sz":69.99,"paras":1,"text":"BOUNCING BACK FROM SETBACKS","font":"Poppins Bold Italics","anchor":"t","box":[9144000,1749276,8125165,1873027],"lineH":888873,"ins":0,"useW":0.938,"base":1.75,"tail":0.12,"below":[{"id":"11","gap":2.622,"cap":0.087},{"id":"13","gap":2.622,"cap":0.087}]},{"id":"4","kind":"text","chars":420,"max":420,"perLine":70.0,"lines":6,"caps":false,"sz":21.99,"paras":1,"text":"Setbacks, failure, and obstacles are part of every growth journey. No one reaches excellence without facing challenges. What defines a strong performer is not whether they fall, but how they get back up. The ability to bounce back, reflect, and try again with even more determination is what builds resilience and long-term confidence. When setbacks are seen as feedback instead of defeat, they become a source of power.","font":"Helvetica World","anchor":"t","box":[7607754,7248525,9661411,2009775],"lineH":335153,"ins":0},{"id":"8","kind":"label","chars":24,"max":32,"perLine":31.6,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"wwww.reallygreatsite.com","font":"Helvetica World","anchor":"t","box":[13135178,245337,3576680,358701],"lineH":355600,"ins":0,"useW":0.819},{"id":"11","kind":"label","chars":34,"max":34,"perLine":17.0,"lines":2,"caps":false,"sz":22.99,"paras":1,"text":"Failure Teaches What Success Hides","font":"Helvetica World Bold","anchor":"t","box":[8433415,4079943,3340943,766688],"lineH":350393,"ins":0,"useW":0.905},{"id":"12","kind":"text","chars":97,"max":97,"perLine":24.2,"lines":4,"caps":false,"sz":21.99,"paras":1,"text":"You often learn more from your mistakes than your wins. Failure reveals areas you can strengthen.","font":"Helvetica World","anchor":"t","box":[8433415,4966704,3340943,1343025],"lineH":335153,"ins":0},{"id":"13","kind":"label","chars":34,"max":34,"perLine":17.0,"lines":2,"caps":false,"sz":22.99,"paras":1,"text":"Resilience Turns Pain Into Purpose","font":"Helvetica World Bold","anchor":"t","box":[13370915,4079943,3340943,766688],"lineH":350393,"ins":0,"useW":0.911},{"id":"14","kind":"text","chars":77,"max":77,"perLine":25.7,"lines":3,"caps":false,"sz":21.99,"paras":1,"text":"Setbacks can be painful, but that pain can motivate change, growth, and grit.","font":"Helvetica World","anchor":"t","box":[13370915,4966704,3340943,1009650],"lineH":335153,"ins":0}],"photos":[{"id":"10","w":9367264,"h":10287000,"area":0.512}]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"3","kind":"title","chars":29,"max":29,"perLine":14.5,"lines":2,"caps":true,"sz":69.99,"paras":1,"text":"FEEDING THE FIRE WITH SUPPORT","font":"Poppins Bold Italics","anchor":"t","box":[807757,783973,9361758,1873027],"lineH":888873,"ins":0,"useW":0.81,"base":1.75,"tail":0.12,"below":[{"id":"4","gap":2.393,"cap":0.072}]},{"id":"4","kind":"text","chars":573,"max":573,"perLine":57.3,"lines":10,"caps":false,"sz":21.99,"paras":1,"text":"Even the strongest internal fire needs fuel from the outside world. While inner drive is essential, the presence of supportive people can make all the difference on the journey. Encouragement, honest feedback, shared goals, and emotional support help maintain high energy, stabilize your mindset, and keep your vision focused during both highs and lows. The people you surround yourself with, whether they are coaches, mentors, teammates, friends, or family, play a powerful role in shaping your belief in yourself, maintaining your motivation, and keeping you accountable.","font":"Helvetica World","anchor":"t","box":[807757,2911446,7363164,3343275],"lineH":335153,"ins":0},{"id":"8","kind":"label","chars":24,"max":32,"perLine":31.6,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"wwww.reallygreatsite.com","font":"Helvetica World","anchor":"t","box":[13135178,245337,3576680,358701],"lineH":355600,"ins":0,"useW":0.819},{"id":"9","kind":"text","chars":426,"max":426,"perLine":60.9,"lines":7,"caps":false,"sz":21.99,"paras":1,"text":"Their influence can uplift you during setbacks, challenge you to go further, and celebrate your progress along the way. A strong support system not only reminds you that you are not alone, but it reinforces that others genuinely believe in your potential, even when you momentarily doubt it yourself. In the most demanding moments, this external support can reignite your fire and keep you moving forward with renewed purpose.","font":"Helvetica World","anchor":"t","box":[8680941,7113261,8578359,2343150],"lineH":335153,"ins":0}],"photos":[{"id":"11","w":9123297,"h":5206815,"area":0.253},{"id":"13","w":7363164,"h":3069254,"area":0.12}]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"3","kind":"title","chars":29,"max":29,"perLine":14.5,"lines":2,"caps":true,"sz":69.99,"paras":1,"text":"COMPETING FOR PERSONAL GROWTH","font":"Poppins Bold Italics","anchor":"t","box":[807757,783973,9361758,1873027],"lineH":888873,"ins":0,"useW":0.949,"base":1.75,"tail":0.12,"below":[{"id":"4","gap":2.393,"cap":0.072}]},{"id":"4","kind":"text","chars":418,"max":418,"perLine":52.2,"lines":8,"caps":false,"sz":21.99,"paras":1,"text":"The most meaningful competition is not with others, it’s with yourself. Comparing yourself to others can be discouraging and misleading. But measuring progress against your past self leads to authentic growth. Every step forward, every small improvement, becomes a win. This kind of internal competition builds confidence, promotes self-reflection, and keeps you focused on what truly matters becoming better each day.","font":"Helvetica World","anchor":"t","box":[807757,2911446,7007871,2676525],"lineH":335153,"ins":0},{"id":"8","kind":"label","chars":24,"max":32,"perLine":31.6,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"wwww.reallygreatsite.com","font":"Helvetica World","anchor":"t","box":[13135178,245337,3576680,358701],"lineH":355600,"ins":0,"useW":0.819}],"photos":[{"id":"10","w":8354860,"h":4329225,"area":0.192},{"id":"12","w":16996481,"h":3141532,"area":0.284}]},{"n":10,"part":"ppt/slides/slide10.xml","role":"end","slots":[{"id":"22","kind":"title","chars":9,"max":14,"perLine":7.1,"lines":2,"caps":true,"sz":154.2,"paras":1,"text":"THANK YOU","font":"Poppins Bold Italics","anchor":"t","box":[9720719,3649123,8336243,3478655],"lineH":1566672,"ins":0,"useW":0.825,"base":1.4,"tail":0.12,"below":[{"id":"27","gap":1.903,"cap":0.033}]},{"id":"23","kind":"label","chars":9,"max":11,"perLine":11.3,"lines":1,"caps":true,"sz":25.0,"paras":1,"text":"JUNE 2025","font":"Poppins Bold","anchor":"t","box":[15338183,8994794,2119072,450812],"lineH":444500,"ins":0,"useW":0.785},{"id":"24","kind":"label","chars":24,"max":32,"perLine":31.6,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"wwww.reallygreatsite.com","font":"Helvetica World","anchor":"t","box":[13135178,245337,3576680,358701],"lineH":355600,"ins":0,"useW":0.819},{"id":"25","kind":"label","chars":8,"max":12,"perLine":12.3,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"Borcelle","font":"Helvetica World","anchor":"t","box":[9024314,232058,1392811,358701],"lineH":355600,"ins":0,"useW":0.658},{"id":"26","kind":"label","chars":12,"max":16,"perLine":16.3,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"123-456-7890","font":"Helvetica World","anchor":"t","box":[10983512,245337,1840583,358701],"lineH":355600,"ins":0,"useW":0.864},{"id":"27","kind":"text","chars":143,"max":143,"perLine":47.7,"lines":3,"caps":false,"sz":21.99,"paras":1,"text":"explores how internal motivation drives action, builds resilience, and sustains personal growth in any competitive or high-performance setting.","font":"Helvetica World","anchor":"t","box":[10251429,7375513,7007871,1009650],"lineH":335153,"ins":0}],"photos":[{"id":"11","w":10557092,"h":10349734,"area":0.581}]}]}