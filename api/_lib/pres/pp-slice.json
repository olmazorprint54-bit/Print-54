{"size":[12192000,6858000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"2","kind":"title","chars":35,"max":35,"perLine":7.0,"lines":5,"caps":false,"sz":40.0,"paras":1,"text":"Mantiq falsafasi. Jamiyat falsafasi","font":"Times New Roman","anchor":"t","box":[684212,457199,7929791,2971801],"lineH":609600,"ins":182880,"useW":0.894},{"id":"3","kind":"text","chars":137,"max":137,"perLine":22.8,"lines":6,"caps":false,"sz":20.0,"paras":2,"text":"Falsafa fanidan taqdimot: to'g'ri tafakkur qonunlari, jamiyatning tuzilishi, taraqqiyoti va global muammolar\nTayyorladi: Ozodova Gulsanam","font":"Times New Roman","anchor":"t","box":[684212,4050344,5333130,1947333],"lineH":304800,"ins":182880}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"2","kind":"title","chars":15,"max":34,"perLine":34.0,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Taqdimot rejasi","font":"Times New Roman","anchor":"t","box":[753038,971550,8534400,727381],"lineH":609600,"ins":182880,"useW":0.383},{"id":"3","kind":"text","chars":288,"max":288,"perLine":22.2,"lines":13,"caps":false,"sz":18.0,"paras":8,"text":"1. Mantiq falsafasining predmeti\n2. Mantiq fanining vazifalari va ahamiyati\n3. Tafakkur shakllari va mantiq qonunlari\n4. Mantiqiy metodlar. Isbotlash va uning tuzilishi\n5. Jamiyat falsafasining mohiyati\n6. Jamiyat tuzilishi va sohalari\n7. Jamiyat taraqqiyoti va global muammolar\n8. Xulosa","font":"Times New Roman","anchor":"t","box":[753038,2041831,8534400,3615267],"lineH":274320,"ins":182880}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"2","kind":"title","chars":29,"max":29,"perLine":14.5,"lines":2,"caps":false,"sz":32.0,"paras":1,"text":"Mantiq falsafasining predmeti","font":"Times New Roman","anchor":"t","box":[4722812,641554,5158367,1143000],"lineH":487680,"ins":182880,"useW":0.983},{"id":"4","kind":"text","chars":529,"max":529,"perLine":40.7,"lines":13,"caps":false,"sz":18.0,"paras":3,"text":"Mantiq (yunoncha logos – so'z, fikr, aql) – to'g'ri tafakkurning shakllari, qonunlari va usullari haqidagi fan. U fikrning mazmunini emas, balki tuzilishini – fikrlar o'zaro qanday bog'lanishini o'rganadi.\nMantiqning asoschisi – qadimgi yunon faylasufi Aristotel (mil. avv. 384–322). Uning mantiqiy asarlari «Organon» («qurol») nomi bilan to'plangan: mantiq barcha fanlar uchun bilish quroli hisoblanadi.\nSharqda Abu Nasr Forobiy va Ibn Sino mantiqni rivojlantirgan; Forobiy «Muallimi soniy» – «Ikkinchi muallim» deb ulug'langan.","font":"Times New Roman","anchor":"t","box":[4722812,1936400,6554788,3550000],"lineH":274320,"ins":182880}],"photos":[{"id":"3","w":3280974,"h":4572000,"area":0.179}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"2","kind":"title","chars":39,"max":176,"perLine":58.7,"lines":3,"caps":false,"sz":30.5,"paras":1,"text":"Mantiq fanining vazifalari va ahamiyati","font":"Times New Roman","anchor":"t","box":[989015,721850,9610159,1507067],"lineH":464820,"ins":182880,"useW":0.652,"base":3.365,"tail":0.216,"below":[{"id":"3","gap":2.699,"cap":0.178},{"id":"4","gap":2.699,"cap":0.178}]},{"id":"3","kind":"text","chars":256,"max":256,"perLine":19.7,"lines":13,"caps":false,"sz":18.0,"paras":4,"text":"Haqiqiy bilimga olib boruvchi to'g'ri fikrlash yo'llarini aniqlaydi.\nFikrlashdagi mantiqiy xatolarni topish va bartaraf etishga o'rgatadi.\nTushuncha, hukm va xulosa chiqarish qoidalarini o'rganadi.\nFikrni aniq, izchil va asosli bayon etishga yordam beradi.","font":"Times New Roman","anchor":"t","box":[782535,1767349,4937655,3615267],"lineH":274320,"ins":182880},{"id":"4","kind":"text","chars":244,"max":244,"perLine":18.8,"lines":13,"caps":false,"sz":18.0,"paras":4,"text":"Falsafa, matematika, huquqshunoslik va pedagogikada qo'llanadi.\nMatematik mantiq – kompyuter va dasturlashning nazariy asosi.\nBahs va munozarada dalillarni to'g'ri tuzishga o'rgatadi.\nSharqda mantiq ilm-fanning kirish qismi sifatida o'qitilgan.","font":"Times New Roman","anchor":"t","box":[5889520,1767349,4934479,3615266],"lineH":274320,"ins":182880}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"2","kind":"label","chars":31,"max":34,"perLine":34.0,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Tafakkur shakllari va qonunlari","font":"Times New Roman","anchor":"t","box":[496623,419100,11393488,838200],"lineH":274320,"ins":182880,"useW":0.257},{"id":"15","kind":"label","chars":18,"max":27,"perLine":27.1,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Tafakkur shakllari","font":"Times New Roman","anchor":"t","box":[872067,1701800,3810000,279400],"lineH":274320,"ins":0,"useW":0.44},{"id":"18","kind":"title","chars":60,"max":40,"perLine":13.4,"lines":3,"caps":false,"sz":20.0,"paras":2,"text":"1  TUSHUNCHA\nPredmetning muhim belgilari: «talaba», «davlat»","font":"Times New Roman","anchor":"t","box":[1100667,2209800,2667000,889000],"lineH":304800,"ins":0,"useW":0.781},{"id":"20","kind":"label","chars":50,"max":50,"perLine":16.7,"lines":3,"caps":false,"sz":20.0,"paras":2,"text":"2  HUKM\nBiror narsani tasdiqlaydi yoki inkor etadi","font":"Times New Roman","anchor":"t","box":[4910667,2209800,2667000,889000],"lineH":304800,"ins":0,"useW":0.941},{"id":"22","kind":"label","chars":50,"max":50,"perLine":16.7,"lines":3,"caps":false,"sz":20.0,"paras":2,"text":"3  XULOSA\nBir necha hukmdan yangi hukm chiqariladi","font":"Times New Roman","anchor":"t","box":[8441267,2209800,2667000,889000],"lineH":304800,"ins":0,"useW":0.98},{"id":"23","kind":"label","chars":16,"max":40,"perLine":40.2,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Mantiq qonunlari","font":"Times New Roman","anchor":"t","box":[872067,3403600,3810000,279400],"lineH":274320,"ins":0,"useW":0.418},{"id":"28","kind":"label","chars":57,"max":57,"perLine":14.2,"lines":4,"caps":false,"sz":16.0,"paras":2,"text":"Ayniyat\nFikr muhokama davomida bir xil ma'noda qo'llanadi","font":"Times New Roman","anchor":"t","box":[1024467,4546600,1701800,1092200],"lineH":243840,"ins":0,"useW":0.894},{"id":"32","kind":"text","chars":67,"max":67,"perLine":16.8,"lines":4,"caps":false,"sz":16.0,"paras":2,"text":"Ziddiyatsizlik\nIkki qarama-qarshi fikr bir vaqtda to'g'ri bo'lmaydi","font":"Times New Roman","anchor":"t","box":[3183467,4546600,1701800,1092200],"lineH":243840,"ins":0},{"id":"36","kind":"label","chars":56,"max":56,"perLine":14.0,"lines":4,"caps":false,"sz":16.0,"paras":2,"text":"Uchinchisi istisno\nIkki zid fikrdan biri albatta to'g'ri","font":"Times New Roman","anchor":"t","box":[5342467,4546600,1701800,1092200],"lineH":243840,"ins":0,"useW":0.937},{"id":"40","kind":"text","chars":63,"max":63,"perLine":15.8,"lines":4,"caps":false,"sz":16.0,"paras":2,"text":"Yetarli asos\nHar bir to'g'ri fikr asoslangan bo'ladi (Leybnits)","font":"Times New Roman","anchor":"t","box":[7501467,4546600,1701800,1092200],"lineH":243840,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"2","kind":"title","chars":17,"max":33,"perLine":16.3,"lines":2,"caps":false,"sz":40.0,"paras":1,"text":"Mantiqiy metodlar","font":"Times New Roman","anchor":"t","box":[7085012,685800,3604931,1371600],"lineH":609600,"ins":182880,"useW":0.545,"base":2.165,"tail":0.216,"below":[{"id":"4","gap":3.0,"cap":0.136}]},{"id":"4","kind":"text","chars":92,"max":92,"perLine":11.5,"lines":8,"caps":false,"sz":18.0,"paras":1,"text":"Metodlar fikrni tizimli, izchil va asosli qiladi: ilmiy bilish ular yordamida amalga oshadi.","font":"Times New Roman","anchor":"t","box":[7085012,2209799,3657600,2091267],"lineH":274320,"ins":182880},{"id":"10","kind":"label","chars":15,"max":20,"perLine":20.1,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Tahlil (analiz)","font":"Times New Roman","anchor":"t","box":[1524000,939800,1905000,381000],"lineH":274320,"ins":0,"useW":0.681},{"id":"11","kind":"label","chars":35,"max":35,"perLine":11.7,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Butunni qismlarga ajratib o'rganish","font":"Times New Roman","anchor":"t","box":[889000,1498600,2540000,711200],"lineH":243840,"ins":0,"useW":0.818},{"id":"15","kind":"label","chars":6,"max":20,"perLine":20.1,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Sintez","font":"Times New Roman","anchor":"t","box":[4610100,939800,1905000,381000],"lineH":274320,"ins":0,"useW":0.3},{"id":"16","kind":"label","chars":38,"max":38,"perLine":12.7,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Qismlarni yagona butunga birlashtirish","font":"Times New Roman","anchor":"t","box":[3975100,1498600,2540000,711200],"lineH":243840,"ins":0,"useW":0.848},{"id":"20","kind":"label","chars":9,"max":20,"perLine":20.1,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Induksiya","font":"Times New Roman","anchor":"t","box":[1524000,2743200,1905000,381000],"lineH":274320,"ins":0,"useW":0.473},{"id":"21","kind":"label","chars":34,"max":34,"perLine":11.3,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Xususiy faktlardan umumiy xulosaga","font":"Times New Roman","anchor":"t","box":[889000,3302000,2540000,711200],"lineH":243840,"ins":0,"useW":0.893},{"id":"25","kind":"label","chars":9,"max":20,"perLine":20.1,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Deduksiya","font":"Times New Roman","anchor":"t","box":[4610100,2743200,1905000,381000],"lineH":274320,"ins":0,"useW":0.512},{"id":"26","kind":"label","chars":32,"max":32,"perLine":10.7,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Umumiy qoidadan xususiy xulosaga","font":"Times New Roman","anchor":"t","box":[3975100,3302000,2540000,711200],"lineH":243840,"ins":0,"useW":0.862},{"id":"30","kind":"label","chars":9,"max":20,"perLine":20.1,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Analogiya","font":"Times New Roman","anchor":"t","box":[1524000,4546600,1905000,381000],"lineH":274320,"ins":0,"useW":0.499},{"id":"31","kind":"label","chars":36,"max":36,"perLine":12.0,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"O'xshashlik asosida xulosa chiqarish","font":"Times New Roman","anchor":"t","box":[889000,5105400,2540000,711200],"lineH":243840,"ins":0,"useW":0.858},{"id":"35","kind":"label","chars":10,"max":20,"perLine":20.1,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Taqqoslash","font":"Times New Roman","anchor":"t","box":[4610100,4546600,1905000,381000],"lineH":274320,"ins":0,"useW":0.546},{"id":"36","kind":"label","chars":50,"max":50,"perLine":16.7,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Umumiy va farqli belgilarni topish, umumlashtirish","font":"Times New Roman","anchor":"t","box":[3975100,5105400,2540000,711200],"lineH":243840,"ins":0,"useW":0.899}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"2","kind":"title","chars":27,"max":34,"perLine":34.0,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Isbotlash va tuzilishiuning","font":"Times New Roman","anchor":"t","box":[1126175,711200,9585852,1054100],"lineH":609600,"ins":182880,"useW":0.571},{"id":"12","kind":"label","chars":11,"max":17,"perLine":16.7,"lines":1,"caps":true,"sz":18.0,"paras":1,"text":"ARGUMENTLAR","font":"Times New Roman","anchor":"t","box":[1649415,2362200,2260600,304800],"lineH":274320,"ins":0,"useW":0.775},{"id":"13","kind":"text","chars":61,"max":61,"perLine":20.3,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Tezisni tasdiqlovchi dalillar: faktlar, ta'riflar, aksiomalar","font":"Times New Roman","anchor":"t","box":[1039815,2844800,2844800,635000],"lineH":243840,"ins":0},{"id":"18","kind":"label","chars":14,"max":17,"perLine":16.7,"lines":1,"caps":true,"sz":18.0,"paras":1,"text":"DEMONSTRATSIYA","font":"Times New Roman","anchor":"t","box":[5357815,2362200,2260600,304800],"lineH":274320,"ins":0,"useW":0.926},{"id":"19","kind":"label","chars":48,"max":48,"perLine":16.0,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Argumentlardan tezis kelib chiqishini ko'rsatish","font":"Times New Roman","anchor":"t","box":[4748215,2844800,2844800,635000],"lineH":243840,"ins":0,"useW":0.776,"base":3.365,"tail":0.216,"below":[{"id":"26","gap":4.0,"cap":0.302}]},{"id":"24","kind":"label","chars":5,"max":11,"perLine":11.2,"lines":1,"caps":true,"sz":18.0,"paras":1,"text":"TEZIS","font":"Times New Roman","anchor":"t","box":[9066215,2362200,2260600,304800],"lineH":274320,"ins":0,"useW":0.275},{"id":"25","kind":"label","chars":31,"max":20,"perLine":6.9,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Isbotlanishi kerak bo'lgan fikr","font":"Times New Roman","anchor":"t","box":[8456615,2844800,2844800,635000],"lineH":243840,"ins":0,"useW":0.855,"base":3.365,"tail":0.216,"below":[{"id":"26","gap":4.0,"cap":0.302}]},{"id":"26","kind":"text","chars":74,"max":100,"perLine":100.4,"lines":1,"caps":false,"sz":16.0,"paras":1,"text":"Isbotlash – fikrning haqiqiyligini boshqa haqiqiy fikrlar orqali asoslash.","font":"Times New Roman","anchor":"t","box":[862015,3657600,8458200,279400],"lineH":243840,"ins":0},{"id":"30","kind":"text","chars":75,"max":75,"perLine":18.8,"lines":4,"caps":false,"sz":16.0,"paras":2,"text":"Bevosita isbot\nTezis argumentlardan to'g'ridan-to'g'ri keltirib chiqariladi","font":"Times New Roman","anchor":"t","box":[1649415,4216400,3175000,914400],"lineH":243840,"ins":0},{"id":"34","kind":"text","chars":77,"max":77,"perLine":19.2,"lines":4,"caps":false,"sz":16.0,"paras":2,"text":"Bilvosita isbot\nTezisga zid fikrning (antitezisning) yolg'onligi ko'rsatiladi","font":"Times New Roman","anchor":"t","box":[5967415,4216400,3175000,914400],"lineH":243840,"ins":0},{"id":"36","kind":"text","chars":129,"max":129,"perLine":64.5,"lines":2,"caps":false,"sz":16.0,"paras":1,"text":"Rad etish – tezis yoki argumentlarning noto'g'riligini asoslash. Xatolar: tezisni almashtirish, yolg'on yoki isbotlanmagan dalil.","font":"Times New Roman","anchor":"t","box":[1065215,5435600,8077200,508000],"lineH":243840,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"2","kind":"title","chars":30,"max":30,"perLine":10.0,"lines":3,"caps":false,"sz":29.51,"paras":1,"text":"Jamiyat falsafasining mohiyati","font":"Times New Roman","anchor":"t","box":[4722812,1447800,5158367,1143000],"lineH":449732,"ins":182880,"useW":0.924,"base":3.365,"tail":0.216,"below":[{"id":"4","gap":3.547,"cap":0.174}]},{"id":"4","kind":"text","chars":374,"max":374,"perLine":26.7,"lines":14,"caps":false,"sz":17.0,"paras":3,"text":"Jamiyat falsafasi (ijtimoiy falsafa) jamiyatning paydo bo'lishi, tuzilishi, rivojlanish qonuniyatlari va undagi inson o'rnini o'rganadi.\nJamiyat – umumiy manfaatlar, qadriyatlar va me'yorlar bilan bog'langan odamlarning tarixan shakllangan birgalikdagi hayot faoliyati.\nAsosiy masalalar: shaxs va jamiyat, erkinlik va mas'uliyat, an'ana va yangilanish o'rtasidagi munosabat.","font":"Times New Roman","anchor":"t","box":[4722812,2777065,5650000,3550000],"lineH":259080,"ins":182880}],"photos":[{"id":"3","w":3280974,"h":4572000,"area":0.179}]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"2","kind":"title","chars":29,"max":34,"perLine":34.0,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Jamiyat tuzilishi va sohalari","font":"Times New Roman","anchor":"t","box":[435263,500761,9344691,889000],"lineH":609600,"ins":182880,"useW":0.62},{"id":"22","kind":"label","chars":14,"max":24,"perLine":24.1,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Iqtisodiy soha","font":"Times New Roman","anchor":"t","box":[1304234,2240661,2286000,330200],"lineH":274320,"ins":0,"useW":0.564},{"id":"23","kind":"label","chars":59,"max":59,"perLine":19.7,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Moddiy ne'matlarni ishlab chiqarish, taqsimlash va iste'mol","font":"Times New Roman","anchor":"t","box":[694634,2748661,2844800,635000],"lineH":243840,"ins":0,"useW":0.929},{"id":"27","kind":"label","chars":13,"max":24,"perLine":24.1,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Ijtimoiy soha","font":"Times New Roman","anchor":"t","box":[6536634,2240661,2286000,330200],"lineH":274320,"ins":0,"useW":0.531},{"id":"28","kind":"text","chars":68,"max":68,"perLine":22.7,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Sinflar, qatlamlar, millatlar, oila va ular o'rtasidagi munosabatlar","font":"Times New Roman","anchor":"t","box":[5927034,2748661,2844800,635000],"lineH":243840,"ins":0},{"id":"32","kind":"label","chars":12,"max":24,"perLine":24.1,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Siyosiy soha","font":"Times New Roman","anchor":"t","box":[1304234,4552061,2286000,330200],"lineH":274320,"ins":0,"useW":0.509},{"id":"33","kind":"label","chars":38,"max":38,"perLine":12.7,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Davlat, hokimiyat, partiyalar va huquq","font":"Times New Roman","anchor":"t","box":[694634,5060061,2844800,635000],"lineH":243840,"ins":0,"useW":0.909},{"id":"37","kind":"label","chars":13,"max":24,"perLine":24.1,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Ma'naviy soha","font":"Times New Roman","anchor":"t","box":[6536634,4552061,2286000,330200],"lineH":274320,"ins":0,"useW":0.581},{"id":"38","kind":"label","chars":44,"max":44,"perLine":14.7,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Fan, ta'lim, din, axloq, san'at va madaniyat","font":"Times New Roman","anchor":"t","box":[5927034,5060061,2844800,635000],"lineH":243840,"ins":0,"useW":0.904},{"id":"40","kind":"label","chars":7,"max":12,"perLine":11.6,"lines":1,"caps":true,"sz":17.0,"paras":1,"text":"JAMIYAT","font":"Times New Roman","anchor":"t","box":[4047434,3739261,1473200,330200],"lineH":259080,"ins":0,"useW":0.641},{"id":"6","kind":"label","chars":50,"max":50,"perLine":16.7,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Sohalar o'zaro bog'liq va bir-biriga ta'sir qiladi","font":"Times New Roman","anchor":"t","box":[9356034,2418461,1905000,812800],"lineH":243840,"ins":0,"useW":0.926},{"id":"10","kind":"label","chars":34,"max":34,"perLine":17.0,"lines":2,"caps":false,"sz":16.0,"paras":1,"text":"Oila – jamiyatning asosiy bo'g'ini","font":"Times New Roman","anchor":"t","box":[9356034,3967861,1905000,558800],"lineH":243840,"ins":0,"useW":0.8}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"2","kind":"title","chars":19,"max":34,"perLine":34.0,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Jamiyat taraqqiyoti","font":"Times New Roman","anchor":"t","box":[1039815,872066,10593385,1010075],"lineH":609600,"ins":182880,"useW":0.375,"base":2.165,"tail":0.216,"below":[{"id":"7","gap":2.817,"cap":0.121},{"id":"9","gap":2.817,"cap":0.121}]},{"id":"7","kind":"text","chars":100,"max":100,"perLine":25.0,"lines":4,"caps":false,"sz":16.0,"paras":2,"text":"Formatsion yondashuv (K. Marks)\nTarix ijtimoiy-iqtisodiy formatsiyalar almashinuvi sifatida qaraladi","font":"Times New Roman","anchor":"t","box":[1041400,2302934,4902200,889000],"lineH":243840,"ins":0},{"id":"9","kind":"text","chars":76,"max":76,"perLine":19.0,"lines":4,"caps":false,"sz":16.0,"paras":2,"text":"Sivilizatsion yondashuv (A. Toynbi)\nMadaniyat, din va qadriyatlarga tayanadi","font":"Times New Roman","anchor":"t","box":[6527800,2302934,4902200,889000],"lineH":243840,"ins":0},{"id":"13","kind":"label","chars":52,"max":52,"perLine":17.3,"lines":3,"caps":false,"sz":16.0,"paras":2,"text":"Agrar jamiyat\nYer va qishloq xo'jaligi asosiy boylik","font":"Times New Roman","anchor":"t","box":[736600,4385734,2641600,838200],"lineH":243840,"ins":0,"useW":0.932},{"id":"16","kind":"label","chars":58,"max":58,"perLine":19.3,"lines":3,"caps":false,"sz":16.0,"paras":2,"text":"Industrial jamiyat\nSanoat va mashinalar (XVIII–XIX asrlar)","font":"Times New Roman","anchor":"t","box":[3632200,4385734,2641600,838200],"lineH":243840,"ins":0,"useW":0.657},{"id":"19","kind":"label","chars":58,"max":58,"perLine":19.3,"lines":3,"caps":false,"sz":16.0,"paras":2,"text":"Axborot jamiyati\nBilim va texnologiyalar (XX asr oxiridan)","font":"Times New Roman","anchor":"t","box":[6527800,4385734,2641600,838200],"lineH":243840,"ins":0,"useW":0.995},{"id":"21","kind":"text","chars":150,"max":150,"perLine":75.0,"lines":2,"caps":false,"sz":16.0,"paras":1,"text":"Taraqqiyot – oddiydan murakkabga rivojlanish; evolyutsiya, islohotlar va inqiloblar orqali amalga oshadi. Bugun bilim va inson kapitali – asosiy omil.","font":"Times New Roman","anchor":"t","box":[1041400,5452534,8077200,533400],"lineH":243840,"ins":0}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"content","slots":[{"id":"2","kind":"title","chars":31,"max":34,"perLine":34.0,"lines":1,"caps":false,"sz":28.0,"paras":1,"text":"Insoniyatning global muammolari","font":"Times New Roman","anchor":"ctr","box":[989011,448734,8382000,787400],"lineH":426720,"ins":182880,"useW":0.59,"base":2.165,"tail":0.216,"below":[{"id":"31","gap":2.879,"cap":0.183},{"id":"35","gap":2.879,"cap":0.183},{"id":"39","gap":2.879,"cap":0.183}]},{"id":"3","kind":"text","chars":242,"max":242,"perLine":30.2,"lines":8,"caps":false,"sz":16.0,"paras":3,"text":"Bu muammolar butun insoniyatga taalluqli va faqat birgalikda hal qilinadi.\nMintaqamiz misoli – Orol dengizining qurishi Markaziy Osiyoda katta ekologik falokatga aylandi.\nYechim – xalqaro hamkorlik, barqaror rivojlanish va ekologik madaniyat.","font":"Times New Roman","anchor":"t","box":[990600,4538134,8128000,1905000],"lineH":243840,"ins":182880},{"id":"31","kind":"label","chars":49,"max":49,"perLine":9.8,"lines":5,"caps":false,"sz":17.0,"paras":2,"text":"Ekologik inqiroz\nHavo, suv va tuproq ifloslanishi","font":"Times New Roman","anchor":"t","box":[1752600,1439334,1854200,1168400],"lineH":259080,"ins":0,"useW":0.943},{"id":"35","kind":"label","chars":44,"max":44,"perLine":8.8,"lines":5,"caps":false,"sz":17.0,"paras":2,"text":"Iqlim o'zgarishi\nGlobal isish, qurg'oqchilik","font":"Times New Roman","anchor":"t","box":[4648200,1439334,1854200,1168400],"lineH":259080,"ins":0,"useW":0.729},{"id":"39","kind":"label","chars":50,"max":50,"perLine":10.0,"lines":5,"caps":false,"sz":17.0,"paras":2,"text":"Urush va terrorizm\nTinchlik va xavfsizlikka tahdid","font":"Times New Roman","anchor":"t","box":[7543800,1439334,1854200,1168400],"lineH":259080,"ins":0,"useW":0.888},{"id":"43","kind":"label","chars":53,"max":53,"perLine":10.6,"lines":5,"caps":false,"sz":17.0,"paras":2,"text":"Qashshoqlik va ochlik\nOziq-ovqat va resurs tanqisligi","font":"Times New Roman","anchor":"t","box":[1752600,2963334,1854200,1168400],"lineH":259080,"ins":0,"useW":0.968},{"id":"47","kind":"label","chars":54,"max":54,"perLine":10.8,"lines":5,"caps":false,"sz":17.0,"paras":2,"text":"Demografik muammolar\nAholining tez o'sishi va qarishia","font":"Times New Roman","anchor":"t","box":[4648200,2963334,1854200,1168400],"lineH":259080,"ins":0,"useW":0.959},{"id":"51","kind":"label","chars":43,"max":43,"perLine":8.6,"lines":5,"caps":false,"sz":17.0,"paras":2,"text":"Pandemiyalar\nYuqumli kasalliklar tarqalishi","font":"Times New Roman","anchor":"t","box":[7543800,2963334,1854200,1168400],"lineH":259080,"ins":0,"useW":0.928}],"photos":[]},{"n":12,"part":"ppt/slides/slide12.xml","role":"content","slots":[{"id":"2","kind":"title","chars":6,"max":47,"perLine":23.4,"lines":2,"caps":false,"sz":40.0,"paras":1,"text":"Xulosa","font":"Times New Roman","anchor":"t","box":[3542507,309032,5106985,1507067],"lineH":609600,"ins":182880,"useW":0.292,"base":2.165,"tail":0.216,"below":[{"id":"3","gap":2.583,"cap":0.136},{"id":"4","gap":2.583,"cap":0.136}]},{"id":"3","kind":"text","chars":191,"max":191,"perLine":14.7,"lines":13,"caps":false,"sz":18.0,"paras":4,"text":"Mantiq falsafasi\nTo'g'ri fikrlashning qonun va qoidalarini o'rgatadi.\nTushuncha, hukm va xulosa – tafakkurning asosiy shakllari.\nIsbotlash fikrni asoslash va xatolarni topishga yordam beradi.","font":"Times New Roman","anchor":"t","box":[836611,1621366,4937655,3615267],"lineH":274320,"ins":182880},{"id":"4","kind":"text","chars":189,"max":189,"perLine":14.5,"lines":13,"caps":false,"sz":18.0,"paras":4,"text":"Jamiyat falsafasi\nJamiyat rivojining qonuniyatlarini ochib beradi.\nJamiyat sohalari o'zaro bog'liq yagona tizimni tashkil etadi.\nGlobal muammolarni hal etish – butun insoniyatning vazifasi.","font":"Times New Roman","anchor":"t","box":[5960533,1621367,4934479,3615266],"lineH":274320,"ins":182880}],"photos":[]},{"n":13,"part":"ppt/slides/slide13.xml","role":"end","slots":[{"id":"2","kind":"title","chars":26,"max":80,"perLine":20.0,"lines":4,"caps":false,"sz":49.98,"paras":1,"text":"E'tiboringiz uchun rahmat!","font":"Times New Roman","anchor":"t","box":[751945,0,8001000,2971801],"lineH":761695,"ins":182880,"useW":0.87},{"id":"3","kind":"text","chars":77,"max":77,"perLine":11.0,"lines":7,"caps":false,"sz":22.0,"paras":1,"text":"Savollar bo'lsa, mamnuniyat bilan javob beraman. Tayyorladi: Ozodova Gulsanam","font":"Times New Roman","anchor":"t","box":[751945,4284134,4260321,2184400],"lineH":335280,"ins":182880}],"photos":[]}]}