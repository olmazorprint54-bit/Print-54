{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"7","kind":"label","chars":58,"max":58,"perLine":14.5,"lines":4,"caps":false,"sz":36.0,"paras":2,"text":"An introduction to the function\nand characteristics of DNA","font":"Codec Pro","anchor":"ctr","box":[5029466,5811928,8229068,1914747],"lineH":525780,"ins":0,"useW":0.818},{"id":"8","kind":"title","chars":16,"max":21,"perLine":10.6,"lines":2,"caps":false,"sz":134.65,"paras":1,"text":"Structure of DNA","font":"Hagrid Text Heavy","anchor":"t","box":[3174598,2277034,11938805,3433764],"lineH":1675892,"ins":0,"useW":0.93}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"5","kind":"label","chars":16,"max":27,"perLine":27.4,"lines":1,"caps":false,"sz":47.99,"paras":1,"text":"Discovery of DNA","font":"Codec Pro","anchor":"t","box":[3304906,3825807,8194069,800100],"lineH":731393,"ins":0,"useW":0.606},{"id":"6","kind":"label","chars":15,"max":27,"perLine":27.4,"lines":1,"caps":false,"sz":47.99,"paras":1,"text":"Function of DNA","font":"Codec Pro","anchor":"t","box":[3304906,5211627,8194069,800100],"lineH":731393,"ins":0,"useW":0.578},{"id":"7","kind":"label","chars":22,"max":27,"perLine":27.4,"lines":1,"caps":false,"sz":47.99,"paras":1,"text":"Characteristics of DNA","font":"Codec Pro","anchor":"t","box":[3304906,6784366,8194069,800100],"lineH":731393,"ins":0,"useW":0.811},{"id":"8","kind":"title","chars":14,"max":16,"perLine":15.6,"lines":1,"caps":false,"sz":62.99,"paras":1,"text":"Lesson Outline","font":"Hagrid Text Heavy","anchor":"t","box":[3287723,1915921,8228434,908685],"lineH":879983,"ins":0,"useW":0.889}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"2","kind":"text","chars":212,"max":212,"perLine":23.6,"lines":9,"caps":false,"sz":37.99,"paras":2,"text":"DNA fingerprinting is an essential tool in forensic science. It does not precisely determine the suspect's identity but helps narrow it down. \n\nWhich suspect's DNA closely matches the sample from the crime scene?","font":"Codec Pro","anchor":"t","box":[9736678,2905716,7522622,5200650],"lineH":578993,"ins":0},{"id":"6","kind":"label","chars":7,"max":9,"perLine":9.1,"lines":1,"caps":false,"sz":16.0,"paras":1,"text":"Locus 1","font":"Codec Pro","anchor":"t","box":[1906794,3986484,904152,276225],"lineH":243840,"ins":0,"useW":0.746},{"id":"7","kind":"label","chars":18,"max":31,"perLine":15.5,"lines":2,"caps":false,"sz":16.0,"paras":1,"text":"Crime Scene Sample","font":"Codec Pro","anchor":"t","box":[2570203,2981146,1542269,457073],"lineH":215392,"ins":0,"useW":0.797},{"id":"8","kind":"label","chars":9,"max":11,"perLine":10.6,"lines":1,"caps":false,"sz":16.0,"paras":1,"text":"Suspect 1","font":"Codec Pro","anchor":"t","box":[4591340,3190696,1060784,247523],"lineH":215392,"ins":0,"useW":0.841},{"id":"9","kind":"label","chars":9,"max":15,"perLine":15.5,"lines":1,"caps":false,"sz":16.0,"paras":1,"text":"Suspect 2","font":"Codec Pro","anchor":"t","box":[5766424,3190696,1542269,247523],"lineH":215392,"ins":0,"useW":0.607},{"id":"10","kind":"label","chars":7,"max":9,"perLine":9.1,"lines":1,"caps":false,"sz":16.0,"paras":1,"text":"Locus 2","font":"Codec Pro","anchor":"t","box":[1906794,5519432,904152,276225],"lineH":243840,"ins":0,"useW":0.796},{"id":"11","kind":"label","chars":7,"max":9,"perLine":9.1,"lines":1,"caps":false,"sz":16.0,"paras":1,"text":"Locus 3","font":"Codec Pro","anchor":"t","box":[1906794,7052957,904152,276225],"lineH":243840,"ins":0,"useW":0.793},{"id":"72","kind":"title","chars":23,"max":26,"perLine":25.5,"lines":1,"caps":false,"sz":52.0,"paras":1,"text":"DNA in Forensic Science","font":"Hagrid Text Heavy","anchor":"t","box":[3582795,1066800,11122410,751840],"lineH":726440,"ins":0,"useW":0.898},{"id":"74","kind":"label","chars":9,"max":15,"perLine":15.5,"lines":1,"caps":false,"sz":16.0,"paras":1,"text":"Suspect 3","font":"Codec Pro","anchor":"t","box":[7182251,3190696,1542269,247523],"lineH":215392,"ins":0,"useW":0.606}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"8","kind":"label","chars":51,"max":51,"perLine":51.3,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"Name the scientists who discovered DNA's structure.","font":"Codec Pro","anchor":"t","box":[1950517,3960930,14386965,771525],"lineH":685800,"ins":0,"useW":0.994},{"id":"9","kind":"label","chars":32,"max":33,"perLine":33.4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"Cite the characteristics of DNA.","font":"Codec Pro","anchor":"t","box":[4463209,5443321,9361582,771525],"lineH":685800,"ins":0,"useW":0.916},{"id":"10","kind":"label","chars":36,"max":38,"perLine":37.7,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"Explain the primary function of DNA.","font":"Codec Pro","anchor":"t","box":[3854072,6967167,10579857,771525],"lineH":685800,"ins":0,"useW":0.938},{"id":"11","kind":"title","chars":17,"max":21,"perLine":21.0,"lines":1,"caps":false,"sz":62.99,"paras":1,"text":"Learning Outcomes","font":"Hagrid Text Heavy","anchor":"t","box":[3593222,1703247,11101556,908685],"lineH":879983,"ins":0,"useW":0.886}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"4","kind":"label","chars":13,"max":32,"perLine":16.1,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"THE DISCOVERY","font":"Hagrid Text Heavy","anchor":"ctr","box":[8310687,733465,4935205,906508],"lineH":419100,"ins":0,"useW":0.707},{"id":"8","kind":"text","chars":90,"max":90,"perLine":30.0,"lines":3,"caps":false,"sz":41.99,"paras":1,"text":"In 1953, they concluded that the DNA molecule appears as a three-dimensional double helix.","font":"Codec Pro","anchor":"t","box":[8536488,3248149,8256875,1981200],"lineH":639953,"ins":0},{"id":"9","kind":"text","chars":109,"max":109,"perLine":27.2,"lines":4,"caps":false,"sz":41.99,"paras":1,"text":"They used X-ray crystallography to study DNA's structure, which helped Watson and Crick with their discovery.","font":"Codec Pro","anchor":"t","box":[8536488,7293479,8256875,2619483],"lineH":639953,"ins":0},{"id":"10","kind":"title","chars":30,"max":26,"perLine":12.8,"lines":2,"caps":false,"sz":53.99,"paras":1,"text":"James Watson and Francis Crick","font":"Codec Pro Ultra-Bold","anchor":"t","box":[8536488,1600398,6921043,1714527],"lineH":822833,"ins":0,"useW":0.912},{"id":"11","kind":"label","chars":37,"max":37,"perLine":18.5,"lines":2,"caps":false,"sz":53.99,"paras":1,"text":"Rosalind Franklin and Maurice Wilkins","font":"Codec Pro Ultra-Bold","anchor":"t","box":[8536488,5695724,6921043,1714527],"lineH":822833,"ins":0,"useW":0.96}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"4","kind":"label","chars":22,"max":55,"perLine":27.5,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"CHARACTERISTICS OF DNA","font":"Hagrid Text Heavy","anchor":"ctr","box":[7545719,733465,7146844,906508],"lineH":419100,"ins":0,"useW":0.822},{"id":"7","kind":"label","chars":49,"max":49,"perLine":24.5,"lines":2,"caps":false,"sz":41.99,"paras":2,"text":"Deoxyribonucleic acid\nMade of nucleotide monomers","font":"Codec Pro","anchor":"t","box":[7771520,3248149,9026569,1343025],"lineH":639953,"ins":0,"useW":0.861},{"id":"8","kind":"text","chars":129,"max":129,"perLine":25.8,"lines":5,"caps":false,"sz":41.99,"paras":2,"text":"Consists of two nucleotide chains\nEach nucleotide consists of a sugar molecule, a phosphate group, and a nitrogen-containing base","font":"Codec Pro","anchor":"t","box":[7771520,6000976,9487780,3257550],"lineH":639953,"ins":0},{"id":"9","kind":"title","chars":3,"max":17,"perLine":17.3,"lines":1,"caps":true,"sz":53.99,"paras":1,"text":"DNA","font":"Codec Pro Ultra-Bold","anchor":"t","box":[7771520,2314473,6921043,895364],"lineH":822833,"ins":0,"useW":0.213},{"id":"10","kind":"label","chars":16,"max":20,"perLine":20.4,"lines":1,"caps":false,"sz":53.99,"paras":1,"text":"DNA Double Helix","font":"Codec Pro Ultra-Bold","anchor":"t","box":[7771520,5067300,6921043,895364],"lineH":822833,"ins":0,"useW":0.835}],"photos":[{"id":"5","w":6716999,"h":10689055,"area":0.382}]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"10","kind":"label","chars":13,"max":55,"perLine":27.5,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"LET’S EXPLORE","font":"Hagrid Text Heavy","anchor":"ctr","box":[1028700,733465,7146844,920128],"lineH":419100,"ins":0,"useW":0.463},{"id":"12","kind":"text","chars":219,"max":219,"perLine":21.9,"lines":10,"caps":false,"sz":41.99,"paras":3,"text":"Explore the short segment of the 3D DNA molecule. Then, answer the following questions:\nCan you spot the sugar-phosphate backbone and the nitrogenous bases?\nWhy do you think the twisted ladder shape of DNA is important?","font":"Codec Pro","anchor":"t","box":[1028700,2171700,7784616,6448425],"lineH":639953,"ins":0},{"id":"17","kind":"label","chars":42,"max":42,"perLine":21.0,"lines":2,"caps":false,"sz":11.99,"paras":1,"text":"🔍 Click and drag to rotate the 3D element.","font":"Public Sans Bold","anchor":"t","box":[10469589,8375219,1952462,410051],"lineH":213233,"ins":0,"useW":0.941}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"10","kind":"label","chars":13,"max":55,"perLine":27.5,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"LET’S EXPLORE","font":"Hagrid Text Heavy","anchor":"ctr","box":[1028700,733465,7146844,920128],"lineH":419100,"ins":0,"useW":0.463},{"id":"11","kind":"text","chars":264,"max":264,"perLine":24.0,"lines":11,"caps":false,"sz":41.99,"paras":2,"text":"The model shows a short segment of a DNA molecule with only 12 nucleotide pairs.\n\nDNA’s twisted ladder shape (double helix) helps make it compact and stable. This shape allows DNA to store genetic information efficiently and be copied accurately when cells divide.","font":"Codec Pro","anchor":"t","box":[1028700,2171700,8000068,7086600],"lineH":639953,"ins":0},{"id":"12","kind":"text","chars":88,"max":88,"perLine":29.3,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"The model includes the sequence CGCTATAATGCG and its complementary strand, CGCATTATAGCG.","font":"Codec Pro","anchor":"t","box":[10746844,7813568,5612408,962025],"lineH":304800,"ins":0}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"10","kind":"title","chars":15,"max":42,"perLine":20.8,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"KNOWLEDGE CHECK","font":"Hagrid Text Heavy","anchor":"ctr","box":[1177374,4753065,5399668,918815],"lineH":419100,"ins":0,"useW":0.806},{"id":"13","kind":"text","chars":93,"max":93,"perLine":23.2,"lines":4,"caps":false,"sz":16.0,"paras":2,"text":"Tip: Double-click to customize this poll or quiz,\nor go to the Elements Tab for more options!","font":"Canva Sans Bold","anchor":"ctr","box":[9943230,8429241,5078792,1042757],"lineH":284480,"ins":508000}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"4","kind":"label","chars":22,"max":55,"perLine":27.5,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"CHARACTERISTICS OF DNA","font":"Hagrid Text Heavy","anchor":"ctr","box":[5570578,1467434,7146844,906508],"lineH":419100,"ins":0,"useW":0.822},{"id":"5","kind":"text","chars":80,"max":86,"perLine":86.5,"lines":1,"caps":false,"sz":27.99,"paras":1,"text":"Hydrogen bonds between complementary bases hold DNA's two polynucleotide chains.","font":"Codec Pro","anchor":"t","box":[1606315,2568785,15075370,497840],"lineH":462153,"ins":0},{"id":"9","kind":"label","chars":35,"max":38,"perLine":38.3,"lines":1,"caps":false,"sz":41.99,"paras":1,"text":"Adenine (A) bonds with thymine (T).","font":"Codec Pro Bold","anchor":"t","box":[4125347,5509748,10037305,704850],"lineH":639953,"ins":0,"useW":0.905},{"id":"10","kind":"label","chars":36,"max":38,"perLine":37.8,"lines":1,"caps":false,"sz":41.99,"paras":1,"text":"Cytosine (C) bonds with guanine (G).","font":"Codec Pro Bold","anchor":"t","box":[4253767,7014160,9908885,704850],"lineH":639953,"ins":0,"useW":0.943},{"id":"11","kind":"title","chars":10,"max":20,"perLine":20.4,"lines":1,"caps":false,"sz":53.99,"paras":1,"text":"Base Pairs","font":"Codec Pro Ultra-Bold","anchor":"t","box":[5683478,3929062,6921043,895364],"lineH":822833,"ins":0,"useW":0.494}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"content","slots":[{"id":"10","kind":"title","chars":15,"max":42,"perLine":20.8,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"KNOWLEDGE CHECK","font":"Hagrid Text Heavy","anchor":"ctr","box":[1177374,4753065,5399668,918815],"lineH":419100,"ins":0,"useW":0.806},{"id":"13","kind":"text","chars":93,"max":93,"perLine":23.2,"lines":4,"caps":false,"sz":16.0,"paras":2,"text":"Tip: Double-click to customize this poll or quiz,\nor go to the Elements Tab for more options!","font":"Canva Sans Bold","anchor":"ctr","box":[9943230,8429241,5078792,1042757],"lineH":284480,"ins":508000}],"photos":[]},{"n":12,"part":"ppt/slides/slide12.xml","role":"content","slots":[{"id":"5","kind":"text","chars":260,"max":260,"perLine":26.0,"lines":10,"caps":false,"sz":41.99,"paras":2,"text":"The sequence or order of the bases in a specific DNA strand is related to the expression of specific traits and qualities.\n\nFor example, the sequence GTC ATT might be responsible for curly brown hair, while GTC AAT might be responsible for straight black hair.","font":"Codec Pro","anchor":"t","box":[4886216,2715920,8515568,6448425],"lineH":639953,"ins":0},{"id":"8","kind":"title","chars":13,"max":19,"perLine":19.2,"lines":1,"caps":false,"sz":74.0,"paras":1,"text":"Did You Know?","font":"Hagrid Text Heavy","anchor":"t","box":[3207803,1180549,11872393,1103630],"lineH":1033780,"ins":0,"useW":0.723}],"photos":[]},{"n":13,"part":"ppt/slides/slide13.xml","role":"content","slots":[{"id":"10","kind":"text","chars":171,"max":171,"perLine":34.2,"lines":5,"caps":false,"sz":41.99,"paras":2,"text":"It stores genetic information necessary for organisms to develop, survive, and reproduce.\n\nDamage to DNA may cause cells to stop dividing, cell death, or become malignant.","font":"Codec Pro","anchor":"t","box":[3195966,3942080,11896068,3257550],"lineH":639953,"ins":0},{"id":"13","kind":"title","chars":15,"max":43,"perLine":21.3,"lines":2,"caps":true,"sz":52.0,"paras":1,"text":"FUNCTION OF DNA","font":"Hagrid Text Heavy","anchor":"ctr","box":[4347367,1849992,9593265,1491011],"lineH":726440,"ins":0,"useW":0.715}],"photos":[]},{"n":14,"part":"ppt/slides/slide14.xml","role":"content","slots":[{"id":"9","kind":"title","chars":15,"max":42,"perLine":20.8,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"KNOWLEDGE CHECK","font":"Hagrid Text Heavy","anchor":"ctr","box":[10149050,1471535,5399668,918815],"lineH":419100,"ins":0,"useW":0.806}],"photos":[]},{"n":15,"part":"ppt/slides/slide15.xml","role":"content","slots":[{"id":"4","kind":"label","chars":23,"max":68,"perLine":34.1,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"FROM DNA TO CHROMOSOMES","font":"Hagrid Text Heavy","anchor":"ctr","box":[1028700,734258,8854023,920128],"lineH":419100,"ins":0,"useW":0.756},{"id":"11","kind":"text","chars":305,"max":305,"perLine":27.7,"lines":11,"caps":false,"sz":41.99,"paras":2,"text":"In each cell, DNA would stretch out to about two meters if uncoiled.\n\nDNA undergoes a process of packaging to fit inside the tiny cell nucleus. It wraps around histone proteins to form nucleosomes, coils into chromatin fibers, and eventually condenses into discrete, visible structures called chromosomes.","font":"Codec Pro","anchor":"t","box":[1028700,2171644,8854023,7086600],"lineH":639953,"ins":0},{"id":"12","kind":"text","chars":90,"max":90,"perLine":30.0,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Interact with the 3D model and locate DNA, histone, nucleosome, chromatin, and chromosome.","font":"Codec Pro","anchor":"t","box":[11803737,7944727,4910033,962025],"lineH":304800,"ins":0}],"photos":[]},{"n":16,"part":"ppt/slides/slide16.xml","role":"content","slots":[{"id":"10","kind":"label","chars":7,"max":33,"perLine":16.6,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"SUMMARY","font":"Hagrid Text Heavy","anchor":"ctr","box":[6994315,1229775,4299370,906508],"lineH":419100,"ins":0,"useW":0.557},{"id":"17","kind":"text","chars":93,"max":93,"perLine":18.6,"lines":5,"caps":false,"sz":27.99,"paras":1,"text":"The double-helical model came from the combined work of Watson, Crick, Franklin, and Wilkins.","font":"Codec Pro","anchor":"t","box":[2575840,4193351,3600890,2143125],"lineH":426593,"ins":0},{"id":"18","kind":"text","chars":98,"max":98,"perLine":32.7,"lines":3,"caps":false,"sz":27.99,"paras":2,"text":"DNA is made of nucleotide monomers. \nThe four bases are adenosine, thymine, cytosine, and guanine.","font":"Codec Pro","anchor":"t","box":[7833112,3852456,6800727,1304925],"lineH":426593,"ins":0},{"id":"19","kind":"label","chars":13,"max":14,"perLine":13.6,"lines":1,"caps":false,"sz":41.99,"paras":1,"text":"The Discovery","font":"Codec Pro Ultra-Bold","anchor":"t","box":[2575840,3432769,3600890,704877],"lineH":639953,"ins":0,"useW":0.995},{"id":"20","kind":"title","chars":19,"max":21,"perLine":20.8,"lines":1,"caps":false,"sz":41.99,"paras":1,"text":"DNA Characteristics","font":"Codec Pro Ultra-Bold","anchor":"t","box":[7833112,3091874,5497306,704877],"lineH":639953,"ins":0,"useW":0.958},{"id":"24","kind":"label","chars":45,"max":47,"perLine":46.7,"lines":1,"caps":false,"sz":27.99,"paras":1,"text":"DNA stores an organism's genetic information.","font":"Codec Pro","anchor":"t","box":[7833112,6947395,8144254,466725],"lineH":426593,"ins":0,"useW":0.972},{"id":"25","kind":"label","chars":12,"max":21,"perLine":20.8,"lines":1,"caps":false,"sz":41.99,"paras":1,"text":"DNA Function","font":"Codec Pro Ultra-Bold","anchor":"t","box":[7833112,6186812,5497306,704877],"lineH":639953,"ins":0,"useW":0.644}],"photos":[]},{"n":17,"part":"ppt/slides/slide17.xml","role":"content","slots":[{"id":"11","kind":"text","chars":89,"max":89,"perLine":29.7,"lines":3,"caps":false,"sz":41.99,"p