{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"7","kind":"label","chars":58,"max":58,"perLine":14.5,"lines":4,"caps":false,"sz":36.0,"paras":2,"text":"An introduction to the function\nand characteristics of DNA"},{"id":"8","kind":"title","chars":16,"max":25,"perLine":12.5,"lines":2,"caps":false,"sz":134.65,"paras":1,"text":"Structure of DNA"}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"5","kind":"label","chars":16,"max":27,"perLine":26.9,"lines":1,"caps":false,"sz":47.99,"paras":1,"text":"Discovery of DNA"},{"id":"6","kind":"label","chars":15,"max":27,"perLine":26.9,"lines":1,"caps":false,"sz":47.99,"paras":1,"text":"Function of DNA"},{"id":"7","kind":"label","chars":22,"max":27,"perLine":26.9,"lines":1,"caps":false,"sz":47.99,"paras":1,"text":"Characteristics of DNA"},{"id":"8","kind":"title","chars":14,"max":18,"perLine":18.4,"lines":1,"caps":false,"sz":62.99,"paras":1,"text":"Lesson Outline"}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"2","kind":"text","chars":212,"max":212,"perLine":23.6,"lines":9,"caps":false,"sz":37.99,"paras":2,"text":"DNA fingerprinting is an essential tool in forensic science. It does not precisely determine the suspect's identity but helps narrow it down. \n\nWhich suspect's DNA closely matches the sample from the crime scene?"},{"id":"6","kind":"label","chars":7,"max":9,"perLine":8.9,"lines":1,"caps":false,"sz":16.0,"paras":1,"text":"Locus 1"},{"id":"7","kind":"label","chars":18,"max":30,"perLine":15.2,"lines":2,"caps":false,"sz":16.0,"paras":1,"text":"Crime Scene Sample"},{"id":"8","kind":"label","chars":9,"max":10,"perLine":10.4,"lines":1,"caps":false,"sz":16.0,"paras":1,"text":"Suspect 1"},{"id":"9","kind":"label","chars":9,"max":15,"perLine":15.2,"lines":1,"caps":false,"sz":16.0,"paras":1,"text":"Suspect 2"},{"id":"10","kind":"label","chars":7,"max":9,"perLine":8.9,"lines":1,"caps":false,"sz":16.0,"paras":1,"text":"Locus 2"},{"id":"11","kind":"label","chars":7,"max":9,"perLine":8.9,"lines":1,"caps":false,"sz":16.0,"paras":1,"text":"Locus 3"},{"id":"72","kind":"title","chars":23,"max":30,"perLine":30.1,"lines":1,"caps":false,"sz":52.0,"paras":1,"text":"DNA in Forensic Science"},{"id":"74","kind":"label","chars":9,"max":15,"perLine":15.2,"lines":1,"caps":false,"sz":16.0,"paras":1,"text":"Suspect 3"}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"8","kind":"label","chars":51,"max":50,"perLine":50.3,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"Name the scientists who discovered DNA's structure."},{"id":"9","kind":"label","chars":32,"max":33,"perLine":32.8,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"Cite the characteristics of DNA."},{"id":"10","kind":"label","chars":36,"max":37,"perLine":37.0,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"Explain the primary function of DNA."},{"id":"11","kind":"title","chars":17,"max":25,"perLine":24.8,"lines":1,"caps":false,"sz":62.99,"paras":1,"text":"Learning Outcomes"}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"4","kind":"label","chars":13,"max":38,"perLine":19.0,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"THE DISCOVERY"},{"id":"8","kind":"text","chars":90,"max":90,"perLine":30.0,"lines":3,"caps":false,"sz":41.99,"paras":1,"text":"In 1953, they concluded that the DNA molecule appears as a three-dimensional double helix."},{"id":"9","kind":"text","chars":109,"max":109,"perLine":27.2,"lines":4,"caps":false,"sz":41.99,"paras":1,"text":"They used X-ray crystallography to study DNA's structure, which helped Watson and Crick with their discovery."},{"id":"10","kind":"title","chars":30,"max":30,"perLine":15.0,"lines":2,"caps":false,"sz":53.99,"paras":1,"text":"James Watson and Francis Crick"},{"id":"11","kind":"label","chars":37,"max":37,"perLine":18.5,"lines":2,"caps":false,"sz":53.99,"paras":1,"text":"Rosalind Franklin and Maurice Wilkins"}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"4","kind":"label","chars":22,"max":55,"perLine":27.6,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"CHARACTERISTICS OF DNA"},{"id":"7","kind":"label","chars":49,"max":49,"perLine":24.5,"lines":2,"caps":false,"sz":41.99,"paras":2,"text":"Deoxyribonucleic acid\nMade of nucleotide monomers"},{"id":"8","kind":"text","chars":129,"max":129,"perLine":25.8,"lines":5,"caps":false,"sz":41.99,"paras":2,"text":"Consists of two nucleotide chains\nEach nucleotide consists of a sugar molecule, a phosphate group, and a nitrogen-containing base"},{"id":"9","kind":"title","chars":3,"max":15,"perLine":14.8,"lines":1,"caps":true,"sz":53.99,"paras":1,"text":"DNA"},{"id":"10","kind":"label","chars":16,"max":18,"perLine":18.0,"lines":1,"caps":false,"sz":53.99,"paras":1,"text":"DNA Double Helix"}],"photos":[{"id":"5","w":6716999,"h":10689055,"area":0.382}]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"10","kind":"label","chars":13,"max":55,"perLine":27.6,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"LET’S EXPLORE"},{"id":"12","kind":"text","chars":219,"max":219,"perLine":21.9,"lines":10,"caps":false,"sz":41.99,"paras":3,"text":"Explore the short segment of the 3D DNA molecule. Then, answer the following questions:\nCan you spot the sugar-phosphate backbone and the nitrogenous bases?\nWhy do you think the twisted ladder shape of DNA is important?"},{"id":"17","kind":"label","chars":42,"max":42,"perLine":21.0,"lines":2,"caps":false,"sz":11.99,"paras":1,"text":"🔍 Click and drag to rotate the 3D element."}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"10","kind":"label","chars":13,"max":55,"perLine":27.6,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"LET’S EXPLORE"},{"id":"11","kind":"text","chars":264,"max":264,"perLine":24.0,"lines":11,"caps":false,"sz":41.99,"paras":2,"text":"The model shows a short segment of a DNA molecule with only 12 nucleotide pairs.\n\nDNA’s twisted ladder shape (double helix) helps make it compact and stable. This shape allows DNA to store genetic information efficiently and be copied accurately when cells divide."},{"id":"12","kind":"text","chars":88,"max":88,"perLine":29.3,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"The model includes the sequence CGCTATAATGCG and its complementary strand, CGCATTATAGCG."}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"10","kind":"title","chars":15,"max":42,"perLine":20.8,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"KNOWLEDGE CHECK"},{"id":"13","kind":"text","chars":93,"max":93,"perLine":23.2,"lines":4,"caps":false,"sz":16.0,"paras":2,"text":"Tip: Double-click to customize this poll or quiz,\nor go to the Elements Tab for more options!"}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"4","kind":"label","chars":22,"max":55,"perLine":27.6,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"CHARACTERISTICS OF DNA"},{"id":"5","kind":"text","chars":80,"max":85,"perLine":84.8,"lines":1,"caps":false,"sz":27.99,"paras":1,"text":"Hydrogen bonds between complementary bases hold DNA's two polynucleotide chains."},{"id":"9","kind":"label","chars":35,"max":34,"perLine":33.6,"lines":1,"caps":false,"sz":41.99,"paras":1,"text":"Adenine (A) bonds with thymine (T)."},{"id":"10","kind":"label","chars":36,"max":33,"perLine":33.2,"lines":1,"caps":false,"sz":41.99,"paras":1,"text":"Cytosine (C) bonds with guanine (G)."},{"id":"11","kind":"title","chars":10,"max":18,"perLine":18.0,"lines":1,"caps":false,"sz":53.99,"paras":1,"text":"Base Pairs"}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"content","slots":[{"id":"10","kind":"title","chars":15,"max":42,"perLine":20.8,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"KNOWLEDGE CHECK"},{"id":"13","kind":"text","chars":93,"max":93,"perLine":23.2,"lines":4,"caps":false,"sz":16.0,"paras":2,"text":"Tip: Double-click to customize this poll or quiz,\nor go to the Elements Tab for more options!"}],"photos":[]},{"n":12,"part":"ppt/slides/slide12.xml","role":"content","slots":[{"id":"5","kind":"text","chars":260,"max":260,"perLine":26.0,"lines":10,"caps":false,"sz":41.99,"paras":2,"text":"The sequence or order of the bases in a specific DNA strand is related to the expression of specific traits and qualities.\n\nFor example, the sequence GTC ATT might be responsible for curly brown hair, while GTC AAT might be responsible for straight black hair."},{"id":"8","kind":"title","chars":13,"max":23,"perLine":22.6,"lines":1,"caps":false,"sz":74.0,"paras":1,"text":"Did You Know?"}],"photos":[]},{"n":13,"part":"ppt/slides/slide13.xml","role":"content","slots":[{"id":"10","kind":"text","chars":171,"max":171,"perLine":34.2,"lines":5,"caps":false,"sz":41.99,"paras":2,"text":"It stores genetic information necessary for organisms to develop, survive, and reproduce.\n\nDamage to DNA may cause cells to stop dividing, cell death, or become malignant."},{"id":"13","kind":"title","chars":15,"max":43,"perLine":21.4,"lines":2,"caps":true,"sz":52.0,"paras":1,"text":"FUNCTION OF DNA"}],"photos":[]},{"n":14,"part":"ppt/slides/slide14.xml","role":"content","slots":[{"id":"9","kind":"title","chars":15,"max":42,"perLine":20.8,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"KNOWLEDGE CHECK"}],"photos":[]},{"n":15,"part":"ppt/slides/slide15.xml","role":"content","slots":[{"id":"4","kind":"label","chars":23,"max":68,"perLine":34.2,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"FROM DNA TO CHROMOSOMES"},{"id":"11","kind":"text","chars":305,"max":305,"perLine":27.7,"lines":11,"caps":false,"sz":41.99,"paras":2,"text":"In each cell, DNA would stretch out to about two meters if uncoiled.\n\nDNA undergoes a process of packaging to fit inside the tiny cell nucleus. It wraps around histone proteins to form nucleosomes, coils into chromatin fibers, and eventually condenses into discrete, visible structures called chromosomes."},{"id":"12","kind":"text","chars":90,"max":90,"perLine":30.0,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Interact with the 3D model and locate DNA, histone, nucleosome, chromatin, and chromosome."}],"photos":[]},{"n":16,"part":"ppt/slides/slide16.xml","role":"content","slots":[{"id":"10","kind":"label","chars":7,"max":33,"perLine":16.6,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"SUMMARY"},{"id":"17","kind":"text","chars":93,"max":93,"perLine":18.6,"lines":5,"caps":false,"sz":27.99,"paras":1,"text":"The double-helical model came from the combined work of Watson, Crick, Franklin, and Wilkins."},{"id":"18","kind":"text","chars":98,"max":98,"perLine":32.7,"lines":3,"caps":false,"sz":27.99,"paras":2,"text":"DNA is made of nucleotide monomers. \nThe four bases are adenosine, thymine, cytosine, and guanine."},{"id":"19","kind":"label","chars":13,"max":12,"perLine":12.1,"lines":1,"caps":false,"sz":41.99,"paras":1,"text":"The Discovery"},{"id":"20","kind":"title","chars":19,"max":18,"perLine":18.4,"lines":1,"caps":false,"sz":41.99,"paras":1,"text":"DNA Characteristics"},{"id":"24","kind":"label","chars":45,"max":46,"perLine":45.8,"lines":1,"caps":false,"sz":27.99,"paras":1,"text":"DNA stores an organism's genetic information."},{"id":"25","kind":"label","chars":12,"max":18,"perLine":18.4,"lines":1,"caps":false,"sz":41.99,"paras":1,"text":"DNA Function"}],"photos":[]},{"n":17,"part":"ppt/slides/slide17.xml","role":"content","slots":[{"id":"11","kind":"text","chars":89,"max":89,"perLine":29.7,"lines":3,"caps":false,"sz":41.99,"paras":1,"text":"How does DNA replication occur? Use a graphic organizer to show the step-by-step process."},{"id":"14","kind":"title","chars":10,"max":33,"perLine":16.4,"lines":2,"caps":true,"sz":52.0,"paras":1,"text":"ASSIGNMENT"}],"photos":[]},{"n":18,"part":"ppt/slides/slide18.xml","role":"content","slots":[{"id":"7","kind":"label","chars":9,"max":33,"perLine":16.6,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"REFERENCE"},{"id":"8","kind":"title","chars":24,"max":47,"perLine":46.6,"lines":1,"caps":false,"sz":31.99,"paras":1,"text":"Add your reference here."}],"photos":[]},{"n":19,"part":"ppt/slides/slide19.xml","role":"content","slots":[{"id":"16","kind":"label","chars":4,"max":171,"perLine":24.4,"lines":7,"caps":false,"sz":19.99,"paras":1,"text":"Text"},{"id":"19","kind":"text","chars":66,"max":66,"perLine":9.4,"lines":7,"caps":false,"sz":16.0,"paras":1,"text":"TIP: Use links to go to a different page inside your presentation."},{"id":"22","kind":"text","chars":128,"max":128,"perLine":16.0,"lines":8,"caps":false,"sz":16.0,"paras":1,"text":"HOW: Highlight text, click on the link symbol on the toolbar, and select the page in your presentation that you want to connect."},{"id":"25","kind":"label","chars":4,"max":24,"perLine":12.0,"lines":2,"caps":true,"sz":30.0,"paras":1,"text":"TEXT"},{"id":"38","kind":"title","chars":13,"max":14,"perLine":13.8,"lines":1,"caps":false,"sz":41.99,"paras":1,"text":"Resource Page"},{"id":"39","kind":"text","chars":133,"max":133,"perLine":66.5,"lines":2,"caps":false,"sz":24.0,"paras":2,"text":"Use these elements and illustrations in your Canva Presentation.\nHappy designing! Don't forget to delete this page before presenting."}],"photos":[]},{"n":20,"part":"ppt/slides/slide20.xml","role":"content","slots":[{"id":"15","kind":"title","chars":85,"max":85,"perLine":21.2,"lines":4,"caps":false,"sz":31.99,"paras":2,"text":"Try this background for online class.\n*Please delete this section before downloading."}],"photos":[]},{"n":21,"part":"ppt/slides/slide21.xml","role":"content","slots":[{"id":"6","kind":"label","chars":39,"max":39,"perLine":9.8,"lines":4,"caps":false,"sz":36.99,"paras":1,"text":"Press these keys while on Present mode!"},{"id":"12","kind":"title","chars":1,"max":8,"perLine":4,"lines":2,"caps":true,"sz":41.99,"paras":1,"text":"B"},{"id":"15","kind":"label","chars":1,"max":8,"perLine":4,"lines":2,"caps":true,"sz":41.99,"paras"