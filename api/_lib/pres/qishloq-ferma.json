{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"11","kind":"title","chars":60,"max":60,"perLine":20.0,"lines":3,"caps":true,"sz":56.0,"paras":1,"text":"GM EKINLARNING BIOLOGIK XAVFSIZLIGI VA KARTAXENA BAYONNOMASI","font":"Times New Roman","anchor":"t","box":[1269999,888999,15748000,2413000],"lineH":853440,"ins":0,"useW":0.991,"base":3.365,"tail":0.195,"below":[{"id":"12","gap":3.929,"cap":0.194}]},{"id":"12","kind":"label","chars":30,"max":54,"perLine":53.6,"lines":1,"caps":false,"sz":36.0,"paras":1,"text":"Tayyorladi: Xolmamatova Asolat","font":"Times New Roman","anchor":"t","box":[4063999,3683000,10160000,762000],"lineH":548640,"ins":0,"useW":0.604}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"21","kind":"title","chars":4,"max":9,"perLine":9.3,"lines":1,"caps":true,"sz":96.0,"paras":1,"text":"REJA","font":"Times New Roman","anchor":"t","box":[9144000,2180483,6687973,1467919],"lineH":1463040,"ins":0,"useW":0.436,"base":0.965,"tail":0.195,"below":[{"id":"23","gap":1.597,"cap":0.107}]},{"id":"22","kind":"label","chars":15,"max":18,"perLine":18.3,"lines":1,"caps":true,"sz":20.0,"paras":1,"text":"TAQDIMOT REJASI","font":"Times New Roman","anchor":"t","box":[9644314,1566512,2741436,300531],"lineH":312928,"ins":0,"useW":0.82},{"id":"23","kind":"text","chars":69,"max":69,"perLine":23.0,"lines":3,"caps":false,"sz":34.0,"paras":2,"text":"1. GM ekinlar va ularning mohiyati\n2. Biologik xavfsizlik tushunchasi","font":"Times New Roman","anchor":"t","box":[9550399,4127500,8128000,1714500],"lineH":518160,"ins":0},{"id":"24","kind":"text","chars":66,"max":66,"perLine":22.0,"lines":3,"caps":false,"sz":34.0,"paras":2,"text":"3. GM ekinlarning ekologik xavflari\n4. Inson salomatligiga ta'siri","font":"Times New Roman","anchor":"t","box":[9550399,6032500,8128000,1714500],"lineH":518160,"ins":0},{"id":"25","kind":"text","chars":71,"max":71,"perLine":23.7,"lines":3,"caps":false,"sz":34.0,"paras":2,"text":"5. Kartaxena bayonnomasi qoidalari\n6. O'zbekistonda biologik xavfsizlik","font":"Times New Roman","anchor":"t","box":[9550399,7937500,8128000,1714500],"lineH":518160,"ins":0}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"13","kind":"title","chars":10,"max":14,"perLine":13.6,"lines":1,"caps":true,"sz":64.5,"paras":1,"text":"GM EKINLAR","font":"Times New Roman","anchor":"t","box":[9144001,2180483,6567100,974626],"lineH":982980,"ins":0,"useW":0.778},{"id":"15","kind":"text","chars":320,"max":320,"perLine":40.0,"lines":8,"caps":false,"sz":32.5,"paras":3,"text":"Genetik modifikatsiyalangan (GM) ekinlar – genomiga gen muhandisligi usulida boshqa organizm geni kiritilgan o'simliklar.\nMaqsad: hosildorlikni oshirish, zararkunanda, kasallik va gerbitsidlarga chidamlilik, qurg'oqchilikka bardosh.\nSeleksiyadan farqi: kerakli belgi qisqa muddatda, turlararo to'siqdan o'tib kiritiladi.","font":"Times New Roman","anchor":"t","box":[9143999,4038599,8445500,4191000],"lineH":495300,"ins":0},{"id":"16","kind":"label","chars":5,"max":8,"perLine":8.5,"lines":1,"caps":true,"sz":28.0,"paras":1,"text":"MISOL","font":"Times New Roman","anchor":"t","box":[9144000,8483599,1778000,508000],"lineH":426720,"ins":0,"useW":0.622},{"id":"17","kind":"text","chars":92,"max":92,"perLine":30.7,"lines":3,"caps":false,"sz":30.0,"paras":1,"text":"Bt-makkajo'xori va Bt-paxta tuproq bakteriyasi geni tufayli zararkunanda qurtlarga chidamli.","font":"Times New Roman","anchor":"t","box":[10921999,8318500,6667500,1524000],"lineH":457200,"ins":0}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"12","kind":"title","chars":10,"max":14,"perLine":13.8,"lines":1,"caps":true,"sz":64.5,"paras":1,"text":"GM EKINLAR","font":"Times New Roman","anchor":"t","box":[1716940,2180483,6687973,974626],"lineH":982980,"ins":0,"useW":0.764},{"id":"13","kind":"label","chars":21,"max":29,"perLine":29.3,"lines":1,"caps":true,"sz":30.0,"paras":1,"text":"TARQALISHI VA TURLARI","font":"Times New Roman","anchor":"t","box":[2306480,1566512,6604000,533400],"lineH":457200,"ins":0,"useW":0.707},{"id":"14","kind":"text","chars":294,"max":294,"perLine":32.7,"lines":9,"caps":false,"sz":31.0,"paras":3,"text":"1996-yildan tijorat maqsadida keng ekilmoqda; hozir 29 ta davlatda 190 mln gektardan ortiq maydonni egallaydi.\nEng ko'p ekiladiganlari: soya (48 %), makkajo'xori (32 %), paxta (13 %) va kanola (5 %).\nYetakchilar: AQSH, Braziliya, Argentina, Kanada va Hindiston – jami maydonning 90 % dan ko'pi.","font":"Times New Roman","anchor":"t","box":[1371600,4038600,7620000,4191000],"lineH":472440,"ins":0},{"id":"15","kind":"label","chars":9,"max":10,"perLine":10.0,"lines":1,"caps":true,"sz":27.0,"paras":1,"text":"XUSUSIYAT","font":"Times New Roman","anchor":"t","box":[1371600,8483599,2159000,508000],"lineH":411480,"ins":0,"useW":0.898},{"id":"16","kind":"text","chars":67,"max":67,"perLine":22.3,"lines":3,"caps":false,"sz":30.0,"paras":1,"text":"Hosildorlik, zararkunanda va gerbitsidga chidamlilik, yaxshi sifat.","font":"Times New Roman","anchor":"t","box":[3619499,8318500,5397500,1524000],"lineH":457200,"ins":0}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"13","kind":"title","chars":19,"max":25,"perLine":24.6,"lines":1,"caps":true,"sz":44.0,"paras":1,"text":"BIOLOGIK XAVFSIZLIK","font":"Times New Roman","anchor":"t","box":[1706697,2222499,8128000,762000],"lineH":670560,"ins":0,"useW":0.753},{"id":"14","kind":"label","chars":9,"max":23,"perLine":22.6,"lines":1,"caps":true,"sz":30.0,"paras":1,"text":"TUSHUNCHA","font":"Times New Roman","anchor":"t","box":[1745200,1646112,5080000,533400],"lineH":457200,"ins":0,"useW":0.462,"base":0.965,"tail":0.195,"below":[{"id":"13","gap":1.513,"cap":0.443}]},{"id":"15","kind":"text","chars":284,"max":284,"perLine":35.5,"lines":8,"caps":false,"sz":34.0,"paras":3,"text":"Biologik xavfsizlik – GMOlarning inson salomatligi va atrof-muhitga zararining oldini oluvchi choralar tizimi.\nU uch bosqichdan iborat: xavfni baholash, xavfni boshqarish va doimiy monitoring.\nLaboratoriya, dala sinovi, tashish, saqlash va sotuvning har bir bosqichi nazorat qilinadi.","font":"Times New Roman","anchor":"t","box":[1371600,4038599,7620000,4191000],"lineH":518160,"ins":0},{"id":"16","kind":"label","chars":7,"max":9,"perLine":9.2,"lines":1,"caps":true,"sz":27.5,"paras":1,"text":"TAMOYIL","font":"Times New Roman","anchor":"t","box":[1371599,8483599,1905000,508000],"lineH":419100,"ins":0,"useW":0.843},{"id":"17","kind":"text","chars":73,"max":73,"perLine":24.3,"lines":3,"caps":false,"sz":30.0,"paras":1,"text":"Ehtiyotkorlik: ilmiy aniqlik yetarli bo'lmasa ham, xavfning oldi olinadi.","font":"Times New Roman","anchor":"t","box":[3365500,8318500,5651500,1524000],"lineH":457200,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"23","kind":"title","chars":16,"max":28,"perLine":13.8,"lines":2,"caps":true,"sz":54.0,"paras":1,"text":"EKOLOGIK XAVFLAR","font":"Times New Roman","anchor":"t","box":[9144000,1714500,5588000,1905000],"lineH":822960,"ins":0,"useW":0.632},{"id":"24","kind":"label","chars":11,"max":23,"perLine":22.6,"lines":1,"caps":true,"sz":30.0,"paras":1,"text":"ATROF-MUHIT","font":"Times New Roman","anchor":"t","box":[8988314,1566511,5080000,533400],"lineH":457200,"ins":0,"useW":0.516,"base":0.965,"tail":0.195,"below":[{"id":"23","gap":0.388,"cap":0.544}]},{"id":"25","kind":"text","chars":107,"max":107,"perLine":26.8,"lines":4,"caps":false,"sz":31.0,"paras":1,"text":"Gen oqimi: transgen chang yovvoyi qarindosh o'simliklarga o'tib, ularning genofondini o'zgartirishi mumkin.","font":"Times New Roman","anchor":"t","box":[9550399,4000499,8128000,1879600],"lineH":472440,"ins":0},{"id":"26","kind":"text","chars":98,"max":98,"perLine":24.5,"lines":4,"caps":false,"sz":31.0,"paras":1,"text":"Chidamli begona o'tlar: gerbitsidga chidamli turlar paydo bo'lib, kimyoviy vositalar sarfi ortadi.","font":"Times New Roman","anchor":"t","box":[9550399,5968999,8128000,1879600],"lineH":472440,"ins":0},{"id":"27","kind":"text","chars":104,"max":104,"perLine":26.0,"lines":4,"caps":false,"sz":31.0,"paras":1,"text":"Biologik xilma-xillik: foydali hasharotlar va tuproq mikroorganizmlariga ta'sir, monokultura kengayishi.","font":"Times New Roman","anchor":"t","box":[9550399,7937500,8128000,1879600],"lineH":472440,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"13","kind":"title","chars":10,"max":15,"perLine":15.1,"lines":1,"caps":true,"sz":72.0,"paras":1,"text":"SALOMATLIK","font":"Times New Roman","anchor":"t","box":[9144000,2180483,8128000,1270000],"lineH":1097280,"ins":0,"useW":0.73},{"id":"14","kind":"label","chars":17,"max":23,"perLine":22.6,"lines":1,"caps":true,"sz":30.0,"paras":1,"text":"TA'SIR MASALALARI","font":"Times New Roman","anchor":"t","box":[9570259,1566512,5080000,533400],"lineH":457200,"ins":0,"useW":0.74},{"id":"15","kind":"text","chars":270,"max":270,"perLine":33.8,"lines":8,"caps":false,"sz":34.0,"paras":3,"text":"Asosiy xavotirlar: yangi allergenlar va kutilmagan toksik moddalar paydo bo'lishi.\nAntibiotikka chidamlilik marker genlarining ichak bakteriyalariga o'tish ehtimoli o'rganiladi.\nShu sababli har bir GM mahsulot bozorga chiqishidan oldin uzoq muddatli tekshiruvdan o'tadi.","font":"Times New Roman","anchor":"t","box":[8509000,4038600,9080500,4191000],"lineH":518160,"ins":0},{"id":"16","kind":"label","chars":6,"max":8,"perLine":8.5,"lines":1,"caps":true,"sz":28.0,"paras":1,"text":"XULOSA","font":"Times New Roman","anchor":"t","box":[8509000,8483599,1778000,508000],"lineH":426720,"ins":0,"useW":0.81},{"id":"17","kind":"text","chars":79,"max":79,"perLine":26.3,"lines":3,"caps":false,"sz":30.0,"paras":1,"text":"JSST: ro'yxatdan o'tgan GM oziq-ovqatlar inson salomatligiga xavf tug'dirmaydi.","font":"Times New Roman","anchor":"t","box":[10350500,8318500,7239000,1524000],"lineH":457200,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"12","kind":"title","chars":10,"max":15,"perLine":15.1,"lines":1,"caps":true,"sz":72.0,"paras":1,"text":"SALOMATLIK","font":"Times New Roman","anchor":"t","box":[1716940,2180483,8128000,1270000],"lineH":1097280,"ins":0,"useW":0.73},{"id":"13","kind":"label","chars":21,"max":29,"perLine":29.3,"lines":1,"caps":true,"sz":30.0,"paras":1,"text":"XAVFSIZLIKNI BAHOLASH","font":"Times New Roman","anchor":"t","box":[2306480,1566512,6604000,533400],"lineH":457200,"ins":0,"useW":0.728},{"id":"14","kind":"text","chars":255,"max":255,"perLine":31.9,"lines":8,"caps":false,"sz":33.0,"paras":3,"text":"Mahsulot tarkibi, allergenligi, toksikligi va ozuqaviy qiymati an'anaviy navi bilan taqqoslanadi.\nBu yondashuv «mohiyatan tenglik» tamoyili deb ataladi (OECD, 1993).\nKodeks Alimentarius komissiyasining 2003-yilgi tamoyillari xalqaro baholash standartidir.","font":"Times New Roman","anchor":"t","box":[1371600,4038599,7620000,4191000],"lineH":502920,"ins":0},{"id":"15","kind":"label","chars":5,"max":8,"perLine":7.3,"lines":1,"caps":true,"sz":28.0,"paras":1,"text":"TALAB","font":"Times New Roman","anchor":"t","box":[1371600,8483599,1524000,508000],"lineH":426720,"ins":0,"useW":0.777},{"id":"16","kind":"text","chars":86,"max":86,"perLine":28.7,"lines":3,"caps":false,"sz":30.0,"paras":1,"text":"GM tarkibli mahsulot yorlig'i ko'p davlatlarda majburiy (YIda 0,9 % dan ortiq bo'lsa).","font":"Times New Roman","anchor":"t","box":[3048000,8318500,5969000,1524000],"lineH":457200,"ins":0}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"12","kind":"title","chars":21,"max":49,"perLine":24.6,"lines":2,"caps":true,"sz":44.0,"paras":1,"text":"KARTAXENA BAYONNOMASI","font":"Times New Roman","anchor":"t","box":[1716939,2095499,8128000,1524000],"lineH":670560,"ins":0,"useW":0.959},{"id":"13","kind":"label","chars":18,"max":29,"perLine":29.3,"lines":1,"caps":true,"sz":30.0,"paras":1,"text":"ASOSIY MA'LUMOTLAR","font":"Times New Roman","anchor":"t","box":[2272639,1498600,6604000,533400],"lineH":457200,"ins":0,"useW":0.646},{"id":"14","kind":"text","chars":212,"max":212,"perLine":26.5,"lines":8,"caps":false,"sz":33.5,"paras":3,"text":"Biologik xilma-xillik to'g'risidagi konvensiyaga qo'shimcha xalqaro shartnoma.\n2000-yil 29-yanvarda Montrealda qabul qilingan, 2003-yil 11-sentyabrda kuchga kirgan.\nHozir unda 170 dan ortiq davlat ishtirok etadi.","font":"Times New Roman","anchor":"t","box":[1371600,4038600,7620000,4191000],"lineH":510540,"ins":0},{"id":"15","kind":"label","chars":6,"max":8,"perLine":8.5,"lines":1,"caps":true,"sz":28.0,"paras":1,"text":"MAQSAD","font":"Times New Roman","anchor":"t","box":[1371600,8483599,1778000,508000],"lineH":426720,"ins":0,"useW":0.866},{"id":"16","kind":"text","chars":74,"max":74,"perLine":24.7,"lines":3,"caps":false,"sz":30.0,"paras":1,"text":"Tirik GMOlarni chegaradan tashishda biologik xilma-xillikni himoya qilish.","font":"Times New Roman","anchor":"t","box":[3238500,8318500,5778500,1524000],"lineH":457200,"ins":0}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"21","kind":"title","chars":19,"max":34,"perLine":16.9,"lines":2,"caps":true,"sz":50.0,"paras":1,"text":"BAYONNOMA QOIDALARI","font":"Times New Roman","anchor":"t","box":[9144000,1904999,6350000,1778000],"lineH":762000,"ins":0,"useW":0.66},{"id":"22","kind":"label","chars":15,"max":26,"perLine":26.0,"lines":1,"caps":true,"sz":26.0,"paras":1,"text":"ASOSIY QOIDALAR","font":"Times New Roman","anchor":"t","box":[9644314,1566511,5080000,508000],"lineH":396240,"ins":0,"useW":0.59,"base":0.965,"tail":0.195,"below":[{"id":"21","gap":1.025,"cap":0.581}]},{"id":"23","kind":"text","chars":112,"max":112,"perLine":28.0,"lines":4,"caps":false,"sz":31.0,"paras":1,"text":"Oldindan asoslangan kelishuv: tirik GMO ilk bor olib kirilishidan oldin import qiluvchi davlat roziligi olinadi.","font":"Times New Roman","anchor":"t","box":[9550399,4000500,8128000,1879600],"lineH":472440,"ins":0},{"id":"24","kind":"text","chars":81,"max":81,"perLine":20.2,"lines":4,"caps":false,"sz":31.0,"paras":1,"text":"Axborot almashinuv markazi: GMOlar haqidagi ma'lumotlar xalqaro bazaga joylanadi.","font":"Times New Roman","anchor":"t","box":[9550399,5969000,8128000,1879600],"lineH":472440,"ins":0},{"id":"25","kind":"text","chars":89,"max":89,"perLine":22.2,"lines":4,"caps":false,"sz":31.0,"paras":1,"text":"Xavfni baholash va yorliqlash: yuklar GMO tarkibi ko'rsatilgan hujjatlar bilan tashiladi.","font":"Times New Roman","anchor":"t","box":[9550399,7937500,8128000,1879600],"lineH":472440,"ins":0}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"content","slots":[{"id":"13","kind":"title","chars":11,"max":16,"perLine":15.9,"lines":1,"caps":true,"sz":66.0,"paras":1,"text":"O'ZBEKISTON","font":"Times New Roman","anchor":"t","box":[9828895,2180483,7874000,1270000],"lineH":1005840,"ins":0,"useW":0.687},{"id":"14","kind":"label","chars":14,"max":23,"perLine":22.6,"lines":1,"caps":true,"sz":30.0,"paras":1,"text":"NAZORAT TIZIMI","font":"Times New Roman","anchor":"t","box":[10384594,1566512,5080000,533400],"lineH":457200,"ins":0,"useW":0.609},{"id":"15","kind":"text","chars":224,"max":224,"perLine":28.0,"lines":8,"caps":false,"sz":34.0,"paras":3,"text":"O'zbekiston bayonnomaga 2019-yil 14-oktyabrdagi O'RQ-569-son Qonun bilan qo'shildi.\nBayonnoma mamlakatimizda 2020-yil 23-yanvardan kuchga kirgan.\n2026-yilda milliy biologik xavfsizlik tizimini joriy etish loyihasi boshlandi.","font":"Times New Roman","anchor":"t","box":[9144000,4038600,8445500,4191000],"lineH":518160,"ins":0},{"id":"16","kind":"label","chars":7,"max":9,"perLine":9.4,"lines":1,"caps":true,"sz":27.0,"paras":1,"text":"NAZORAT","font":"Times New Roman","anchor":"t","box":[9144000,8483599,1905000,508000],"lineH":411480,"ins":0,"useW":0.858},{"id":"17","kind":"text","chars":69,"max":69,"perLine":23.0,"lines":3,"caps":false,"sz":30.0,"paras":1,"text":"Chegarada GMO tarkibi tekshiriladi, laboratoriya tahlili o'tkaziladi.","font":"Times New Roman","anchor":"t","box":[11112499,8318500,6477000,1524000],"lineH":457200,"ins":0}],"photos":[]},{"n":12,"part":"ppt/slides/slide12.xml","role":"content","slots":[{"id":"15","kind":"title","chars":13,"max":16,"perLine":16.4,"lines":1,"caps":true,"sz":66.0,"paras":1,"text":"KALIT FAKTLAR","font":"Times New Roman","anchor":"t","box":[1716939,2180483,8128000,1270000],"lineH":1005840,"ins":0,"useW":0.809},{"id":"16","kind":"label","chars":8,"max":17,"perLine":16.9,"lines":1,"caps":true,"sz":30.0,"paras":1,"text":"QISQACHA","font":"Times New Roman","anchor":"t","box":[1795921,1566512,3810000,533400],"lineH":457200,"ins":0,"useW":0.516},{"id":"17","kind":"text","chars":66,"max":66,"perLine":22.0,"lines":3,"caps":false,"sz":31.0,"paras":1,"text":"1994 – birinchi GM oziq-ovqat (Flavr Savr pomidori) sotuvga chiqdi","font":"Times New Roman","anchor":"t","box":[1968500,3936999,7493000,1397000],"lineH":472440,"ins":0},{"id":"18","kind":"label","chars":53,"max":53,"perLine":17.7,"lines":3,"caps":false,"sz":31.0,"paras":1,"text":"2000 – Kartaxena bayonnomasi Montrealda qabul qilindi","font":"Times New Roman","anchor":"t","box":[1968500,5460999,7493000,1397000],"lineH":472440,"ins":0,"useW":0.921,"base":3.365,"tail":0.216,"below":[{"id":"19","gap":3.871,"cap":0.302}]},{"id":"19","kind":"label","chars":46,"max":46,"perLine":15.3,"lines":3,"caps":false,"sz":31.0,"paras":1,"text":"2003 – bayonnoma xalqaro miqyosda kuchga kirdi","font":"Times New Roman","anchor":"t","box":[1968500,6984999,7493000,1397000],"lineH":472440,"ins":0,"useW":0.955,"base":3.365,"tail":0.216,"below":[{"id":"20","gap":3.871,"cap":0.302}]},{"id":"20","kind":"label","chars":43,"max":43,"perLine":14.3,"lines":3,"caps":false,"sz":31.0,"paras":1,"text":"2020 – bayonnoma O'zbekistonda kuchga kirdi","font":"Times New Roman","anchor":"t","box":[1968500,8508999,7493000,1397000],"lineH":472440,"ins":0,"useW":0.99}],"photos":[]},{"n":13,"part":"ppt/slides/slide13.xml","role":"content","slots":[{"id":"12","kind":"title","chars":6,"max":11,"perLine":11.0,"lines":1,"caps":true,"sz":80.0,"paras":1,"text":"XULOSA","font":"Times New Roman","anchor":"t","box":[2479895,2032000,6604000,1397000],"lineH":1219200,"ins":0,"useW":0.623},{"id":"13","kind":"label","chars":15,"max":23,"perLine":22.6,"lines":1,"caps":true,"sz":30.0,"paras":1,"text":"ASOSIY G'OYALAR","font":"Times New Roman","anchor":"t","box":[2272639,1498600,5080000,533400],"lineH":457200,"ins":0,"useW":0.669},{"id":"14","kind":"text","chars":241,"max":241,"perLine":30.1,"lines":8,"caps":false,"sz":34.0,"paras":3,"text":"GM ekinlar hosildorlik va chidamlilikni oshirib, oziq-ovqat xavfsizligiga hissa qo'shadi.\nGen oqimi, chidamli begona o'tlar va allergen xavfi puxta nazoratni talab qiladi.\nKartaxena bayonnomasi va milliy qonunchilik bu xavflarni kamaytiradi.","font":"Times New Roman","anchor":"t","box":[1371600,4038599,7620000,4191000],"lineH":518160,"ins":0},{"id":"15","kind":"label","chars":7,"max":8,"perLine":8.5,"lines":1,"caps":true,"sz":28.0,"paras":1,"text":"TAVSIYA","font":"Times New Roman","anchor":"t","box":[1371600,8483599,1778000,508000],"lineH":426720,"ins":0,"useW":0.875},{"id":"16","kind":"label","chars":50,"max":50,"perLine":16.7,"lines":3,"caps":false,"sz":30.0,"paras":1,"text":"Ilmiy baholash, ochiq axborot va yorliqlash muhim.","font":"Times New Roman","anchor":"t","box":[3238500,8318500,5778500,1524000],"lineH":457200,"ins":0,"useW":0.869}],"photos":[]},{"n":14,"part":"ppt/slides/slide14.xml","role":"end","slots":[{"id":"19","kind":"title","chars":26,"max":26,"perLine":8.7,"lines":3,"caps":true,"sz":80.0,"paras":1,"text":"E'TIBORINGIZ UCHUN RAHMAT!","font":"Times New Roman","anchor":"t","box":[3174999,3619500,11938000,3302000],"lineH":1219200,"ins":0,"useW":0.877}],"photos":[]}]}