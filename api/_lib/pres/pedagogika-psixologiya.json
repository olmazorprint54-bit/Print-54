{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"9","kind":"label","chars":18,"max":39,"perLine":38.6,"lines":1,"caps":false,"sz":40.0,"paras":1,"text":"Oliy ta'lim tizimi","font":"Times New Roman","anchor":"t","box":[1028699,2730500,8128000,711200],"lineH":609600,"ins":0,"useW":0.429},{"id":"10","kind":"label","chars":19,"max":51,"perLine":50.8,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"Tayyorladi: Muxlisa","font":"Times New Roman","anchor":"t","box":[1028700,8128000,7620000,635000],"lineH":434340,"ins":0,"useW":0.389},{"id":"11","kind":"label","chars":7,"max":22,"perLine":22.4,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"Muxlisa","font":"Times New Roman","anchor":"t","box":[1896843,1092266,2477374,342017],"lineH":373380,"ins":0,"useW":0.353},{"id":"12","kind":"title","chars":25,"max":28,"perLine":28.1,"lines":1,"caps":false,"sz":60.0,"paras":1,"text":"Oliy ta'lim o'quv rejasi:","font":"Times New Roman","anchor":"t","box":[1028700,3619500,8890000,1143000],"lineH":914400,"ins":0,"useW":0.805,"base":0.965,"tail":0.216,"below":[{"id":"13","gap":1.5,"cap":0.272}]},{"id":"13","kind":"label","chars":20,"max":31,"perLine":31.3,"lines":1,"caps":false,"sz":54.0,"paras":1,"text":"nazariya va amaliyot","font":"Times New Roman","anchor":"t","box":[1028700,4762500,8890000,1016000],"lineH":822960,"ins":0,"useW":0.641}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"10","kind":"title","chars":6,"max":20,"perLine":20.1,"lines":1,"caps":false,"sz":64.0,"paras":1,"text":"Kirish","font":"Times New Roman","anchor":"t","box":[9740900,2413000,6781800,1270000],"lineH":975360,"ins":0,"useW":0.3,"base":0.965,"tail":0.216,"below":[{"id":"11","gap":1.797,"cap":0.142}]},{"id":"11","kind":"text","chars":405,"max":405,"perLine":33.8,"lines":12,"caps":false,"sz":30.0,"paras":1,"text":"Oliy ta'limda o'quv rejasi mutaxassis tayyorlash sifatini belgilovchi asosiy hujjatdir. Unda fanlar ro'yxati, o'qitish ketma-ketligi, soatlar va kreditlar hajmi belgilanadi. Nazariya va amaliyot muvozanati bitiruvchining kasbiy kompetensiyalari va mehnat bozoridagi raqobatbardoshligiga bevosita ta'sir qiladi. 2020-yildan boshlab oliy ta'lim muassasalari bosqichma-bosqich kredit-modul tizimiga o'tmoqda.","font":"Times New Roman","anchor":"t","box":[9740900,3873500,7239000,5588000],"lineH":457200,"ins":0},{"id":"12","kind":"label","chars":7,"max":22,"perLine":22.4,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"Muxlisa","font":"Times New Roman","anchor":"t","box":[1896843,1092266,2477374,342017],"lineH":373380,"ins":0,"useW":0.353}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"12","kind":"title","chars":18,"max":42,"perLine":42.5,"lines":1,"caps":false,"sz":56.0,"paras":1,"text":"O'quv reja turlari","font":"Times New Roman","anchor":"t","box":[2885247,1295663,12517506,1068203],"lineH":853440,"ins":0,"useW":0.388},{"id":"13","kind":"text","chars":95,"max":95,"perLine":11.9,"lines":8,"caps":false,"sz":26.0,"paras":1,"text":"Namunaviy reja – ta'lim yo'nalishi uchun vazirlik darajasida ishlab chiqiladigan asosiy andoza.","font":"Times New Roman","anchor":"t","box":[1460500,4699000,4318000,3302000],"lineH":396240,"ins":0},{"id":"14","kind":"text","chars":99,"max":99,"perLine":12.4,"lines":8,"caps":false,"sz":26.0,"paras":1,"text":"Ishchi reja – OTM tomonidan namunaviy reja asosida tuziladi va mahalliy ehtiyojlarni hisobga oladi.","font":"Times New Roman","anchor":"t","box":[7010400,4699000,4318000,3302000],"lineH":396240,"ins":0},{"id":"15","kind":"text","chars":91,"max":91,"perLine":11.4,"lines":8,"caps":false,"sz":26.0,"paras":1,"text":"Yakka (individual) reja – talabaning tanlov fanlari asosidagi shaxsiy ta'lim traektoriyasi.","font":"Times New Roman","anchor":"t","box":[12547600,4699000,4318000,3302000],"lineH":396240,"ins":0}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"5","kind":"title","chars":25,"max":62,"perLine":31.0,"lines":2,"caps":false,"sz":42.0,"paras":1,"text":"O'quv rejasining mohiyati","font":"Times New Roman","anchor":"t","box":[1028700,2349500,6858000,1524000],"lineH":640080,"ins":0,"useW":0.809,"base":2.165,"tail":0.216,"below":[{"id":"13","gap":2.857,"cap":0.194}]},{"id":"13","kind":"text","chars":373,"max":373,"perLine":41.4,"lines":9,"caps":false,"sz":27.0,"paras":4,"text":"Ta'lim yo'nalishi bo'yicha fanlar ro'yxati, ularni o'rganish ketma-ketligi, hajmi (soat, kredit), semestrlar va nazorat shakllarini belgilovchi asosiy hujjat.\nBakalavriat va magistratura uchun alohida ishlab chiqiladi.\nFanlar bloklarga ajratiladi: majburiy fanlar, tanlov fanlari va malakaviy amaliyot.\nHar bir fan uchun auditoriya va mustaqil ta'lim soatlari ko'rsatiladi.","font":"Times New Roman","anchor":"t","box":[1028699,3873500,8382000,3810000],"lineH":411480,"ins":0},{"id":"14","kind":"label","chars":7,"max":22,"perLine":22.4,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"Muxlisa","font":"Times New Roman","anchor":"t","box":[1896843,1092266,2477374,342017],"lineH":373380,"ins":0,"useW":0.353}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"3","kind":"title","chars":16,"max":42,"perLine":21.1,"lines":2,"caps":false,"sz":64.0,"paras":1,"text":"Me'yoriy asoslar","font":"Times New Roman","anchor":"t","box":[1028699,3809999,7112000,2159000],"lineH":975360,"ins":0,"useW":0.759,"base":2.165,"tail":0.216,"below":[{"id":"4","gap":2.969,"cap":0.135}]},{"id":"4","kind":"text","chars":173,"max":173,"perLine":21.6,"lines":8,"caps":false,"sz":28.5,"paras":1,"text":"O'zbekiston Respublikasining «Ta'lim to'g'risida»gi Qonuni (2020-yil 23-sentyabr, O'RQ-637) va davlat ta'lim standartlari o'quv rejasini shakllantirishning huquqiy asosidir.","font":"Times New Roman","anchor":"t","box":[1028700,6223000,7874000,3302000],"lineH":434340,"ins":0},{"id":"5","kind":"text","chars":92,"max":92,"perLine":15.3,"lines":6,"caps":false,"sz":27.5,"paras":1,"text":"Qonun ta'lim sifati, OTMlarning akademik mustaqilligi va talabalar huquqlarini kafolatlaydi.","font":"Times New Roman","anchor":"t","box":[10198099,1015999,7112000,2413000],"lineH":419100,"ins":0},{"id":"6","kind":"text","chars":117,"max":117,"perLine":19.5,"lines":6,"caps":false,"sz":27.5,"paras":1,"text":"Davlat ta'lim standartlari bitiruvchining bilim, ko'nikma va malakalariga qo'yiladigan minimal talablarni belgilaydi.","font":"Times New Roman","anchor":"t","box":[10198099,3873499,7112000,2413000],"lineH":419100,"ins":0},{"id":"7","kind":"text","chars":145,"max":145,"perLine":24.2,"lines":6,"caps":false,"sz":27.5,"paras":1,"text":"«Oliy ta'lim tizimini 2030-yilgacha rivojlantirish konsepsiyasi» (2019) va vazirlik buyruqlari kredit-modul tizimiga o'tish tartibini belgilaydi.","font":"Times New Roman","anchor":"t","box":[10198099,6730999,7112000,2667000],"lineH":419100,"ins":0},{"id":"9","kind":"label","chars":7,"max":22,"perLine":22.4,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"Muxlisa","font":"Times New Roman","anchor":"t","box":[1896843,1092266,2477374,342017],"lineH":373380,"ins":0,"useW":0.353}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"5","kind":"title","chars":28,"max":28,"perLine":14.0,"lines":2,"caps":false,"sz":54.0,"paras":1,"text":"Nazariya va amaliyot nisbati","font":"Times New Roman","anchor":"t","box":[1028699,2349499,8128000,1778000],"lineH":822960,"ins":0,"useW":0.966,"base":2.165,"tail":0.216,"below":[{"id":"6","gap":2.87,"cap":0.154}]},{"id":"6","kind":"text","chars":399,"max":399,"perLine":30.7,"lines":13,"caps":false,"sz":27.5,"paras":4,"text":"Nazariy fanlar talabaga ilmiy asos, tushunchalar va tahliliy fikrlashni beradi.\nAmaliy mashg'ulotlar, laboratoriya ishlari va malakaviy amaliyot bilimni kasbiy ko'nikmaga aylantiradi.\nZamonaviy yondashuvda amaliy qism ulushi oshirilib, ish beruvchilar bilan hamkorlik kuchaytiriladi.\nMuvozanat buzilsa: ortiqcha nazariya – amaliyotdan uzilgan bilim, ortiqcha amaliyot – chuqur tushunchasiz ko'nikma.","font":"Times New Roman","anchor":"t","box":[1028699,4318000,8636000,5588000],"lineH":419100,"ins":0},{"id":"8","kind":"label","chars":7,"max":22,"perLine":22.4,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"Muxlisa","font":"Times New Roman","anchor":"t","box":[1896843,1092266,2477374,342017],"lineH":373380,"ins":0,"useW":0.353}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"9","kind":"text","chars":242,"max":242,"perLine":22.0,"lines":11,"caps":false,"sz":30.0,"paras":2,"text":"O'quv reja – oliy ta'lim sifatining asosi. Nazariya va amaliyot uyg'unligi, kredit-modul tizimi va ish beruvchilar bilan hamkorlik raqobatbardosh mutaxassis tayyorlash garovidir.\n«Nazariyasiz amaliyot ko'r, amaliyotsiz nazariya esa quruqdir.»","font":"Times New Roman","anchor":"t","box":[1028699,3873500,8382000,5080000],"lineH":457200,"ins":0},{"id":"10","kind":"title","chars":6,"max":19,"perLine":18.8,"lines":1,"caps":false,"sz":64.0,"paras":1,"text":"Xulosa","font":"Times New Roman","anchor":"t","box":[1028700,2540000,6324600,1143000],"lineH":975360,"ins":0,"useW":0.364,"base":0.965,"tail":0.216,"below":[{"id":"9","gap":1.641,"cap":0.142}]},{"id":"11","kind":"label","chars":7,"max":22,"perLine":22.4,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"Muxlisa","font":"Times New Roman","anchor":"t","box":[1896843,1092266,2477374,342017],"lineH":373380,"ins":0,"useW":0.353}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"end","slots":[{"id":"9","kind":"label","chars":25,"max":43,"perLine":43.0,"lines":1,"caps":false,"sz":36.5,"paras":1,"text":"Foydalanilgan adabiyotlar","font":"Times New Roman","anchor":"t","box":[1028699,4953000,8255000,635000],"lineH":556260,"ins":0,"useW":0.587,"base":0.965,"tail":0.216,"below":[{"id":"10","gap":1.644,"cap":0.195}]},{"id":"10","kind":"text","chars":305,"max":305,"perLine":27.7,"lines":11,"caps":false,"sz":23.5,"paras":4,"text":"O'zbekiston Respublikasining «Ta'lim to'g'risida»gi Qonuni. 2020-yil 23-sentyabr, O'RQ-637.\nOliy ta'lim tizimini 2030-yilgacha rivojlantirish konsepsiyasi. PF-5847, 2019-yil 8-oktyabr.\nOliy ta'limning davlat ta'lim standartlari.\nOliy ta'limda kredit-modul tizimini joriy etish bo'yicha me'yoriy hujjatlar.","font":"Times New Roman","anchor":"t","box":[1028700,5715000,8890000,3810000],"lineH":358140,"ins":0},{"id":"11","kind":"label","chars":7,"max":22,"perLine":22.4,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"Muxlisa","font":"Times New Roman","anchor":"t","box":[1896843,1092266,2477374,342017],"lineH":373380,"ins":0,"useW":0.353},{"id":"12","kind":"title","chars":7,"max":17,"perLine":17.4,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Rahmat!","font":"Times New Roman","anchor":"t","box":[1028699,2921000,8255000,1651000],"lineH":1371600,"ins":0,"useW":0.476,"base":0.965,"tail":0.216,"below":[{"id":"9","gap":1.778,"cap":0.123}]}],"photos":[]}]}