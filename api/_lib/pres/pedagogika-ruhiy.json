{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"12","kind":"title","chars":23,"max":61,"perLine":30.6,"lines":2,"caps":false,"sz":60.0,"paras":1,"text":"Pedagogik antropologiya","font":"Times New Roman","anchor":"t","box":[1943099,1905000,9652000,1397000],"lineH":914400,"ins":0,"useW":0.791,"base":2.165,"tail":0.216,"below":[{"id":"13","gap":2.0,"cap":0.222}]},{"id":"13","kind":"label","chars":37,"max":42,"perLine":41.7,"lines":1,"caps":false,"sz":44.0,"paras":1,"text":"Shaxs va jamiyat integratsiyasi omili","font":"Times New Roman","anchor":"t","box":[1955800,3428999,9652000,711200],"lineH":670560,"ins":0,"useW":0.856,"base":0.965,"tail":0.216,"below":[{"id":"14","gap":1.477,"cap":0.251}]},{"id":"14","kind":"label","chars":24,"max":40,"perLine":39.7,"lines":1,"caps":false,"sz":36.5,"paras":1,"text":"Pedagogika fani asoslari","font":"Times New Roman","anchor":"t","box":[1943100,4254499,7620000,584200],"lineH":556260,"ins":0,"useW":0.594},{"id":"15","kind":"label","chars":11,"max":21,"perLine":21.3,"lines":1,"caps":false,"sz":34.0,"paras":1,"text":"Tayyorladi:","font":"Times New Roman","anchor":"t","box":[1943099,6096000,3810000,533400],"lineH":518160,"ins":0,"useW":0.528,"base":0.965,"tail":0.216,"below":[{"id":"17","gap":1.294,"cap":0.347}]},{"id":"17","kind":"label","chars":7,"max":25,"perLine":24.7,"lines":1,"caps":false,"sz":39.0,"paras":1,"text":"Muxlisa","font":"Times New Roman","anchor":"t","box":[1968499,6654799,5080000,584200],"lineH":594360,"ins":0,"useW":0.32}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"11","kind":"title","chars":6,"max":25,"perLine":25.4,"lines":1,"caps":true,"sz":50.0,"paras":1,"text":"KIRISH","font":"Times New Roman","anchor":"t","box":[1606400,1452755,9526566,933450],"lineH":762000,"ins":0,"useW":0.222},{"id":"12","kind":"text","chars":368,"max":368,"perLine":61.3,"lines":6,"caps":false,"sz":29.0,"paras":1,"text":"Tarbiya jarayonini to'g'ri tashkil etish uchun inson tabiatini chuqur bilish zarur. Pedagogik antropologiya insonni tarbiya ob'ekti va sub'ekti sifatida o'rganib, shaxs va jamiyat uyg'unligini ta'minlashga xizmat qiladi. Globallashuv sharoitida yoshlarni jamiyat hayotiga tayyorlash, ularning qobiliyat va ehtiyojlarini hisobga olish bu fanning dolzarbligini oshiradi.","font":"Times New Roman","anchor":"t","box":[1600200,3111499,9906000,2667000],"lineH":441960,"ins":0},{"id":"13","kind":"label","chars":16,"max":34,"perLine":33.9,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"~ K.D. Ushinskiy","font":"Times New Roman","anchor":"t","box":[1600199,5918199,5080000,431800],"lineH":434340,"ins":0,"useW":0.502},{"id":"14","kind":"text","chars":105,"max":105,"perLine":35.0,"lines":3,"caps":false,"sz":31.0,"paras":1,"text":"«Agar pedagogika insonni har tomonlama tarbiyalamoqchi bo'lsa, u avvalo uni har tomonlama bilishi kerak.»","font":"Times New Roman","anchor":"t","box":[3327399,7111999,8763000,1460500],"lineH":472440,"ins":0}],"photos":[{"id":"6","w":8141529,"h":11882882,"area":0.514}]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"24","kind":"text","chars":231,"max":231,"perLine":15.4,"lines":15,"caps":false,"sz":28.5,"paras":1,"text":"Tarbiya shaxsni jamiyat hayotiga tayyorlaydi: umumiy qadriyatlar, qonunlar va madaniyatni o'zlashtirish orqali ijtimoiy birlik mustahkamlanadi. Milliy qadriyatlar va umuminsoniy g'oyalar integratsiyaning ma'naviy poydevori bo'ladi.","font":"Times New Roman","anchor":"t","box":[1028699,2920999,3810000,6350000],"lineH":434340,"ins":0},{"id":"25","kind":"title","chars":17,"max":30,"perLine":30.1,"lines":1,"caps":true,"sz":50.0,"paras":1,"text":"TARBIYANING O'RNI","font":"Times New Roman","anchor":"t","box":[1028700,1000125,11290332,933450],"lineH":762000,"ins":0,"useW":0.551},{"id":"26","kind":"label","chars":4,"max":33,"perLine":16.3,"lines":2,"caps":false,"sz":26.0,"paras":1,"text":"Oila","font":"Times New Roman","anchor":"t","box":[6827310,2450405,2224852,711200],"lineH":396240,"ins":0,"useW":0.255},{"id":"27","kind":"label","chars":6,"max":35,"perLine":17.7,"lines":2,"caps":false,"sz":26.0,"paras":1,"text":"Maktab","font":"Times New Roman","anchor":"t","box":[4322978,7270750,2423061,711200],"lineH":396240,"ins":0,"useW":0.416},{"id":"28","kind":"label","chars":18,"max":28,"perLine":13.8,"lines":2,"caps":false,"sz":23.5,"paras":1,"text":"Mahalla va jamiyat","font":"Times New Roman","anchor":"t","box":[5410612,4760595,1710850,711200],"lineH":358140,"ins":0,"useW":0.778},{"id":"29","kind":"label","chars":11,"max":35,"perLine":17.7,"lines":2,"caps":false,"sz":26.0,"paras":1,"text":"Qadriyatlar","font":"Times New Roman","anchor":"t","box":[15246986,1760795,2423061,711200],"lineH":396240,"ins":0,"useW":0.619}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"6","kind":"text","chars":224,"max":224,"perLine":32.0,"lines":7,"caps":false,"sz":27.5,"paras":5,"text":"Inson – biologik mavjudot (irsiyat, tana, temperament)\nInson – ijtimoiy mavjudot (muloqot, jamiyat)\nInson – ma'naviy shaxs (qadriyat, e'tiqod)\nInson – faoliyat sub'ekti (mehnat, ijod)\nInson – tarbiyalanuvchi va tarbiyalovchi","font":"Times New Roman","anchor":"t","box":[1270000,4749799,6667500,2997200],"lineH":419100,"ins":0},{"id":"8","kind":"title","chars":26,"max":26,"perLine":8.7,"lines":3,"caps":true,"sz":46.0,"paras":1,"text":"INSON HAQIDAGI TA'LIMOTLAR","font":"Times New Roman","anchor":"t","box":[1028700,1003300,7620000,1905000],"lineH":701040,"ins":0,"useW":0.635},{"id":"9","kind":"text","chars":101,"max":101,"perLine":33.7,"lines":3,"caps":false,"sz":27.5,"paras":1,"text":"Falsafiy, psixologik va biologik yondashuvlar insonni yaxlit tizim sifatida tushunishga asos bo'ladi.","font":"Times New Roman","anchor":"t","box":[1333500,7810499,6667500,1333500],"lineH":419100,"ins":0}],"photos":[{"id":"2","w":11756571,"h":8229600,"area":0.514}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"29","kind":"text","chars":91,"max":91,"perLine":10.1,"lines":9,"caps":false,"sz":27.5,"paras":1,"text":"Ota-onadan o'tgan biologik xususiyatlar va tug'ma layoqatlar – rivojlanish uchun imkoniyat.","font":"Times New Roman","anchor":"t","box":[1418112,5968999,2857500,3810000],"lineH":419100,"ins":0},{"id":"30","kind":"text","chars":76,"max":76,"perLine":8.4,"lines":9,"caps":false,"sz":27.5,"paras":1,"text":"Oila, mahalla, maktab va jamiyat shaxs qarashlari va xulqini shakllantiradi.","font":"Times New Roman","anchor":"t","box":[4630593,5968999,2857500,3810000],"lineH":419100,"ins":0},{"id":"31","kind":"text","chars":81,"max":81,"perLine":9.0,"lines":9,"caps":false,"sz":27.5,"paras":1,"text":"Maqsadli va tizimli ta'sir irsiyat va muhit imkoniyatlarini to'g'ri yo'naltiradi.","font":"Times New Roman","anchor":"t","box":[7843073,5968999,2857500,3810000],"lineH":419100,"ins":0},{"id":"32","kind":"text","chars":75,"max":75,"perLine":8.3,"lines":9,"caps":false,"sz":27.5,"paras":1,"text":"O'yin, o'qish va mehnat orqali bilim, ko'nikma va qobiliyatlar rivojlanadi.","font":"Times New Roman","anchor":"t","box":[11055554,5968999,2857500,3810000],"lineH":419100,"ins":0},{"id":"33","kind":"text","chars":76,"max":76,"perLine":8.4,"lines":9,"caps":false,"sz":27.5,"paras":1,"text":"O'z-o'zini tarbiyalash va o'z ustida ishlash – rivojlanishning ichki manbai.","font":"Times New Roman","anchor":"t","box":[14268034,5968999,2857500,3810000],"lineH":419100,"ins":0},{"id":"34","kind":"title","chars":18,"max":31,"perLine":30.8,"lines":1,"caps":true,"sz":44.0,"paras":1,"text":"SHAXS RIVOJLANISHI","font":"Times New Roman","anchor":"t","box":[1028699,1003300,10160000,939800],"lineH":670560,"ins":0,"useW":0.569},{"id":"35","kind":"label","chars":7,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"Irsiyat","font":"Times New Roman","anchor":"t","box":[1322039,5232400,2794000,508000],"lineH":434340,"ins":0,"useW":0.33},{"id":"36","kind":"label","chars":5,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"Muhit","font":"Times New Roman","anchor":"t","box":[4534518,5232400,2794000,508000],"lineH":434340,"ins":0,"useW":0.317},{"id":"37","kind":"label","chars":7,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"Tarbiya","font":"Times New Roman","anchor":"t","box":[7747000,5232400,2794000,508000],"lineH":434340,"ins":0,"useW":0.401},{"id":"38","kind":"label","chars":8,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"Faoliyat","font":"Times New Roman","anchor":"t","box":[10884290,5232400,2794000,508000],"lineH":434340,"ins":0,"useW":0.425},{"id":"39","kind":"label","chars":7,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"Faollik","font":"Times New Roman","anchor":"t","box":[14170950,5232400,2794000,508000],"lineH":434340,"ins":0,"useW":0.368}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"10","kind":"text","chars":371,"max":371,"perLine":24.7,"lines":15,"caps":false,"sz":32.5,"paras":4,"text":"Inson haqidagi fanlar – falsafa, psixologiya, biologiya, sotsiologiya va madaniyatshunoslik ma'lumotlarini tarbiya maqsadlarida birlashtiruvchi fan.\nInson kimligi, uning rivojlanish qonuniyatlari va tarbiyalanuvchanligini o'rganadi.\nOb'ekti – inson; predmeti – tarbiya jarayonidagi inson rivojlanishi.\nAsosiy vazifasi – tarbiya va ta'limni inson tabiatiga muvofiq qurish.","font":"Times New Roman","anchor":"t","box":[10540999,1904999,6858000,7620000],"lineH":495300,"ins":0},{"id":"11","kind":"title","chars":23,"max":29,"perLine":29.2,"lines":1,"caps":true,"sz":44.0,"paras":1,"text":"PEDAGOGIK ANTROPOLOGIYA","font":"Times New Roman","anchor":"t","box":[1028699,1000125,9652000,939800],"lineH":670560,"ins":0,"useW":0.846}],"photos":[{"id":"6","w":10529040,"h":10190991,"area":0.57}]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"18","kind":"text","chars":106,"max":106,"perLine":10.6,"lines":10,"caps":false,"sz":27.5,"paras":1,"text":"Birlamchi ijtimoiylashuv: oilada bola til, qadriyatlar, muomala odobi va kundalik ko'nikmalarni o'rganadi.","font":"Times New Roman","anchor":"t","box":[10223500,2412999,2730500,4191000],"lineH":419100,"ins":0},{"id":"19","kind":"text","chars":90,"max":90,"perLine":9.0,"lines":10,"caps":false,"sz":27.5,"paras":1,"text":"Ikkilamchi ijtimoiylashuv: maktab, tengdoshlar, mahalla va OAV dunyoqarashni kengaytiradi.","font":"Times New Roman","anchor":"t","box":[14135100,2412999,2730500,4191000],"lineH":419100,"ins":0},{"id":"20","kind":"text","chars":98,"max":98,"perLine":24.5,"lines":4,"caps":false,"sz":27.5,"paras":1,"text":"Kattalar davri: kasb egallash, mehnat jamoasi va fuqarolik rollarini o'zlashtirish, umrbod o'qish.","font":"Times New Roman","anchor":"t","box":[11874500,7340599,5080000,1778000],"lineH":419100,"ins":0},{"id":"22","kind":"label","chars":4,"max":28,"perLine":14.2,"lines":2,"caps":false,"sz":36.0,"paras":1,"text":"Oila","font":"Times New Roman","anchor":"t","box":[10282187,1363856,2682031,933450],"lineH":548640,"ins":0,"useW":0.293,"base":2.165,"tail":0.216,"below":[{"id":"18","gap":2.295,"cap":0.231}]},{"id":"23","kind":"label","chars":6,"max":28,"perLine":14.2,"lines":2,"caps":false,"sz":36.0,"paras":1,"text":"Maktab","font":"Times New Roman","anchor":"t","box":[14199982,1363856,2682031,933450],"lineH":548640,"ins":0,"useW":0.52,"base":2.165,"tail":0.216,"below":[{"id":"19","gap":2.295,"cap":0.231}]},{"id":"24","kind":"label","chars":4,"max":8,"perLine":7.4,"lines":1,"caps":false,"sz":39.0,"paras":1,"text":"Kasb","font":"Times New Roman","anchor":"t","box":[10223500,7620000,1524000,762000],"lineH":594360,"ins":0,"useW":0.666},{"id":"21","kind":"title","chars":21,"max":22,"perLine":22.3,"lines":1,"caps":true,"sz":44.0,"paras":1,"text":"SHAXS IJTIMOIYLASHUVI","font":"Times New Roman","anchor":"ctr","box":[762000,7975600,7366000,939800],"lineH":670560,"ins":0,"useW":0.928}],"photos":[{"id":"12","w":8790331,"h":10287000,"area":0.481}]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"16","kind":"text","chars":212,"max":212,"perLine":35.3,"lines":6,"caps":false,"sz":31.0,"paras":1,"text":"Antropologik g'oyalar qadimgi Yunonistonda Sokrat, Aflotun va Arastu asarlarida shakllangan. Sharqda Forobiy («Fozil odamlar shahri»), Ibn Sino, Beruniy va Alisher Navoiy komil inson haqidagi ta'limotni yaratgan.","font":"Times New Roman","anchor":"t","box":[9613899,1333499,7620000,2921000],"lineH":472440,"ins":0},{"id":"17","kind":"text","chars":174,"max":174,"perLine":15.8,"lines":11,"caps":false,"sz":30.0,"paras":1,"text":"1868–1869-yillarda K.D. Ushinskiy «Inson tarbiya predmeti sifatida» asarini yozdi. XX asrda M. Sheler, O. Bolnov va boshqalar fanni mustaqil yo'nalish sifatida rivojlantirdi.","font":"Times New Roman","anchor":"t","box":[13080999,4381499,4191000,5080000],"lineH":457200,"ins":0},{"id":"18","kind":"title","chars":14,"max":22,"perLine":22.3,"lines":1,"caps":true,"sz":50.0,"paras":1,"text":"FANNING TARIXI","font":"Times New Roman","anchor":"t","box":[1121189,1000125,8381975,933450],"lineH":762000,"ins":0,"useW":0.615},{"id":"19","kind":"label","chars":12,"max":15,"perLine":15.4,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"Qadimgi davr","font":"Times New Roman","anchor":"t","box":[1978705,7479374,2305361,457200],"lineH":434340,"ins":0,"useW":0.867},{"id":"20","kind":"label","chars":15,"max":18,"perLine":17.9,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"Ushinskiy davri","font":"Times New Roman","anchor":"t","box":[5696878,4711064,2688874,457200],"lineH":434340,"ins":0,"useW":0.856},{"id":"21","kind":"label","chars":6,"max":19,"perLine":18.6,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"XX asr","font":"Times New Roman","anchor":"t","box":[9257239,7479374,2797632,457200],"lineH":434340,"ins":0,"useW":0.369}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"5","kind":"text","chars":264,"max":264,"perLine":15.5,"lines":17,"caps":false,"sz":32.5,"paras":8,"text":"Kirish\nPedagogik antropologiya tushunchasi\nFanning rivojlanish tarixi\nInson haqidagi ta'limotlar asoslari\nShaxs rivojlanishi va ijtimoiylashuvi\nJamiyat integratsiyasida tarbiyaning o'rni\nZamonaviy ta'limda antropologik yondashuv\nXulosa va foydalanilgan adabiyotlar","font":"Times New Roman","anchor":"t","box":[1524000,1079499,8128000,8255000],"lineH":495300,"ins":0},{"id":"7","kind":"title","chars":4,"max":14,"perLine":14.5,"lines":1,"caps":true,"sz":54.0,"paras":1,"text":"REJA","font":"Times New Roman","anchor":"t","box":[11392083,1186691,5867217,933450],"lineH":822960,"ins":0,"useW":0.279},{"id":"11","kind":"text","chars":144,"max":144,"perLine":14.4,"lines":10,"caps":false,"sz":34.0,"paras":1,"text":"Taqdimotda pedagogik antropologiyaning mohiyati, tarixi, shaxs rivojlanishi va ijtimoiylashuvi hamda jamiyatga integratsiya omillari yoritiladi.","font":"Times New Roman","anchor":"t","box":[11683999,3682999,5207000,5080000],"lineH":518160,"ins":0}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"end","slots":[{"id":"6","kind":"title","chars":26,"max":26,"perLine":8.7,"lines":3,"caps":true,"sz":52.0,"paras":1,"text":"E'TIBORINGIZ UCHUN RAHMAT!","font":"Times New Roman","anchor":"t","box":[3809999,1397000,10668000,2159000],"lineH":792480,"ins":0,"useW":0.941,"base":3.365,"tail":0.195,"below":[{"id":"7","gap":3.654,"cap":0.166}]},{"id":"7","kind":"text","chars":149,"max":149,"perLine":18.6,"lines":8,"caps":false,"sz":28.5,"paras":4,"text":"Foydalanilgan adabiyotlar:\nUshinskiy K.D. Inson tarbiya predmeti sifatida (1868–1869)\nForobiy. Fozil odamlar shahri\nIbn Sino, Alisher Navoiy asarlari","font":"Times New Roman","anchor":"t","box":[3809999,3809999,10668000,3429000],"lineH":434340,"ins":0},{"id":"8","kind":"label","chars":7,"max":12,"perLine":12.4,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"Tarbiya","font":"Times New Roman","anchor":"t","box":[3072553,7732680,1856189,508000],"lineH":434340,"ins":0,"useW":0.604},{"id":"9","kind":"label","chars":5,"max":15,"perLine":14.7,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"Shaxs","font":"Times New Roman","anchor":"t","box":[7689412,7732680,2212225,508000],"lineH":434340,"ins":0,"useW":0.391},{"id":"10","kind":"label","chars":7,"max":20,"perLine":20.0,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"Jamiyat","font":"Times New Roman","anchor":"t","box":[12092065,7732680,2996673,508000],"lineH":434340,"ins":0,"useW":0.376}],"photos":[]}]}