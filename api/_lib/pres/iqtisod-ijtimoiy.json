{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"16","kind":"title","chars":59,"max":59,"perLine":19.7,"lines":3,"caps":false,"sz":70.02,"paras":1,"text":"The Role of Social Innovation in Local Economic Development","font":"Bernoru SemiCondensed","anchor":"t","box":[7660296,3327261,10195617,2936903],"lineH":978154,"ins":0},{"id":"17","kind":"text","chars":110,"max":110,"perLine":36.7,"lines":3,"caps":false,"sz":31.29,"paras":1,"text":"The local economy can be improved by social innovation by creating creative solutions that empower communities","font":"B612","anchor":"t","box":[7660296,7217169,7672771,1430957],"lineH":476885,"ins":0},{"id":"18","kind":"label","chars":18,"max":21,"perLine":20.8,"lines":1,"caps":false,"sz":35.65,"paras":1,"text":"Arowwai Industries","font":"B612 Bold","anchor":"t","box":[8641287,1616797,4650382,543382],"lineH":543306,"ins":0}],"photos":[{"id":"3","w":4278559,"h":9220717,"area":0.21},{"id":"8","w":4278559,"h":9220717,"area":0.21}]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"9","kind":"text","chars":375,"max":375,"perLine":37.5,"lines":10,"caps":false,"sz":31.29,"paras":1,"text":"The quality of life of the community is directly influenced by the success of the local economy which plays an important role in improving community welfare. Local economies often face various difficulties, such as limited resources, market access, and lack of innovation. The main goal is to develop social innovation by creating innovative solutions tailored to local needs","font":"B612","anchor":"t","box":[9410407,4061699,7848893,4769856],"lineH":476885,"ins":0},{"id":"13","kind":"title","chars":12,"max":14,"perLine":13.8,"lines":1,"caps":false,"sz":71.5,"paras":1,"text":"Introduction","font":"Bernoru SemiCondensed","anchor":"t","box":[11160444,1710132,6035514,1019240],"lineH":998855,"ins":0}],"photos":[{"id":"5","w":6320333,"h":9220719,"area":0.31}]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"9","kind":"title","chars":31,"max":31,"perLine":15.5,"lines":2,"caps":false,"sz":73.63,"paras":1,"text":"Definition of Social Innovation","font":"Bernoru SemiCondensed","anchor":"t","box":[2259719,1663571,8115300,2066932],"lineH":1028573,"ins":0},{"id":"10","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":71.5,"paras":1,"text":"01","font":"Bernoru SemiCondensed","anchor":"t","box":[737454,6126794,1352562,1014738],"lineH":998855,"ins":0},{"id":"11","kind":"fixed","chars":2,"max":12,"perLine":4,"lines":1,"caps":false,"sz":71.5,"paras":1,"text":"02","font":"Bernoru SemiCondensed","anchor":"t","box":[737454,8243562,1352562,1014738],"lineH":998855,"ins":0},{"id":"12","kind":"text","chars":90,"max":90,"perLine":45.0,"lines":2,"caps":false,"sz":28.0,"paras":1,"text":"Social innovation involves creating new and effective solutions to address social problems","font":"B612","anchor":"t","box":[2259719,4515217,7881024,838200],"lineH":426720,"ins":0},{"id":"13","kind":"text","chars":121,"max":121,"perLine":40.3,"lines":3,"caps":false,"sz":28.0,"paras":1,"text":"Community empowerment is achieved through urban agriculture programs that grow vegetables and fruit in urban environments","font":"B612","anchor":"t","box":[2090017,6181725,7914597,1257300],"lineH":426720,"ins":0},{"id":"14","kind":"text","chars":135,"max":135,"perLine":45.0,"lines":3,"caps":false,"sz":28.0,"paras":1,"text":"The Village Clean Water System initiative aims to offer clean water access to remote villages using environmentally friendly technology","font":"B612","anchor":"t","box":[2090017,8001000,8285002,1257300],"lineH":426720,"ins":0}],"photos":[{"id":"8","w":6593036,"h":8229600,"area":0.288}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"2","kind":"title","chars":60,"max":60,"perLine":30.0,"lines":2,"caps":false,"sz":65.0,"paras":1,"text":"The Relationship between Social Innovation and Local Economy","font":"Bernoru SemiCondensed","anchor":"t","box":[1362109,1085850,13824928,1835150],"lineH":908050,"ins":0},{"id":"5","kind":"fixed","chars":3,"max":12,"perLine":7.0,"lines":1,"caps":false,"sz":47.88,"paras":1,"text":"30%","font":"B612 Bold","anchor":"t","box":[1893998,5134238,2106094,679131],"lineH":668909,"ins":0},{"id":"6","kind":"fixed","chars":3,"max":12,"perLine":7.0,"lines":1,"caps":false,"sz":47.88,"paras":1,"text":"50%","font":"B612 Bold","anchor":"t","box":[6829041,5134238,2106094,679131],"lineH":668909,"ins":0},{"id":"8","kind":"label","chars":30,"max":30,"perLine":10.0,"lines":3,"caps":false,"sz":26.81,"paras":1,"text":"Community Economic Empowerment","font":"B612 Bold","anchor":"t","box":[1547191,7499235,2799708,1213688],"lineH":408686,"ins":0},{"id":"9","kind":"label","chars":23,"max":23,"perLine":7.7,"lines":3,"caps":false,"sz":26.81,"paras":1,"text":"Improved Social Welfare","font":"B612 Bold","anchor":"t","box":[6797634,7499235,2168909,1213688],"lineH":408686,"ins":0},{"id":"12","kind":"text","chars":192,"max":192,"perLine":38.4,"lines":5,"caps":false,"sz":28.0,"paras":1,"text":"Social innovation enables communities to become economically independent and participate actively in the local economy through programs such as skills training and support for small businesses","font":"B612","anchor":"t","box":[10185854,4095750,7314568,2095500],"lineH":426720,"ins":0},{"id":"13","kind":"text","chars":183,"max":183,"perLine":36.6,"lines":5,"caps":false,"sz":28.0,"paras":1,"text":"Improving people's quality of life is directly impacted by social innovation through the creation of solutions to social problems, such as access to health, education, and clean water","font":"B612","anchor":"t","box":[10185854,6795881,7582533,2095500],"lineH":426720,"ins":0}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"3","kind":"title","chars":30,"max":31,"perLine":31.1,"lines":1,"caps":false,"sz":65.0,"paras":1,"text":"Case Study: Innovative Village","font":"Bernoru SemiCondensed","anchor":"t","box":[1028700,1307002,12399858,930275],"lineH":908050,"ins":0},{"id":"5","kind":"text","chars":426,"max":426,"perLine":35.5,"lines":12,"caps":false,"sz":31.29,"paras":1,"text":"By introducing creative solutions that drive business growth and empower communities, social innovation makes a significant contribution to local economic development. People can improve their standard of living and become more economically independent by creating new jobs. Social innovation also increases the competitiveness of local products and expands market access, thereby strengthening the regional economy as a whole","font":"B612","anchor":"t","box":[1028700,3534473,7818374,5723827],"lineH":476885,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"2","kind":"title","chars":54,"max":54,"perLine":27.0,"lines":2,"caps":false,"sz":65.0,"paras":1,"text":"The Role of Government in Supporting Social Innovation","font":"Bernoru SemiCondensed","anchor":"t","box":[2604826,1714632,12910592,1835150],"lineH":908050,"ins":0},{"id":"3","kind":"text","chars":472,"max":472,"perLine":59.0,"lines":8,"caps":false,"sz":35.0,"paras":1,"text":"Social innovation is supported by the government by providing supportive policies, supportive regulations, and the necessary funding to facilitate social projects. Governments can reduce barriers for social innovation practitioners by creating inclusive legal frameworks and developing incentive programs. Governments can also partner with the private sector and communities to create an ecosystem that encourages experimentation and implementation of innovative solutions","font":"B612","anchor":"t","box":[2240739,4352793,13638766,4276725],"lineH":533400,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"10","kind":"title","chars":41,"max":41,"perLine":20.5,"lines":2,"caps":false,"sz":65.73,"paras":1,"text":"Challenges in spreading Social Innovation","font":"Bernoru SemiCondensed","anchor":"t","box":[7328740,397716,9983857,1851109],"lineH":918337,"ins":0},{"id":"24","kind":"label","chars":22,"max":22,"perLine":11.0,"lines":2,"caps":false,"sz":35.0,"paras":1,"text":"Scalability Challenges","font":"B612","anchor":"t","box":[7945404,6845921,2780805,1076325],"lineH":533400,"ins":0},{"id":"25","kind":"label","chars":21,"max":21,"perLine":10.5,"lines":2,"caps":false,"sz":35.0,"paras":1,"text":"Coordination Problems","font":"B612","anchor":"t","box":[11364383,6845921,2780805,1076325],"lineH":533400,"ins":0},{"id":"26","kind":"label","chars":20,"max":20,"perLine":10.0,"lines":2,"caps":false,"sz":35.0,"paras":1,"text":"Capacity Limitations","font":"B612","anchor":"t","box":[14783363,6845921,2780805,1076325],"lineH":533400,"ins":0}],"photos":[{"id":"9","w":5980652,"h":8725159,"area":0.277}]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"5","kind":"title","chars":54,"max":54,"perLine":27.0,"lines":2,"caps":false,"sz":65.0,"paras":1,"text":"Strategies for Overcoming Social Innovation Challenges","font":"Bernoru SemiCondensed","anchor":"t","box":[1028700,831688,12399858,1835150],"lineH":908050,"ins":0},{"id":"14","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":61.1,"paras":1,"text":"1","font":"Bernoru SemiCondensed","anchor":"t","box":[10362932,4553539,810160,890148],"lineH":853567,"ins":0},{"id":"18","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":61.1,"paras":1,"text":"2","font":"Bernoru SemiCondensed","anchor":"t","box":[10362932,6388877,810160,890148],"lineH":853567,"ins":0},{"id":"22","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":61.1,"paras":1,"text":"3","font":"Bernoru SemiCondensed","anchor":"t","box":[10362932,8192779,810160,890148],"lineH":853567,"ins":0},{"id":"23","kind":"text","chars":87,"max":87,"perLine":29.0,"lines":3,"caps":false,"sz":25.0,"paras":1,"text":"Involving the community in the process of developing and implementing social innovation","font":"B612 Bold","anchor":"t","box":[12060842,4417017,5055583,1143000],"lineH":381000,"ins":0},{"id":"24","kind":"text","chars":84,"max":84,"perLine":28.0,"lines":3,"caps":false,"sz":25.0,"paras":1,"text":"Drive policy changes that encourage social innovation and reduce regulatory barriers","font":"B612 Bold","anchor":"t","box":[12060842,6243402,4844521,1143000],"lineH":381000,"ins":0},{"id":"25","kind":"text","chars":93,"max":93,"perLine":31.0,"lines":3,"caps":false,"sz":25.0,"paras":1,"text":"Building infrastructure that helps implement social innovation, such as technology facilities","font":"B612 Bold","anchor":"t","box":[12060842,8154679,5243193,1143000],"lineH":381000,"ins":0}],"photos":[{"id":"10","w":8476458,"h":6229729,"area":0.281}]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"8","kind":"title","chars":23,"max":25,"perLine":25.3,"lines":1,"caps":false,"sz":65.0,"paras":1,"text":"Presentation Conclusion","font":"Bernoru SemiCondensed","anchor":"t","box":[4105635,841503,10076729,930275],"lineH":908050,"ins":0},{"id":"14","kind":"text","chars":506,"max":506,"perLine":72.3,"lines":7,"caps":false,"sz":31.29,"paras":1,"text":"In short, social innovation is essential for local economic development. Social innovation can overcome the economic challenges faced by local communities by creating jobs, empowering communities and improving welfare. This innovation not only brings positive changes to people's lives, but also provides a solid foundation for sustainable and inclusive economic development. By collaborating with various parties, social innovation can continue to develop and have a greater impact on regional development","font":"B612","anchor":"t","box":[1751024,6163748,14785953,3338899],"lineH":476885,"ins":0}],"photos":[{"id":"5","w":14785953,"h":3062968,"area":0.241}]},{"n":10,"part":"ppt/slides/slide10.xml","role":"end","slots":[{"id":"9","kind":"title","chars":9,"max":10,"perLine":10.3,"lines":1,"caps":false,"sz":199.7,"paras":1,"text":"Thank You","font":"Bernoru SemiCondensed","anchor":"t","box":[2826025,3673659,12635951,2853957],"lineH":2789936,"ins":0},{"id":"10","kind":"label","chars":37,"max":45,"perLine":45.0,"lines":1,"caps":false,"sz":35.0,"paras":1,"text":"Presentation by Bartholomew Henderson","font":"B612 Bold","anchor":"t","box":[4214453,1820742,9859095,542925],"lineH":533400,"ins":0},{"id":"11","kind":"label","chars":25,"max":33,"perLine":33.3,"lines":1,"caps":false,"sz":35.0,"paras":1,"text":"Contact Us: +123-456-7890","font":"B612 Bold","anchor":"t","box":[5497708,7913808,7292584,542925],"lineH":533400,"ins":0}],"photos":[]}]}