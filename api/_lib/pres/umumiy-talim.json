{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"8","kind":"title","chars":8,"max":9,"perLine":8.7,"lines":1,"caps":true,"sz":171.24,"paras":1,"text":"LEARNING","font":"Fredoka","anchor":"t","box":[709212,1030851,11371249,3212520],"lineH":2609723,"ins":0,"useW":0.964},{"id":"9","kind":"label","chars":26,"max":26,"perLine":13.0,"lines":2,"caps":false,"sz":42.73,"paras":1,"text":"Learning Beyond Boundaries","font":"Itim","anchor":"t","box":[2864158,3563625,6809916,941222],"lineH":537337,"ins":0,"useW":0.992}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"9","kind":"title","chars":25,"max":25,"perLine":12.5,"lines":2,"caps":false,"sz":95.4,"paras":1,"text":"The Spirit of Achievement","font":"Fredoka","anchor":"t","box":[2952278,1940453,9254498,2327377],"lineH":1126744,"ins":0,"useW":0.839},{"id":"10","kind":"text","chars":237,"max":237,"perLine":33.9,"lines":7,"caps":false,"sz":37.28,"paras":1,"text":"Every certificate and milestone tells a story of perseverance. Behind every achievement are hours of study, failure, and growth. Recognition reminds us that hard work pays off and encourages us to continue pursuing excellence fearlessly.","font":"Itim","anchor":"t","box":[6607316,5116599,7689846,3280273],"lineH":468630,"ins":0}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"10","kind":"text","chars":242,"max":242,"perLine":34.6,"lines":7,"caps":false,"sz":37.28,"paras":1,"text":"Education illuminates the path toward opportunity and empowerment. It equips us to question, innovate, and improve the world around us. Knowledge breaks barriers and becomes the torch that guides generations toward progress and understanding.","font":"Itim","anchor":"t","box":[4790334,5328682,8707332,3290304],"lineH":468630,"ins":0},{"id":"11","kind":"title","chars":24,"max":24,"perLine":12.0,"lines":2,"caps":false,"sz":95.4,"paras":1,"text":"Knowledge Lights the Way","font":"Fredoka","anchor":"t","box":[4516751,2322320,9254498,2327377],"lineH":1126744,"ins":0,"useW":0.956}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"5","kind":"title","chars":22,"max":22,"perLine":11.0,"lines":2,"caps":false,"sz":95.4,"paras":1,"text":"Innovation in Learning","font":"Fredoka","anchor":"t","box":[7146197,2245170,9254498,2327377],"lineH":1126744,"ins":0,"useW":0.831},{"id":"6","kind":"text","chars":245,"max":245,"perLine":35.0,"lines":7,"caps":false,"sz":37.28,"paras":1,"text":"Modern education embraces creativity, technology, and collaboration. Digital learning tools and interactive methods allow students to explore ideas freely. Innovation in education ensures that knowledge remains relevant in a fast-changing world.","font":"Itim","anchor":"t","box":[7626172,5217140,8294546,3290304],"lineH":468630,"ins":0}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"9","kind":"title","chars":20,"max":20,"perLine":10.0,"lines":2,"caps":false,"sz":95.4,"paras":1,"text":"The Role of Teachers","font":"Fredoka","anchor":"t","box":[2952278,1940453,8062136,2327377],"lineH":1126744,"ins":0,"useW":0.84},{"id":"10","kind":"text","chars":241,"max":241,"perLine":30.1,"lines":8,"caps":false,"sz":37.28,"paras":1,"text":"Teachers are builders of futures. With patience and dedication, they guide young minds, nurturing critical thinking and empathy. A great teacher doesn’t just transfer knowledge but inspires lifelong curiosity and confidence in every learner.","font":"Itim","anchor":"t","box":[6607316,5116599,7689846,3745565],"lineH":468630,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"10","kind":"text","chars":217,"max":217,"perLine":36.2,"lines":6,"caps":false,"sz":37.28,"paras":1,"text":"Excellence is a journey, not a destination. Every skill mastered and every lesson learned adds to our growth. The pursuit of improvement fuels our potential, reminding us that learning continues long after graduation.","font":"Itim","anchor":"t","box":[4790334,5328682,8707332,2823579],"lineH":468630,"ins":0},{"id":"11","kind":"title","chars":22,"max":22,"perLine":11.0,"lines":2,"caps":false,"sz":95.4,"paras":1,"text":"Continuous Improvement","font":"Fredoka","anchor":"t","box":[4516751,2322320,9254498,2327377],"lineH":1126744,"ins":0,"useW":0.844}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"5","kind":"title","chars":29,"max":29,"perLine":14.5,"lines":2,"caps":false,"sz":95.4,"paras":1,"text":"Graduation and New Beginnings","font":"Fredoka","anchor":"t","box":[7146197,2245170,9254498,2327377],"lineH":1126744,"ins":0,"useW":0.988},{"id":"9","kind":"text","chars":218,"max":218,"perLine":36.3,"lines":6,"caps":false,"sz":37.28,"paras":1,"text":"Graduation marks both completion and commencement—a celebration of progress and a step into the unknown. Each student leaves with lessons, memories, and the courage to shape their next chapter with passion and purpose.","font":"Itim","anchor":"t","box":[7523517,5217140,8499858,2823579],"lineH":468630,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"9","kind":"title","chars":24,"max":24,"perLine":12.0,"lines":2,"caps":false,"sz":95.4,"paras":1,"text":"Balancing Study and Life","font":"Fredoka","anchor":"t","box":[2952278,1940453,9254498,2327377],"lineH":1126744,"ins":0,"useW":0.919},{"id":"10","kind":"text","chars":239,"max":239,"perLine":29.9,"lines":8,"caps":false,"sz":37.28,"paras":1,"text":"True success in education comes from balance. Managing time between study, rest, and recreation cultivates focus and mental well-being. Harmony between work and relaxation leads to sustainable achievement and a fulfilling academic journey.","font":"Itim","anchor":"t","box":[6607316,5116599,7689846,3745565],"lineH":468630,"ins":0}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"10","kind":"text","chars":210,"max":210,"perLine":35.0,"lines":6,"caps":false,"sz":37.28,"paras":1,"text":"Education empowers action. Turning knowledge into real-world solutions defines true learning. When creativity meets practical execution, innovation happens—bridging theory and reality to make meaningful impact.","font":"Itim","anchor":"t","box":[4790334,5328682,8707332,2823579],"lineH":468630,"ins":0},{"id":"11","kind":"title","chars":27,"max":27,"perLine":13.5,"lines":2,"caps":false,"sz":95.4,"paras":1,"text":"From Idea to Implementation","font":"Fredoka","anchor":"t","box":[4516751,2322320,9254498,2327377],"lineH":1126744,"ins":0,"useW":0.994}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"5","kind":"title","chars":17,"max":31,"perLine":15.5,"lines":2,"caps":false,"sz":95.4,"paras":1,"text":"Lifelong Learners","font":"Fredoka","anchor":"t","box":[7146197,2245170,9254498,2327377],"lineH":1126744,"ins":0,"useW":0.568},{"id":"9","kind":"text","chars":218,"max":218,"perLine":36.3,"lines":6,"caps":false,"sz":37.28,"paras":1,"text":"Curiosity keeps the mind young. Lifelong learners adapt to change, embrace challenges, and seek growth beyond comfort zones. In every new skill or subject explored, they rediscover purpose and the joy of understanding.","font":"Itim","anchor":"t","box":[7626172,5217140,8294546,2823579],"lineH":468630,"ins":0}],"photos":[]}]}