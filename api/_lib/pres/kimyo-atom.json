{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"9","kind":"title","chars":17,"max":20,"perLine":9.8,"lines":2,"caps":false,"sz":190.0,"paras":1,"text":"Model of the Atom","font":"Etna Sans Serif","anchor":"t","box":[3645613,1862915,10996773,5431859],"lineH":2702560,"ins":0,"useW":0.972,"base":2.004,"tail":0.256,"below":[{"id":"10","gap":2.513,"cap":0.11}]},{"id":"10","kind":"label","chars":14,"max":18,"perLine":18.4,"lines":1,"caps":false,"sz":59.99,"paras":1,"text":"GCSE Chemistry","font":"Blogger","anchor":"t","box":[6244417,7927224,5799167,1076392],"lineH":1066673,"ins":0,"useW":0.815}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"24","kind":"label","chars":3,"max":8,"perLine":6.6,"lines":1,"caps":false,"sz":69.99,"paras":1,"text":"One","font":"Etna Sans Serif","anchor":"t","box":[2310934,4815504,2715008,1004504],"lineH":995553,"ins":0,"useW":0.589},{"id":"25","kind":"label","chars":43,"max":43,"perLine":21.5,"lines":2,"caps":false,"sz":39.99,"paras":1,"text":"Name the three types of subatomic particle.","font":"Blogger","anchor":"t","box":[1395557,6780893,4545761,1422268],"lineH":711073,"ins":0,"useW":0.965},{"id":"26","kind":"label","chars":3,"max":8,"perLine":6.6,"lines":1,"caps":false,"sz":69.99,"paras":1,"text":"Two","font":"Etna Sans Serif","anchor":"t","box":[7786496,4815504,2715008,1004504],"lineH":995553,"ins":0,"useW":0.599,"base":0.884,"tail":0.256,"below":[{"id":"27","gap":1.418,"cap":0.199}]},{"id":"27","kind":"label","chars":57,"max":57,"perLine":14.2,"lines":4,"caps":false,"sz":39.99,"paras":1,"text":"Describe key properties of the three subatomic particles.","font":"Blogger","anchor":"t","box":[6894714,6076109,4498573,2831836],"lineH":711073,"ins":0,"useW":0.747},{"id":"28","kind":"label","chars":5,"max":8,"perLine":6.6,"lines":1,"caps":false,"sz":69.99,"paras":1,"text":"Three","font":"Etna Sans Serif","anchor":"t","box":[13265997,4815504,2715008,1004504],"lineH":995553,"ins":0,"useW":0.838},{"id":"29","kind":"label","chars":50,"max":50,"perLine":16.7,"lines":3,"caps":false,"sz":39.99,"paras":1,"text":"Explain what an isotope is and provide an example.","font":"Blogger","anchor":"t","box":[12374288,6428501,4498573,2127052],"lineH":711073,"ins":0,"useW":0.988},{"id":"30","kind":"title","chars":15,"max":16,"perLine":16.3,"lines":1,"caps":false,"sz":125.0,"paras":1,"text":"Learning Points","font":"Etna Sans Serif","anchor":"t","box":[3134282,1048917,12019436,2139940],"lineH":2222500,"ins":0,"useW":0.917}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"9","kind":"title","chars":15,"max":22,"perLine":21.9,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"What are atoms?","font":"Etna Sans Serif","anchor":"t","box":[3349859,2222193,11588282,1301049],"lineH":1280160,"ins":0,"useW":0.794,"base":0.884,"tail":0.256,"below":[{"id":"10","gap":1.633,"cap":0.174}]},{"id":"10","kind":"text","chars":191,"max":191,"perLine":47.8,"lines":4,"caps":false,"sz":45.0,"paras":1,"text":"Atoms make up everything in the world. Elements are made up of only one type of atom. Each element has specific, unique atoms. All atoms are neutral, meaning that they have no overall charge.","font":"Blogger","anchor":"t","box":[2520913,4088574,13246173,3219185],"lineH":799973,"ins":0}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"34","kind":"title","chars":7,"max":11,"perLine":11.3,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Nucleus","font":"Etna Sans Serif","anchor":"t","box":[10208283,1979012,5986734,1301050],"lineH":1280160,"ins":0,"useW":0.655},{"id":"35","kind":"text","chars":92,"max":92,"perLine":23.0,"lines":4,"caps":false,"sz":45.0,"paras":1,"text":"The nucleus is the centre of the atom. It is where all of the mass of the atom is contained.","font":"Blogger","anchor":"t","box":[9707912,4141580,6987477,3219185],"lineH":799973,"ins":0},{"id":"36","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-","font":"Blogger","anchor":"t","box":[4265258,1274248,312955,819084],"lineH":799973,"ins":0},{"id":"37","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-","font":"Blogger","anchor":"t","box":[4286487,8060318,270497,819084],"lineH":799973,"ins":0},{"id":"38","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+","font":"Blogger","anchor":"t","box":[3734366,4654017,370668,819084],"lineH":799973,"ins":0},{"id":"39","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+","font":"Blogger","anchor":"t","box":[4745513,4654017,356515,819084],"lineH":799973,"ins":0},{"id":"40","kind":"label","chars":7,"max":9,"perLine":8.7,"lines":1,"caps":false,"sz":39.99,"paras":1,"text":"Nucleus","font":"Blogger","anchor":"t","box":[6223927,3198197,1828157,717484],"lineH":711073,"ins":0,"useW":0.858}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"30","kind":"title","chars":19,"max":23,"perLine":11.3,"lines":2,"caps":false,"sz":90.0,"paras":1,"text":"Subatomic Particles","font":"Etna Sans Serif","anchor":"t","box":[2092983,1305429,5986734,2577334],"lineH":1280160,"ins":0,"useW":0.934},{"id":"31","kind":"text","chars":74,"max":74,"perLine":14.8,"lines":5,"caps":false,"sz":45.0,"paras":5,"text":"Atoms are made up of\nthree subatomic particles:\nProtons\nNeutrons\nElectrons","font":"Blogger","anchor":"t","box":[2051684,4591065,6069332,4019219],"lineH":799973,"ins":0},{"id":"32","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-","font":"Blogger","anchor":"t","box":[13727478,1274248,277573,819084],"lineH":799973,"ins":0},{"id":"33","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-","font":"Blogger","anchor":"t","box":[13702711,8060318,327108,819084],"lineH":799973,"ins":0},{"id":"34","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+","font":"Blogger","anchor":"t","box":[13178896,4654017,370668,819084],"lineH":799973,"ins":0},{"id":"35","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+","font":"Blogger","anchor":"t","box":[14182966,4654017,370668,819084],"lineH":799973,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"33","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-","font":"Blogger","anchor":"t","box":[4258181,1272471,327108,819084],"lineH":799973,"ins":0},{"id":"34","kind":"title","chars":7,"max":11,"perLine":11.3,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Protons","font":"Etna Sans Serif","anchor":"t","box":[10208283,1979012,5986734,1301050],"lineH":1280160,"ins":0,"useW":0.67},{"id":"35","kind":"text","chars":117,"max":117,"perLine":29.2,"lines":4,"caps":false,"sz":45.0,"paras":1,"text":"Protons are positively charged subatomic particles. They can be found in the nucleus and have a relative weight of 1.","font":"Blogger","anchor":"t","box":[9707912,4141580,6987477,3219185],"lineH":799973,"ins":0},{"id":"36","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-","font":"Blogger","anchor":"t","box":[4282949,8062095,277573,819084],"lineH":799973,"ins":0},{"id":"37","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+","font":"Blogger","anchor":"t","box":[3725692,4654017,388016,819084],"lineH":799973,"ins":0},{"id":"38","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+","font":"Blogger","anchor":"t","box":[4738436,4654017,370668,819084],"lineH":799973,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"33","kind":"title","chars":8,"max":11,"perLine":11.3,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Neutrons","font":"Etna Sans Serif","anchor":"t","box":[2092983,1589707,5986734,1301050],"lineH":1280160,"ins":0,"useW":0.783},{"id":"34","kind":"text","chars":137,"max":137,"perLine":27.4,"lines":5,"caps":false,"sz":45.0,"paras":1,"text":"Neutrons are subatomic particles that have no charge. They are neutral. They can be found in the nucleus and have a relative weight of 1.","font":"Blogger","anchor":"t","box":[1592612,3776200,6987477,4019219],"lineH":799973,"ins":0},{"id":"35","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-","font":"Blogger","anchor":"t","box":[13731016,1274248,270497,819084],"lineH":799973,"ins":0},{"id":"36","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-","font":"Blogger","anchor":"t","box":[13709787,8060318,312955,819084],"lineH":799973,"ins":0},{"id":"37","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+","font":"Blogger","anchor":"t","box":[13178896,4654017,370668,819084],"lineH":799973,"ins":0},{"id":"38","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+","font":"Blogger","anchor":"t","box":[14175890,4654017,384821,819084],"lineH":799973,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"33","kind":"title","chars":9,"max":12,"perLine":11.6,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Electrons","font":"Etna Sans Serif","anchor":"t","box":[10137500,1200403,6128300,1301049],"lineH":1280160,"ins":0,"useW":0.763,"base":0.884,"tail":0.256,"below":[{"id":"34","gap":1.53,"cap":0.174}]},{"id":"34","kind":"text","chars":192,"max":192,"perLine":27.4,"lines":7,"caps":false,"sz":45.0,"paras":1,"text":"Electrons are negatively charged subatomic particles. They are located in shells (or energy levels) around the nucleus. Electrons have a relative weight of 0, because the weight is negligible.","font":"Blogger","anchor":"t","box":[9707912,2948913,6987477,5619287],"lineH":799973,"ins":0},{"id":"35","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-","font":"Blogger","anchor":"t","box":[4265258,1272471,312955,819084],"lineH":799973,"ins":0},{"id":"36","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-","font":"Blogger","anchor":"t","box":[4286487,8060318,270497,819084],"lineH":799973,"ins":0},{"id":"37","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+","font":"Blogger","anchor":"t","box":[3706060,4654017,427279,819084],"lineH":799973,"ins":0},{"id":"38","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+","font":"Blogger","anchor":"t","box":[4752589,4654017,342362,819084],"lineH":799973,"ins":0}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"16","kind":"title","chars":7,"max":10,"perLine":9.9,"lines":1,"caps":false,"sz":109.99,"paras":1,"text":"Summary","font":"Etna Sans Serif","anchor":"t","box":[5953534,960568,6380931,1873257],"lineH":1955673,"ins":0,"useW":0.983}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"9","kind":"title","chars":22,"max":22,"perLine":21.9,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Electron Configuration","font":"Etna Sans Serif","anchor":"t","box":[3349859,1200403,11588282,1301049],"lineH":1280160,"ins":0,"useW":0.985,"base":0.884,"tail":0.256,"below":[{"id":"10","gap":1.541,"cap":0.155}]},{"id":"10","kind":"text","chars":275,"max":275,"perLine":34.4,"lines":8,"caps":false,"sz":39.99,"paras":5,"text":"Atoms can have multiple shells of electrons. The electrons are arranged in a specific way:\n\nThe first shell can hold 2 electrons\nThe second shell can hold 8 electrons\nThe third shell can hold 8 electrons\nThe earlier shells must be filled before the next shell can be occupied","font":"Blogger","anchor":"t","box":[3019503,2961982,12248994,5650971],"lineH":711073,"ins":0}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"content","slots":[{"id":"108","kind":"title","chars":33,"max":33,"perLine":33.2,"lines":1,"caps":false,"sz":80.0,"paras":1,"text":"Looking at Electron Configuration","font":"Etna Sans Serif","anchor":"t","box":[1321003,1200403,15648519,1148016],"lineH":1137920,"ins":0,"useW":0.976},{"id":"109","kind":"label","chars":2,"max":8,"perLine":4.5,"lines":1,"caps":false,"sz":35.0,"paras":1,"text":"Ne","font":"Blogger","anchor":"t","box":[4535051,4662578,822752,644525],"lineH":622300,"ins":0,"useW":0.562},{"id":"110","kind":"text","chars":72,"max":72,"perLine":36.0,"lines":2,"caps":false,"sz":35.0,"paras":1,"text":"Neon atoms have 10 electrons. The electron configuration of neon is 2,8.","font":"Blogger","anchor":"t","box":[1269401,7668985,7373852,1263650],"lineH":622300,"ins":0},{"id":"111","kind":"text","chars":82,"max":82,"perLine":41.0,"lines":2,"caps":false,"sz":35.0,"paras":1,"text":"Chlorine atoms have 17 electrons. The electron configuration of chlorine is 2,8,7.","font":"Blogger","anchor":"t","box":[9611677,7668985,7442516,1263650],"lineH":622300,"ins":0},{"id":"112","kind":"label","chars":2,"max":8,"perLine":4.5,"lines":1,"caps":false,"sz":35.0,"paras":1,"text":"Cl","font":"Blogger","anchor":"t","box":[12911658,4662578,822752,644525],"lineH":622300,"ins":0,"useW":0.384}],"photos":[]},{"n":12,"part":"ppt/slides/slide12.xml","role":"content","slots":[{"id":"54","kind":"title","chars":20,"max":33,"perLine":33.2,"lines":1,"caps":false,"sz":80.0,"paras":1,"text":"Relative Atomic Mass","font":"Etna Sans Serif","anchor":"t","box":[1321003,1200403,15648519,1148016],"lineH":1137920,"ins":0,"useW":0.638},{"id":"55","kind":"label","chars":2,"max":8,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"Li","font":"Blogger","anchor":"t","box":[2156845,4064172,822752,819084],"lineH":799973,"ins":0,"useW":0.486},{"id":"56","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"3","font":"Blogger","anchor":"t","box":[2156845,3033200,822752,819084],"lineH":799973,"ins":0},{"id":"57","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"7","font":"Blogger","anchor":"t","box":[2156845,5092805,822752,819084],"lineH":799973,"ins":0},{"id":"58","kind":"text","chars":228,"max":228,"perLine":57.0,"lines":4,"caps":false,"sz":30.0,"paras":1,"text":"Elements can be found in the periodic table. The numbers next to the chemical symbols in the periodic table, provide information about the numbers of subatomic particles. A lithium atom has 3 protons, 4 neutrons and 3 electrons.","font":"Blogger","anchor":"t","box":[1340907,6497686,10034117,2152915],"lineH":533400,"ins":0},{"id":"59","kind":"text","chars":78,"max":78,"perLine":39.0,"lines":2,"caps":false,"sz":30.0,"paras":1,"text":"Atomic (proton) number = the number of protons (also the number of electrons).","font":"Blogger","anchor":"t","box":[4583505,3092729,6849929,1085982],"lineH":533400,"ins":0},{"id":"60","kind":"text","chars":76,"max":76,"perLine":38.0,"lines":2,"caps":false,"sz":30.0,"paras":1,"text":"Relative atomic mass = the total mass of the nucleus (protons and neutrons).","font":"Blogger","anchor":"t","box":[4583505,4797122,6849929,1085982],"lineH":533400,"ins":0},{"id":"61","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"+","font":"Blogger","anchor":"t","box":[13758545,5298326,255311,552516],"lineH":533400,"ins":0},{"id":"62","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"+","font":"Blogger","anchor":"t","box":[14335905,5593187,221642,552516],"lineH":533400,"ins":0},{"id":"63","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"+","font":"Blogger","anchor":"t","box":[14320334,4973939,252784,552516],"lineH":533400,"ins":0},{"id":"64","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"-","font":"Blogger","anchor":"t","box":[14312122,3796646,203948,552516],"lineH":533400,"ins":0},{"id":"65","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"-","font":"Blogger","anchor":"t","box":[16815532,5410216,203847,552516],"lineH":533400,"ins":0},{"id":"66","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"-","font":"Blogger","anchor":"t","box":[14289100,7379367,249992,552516],"lineH":533400,"ins":0}],"photos":[]},{"n":13,"part":"ppt/slides/slide13.xml","role":"content","slots":[{"id":"54","kind":"title","chars":8,"max":11,"perLine":11.3,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Isotopes","font":"Etna Sans Serif","anchor":"t","box":[2092983,1589707,5986734,1301050],"lineH":1280160,"ins":0,"useW":0.722,"base":0.884,"tail":0.256,"below":[{"id":"55","gap":1.503,"cap":0.155}]},{"id":"55","kind":"text","chars":197,"max":197,"perLine":28.1,"lines":7,"caps":false,"sz":39.99,"paras":1,"text":"Isotopes are atoms of the same element with different numbers of neutrons. For example, hydrogen has three isotopes with the same number of protons and electrons, but different numbers of neutrons.","font":"Blogger","anchor":"t","box":[1682265,3307688,6808170,4946187],"lineH":711073,"ins":0},{"id":"56","kind":"label","chars":10,"max":13,"perLine":12.5,"lines":1,"caps":false,"sz":39.99,"paras":1,"text":"Hydrogen-1","font":"Blogger","anchor":"t","box":[14114217,1836915,2620893,717484],"lineH":711073,"ins":0,"useW":0.895},{"id":"57","kind":"label","chars":10,"max":13,"perLine":13.1,"lines":1,"caps":false,"sz":39.99,"paras":1,"text":"Hydrogen-2","font":"Blogger","anchor":"t","box":[14055532,4714342,2738263,717484],"lineH":711073,"ins":0,"useW":0.857},{"id":"58","kind":"label","chars":10,"max":14,"perLine":13.9,"lines":1,"caps":false,"sz":39.99,"paras":1,"text":"Hydrogen-3","font":"Blogger","anchor":"t","box":[13972799,7614505,2903729,717484],"lineH":711073,"ins":0,"useW":0.808}],"photos":[]},{"n":14,"part":"ppt/slides/slide14.xml","role":"content","slots":[{"id":"9","kind":"title","chars":24,"max":24,"perLine":12.0,"lines":2,"caps":false,"sz":153.01,"paras":1,"text":"Thank you for listening!","font":"Etna Sans Serif","anchor":"t","box":[3645613,2320848,10996773,4384626],"lineH":2176399,"ins":0,"useW":0.974,"base":2.004,"tail":0.256,"below":[{"id":"40","gap":2.531,"cap":0.137}]},{"id":"40","kind":"label","chars":17,"max":18,"perLine":18.4,"lines":1,"caps":false,"sz":59.99,"paras":1,"text":"Model of the Atom","font":"Blogger","anchor":"t","box":[6244417,7239735,5799167,1076392],"lineH":1066673,"ins":0,"useW":0.971}],"photos":[]},{"n":15,"part":"ppt/slides/slide15.xml","role":"content","slots":[{"id":"9","kind":"title","chars":18,"max":22,"perLine":21.9,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Keyboard Shortcuts","font":"Etna Sans Serif","anchor":"t","box":[3349859,1200403,11588282,1301049],"lineH":1280160,"ins":0,"useW":0.905},{"id":"10","kind":"label","chars":40,"max":49,"perLine":49.3,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"Press these keys whilst in present mode!","font":"Blogger","anchor":"t","box":[3328544,3460530,11633437,819084],"lineH":799973,"ins":0,"useW":0.797},{"id":"11","kind":"text","chars":46,"max":46,"perLine":11.5,"lines":4,"caps":false,"sz":45.0,"paras":4,"text":"B = Blur\nC = Confetti\nD = Drumroll\nO = Bubbles","font":"Blogger","anchor":"t","box":[3910422,5238691,4103265,3219185],"lineH":799973,"ins":0},{"id":"12","kind":"text","chars":32,"max":32,"perLine":10.7,"lines":3,"caps":false,"sz":45.0,"paras":3,"text":"Q = Quiet\nU = Unveil\n0-9 = Timer","font":"Blogger","anchor":"t","box":[10276838,5638667,4103265,2419152],"lineH":799973,"ins":0}],"photos":[]}]}