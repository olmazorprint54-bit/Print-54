{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"9","kind":"title","chars":17,"max":18,"perLine":9.1,"lines":2,"caps":false,"sz":190.0,"paras":1,"text":"Model of the Atom"},{"id":"10","kind":"label","chars":14,"max":15,"perLine":15.2,"lines":1,"caps":false,"sz":59.99,"paras":1,"text":"GCSE Chemistry"}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"24","kind":"label","chars":3,"max":8,"perLine":6.1,"lines":1,"caps":false,"sz":69.99,"paras":1,"text":"One"},{"id":"25","kind":"label","chars":43,"max":39,"perLine":19.7,"lines":2,"caps":false,"sz":39.99,"paras":1,"text":"Name the three types of subatomic particle."},{"id":"26","kind":"label","chars":3,"max":8,"perLine":6.1,"lines":1,"caps":false,"sz":69.99,"paras":1,"text":"Two"},{"id":"27","kind":"label","chars":57,"max":57,"perLine":14.2,"lines":4,"caps":false,"sz":39.99,"paras":1,"text":"Describe key properties of the three subatomic particles."},{"id":"28","kind":"label","chars":5,"max":8,"perLine":6.1,"lines":1,"caps":false,"sz":69.99,"paras":1,"text":"Three"},{"id":"29","kind":"label","chars":50,"max":50,"perLine":16.7,"lines":3,"caps":false,"sz":39.99,"paras":1,"text":"Explain what an isotope is and provide an example."},{"id":"30","kind":"title","chars":15,"max":15,"perLine":15.1,"lines":1,"caps":false,"sz":125.0,"paras":1,"text":"Learning Points"}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"9","kind":"title","chars":15,"max":20,"perLine":20.3,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"What are atoms?"},{"id":"10","kind":"text","chars":191,"max":191,"perLine":47.8,"lines":4,"caps":false,"sz":45.0,"paras":1,"text":"Atoms make up everything in the world. Elements are made up of only one type of atom. Each element has specific, unique atoms. All atoms are neutral, meaning that they have no overall charge."}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"34","kind":"title","chars":7,"max":10,"perLine":10.5,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Nucleus"},{"id":"35","kind":"text","chars":92,"max":92,"perLine":23.0,"lines":4,"caps":false,"sz":45.0,"paras":1,"text":"The nucleus is the centre of the atom. It is where all of the mass of the atom is contained."},{"id":"36","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-"},{"id":"37","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-"},{"id":"38","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+"},{"id":"39","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+"},{"id":"40","kind":"label","chars":7,"max":8,"perLine":7.2,"lines":1,"caps":false,"sz":39.99,"paras":1,"text":"Nucleus"}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"30","kind":"title","chars":19,"max":21,"perLine":10.5,"lines":2,"caps":false,"sz":90.0,"paras":1,"text":"Subatomic Particles"},{"id":"31","kind":"text","chars":74,"max":74,"perLine":14.8,"lines":5,"caps":false,"sz":45.0,"paras":5,"text":"Atoms are made up of\nthree subatomic particles:\nProtons\nNeutrons\nElectrons"},{"id":"32","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-"},{"id":"33","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-"},{"id":"34","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+"},{"id":"35","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+"}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"33","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-"},{"id":"34","kind":"title","chars":7,"max":10,"perLine":10.5,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Protons"},{"id":"35","kind":"text","chars":117,"max":117,"perLine":26.9,"lines":4,"caps":false,"sz":45.0,"paras":1,"text":"Protons are positively charged subatomic particles. They can be found in the nucleus and have a relative weight of 1."},{"id":"36","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-"},{"id":"37","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+"},{"id":"38","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+"}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"33","kind":"title","chars":8,"max":10,"perLine":10.5,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Neutrons"},{"id":"34","kind":"text","chars":137,"max":137,"perLine":26.9,"lines":5,"caps":false,"sz":45.0,"paras":1,"text":"Neutrons are subatomic particles that have no charge. They are neutral. They can be found in the nucleus and have a relative weight of 1."},{"id":"35","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-"},{"id":"36","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-"},{"id":"37","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+"},{"id":"38","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+"}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"33","kind":"title","chars":9,"max":11,"perLine":10.7,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Electrons"},{"id":"34","kind":"text","chars":192,"max":192,"perLine":26.9,"lines":7,"caps":false,"sz":45.0,"paras":1,"text":"Electrons are negatively charged subatomic particles. They are located in shells (or energy levels) around the nucleus. Electrons have a relative weight of 0, because the weight is negligible."},{"id":"35","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-"},{"id":"36","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"-"},{"id":"37","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+"},{"id":"38","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"+"}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"16","kind":"title","chars":7,"max":9,"perLine":9.1,"lines":1,"caps":false,"sz":109.99,"paras":1,"text":"Summary"}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"9","kind":"title","chars":22,"max":20,"perLine":20.3,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Electron Configuration"},{"id":"10","kind":"text","chars":275,"max":275,"perLine":34.4,"lines":8,"caps":false,"sz":39.99,"paras":5,"text":"Atoms can have multiple shells of electrons. The electrons are arranged in a specific way:\n\nThe first shell can hold 2 electrons\nThe second shell can hold 8 electrons\nThe third shell can hold 8 electrons\nThe earlier shells must be filled before the next shell can be occupied"}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"content","slots":[{"id":"108","kind":"title","chars":33,"max":31,"perLine":30.8,"lines":1,"caps":false,"sz":80.0,"paras":1,"text":"Looking at Electron Configuration"},{"id":"109","kind":"label","chars":2,"max":8,"perLine":4,"lines":1,"caps":false,"sz":35.0,"paras":1,"text":"Ne"},{"id":"110","kind":"text","chars":72,"max":72,"perLine":36.0,"lines":2,"caps":false,"sz":35.0,"paras":1,"text":"Neon atoms have 10 electrons. The electron configuration of neon is 2,8."},{"id":"111","kind":"text","chars":82,"max":82,"perLine":36.8,"lines":2,"caps":false,"sz":35.0,"paras":1,"text":"Chlorine atoms have 17 electrons. The electron configuration of chlorine is 2,8,7."},{"id":"112","kind":"label","chars":2,"max":8,"perLine":4,"lines":1,"caps":false,"sz":35.0,"paras":1,"text":"Cl"}],"photos":[]},{"n":12,"part":"ppt/slides/slide12.xml","role":"content","slots":[{"id":"54","kind":"title","chars":20,"max":31,"perLine":30.8,"lines":1,"caps":false,"sz":80.0,"paras":1,"text":"Relative Atomic Mass"},{"id":"55","kind":"label","chars":2,"max":8,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"Li"},{"id":"56","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"3"},{"id":"57","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"7"},{"id":"58","kind":"text","chars":228,"max":228,"perLine":57.0,"lines":4,"caps":false,"sz":30.0,"paras":1,"text":"Elements can be found in the periodic table. The numbers next to the chemical symbols in the periodic table, provide information about the numbers of subatomic particles. A lithium atom has 3 protons, 4 neutrons and 3 electrons."},{"id":"59","kind":"text","chars":78,"max":78,"perLine":39.0,"lines":2,"caps":false,"sz":30.0,"paras":1,"text":"Atomic (proton) number = the number of protons (also the number of electrons)."},{"id":"60","kind":"text","chars":76,"max":76,"perLine":38.0,"lines":2,"caps":false,"sz":30.0,"paras":1,"text":"Relative atomic mass = the total mass of the nucleus (protons and neutrons)."},{"id":"61","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"+"},{"id":"62","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"+"},{"id":"63","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"+"},{"id":"64","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"-"},{"id":"65","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"-"},{"id":"66","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"-"}],"photos":[]},{"n":13,"part":"ppt/slides/slide13.xml","role":"content","slots":[{"id":"54","kind":"title","chars":8,"max":10,"perLine":10.5,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Isotopes"},{"id":"55","kind":"text","chars":197,"max":197,"perLine":28.1,"lines":7,"caps":false,"sz":39.99,"paras":1,"text":"Isotopes are atoms of the same element with different numbers of neutrons. For example, hydrogen has three isotopes with the same number of protons and electrons, but different numbers of neutrons."},{"id":"56","kind":"label","chars":10,"max":10,"perLine":10.3,"lines":1,"caps":false,"sz":39.99,"paras":1,"text":"Hydrogen-1"},{"id":"57","kind":"label","chars":10,"max":11,"perLine":10.8,"lines":1,"caps":false,"sz":39.99,"paras":1,"text":"Hydrogen-2"},{"id":"58","kind":"label","chars":10,"max":11,"perLine":11.4,"lines":1,"caps":false,"sz":39.99,"paras":1,"text":"Hydrogen-3"}],"photos":[]},{"n":14,"part":"ppt/slides/slide14.xml","role":"content","slots":[{"id":"9","kind":"title","chars":24,"max":24,"perLine":12.0,"lines":2,"caps":false,"sz":153.01,"paras":1,"text":"Thank you for listening!"},{"id":"40","kind":"label","chars":17,"max":15,"perLine":15.2,"lines":1,"caps":false,"sz":59.99,"paras":1,"text":"Model of the Atom"}],"photos":[]},{"n":15,"part":"ppt/slides/slide15.xml","role":"content","slots":[{"id":"9","kind":"title","chars":18,"max":20,"perLine":20.3,"lines":1,"caps":false,"sz":90.0,"paras":1,"text":"Keyboard Shortcuts"},{"id":"10","kind":"label","chars":40,"max":41,"perLine":40.7,"lines":1,"caps":false,"sz":45.0,"paras":1,"text":"Press these keys whilst in present mode!"},{"id":"11","kind":"text","chars":46,"max":46,"perLine":11.5,"lines":4,"caps":false,"sz":45.0,"paras":4,"text":"B = Blur\nC = Confetti\nD = Drumroll\nO = Bubbles"},{"id":"12","kind":"text","chars":32,"max":32,"perLine":10.7,"lines":3,"caps":false,"sz":45.0,"paras":3,"text":"Q = Quiet\nU = Unveil\n0-9 = Timer"}],"photos":[]}]}