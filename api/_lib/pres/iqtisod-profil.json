ns":0,"useW":0.769},{"id":"10","kind":"label","chars":20,"max":26,"perLine":26.0,"lines":1,"caps":true,"sz":18.0,"paras":1,"text":"XUSUSIY KAPITAL: 14%","font":"Times New Roman","anchor":"ctr","box":[12192000,4910129,3860800,929683],"lineH":354330,"ins":101600,"useW":0.682},{"id":"13","kind":"label","chars":21,"max":26,"perLine":26.0,"lines":1,"caps":true,"sz":18.0,"paras":1,"text":"IMTIYOZLI AKSIYA: 11%","font":"Times New Roman","anchor":"ctr","box":[12192000,6624065,3860800,924991],"lineH":354330,"ins":101600,"useW":0.701},{"id":"16","kind":"label","chars":22,"max":26,"perLine":26.0,"lines":1,"caps":true,"sz":18.0,"paras":1,"text":"QARZ (SOLIQQACHA): 10%","font":"Times New Roman","anchor":"ctr","box":[12192000,8333309,3860800,924991],"lineH":354330,"ins":101600,"useW":0.759},{"id":"17","kind":"label","chars":17,"max":20,"perLine":19.9,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"Eng qimmat manba:","font":"Times New Roman","anchor":"t","box":[12553385,4388056,3143627,461665],"lineH":462153,"ins":0,"useW":0.983,"base":0.976,"tail":0.216,"below":[{"id":"10","gap":1.195,"cap":0.35}]},{"id":"18","kind":"label","chars":12,"max":30,"perLine":29.7,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"O'rta manba:","font":"Times New Roman","anchor":"t","box":[11780681,6101991,4689034,461665],"lineH":462153,"ins":0,"useW":0.418,"base":0.976,"tail":0.216,"below":[{"id":"13","gap":1.189,"cap":0.35}]},{"id":"19","kind":"label","chars":16,"max":27,"perLine":26.7,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"Eng arzon manba:","font":"Times New Roman","anchor":"t","box":[12019282,7811236,4211832,461665],"lineH":462153,"ins":0,"useW":0.657,"base":0.976,"tail":0.216,"below":[{"id":"16","gap":1.189,"cap":0.35}]},{"id":"20","kind":"label","chars":14,"max":19,"perLine":18.9,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Rejaga qaytish","font":"Times New Roman","anchor":"t","box":[15469474,1100978,1789826,275332],"lineH":297180,"ins":0,"useW":0.755},{"id":"21","kind":"text","chars":360,"max":360,"perLine":32.7,"lines":11,"caps":false,"sz":29.0,"paras":5,"text":"Kapital qiymati – investorlar kapital bergani uchun talab qiladigan minimal daromad stavkasi.\nXususiy kapital eng qimmat manba: aksiyador eng katta xavfni oladi.\nImtiyozli aksiya o'rtada: dividendi qat'iy, lekin soliqdan chegirilmaydi.\nQarz eng arzon: foiz qat'iy va soliqdan oldin chegiriladi.\nWACC – barcha manbalar qiymatining ulushlari bo'yicha o'rtachasi.","font":"Times New Roman","anchor":"t","box":[1028700,4000500,9144000,5080000],"lineH":441960,"ins":182880}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"13","kind":"label","chars":36,"max":81,"perLine":40.5,"lines":2,"caps":false,"sz":40.5,"paras":1,"text":"WACC = E/V × Re + D/V × Rd × (1 – T)","font":"Times New Roman","anchor":"ctr","box":[7620000,2159000,9144001,1524000],"lineH":617220,"ins":508000,"useW":0.993},{"id":"16","kind":"label","chars":45,"max":45,"perLine":9.0,"lines":5,"caps":false,"sz":24.0,"paras":1,"text":"WACC – kapitalning o'rtacha tortilgan qiymati","font":"Times New Roman","anchor":"ctr","box":[4445000,3619500,2159001,1778000],"lineH":365760,"ins":101600,"useW":1.0},{"id":"23","kind":"label","chars":28,"max":28,"perLine":7.0,"lines":4,"caps":false,"sz":27.5,"paras":1,"text":"Re – xususiy kapital qiymati","font":"Times New Roman","anchor":"ctr","box":[14795500,5016501,2032000,1524000],"lineH":419100,"ins":101600,"useW":0.935},{"id":"26","kind":"label","chars":17,"max":53,"perLine":13.3,"lines":4,"caps":false,"sz":27.5,"paras":1,"text":"Rd – qarz qiymati","font":"Times New Roman","anchor":"ctr","box":[12128501,5016501,2032000,1524000],"lineH":419100,"ins":101600,"useW":0.702},{"id":"27","kind":"title","chars":14,"max":20,"perLine":19.6,"lines":1,"caps":false,"sz":50.0,"paras":1,"text":"WACC formulasi","font":"Times New Roman","anchor":"t","box":[1028700,962025,5171318,775469],"lineH":825500,"ins":0,"useW":0.869},{"id":"30","kind":"text","chars":279,"max":279,"perLine":69.8,"lines":4,"caps":false,"sz":27.5,"paras":1,"text":"Bunda E – xususiy kapital, D – qarz, V = E + D, T – foyda solig'i stavkasi. Re odatda CAPM modeli bilan topiladi: Re = Rf + β(Rm – Rf). WACC investitsiya loyihalarini diskontlash va kompaniya qiymatini baholashda ishlatiladi: loyiha daromadi WACCdan yuqori bo'lsa, qiymat oshadi.","font":"Times New Roman","anchor":"ctr","box":[1282700,7429500,15240000,1778000],"lineH":419100,"ins":381000}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"6","kind":"title","chars":11,"max":16,"perLine":16.4,"lines":1,"caps":false,"sz":69.99,"paras":1,"text":"WACC misoli","font":"Times New Roman","anchor":"t","box":[1028700,3671820,6044810,1085618],"lineH":1155573,"ins":0,"useW":0.847},{"id":"7","kind":"text","chars":147,"max":147,"perLine":24.5,"lines":6,"caps":false,"sz":30.0,"paras":1,"text":"Hisoblash: E = 60 %, D = 40 %, soliq stavkasi 15 %. Natija: loyihalar kamida 12,4 % daromad keltirishi kerak, aks holda kompaniya qiymati kamayadi.","font":"Times New Roman","anchor":"t","box":[1028700,6128373,5842000,2921000],"lineH":457200,"ins":0},{"id":"8","kind":"label","chars":14,"max":21,"perLine":21.0,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Rejaga qaytish","font":"Times New Roman","anchor":"t","box":[1028700,8957310,1987273,275332],"lineH":297180,"ins":0,"useW":0.68},{"id":"11","kind":"label","chars":35,"max":42,"perLine":41.6,"lines":1,"caps":false,"sz":32.5,"paras":1,"text":"Xususiy kapital ulushi (E/V) – 60 %","font":"Times New Roman","anchor":"t","box":[10627887,3686106,7112000,508000],"lineH":495300,"ins":0,"useW":0.844},{"id":"14","kind":"label","chars":35,"max":42,"perLine":41.6,"lines":1,"caps":false,"sz":32.5,"paras":1,"text":"Xususiy kapital qiymati (Re) – 15 %","font":"Times New Roman","anchor":"t","box":[10627887,4952043,7112000,508000],"lineH":495300,"ins":0,"useW":0.851},{"id":"17","kind":"label","chars":24,"max":42,"perLine":41.6,"lines":1,"caps":false,"sz":32.5,"paras":1,"text":"Qarz ulushi (D/V) – 40 %","font":"Times New Roman","anchor":"t","box":[10627887,6206105,7112000,508000],"lineH":495300,"ins":0,"useW":0.6},{"id":"20","kind":"label","chars":42,"max":42,"perLine":42.2,"lines":1,"caps":false,"sz":32.0,"paras":1,"text":"Qarz qiymati (Rd) – 10 %, soliq (T) – 15 %","font":"Times New Roman","anchor":"t","box":[10627887,7460168,7112000,508000],"lineH":487680,"ins":0,"useW":0.997},{"id":"23","kind":"label","chars":46,"max":35,"perLine":35.1,"lines":1,"caps":true,"sz":27.0,"paras":1,"text":"WACC = 0,6 × 15 % + 0,4 × 10 % × 0,85 = 12,4 %","font":"Times New Roman","anchor":"t","box":[10627887,8714230,7112000,508000],"lineH":411480,"ins":0,"useW":0.993}],"photos":[{"id":"25","w":18288000,"h":2340491,"area":0.228}]},{"n":11,"part":"ppt/slides/slide11.xml","role":"content","slots":[{"id":"5","kind":"label","chars":12,"max":26,"perLine":25.7,"lines":1,"caps":false,"sz":37.5,"paras":1,"text":"Qarz foydasi","font":"Times New Roman","anchor":"t","box":[10959783,6087110,5080000,571500],"lineH":571500,"ins":0,"useW":0.48,"base":0.965,"tail":0.216,"below":[{"id":"6","gap":1.459,"cap":0.242}]},{"id":"6","kind":"text","chars":112,"max":112,"perLine":22.4,"lines":5,"caps":false,"sz":30.0,"paras":1,"text":"Foiz soliqdan oldin chegiriladi: soliq qalqoni = T × D. Mo'tadil leveraj aksiyadorlar daromadini (ROE) oshiradi.","font":"Times New Roman","anchor":"t","box":[10959783,6781800,6096000,2159000],"lineH":457200,"ins":0},{"id":"11","kind":"title","chars":17,"max":34,"perLine":17.0,"lines":2,"caps":false,"sz":66.17,"paras":1,"text":"Moliyaviy leveraj","font":"Times New Roman","anchor":"t","box":[1028700,2288955,5914984,2128916],"lineH":1092581,"ins":0,"useW":0.592},{"id":"12","kind":"text","chars":106,"max":106,"perLine":17.7,"lines":6,"caps":false,"sz":30.0,"paras":1,"text":"Moliyaviy leveraj – qarzdan foydalanish darajasi. U aksiyadorlar daromadini ham, xavfini ham kuchaytiradi.","font":"Times New Roman","anchor":"t","box":[1028700,5067715,5842001,2921000],"lineH":457200,"ins":0},{"id":"14","kind":"label","chars":10,"max":26,"perLine":25.7,"lines":1,"caps":false,"sz":37.5,"paras":1,"text":"Qarz xavfi","font":"Times New Roman","anchor":"t","box":[10959783,2346105,5080000,571500],"lineH":571500,"ins":0,"useW":0.397,"base":0.965,"tail":0.216,"below":[{"id":"15","gap":1.474,"cap":0.242}]},{"id":"15","kind":"text","chars":112,"max":112,"perLine":22.4,"lines":5,"caps":false,"sz":30.0,"paras":1,"text":"Qarz ko'paysa, majburiy foiz to'lovlari va bankrotlik xavfi ortadi; aksiyadorlar yuqoriroq daromad talab qiladi.","font":"Times New Roman","anchor":"t","box":[10959783,3047999,6096000,2159000],"lineH":457200,"ins":0},{"id":"16","kind":"label","chars":21,"max":36,"perLine":36.5,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Reja bo'yicha: 4-band","font":"Times New Roman","anchor":"t","box":[1028700,8957310,3455295,275332],"lineH":297180,"ins":0,"useW":0.577}],"photos":[]},{"n":12,"part":"ppt/slides/slide12.xml","role":"content","slots":[{"id":"4","kind":"label","chars":12,"max":35,"perLine":11.6,"lines":3,"caps":true,"sz":26.0,"paras":1,"text":"PAST LEVERAJ","font":"Times New Roman","anchor":"ctr","box":[1444055,4331169,2354518,1338539],"lineH":511302,"ins":101600,"useW":0.635},{"id":"7","kind":"label","chars":16,"max":31,"perLine":10.3,"lines":3,"caps":true,"sz":26.0,"paras":1,"text":"O'RTACHA LEVERAJ","font":"Times New Roman","anchor":"ctr","box":[1564933,6125019,2112760,1338539],"lineH":511302,"ins":101600,"useW":0.822},{"id":"10","kind":"label","chars":14,"max":31,"perLine":10.3,"lines":3,"caps":true,"sz":26.0,"paras":1,"text":"YUQORI LEVERAJ","font":"Times New Roman","anchor":"ctr","box":[1564933,7918868,2112760,1338539],"lineH":511302,"ins":101600,"useW":0.711},{"id":"11","kind":"label","chars":56,"max":56,"perLine":18.7,"lines":3,"caps":false,"sz":29.0,"paras":1,"text":"Xavf past, lekin soliq qalqonidan to'liq foydalanilmaydi","font":"Times New Roman","anchor":"t","box":[4682197,4627604,4191000,1397000],"lineH":441960,"ins":0,"useW":0.751},{"id":"12","kind":"label","chars":58,"max":58,"perLine":19.3,"lines":3,"caps":false,"sz":29.0,"paras":1,"text":"Optimal nuqta: WACC eng past, kompaniya qiymati eng yuqori","font":"Times New Roman","anchor":"t","box":[4682197,6421453,4191000,1397000],"lineH":441960,"ins":0,"useW":0.964},{"id":"13","kind":"text","chars":68,"max":68,"perLine":22.7,"lines":3,"caps":false,"sz":29.0,"paras":1,"text":"Bankrotlik va moliyaviy qiyinchilik xarajatlari qiymatni kamaytiradi","font":"Times New Roman","anchor":"t","box":[4682197,8215303,4191000,1397000],"lineH":441960,"ins":0},{"id":"18","kind":"title","chars":17,"max":25,"perLine":25.3,"lines":1,"caps":false,"sz":43.84,"paras":1,"text":"Leveraj va qiymat","font":"Times New Roman","anchor":"t","box":[1028700,1163355,5849032,680058],"lineH":723773,"ins":0,"useW":0.691},{"id":"19","kind":"text","chars":66,"max":66,"perLine":33.0,"lines":2,"caps":false,"sz":30.0,"paras":1,"text":"Trade-off nazariyasi: soliq foydasi va bankrotlik xavfi muvozanati","font":"Times New Roman","anchor":"t","box":[1028700,2472113,7112000,1104900],"lineH":457200,"ins":0},{"id":"26","kind":"label","chars":4,"max":11,"perLine":10.8,"lines":1,"caps":false,"sz":31.99,"paras":1,"text":"Past","font":"Times New Roman","anchor":"t","box":[12928399,2133562,1823443,537845],"lineH":568833,"ins":0,"useW":0.372},{"id":"27","kind":"label","chars":7,"max":9,"perLine":9.3,"lines":1,"caps":false,"sz":31.99,"paras":1,"text":"Optimal","font":"Times New Roman","anchor":"t","box":[13054057,6124047,1572126,537845],"lineH":568833,"ins":0,"useW":0.848},{"id":"28","kind":"label","chars":6,"max":9,"perLine":9.3,"lines":1,"caps":false,"sz":31.99,"paras":1,"text":"Yuqori","font":"Times New Roman","anchor":"t","box":[13054057,3856949,1572126,537845],"lineH":568833,"ins":0,"useW":0.731},{"id":"29","kind":"label","chars":14,"max":19,"perLine":18.9,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Rejaga qaytish","font":"Times New Roman","anchor":