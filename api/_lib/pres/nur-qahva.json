{"size":[12192000,6858000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"6","kind":"title","chars":42,"max":60,"perLine":32.0,"lines":2,"caps":false,"sz":44.0,"paras":1,"text":"Raqamli texnologiyalar va zamonaviy ta'lim","font":"Times New Roman","anchor":"ctr","box":[1524000,2095500,9144000,2032000],"lineH":670560,"ins":182880,"useW":0.95},{"id":"8","kind":"label","chars":42,"max":90,"perLine":85.1,"lines":2,"caps":false,"sz":20.0,"paras":2,"text":"Tayyorladi: talaba F.I.Sh.\nFan: Pedagogika","font":"Times New Roman","anchor":"t","box":[1524000,4648200,9144000,889000],"lineH":304800,"ins":182880,"useW":0.29}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"7","kind":"title","chars":4,"max":48,"perLine":57.9,"lines":2,"caps":false,"sz":34.0,"paras":1,"text":"Reja","font":"Times New Roman","anchor":"ctr","box":[965200,355600,10541000,889000],"lineH":518160,"ins":182880,"useW":0.076},{"id":"9","kind":"text","chars":189,"max":340,"perLine":103.5,"lines":17,"caps":false,"sz":22.0,"paras":6,"text":"Raqamli texnologiyalar tushunchasi\nTa'limda raqamli vositalarning o'rni\nOnlayn va aralash ta'lim shakllari\nO'qituvchining raqamli kompetensiyasi\nAfzalliklar va muammolar\nXulosa va takliflar","font":"Times New Roman","anchor":"t","box":[1066800,1854200,10058400,4368800],"lineH":335280,"ins":182880}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"7","kind":"title","chars":39,"max":48,"perLine":57.9,"lines":2,"caps":false,"sz":34.0,"paras":1,"text":"Raqamli ta'limning asosiy yo'nalishlari","font":"Times New Roman","anchor":"ctr","box":[965200,355600,10541000,889000],"lineH":518160,"ins":182880,"useW":0.649},{"id":"9","kind":"label","chars":18,"max":22,"perLine":14.0,"lines":2,"caps":false,"sz":18.0,"paras":1,"text":"Elektron resurslar","font":"Times New Roman","anchor":"ctr","box":[1092200,1701800,2971800,736600],"lineH":274320,"ins":182880,"useW":0.584},{"id":"11","kind":"text","chars":102,"max":291,"perLine":31.1,"lines":14,"caps":false,"sz":16.0,"paras":1,"text":"Elektron darsliklar, video darslar va interaktiv mashqlar istalgan vaqtda bilim olish imkonini beradi.","font":"Times New Roman","anchor":"t","box":[965200,2870200,3149600,3403600],"lineH":243840,"ins":182880},{"id":"13","kind":"label","chars":19,"max":22,"perLine":14.0,"lines":2,"caps":false,"sz":18.0,"paras":1,"text":"Onlayn platformalar","font":"Times New Roman","anchor":"ctr","box":[4648200,1701800,2971800,736600],"lineH":274320,"ins":182880,"useW":0.666},{"id":"15","kind":"text","chars":102,"max":291,"perLine":31.1,"lines":14,"caps":false,"sz":16.0,"paras":1,"text":"Topshiriq berish, tekshirish va baholash bir joyda jamlanadi, o'qituvchi bilan aloqa uzluksiz bo'ladi.","font":"Times New Roman","anchor":"t","box":[4521200,2870200,3149600,3403600],"lineH":243840,"ins":182880},{"id":"17","kind":"label","chars":16,"max":22,"perLine":14.0,"lines":2,"caps":false,"sz":18.0,"paras":1,"text":"Sun'iy intellekt","font":"Times New Roman","anchor":"ctr","box":[8204200,1701800,2971800,736600],"lineH":274320,"ins":182880,"useW":0.496},{"id":"19","kind":"text","chars":92,"max":291,"perLine":31.1,"lines":14,"caps":false,"sz":16.0,"paras":1,"text":"Shaxsiy o'quv yo'nalishini tuzadi, xatolarni tahlil qiladi va vaqtni tejashga yordam beradi.","font":"Times New Roman","anchor":"t","box":[8077200,2870200,3149600,3403600],"lineH":243840,"ins":182880}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"7","kind":"title","chars":33,"max":48,"perLine":57.9,"lines":2,"caps":false,"sz":34.0,"paras":1,"text":"Raqamli vositalar dars jarayonida","font":"Times New Roman","anchor":"ctr","box":[965200,355600,10541000,889000],"lineH":518160,"ins":182880,"useW":0.561},{"id":"11","kind":"text","chars":211,"max":340,"perLine":58.8,"lines":19,"caps":false,"sz":20.0,"paras":4,"text":"Interaktiv doska darsni ko'rgazmali va qiziqarli qiladi.\nPlanshet va kompyuterlar mustaqil ishlash imkonini beradi.\nElektron testlar natijani darhol ko'rsatadi.\nVideo darslar murakkab mavzuni sodda tushuntiradi.","font":"Times New Roman","anchor":"t","box":[5638800,1676400,5791200,4724400],"lineH":304800,"ins":182880}],"photos":[{"id":"10","w":4368800,"h":4622800,"area":0.242}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"7","kind":"title","chars":27,"max":48,"perLine":57.9,"lines":2,"caps":false,"sz":34.0,"paras":1,"text":"An'anaviy va raqamli ta'lim","font":"Times New Roman","anchor":"ctr","box":[965200,355600,10541000,889000],"lineH":518160,"ins":182880,"useW":0.46},{"id":"10","kind":"label","chars":16,"max":24,"perLine":41.7,"lines":2,"caps":false,"sz":20.0,"paras":1,"text":"An'anaviy ta'lim","font":"Times New Roman","anchor":"ctr","box":[1066800,1854200,4572000,533400],"lineH":304800,"ins":182880,"useW":0.379},{"id":"11","kind":"text","chars":123,"max":340,"perLine":47.1,"lines":15,"caps":false,"sz":18.0,"paras":3,"text":"Bilim asosan o'qituvchi va darslikdan olinadi.\nDars vaqti va joyi qat'iy belgilangan.\nNatija chorak oxirida ma'lum bo'ladi.","font":"Times New Roman","anchor":"t","box":[1016000,2590800,4673600,3657600],"lineH":274320,"ins":182880},{"id":"14","kind":"label","chars":14,"max":24,"perLine":41.7,"lines":2,"caps":false,"sz":20.0,"paras":1,"text":"Raqamli ta'lim","font":"Times New Roman","anchor":"ctr","box":[6553200,1854200,4572000,533400],"lineH":304800,"ins":182880,"useW":0.34},{"id":"15","kind":"text","chars":122,"max":340,"perLine":47.1,"lines":15,"caps":false,"sz":18.0,"paras":3,"text":"Bilim manbalari ko'p: video, platforma, bazalar.\nIstalgan vaqt va joyda o'qish mumkin.\nNatija va xatolar darhol ko'rinadi.","font":"Times New Roman","anchor":"t","box":[6502400,2590800,4673600,3657600],"lineH":274320,"ins":182880}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"7","kind":"title","chars":28,"max":48,"perLine":57.9,"lines":2,"caps":false,"sz":34.0,"paras":1,"text":"Raqamli kompetensiya tarkibi","font":"Times New Roman","anchor":"ctr","box":[965200,355600,10541000,889000],"lineH":518160,"ins":182880,"useW":0.502},{"id":"10","kind":"label","chars":20,"max":14,"perLine":14.0,"lines":1,"caps":false,"sz":19.0,"paras":1,"text":"Axborot savodxonligi","font":"Times New Roman","anchor":"ctr","box":[914400,1676400,4914900,482600],"lineH":289560,"ins":182880,"useW":0.446,"base":2.165,"tail":0.216,"below":[{"id":"11","gap":2.832,"cap":0.254}]},{"id":"11","kind":"text","chars":66,"max":211,"perLine":49.1,"lines":6,"caps":false,"sz":16.0,"paras":1,"text":"Ishonchli manbani topish, tekshirish va undan to'g'ri foydalanish.","font":"Times New Roman","anchor":"t","box":[939800,2311400,4864100,1511300],"lineH":243840,"ins":182880},{"id":"14","kind":"label","chars":7,"max":14,"perLine":14.0,"lines":1,"caps":false,"sz":19.0,"paras":1,"text":"Muloqot","font":"Times New Roman","anchor":"ctr","box":[6362700,1676400,4914900,482600],"lineH":289560,"ins":182880,"useW":0.176,"base":2.165,"tail":0.216,"below":[{"id":"15","gap":2.832,"cap":0.254}]},{"id":"15","kind":"text","chars":56,"max":211,"perLine":49.1,"lines":6,"caps":false,"sz":16.0,"paras":1,"text":"Onlayn hamkorlik, elektron xat va guruhda ishlash odobi.","font":"Times New Roman","anchor":"t","box":[6388100,2311400,4864100,1511300],"lineH":243840,"ins":182880,"useW":0.88},{"id":"18","kind":"label","chars":16,"max":14,"perLine":14.0,"lines":1,"caps":false,"sz":19.0,"paras":1,"text":"Kontent yaratish","font":"Times New Roman","anchor":"ctr","box":[914400,4203700,4914900,482600],"lineH":289560,"ins":182880,"useW":0.338,"base":2.165,"tail":0.216,"below":[{"id":"19","gap":2.832,"cap":0.254}]},{"id":"19","kind":"text","chars":63,"max":211,"perLine":49.1,"lines":6,"caps":false,"sz":16.0,"paras":1,"text":"Taqdimot, video va test kabi materiallarni mustaqil tayyorlash.","font":"Times New Roman","anchor":"t","box":[939800,4838700,4864100,1511300],"lineH":243840,"ins":182880},{"id":"22","kind":"label","chars":10,"max":14,"perLine":14.0,"lines":1,"caps":false,"sz":19.0,"paras":1,"text":"Xavfsizlik","font":"Times New Roman","anchor":"ctr","box":[6362700,4203700,4914900,482600],"lineH":289560,"ins":182880,"useW":0.212,"base":2.165,"tail":0.216,"below":[{"id":"23","gap":2.832,"cap":0.254}]},{"id":"23","kind":"text","chars":65,"max":211,"perLine":49.1,"lines":6,"caps":false,"sz":16.0,"paras":1,"text":"Shaxsiy ma'lumotlarni himoya qilish va kiberxavflardan saqlanish.","font":"Times New Roman","anchor":"t","box":[6388100,4838700,4864100,1511300],"lineH":243840,"ins":182880}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"7","kind":"title","chars":30,"max":48,"perLine":57.9,"lines":2,"caps":false,"sz":34.0,"paras":1,"text":"Onlayn ta'limning afzalliklari","font":"Times New Roman","anchor":"ctr","box":[965200,355600,10541000,889000],"lineH":518160,"ins":182880,"useW":0.491},{"id":"8","kind":"text","chars":144,"max":340,"perLine":58.8,"lines":19,"caps":false,"sz":20.0,"paras":4,"text":"Masofa va vaqt chegarasi yo'qoladi.\nDarslarni qayta ko'rib, mustahkamlash mumkin.\nO'quvchi o'z tezligida o'rganadi.\nTa'lim xarajatlari kamayadi.","font":"Times New Roman","anchor":"t","box":[762000,1676400,5791200,4724400],"lineH":304800,"ins":182880}],"photos":[{"id":"11","w":4368800,"h":4622800,"area":0.242}]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"7","kind":"title","chars":22,"max":48,"perLine":57.9,"lines":2,"caps":false,"sz":34.0,"paras":1,"text":"Muammolar va yechimlar","font":"Times New Roman","anchor":"ctr","box":[965200,355600,10541000,889000],"lineH":518160,"ins":182880,"useW":0.432},{"id":"13","kind":"label","chars":16,"max":24,"perLine":36.8,"lines":2,"caps":false,"sz":22.0,"paras":1,"text":"Asosiy muammolar","font":"Times New Roman","anchor":"ctr","box":[6756400,1905000,4445000,635000],"lineH":335280,"ins":182880,"useW":0.515,"base":2.165,"tail":0.216,"below":[{"id":"14","gap":2.7,"cap":0.247}]},{"id":"14","kind":"text","chars":153,"max":340,"perLine":44.7,"lines":14,"caps":false,"sz":18.0,"paras":1,"text":"Internet sifati, qurilmalar yetishmasligi va o'qituvchilarning raqamli tayyorgarligi. Yechim — infratuzilmani rivojlantirish va muntazam malaka oshirish.","font":"Times New Roman","anchor":"t","box":[6756400,2641600,4445000,3606800],"lineH":274320,"ins":182880}],"photos":[{"id":"10","w":5257800,"h":4622800,"area":0.291}]},{"n":9,"part":"ppt/slides/slide9.xml","role":"end","slots":[{"id":"6","kind":"title","chars":26,"max":60,"perLine":35.4,"lines":2,"caps":false,"sz":44.0,"paras":1,"text":"E'tiboringiz uchun rahmat!","font":"Times New Roman","anchor":"ctr","box":[1905000,2286000,8382000,1397000],"lineH":670560,"ins":182880,"useW":0.731,"base":2.165,"tail":0.216,"below":[{"id":"7","gap":2.45,"cap":0.137}]},{"id":"7","kind":"label","chars":52,"max":90,"perLine":77.9,"lines":2,"caps":false,"sz":20.0,"paras":1,"text":"Savollaringiz bo'lsa, mamnuniyat bilan javob beraman","font":"Times New Roman","anchor":"t","box":[1905000,3683000,8382000,508000],"lineH":304800,"ins":182880,"useW":0.674}],"photos":[]}]}