lari.","font":"Solway","anchor":"t","box":[5892800,6908800,3048000,2095500],"lineH":320040,"ins":152400,"useW":0.933},{"id":"43","kind":"fixed","chars":1,"max":12,"perLine":4.2,"lines":2,"caps":false,"sz":20.0,"paras":1,"text":"5","font":"Solway Bold","anchor":"ctr","box":[9550400,6070600,558800,558800],"lineH":304800,"ins":0},{"id":"44","kind":"label","chars":9,"max":27,"perLine":13.7,"lines":2,"caps":false,"sz":24.0,"paras":1,"text":"Ta'tillar","font":"Solway Bold","anchor":"ctr","box":[10210800,5994400,2362200,787400],"lineH":365760,"ins":152400,"useW":0.579,"base":2.15,"tail":0.24,"below":[{"id":"45","gap":2.908,"cap":0.219}]},{"id":"45","kind":"label","chars":58,"max":58,"perLine":8.3,"lines":7,"caps":false,"sz":21.0,"paras":1,"text":"Yillik asosiy, qöşimça, ijtimoiy, öquv va boşqa ta'tillar.","font":"Solway","anchor":"t","box":[9499600,6908800,3048000,2095500],"lineH":320040,"ins":152400,"useW":0.979}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"9","kind":"title","chars":27,"max":27,"perLine":9.0,"lines":3,"caps":true,"sz":35.16,"paras":1,"text":"TANAFFUSLAR VA KUNDALIK DAM","font":"ITC Motter Corpus Regular","anchor":"t","box":[10096500,1524000,5842000,1219200],"lineH":446532,"ins":0,"useW":0.79,"base":2.824,"tail":0.163,"below":[{"id":"10","gap":3.271,"cap":0.301}]},{"id":"10","kind":"text","chars":350,"max":350,"perLine":26.9,"lines":13,"caps":false,"sz":26.0,"paras":5,"text":"Iş kuni davomida xodimga dam oliş va ovqatlaniş uçun tanaffus beriladi.\nDavomiyligi 30 daqiqadan kam va 2 soatdan köp bölmaydi.\nTanaffus iş vaqtiga kiritilmaydi, xodim undan öz xohişiga köra foydalanadi.\nAyrim işlarda isiniş va bolani ovqatlantiriş uçun maxsus tanaffuslar beriladi.\nIş kunlari (smenalar) orasidagi kundalik dam odatda kamida 12 soat.","font":"Solway","anchor":"t","box":[9398000,2984500,6667500,6096000],"lineH":461899,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"11","kind":"title","chars":25,"max":25,"perLine":12.5,"lines":2,"caps":true,"sz":40.0,"paras":1,"text":"HAFTALIK DAM OLIŞ KUNLARI","font":"ITC Motter Corpus Regular","anchor":"t","box":[6413500,2349500,6731000,1219200],"lineH":584073,"ins":0,"useW":0.855,"base":2.097,"tail":0.163,"below":[{"id":"12","gap":2.625,"cap":0.293}]},{"id":"12","kind":"text","chars":275,"max":275,"perLine":25.0,"lines":11,"caps":false,"sz":26.0,"paras":5,"text":"Haftalik dam - iş haftasi davomida beriladigan uzluksiz dam oliş.\nDavomiyligi kamida 42 soat.\nBeş kunlik iş haftasida ikki kun, olti kunlikda bir kun dam olinadi.\nUmumiy dam oliş kuni - yakşanba.\nDam oliş kunidagi iş kamida ikki baravar tölanadi yoki boşqa dam kuni beriladi.","font":"Solway","anchor":"t","box":[6413500,3683000,5842000,5334000],"lineH":480060,"ins":0}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"8","kind":"title","chars":34,"max":34,"perLine":11.3,"lines":3,"caps":true,"sz":38.33,"paras":1,"text":"BAYRAM KUNLARI VA ULARNING TARTIBI","font":"ITC Motter Corpus Regular","anchor":"t","box":[5022270,1244688,7457855,1221889],"lineH":486791,"ins":0,"useW":0.822},{"id":"33","kind":"label","chars":20,"max":59,"perLine":29.5,"lines":2,"caps":false,"sz":22.0,"paras":1,"text":"1-yanvar - Yangi yil","font":"Solway Bold","anchor":"ctr","box":[1524000,2946400,4724400,787400],"lineH":335280,"ins":355600,"useW":0.652},{"id":"34","kind":"label","chars":26,"max":59,"perLine":29.5,"lines":2,"caps":false,"sz":22.0,"paras":1,"text":"8-mart - Xotin-qizlar kuni","font":"Solway Bold","anchor":"ctr","box":[1524000,3911600,4724400,787400],"lineH":335280,"ins":355600,"useW":0.886},{"id":"35","kind":"label","chars":24,"max":59,"perLine":29.5,"lines":2,"caps":false,"sz":22.0,"paras":1,"text":"21-mart - Navröz bayrami","font":"Solway Bold","anchor":"ctr","box":[1524000,4876800,4724400,787400],"lineH":335280,"ins":355600,"useW":0.856},{"id":"36","kind":"label","chars":30,"max":30,"perLine":15.0,"lines":2,"caps":false,"sz"