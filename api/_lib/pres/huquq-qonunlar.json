{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"23","kind":"title","chars":26,"max":26,"perLine":8.7,"lines":3,"caps":true,"sz":93.74,"paras":1,"text":"THE ROLE OF RULES AND LAWS"}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"11","kind":"title","chars":14,"max":26,"perLine":13.2,"lines":2,"caps":false,"sz":103.05,"paras":1,"text":"Adora Montminy"},{"id":"12","kind":"label","chars":15,"max":37,"perLine":37.2,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"Presentation by"}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"9","kind":"text","chars":166,"max":166,"perLine":27.7,"lines":6,"caps":false,"sz":27.0,"paras":1,"text":"Rules and laws are created to guide behavior and maintain order in society. They help people understand what is acceptable and ensure that everyone is treated fairly."}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"20","kind":"label","chars":5,"max":19,"perLine":19.5,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"Laws:"},{"id":"21","kind":"label","chars":6,"max":19,"perLine":19.5,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"Rules:"},{"id":"22","kind":"label","chars":21,"max":22,"perLine":21.8,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"Official and enforced"},{"id":"23","kind":"label","chars":21,"max":22,"perLine":21.8,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"Informal and flexible"},{"id":"24","kind":"title","chars":33,"max":33,"perLine":16.5,"lines":2,"caps":true,"sz":45.99,"paras":1,"text":"DIFFERENCE BETWEEN RULES AND LAWS"}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"10","kind":"title","chars":28,"max":28,"perLine":14.0,"lines":2,"caps":true,"sz":45.99,"paras":1,"text":"MAINTAINING ORDER IN SOCIETY"},{"id":"11","kind":"text","chars":165,"max":165,"perLine":33.0,"lines":5,"caps":false,"sz":27.0,"paras":1,"text":"Without rules and laws, society would become disorganized. These systems help prevent confusion and create a structured environment where people can live peacefully."}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"21","kind":"title","chars":31,"max":31,"perLine":15.5,"lines":2,"caps":true,"sz":45.99,"paras":1,"text":"PROMOTING FAIRNESS AND EQUALITY"},{"id":"22","kind":"text","chars":147,"max":147,"perLine":36.8,"lines":4,"caps":false,"sz":27.0,"paras":1,"text":"Rules and laws ensure that everyone is treated equally. They help protect people from unfair treatment and promote justice in different situations."},{"id":"23","kind":"label","chars":15,"max":19,"perLine":19.1,"lines":1,"caps":false,"sz":27.0,"paras":1,"text":"Equal treatment"},{"id":"24","kind":"label","chars":14,"max":19,"perLine":19.1,"lines":1,"caps":false,"sz":27.0,"paras":1,"text":"Protect rights"},{"id":"25","kind":"label","chars":14,"max":19,"perLine":19.1,"lines":1,"caps":false,"sz":27.0,"paras":1,"text":"Ensure justice"}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"9","kind":"title","chars":26,"max":26,"perLine":13.0,"lines":2,"caps":true,"sz":45.99,"paras":1,"text":"ENCOURAGING RESPONSIBILITY"},{"id":"10","kind":"text","chars":165,"max":165,"perLine":33.0,"lines":5,"caps":false,"sz":27.0,"paras":1,"text":"Following rules and laws teaches people to be responsible for their actions. It helps individuals understand the importance of accountability and respect for others."}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"8","kind":"title","chars":34,"max":34,"perLine":17.0,"lines":2,"caps":true,"sz":45.99,"paras":1,"text":"THE IMPORTANCE OF RESPECTING RULES"},{"id":"18","kind":"label","chars":11,"max":19,"perLine":19.5,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"Build Trust"},{"id":"19","kind":"label","chars":12,"max":19,"perLine":19.5,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"Show Respect"},{"id":"20","kind":"label","chars":20,"max":22,"perLine":22.0,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"Strengthen Community"}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"11","kind":"title","chars":36,"max":36,"perLine":18.0,"lines":2,"caps":true,"sz":45.99,"paras":1,"text":"LIVING BY RULES FOR A BETTER SOCIETY"},{"id":"12","kind":"text","chars":159,"max":159,"perLine":39.8,"lines":4,"caps":false,"sz":27.0,"paras":1,"text":"Rules and laws are essential for creating a fair and peaceful society. By understanding and following them, we contribute to a better environment for everyone."}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"end","slots":[{"id":"8","kind":"title","chars":9,"max":11,"perLine":11.2,"lines":1,"caps":true,"sz":98.12,"paras":1,"text":"THANK YOU"}],"photos":[]}]}