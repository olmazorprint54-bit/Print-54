863600],"lineH":365760,"ins":355600,"useW":0.792},{"id":"40","kind":"label","chars":30,"max":30,"perLine":15.0,"lines":2,"caps":false,"sz":24.0,"paras":1,"text":"4. Tanaffuslar va kundalik dam","font":"Solway Bold","anchor":"ctr","box":[11493500,3111500,5080000,863600],"lineH":365760,"ins":355600,"useW":0.871},{"id":"41","kind":"label","chars":28,"max":28,"perLine":14.0,"lines":2,"caps":false,"sz":24.0,"paras":1,"text":"5. Haftalik dam va bayramlar","font":"Solway Bold","anchor":"ctr","box":[11493500,4229100,5080000,863600],"lineH":365760,"ins":355600,"useW":0.967},{"id":"42","kind":"label","chars":30,"max":30,"perLine":15.0,"lines":2,"caps":false,"sz":24.0,"paras":1,"text":"6. Mehnat ta'tillari va xulosa","font":"Solway Bold","anchor":"ctr","box":[11493500,5346700,5080000,863600],"lineH":365760,"ins":355600,"useW":0.957}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"10","kind":"title","chars":24,"max":24,"perLine":12.0,"lines":2,"caps":true,"sz":39.74,"paras":1,"text":"DAM OLIŞ VAQTI TUŞUNÇASI","font":"ITC Motter Corpus Regular","anchor":"t","box":[1651000,2159000,7112000,1219200],"lineH":504698,"ins":0,"useW":0.647},{"id":"11","kind":"text","chars":285,"max":285,"perLine":31.7,"lines":9,"caps":false,"sz":28.0,"paras":4,"text":"Dam oliş vaqti - xodim mehnat vazifalarini bajarişdan ozod bölgan va undan öz xohişiga köra foydalanişi mumkin bölgan vaqt.\nIş vaqtiga qarama-qarşi tuşunça hisoblanadi.\nMehnat kodeksi bilan tartibga solinadi.\nBu vaqtda xodimni işga jalb qiliş faqat qonunda körsatilgan hollarda mumkin.","font":"Solway","anchor":"t","box":[1651000,3492500,7239000,4191000],"lineH":480060,"ins":0}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"21","kind":"title","chars":28,"max":28,"perLine":14.0,"lines":2,"caps":true,"sz":40.97,"paras":1,"text":"DAM OLIŞ VAQTINING AHAMIYATI","font":"ITC Motter Corpus Regular","anchor":"t","box":[5080000,1333500,7874000,1219200],"lineH":520319,"ins":0,"useW":0.807},{"id":"22","kind":"text","chars":347,"max":347,"perLine":26.7,"lines":13,"caps":false,"sz":26.0,"paras":5,"text":"Dam oliş - Konstitutsiya va Mehnat kodeksi bilan kafolatlangan huquq.\nSalomatlik: çarçoqni yöqotadi, kasallik va jarohat xavfini kamaytiradi.\nUnumdorlik: dam olgan xodim sifatli va xatosiz işlaydi.\nŞaxsiy hayot: oila, ta'lim, sport va madaniy hordiq uçun vaqt qoladi.\nKafolat: şartnoma bilan dam oliş muddatlarini qonundagidan kamaytirib bölmaydi.","font":"Solway","anchor":"t","box":[5270500,2730500,7747000,6096000],"lineH":480060,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"8","kind":"title","chars":22,"max":54,"perLine":26.8,"lines":2,"caps":true,"sz":42.0,"paras":1,"text":"DAM OLIŞ VAQTI TURLARI","font":"ITC Motter Corpus Regular","anchor":"t","box":[4191000,889000,9906000,1016000],"lineH":559181,"ins":0,"useW":0.771},{"id":"27","kind":"fixed","chars":1,"max":12,"perLine":4.2,"lines":2,"caps":false,"sz":20.0,"paras":1,"text":"1","font":"Solway Bold","anchor":"ctr","box":[4140200,2552700,558800,558800],"lineH":304800,"ins":0},{"id":"28","kind":"label","chars":11,"max":27,"perLine":13.7,"lines":2,"caps":false,"sz":24.0,"paras":1,"text":"Tanaffuslar","font":"Solway Bold","anchor":"ctr","box":[4800600,2476500,2362200,787400],"lineH":365760,"ins":152400,"useW":0.821,"base":2.15,"tail":0.24,"below":[{"id":"29","gap":2.908,"cap":0.219}]},{"id":"29","kind":"text","chars":70,"max":70,"perLine":10.0,"lines":7,"caps":false,"sz":21.0,"paras":1,"text":"Iş kuni davomida dam oliş va ovqatlaniş uçun: 30 daqiqadan 2 soatgaça.","font":"Solway","anchor":"t","box":[4089400,3390900,3048000,2095500],"lineH":320040,"ins":152400},{"id":"31","kind":"fixed","chars":1,"max":12,"perLine":4.2,"lines":2,"caps":false,"sz":20.0,"paras":1,"text":"2","font":"Solway Bold","anchor":"ctr","box":[7747000,2552700,558800,558800],"lineH":304800,"ins":0},{"id":"32","kind":"label","chars":12,"max":27,"perLine":13.7,"lines":2,"c