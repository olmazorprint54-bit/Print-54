neH":545084,"ins":0,"useW":0.888,"base":1.824,"tail":0.163,"below":[{"id":"11","gap":1.747,"cap":0.257}]},{"id":"11","kind":"text","chars":306,"max":251,"perLine":25.1,"lines":10,"caps":false,"sz":27.0,"paras":5,"text":"Mehnat ta'tili - xodimga iş joyi va örtaça iş haqi saqlangan holda beriladigan yillik dam.\nAsosiy ta'til yiliga kamida 21 kalendar kun.\nTa'tillar iş beruvçi tasdiqlagan jadval asosida beriladi.\nTa'til haqi ta'til boşlanişidan oldin tölanadi.\nFoydalanilmagan ta'til uçun pul asosan işdan böşaganda tölanadi.","font":"Solway","anchor":"t","box":[1651000,3175000,7239000,4572000],"lineH":480060,"ins":0}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"content","slots":[{"id":"8","kind":"title","chars":14,"max":54,"perLine":26.8,"lines":2,"caps":true,"sz":42.0,"paras":1,"text":"TA'TIL TURLARI","font":"ITC Motter Corpus Regular","anchor":"t","box":[4191000,889000,9906000,1016000],"lineH":559181,"ins":0,"useW":0.475,"base":1.912,"tail":0.163,"below":[{"id":"27","gap":2.476,"cap":0.119},{"id":"28","gap":2.433,"cap":0.143},{"id":"31","gap":2.476,"cap":0.119},{"id":"32","gap":2.433,"cap":0.143},{"id":"35","gap":2.476,"cap":0.119},{"id":"36","gap":2.433,"cap":0.143}]},{"id":"27","kind":"fixed","chars":1,"max":12,"perLine":4.2,"lines":2,"caps":false,"sz":20.0,"paras":1,"text":"1","font":"Solway Bold","anchor":"ctr","box":[4140200,2235200,558800,558800],"lineH":304800,"ins":0},{"id":"28","kind":"label","chars":13,"max":27,"perLine":13.7,"lines":2,"caps":false,"sz":24.0,"paras":1,"text":"Asosiy ta'til","font":"Solway Bold","anchor":"ctr","box":[4800600,2159000,2362200,787400],"lineH":365760,"ins":152400,"useW":0.852,"base":2.15,"tail":0.24,"below":[{"id":"29","gap":2.908,"cap":0.219}]},{"id":"29","kind":"label","chars":49,"max":49,"perLine":7.0,"lines":7,"caps":false,"sz":21.0,"paras":1,"text":"Yiliga kamida 21 kalendar kun, iş haqi saqlanadi.","font":"Solway","anchor":"t","box":[4089400,3073400,3048000,2095500],"lineH":320040,"ins":152400,"useW":0.918},{"id":"31","kind":"fixed","chars":1,"max":12,"perLine":4.2,"lines":2,"caps":false,"sz":20.0,"paras":1,"text":"2","font":"Solway Bold","anchor":"ctr","box":[7747000,2235200,558800,558800],"lineH":304800,"ins":0},{"id":"32","kind":"label","chars":12,"max":27,"perLine":13.7,"lines":2,"caps":false,"sz":24.0,"paras":1,"text":"Uzaytirilgan","font":"Solway Bold","anchor":"ctr","box":[8407400,2159000,2362200,787400],"lineH":365760,"ins":152400,"useW":0.884,"base":2.15,"tail":0.24,"below":[{"id":"33","gap":2.908,"cap":0.219}]},{"id":"33","kind":"text","chars":78,"max":78,"perLine":11.1,"lines":7,"caps":false,"sz":21.0,"paras":1,"text":"18 yoşga tölmaganlar va I-II guruh nogironligi bor xodimlarga 30 kalendar kun.","font":"Solway","anchor":"t","box":[7696200,3073400,3048000,2095500],"lineH":320040,"ins":152400},{"id":"35","kind":"fixed","chars":1,"max":12,"perLine":4.2,"lines":2,"caps":false,"sz":20.0,"paras":1,"text":"3","font":"Solway Bold","anchor":"ctr","box":[11353800,2235200,558800,558800],"lineH":304800,"ins":0},{"id":"36","kind":"label","chars":7,"max":27,"perLine":13.7,"lines":2,"caps":false,"sz":24.0,"paras":1,"text":"Qöşimça","font":"Solway Bold","anchor":"ctr","box":[12014200,2159000,2362200,787400],"lineH":365760,"ins":152400,"useW":0.588,"base":2.15,"tail":0.24,"below":[{"id":"37","gap":2.908,"cap":0.219}]},{"id":"37","kind":"text","chars":74,"max":74,"perLine":10.6,"lines":7,"caps":false,"sz":21.0,"paras":1,"text":"Noqulay mehnat şaroiti, alohida xususiyatli iş va nostandart iş kuni uçun.","font":"Solway","anchor":"t","box":[11303000,3073400,3048000,2095500],"lineH":320040,"ins":152400},{"id":"39","kind":"fixed","chars":1,"max":12,"perLine":4.2,"lines":2,"caps":false,"sz":20.0,"paras":1,"text":"4","font":"Solway Bold","anchor":"ctr","box":[4140200,5753100,558800,558800],"lineH":304800,"ins":0},{"id":"40","kind":"label","chars":8,"max":27,"perLine":13.7,"lines":2,"caps":false,"sz":24.0,"paras":1,"text":"Ijtimoiy","font":"Solway Bold","anchor":"ctr","box":[4800600,5676900,2362200,787400],"lineH":365760,"ins":152400,"useW":0.563,"base":2.15,"tail":0.24,"below":[{"id":"41","gap":2.908,"cap":0.219}]},{"id":"41","kind":"label","chars":59,"max":59,"perLine":8.4,"lines":7,"caps":false,"sz":21.0,"paras":1,"text":"Homiladorlik va tuğiş uçun 126 kun, bola parvarişi ta'tili.","font":"Solway","anchor":"t","box":[4089400,6591300,3048000,2095500],"lineH":320040,"ins":152400,"useW":0.939},{"id":"43","kind":"fixed","chars":1,"max":12,"perLine":4.2,"lines":2,"caps":false,"sz":20.0,"paras":1,"text":"5","font":"Solway Bold","anchor":"ctr","box":[7747000,5753100,558800,558800],"lineH":304800,"ins":0},{"id":"44","kind":"label","chars":12,"max":27,"perLine":13.7,"lines":2,"caps":false,"sz":24.0,"paras":1,"text":"Öquv ta'tili","font":"Solway Bold","anchor":"ctr","box":[8407400,5676900,2362200,787400],"lineH":365760,"ins":152400,"useW":0.806,"base":2.15,"tail":0.24,"below":[{"id":"45","gap":2.908,"cap":0.219}]},{"id":"45","kind":"label","chars":49,"max":49,"perLine":7.0,"lines":7,"caps":false,"sz":21.0,"paras":1,"text":"Öqişni iş bilan birga olib borayotgan xodimlarga.","font":"Solway","anchor":"t","box":[7696200,6591300,3048000,2095500],"lineH":320040,"ins":152400,"useW":0.87},{"id":"47","kind":"fixed","chars":1,"max":12,"perLine":4.2,"lines":2,"caps":false,"sz":20.0,"paras":1,"text":"6","font":"Solway Bold","anchor":"ctr","box":[11353800,5753100,558800,558800],"lineH":304800,"ins":0},{"id":"48","kind":"label","chars":13,"max":27,"perLine":13.7,"lines":2,"caps":false,"sz":24.0,"paras":1,"text":"Haqsiz ta'til","font":"Solway Bold","anchor":"ctr","box":[12014200,5676900,2362200,787400],"lineH":365760,"ins":152400,"useW":0.862,"base":2.15,"tail":0.24,"below":[{"id":"49","gap":2.908,"cap":0.219}]},{"id":"49","kind":"text","chars":81,"max":81,"perLine":11.6,"lines":7,"caps":false,"sz":21.0,"paras":1,"text":"Iş haqi saqlanmaydi; xodim arizasi bilan, oilaviy va boşqa uzrli sabablarga köra.","font":"Solway","anchor":"t","box":[11303000,6591300,3048000,2095500],"lineH":320040,"ins":152400}],"photos":[]},{"n":12,"part":"ppt/slides/slide12.xml","role":"content","slots":[{"id":"11","kind":"title","chars":6,"max":33,"perLine":16.6,"lines":2,"caps":true,"sz":46.0,"paras":1,"text":"XULOSA","font":"ITC Motter Corpus Regular","anchor":"t","box":[6413500,2540000,6731000,889000],"lineH":584073,"ins":0,"useW":0.402,"base":1.824,"tail":0.163,"below":[{"id":"12","gap":1.739,"cap":0.255}]},{"id":"12","kind":"text","chars":311,"max":311,"perLine":28.3,"lines":11,"caps":false,"sz":26.0,"paras":4,"text":"Dam oliş vaqti xodimning soğliği va iş qobiliyatini saqlaşga xizmat qiladi.\nQonun tanaffus, kundalik va haftalik dam, bayramlar hamda ta'tillarning eng kam muddatlarini belgilaydi.\nBu kafolatlarni mehnat şartnomasi bilan kamaytirib bölmaydi.\nIş beruvçi ularga rioya etişi, xodim esa öz huquqlarini bilişi zarur.","font":"Solway","anchor":"t","box":[6413500,3556000,5842000,5334000],"lineH":480060,"ins":0}],"photos":[]}]}