{"size":[12192000,6858000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"2","kind":"title","chars":78,"max":78,"perLine":19.5,"lines":4,"caps":false,"sz":40.0,"paras":1,"text":"Taqdimot nutqi ommabop nutqning bir turi sifatida: taqdimot turlari va tarkibi","font":"Times New Roman","anchor":"t","box":[2928401,1380068,7149520,2616199],"lineH":609600,"ins":182880,"useW":0.762,"base":4.565,"tail":0.216,"below":[{"id":"3","gap":5.283,"cap":0.196}]},{"id":"3","kind":"label","chars":47,"max":47,"perLine":11.8,"lines":4,"caps":false,"sz":26.0,"paras":2,"text":"Fan: Akademik yozuv\nMuallif: Xaydarov Abdulaziz","font":"Times New Roman","anchor":"t","box":[3555999,4064000,5842000,1397000],"lineH":396240,"ins":182880,"useW":0.689}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"2","kind":"title","chars":27,"max":60,"perLine":30.0,"lines":3,"caps":false,"sz":18.0,"paras":1,"text":"Taqdimot nutqining mohiyati","font":"Times New Roman","anchor":"t","box":[1484311,685800,5009357,1752599],"lineH":274320,"ins":182880,"useW":0.558,"base":6.965,"tail":0.216,"below":[{"id":"3","gap":7.278,"cap":0.42}]},{"id":"3","kind":"text","chars":432,"max":432,"perLine":39.3,"lines":11,"caps":false,"sz":25.0,"paras":5,"text":"Taqdimot nutqi – g'oya, loyiha yoki natijani auditoriyaga vizual vositalar bilan tushuntirish uchun tayyorlangan nutq.\nU og'zaki so'z va slaydlarni birlashtiradi: ma'lumot ham eshitiladi, ham ko'riladi.\nMaqsadi: xabar yetkazish, qiziqtirish va qaror qabul qilishga yordam berish.\nTaqdimotda nutq asosiy, slayd esa yordamchi vosita hisoblanadi.\nInson ko'rgan va eshitgan ma'lumotni yaxshiroq eslab qoladi – taqdimotning kuchi shunda.","font":"Times New Roman","anchor":"t","box":[1485899,2349499,10020300,4064000],"lineH":381000,"ins":182880}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"2","kind":"title","chars":30,"max":60,"perLine":30.0,"lines":3,"caps":false,"sz":18.0,"paras":1,"text":"Ommabop nutqning xususiyatlari","font":"Times New Roman","anchor":"t","box":[1484311,685800,5009357,1752599],"lineH":274320,"ins":182880,"useW":0.634},{"id":"3","kind":"text","chars":198,"max":198,"perLine":19.8,"lines":10,"caps":false,"sz":25.0,"paras":3,"text":"Sodda va tushunarli til – gaplar qisqa, so'zlar hammaga tanish\nAniq va izchil mantiq – fikrlar ketma-ket bayon qilinadi\nTinglovchiga yo'naltirilganlik – auditoriya yoshi va qiziqishi hisobga olinadi","font":"Times New Roman","anchor":"t","box":[1485900,2412999,4889500,3937000],"lineH":381000,"ins":182880},{"id":"4","kind":"text","chars":147,"max":147,"perLine":14.7,"lines":10,"caps":false,"sz":25.0,"paras":3,"text":"Murakkab atamalar oddiy so'zlar bilan izohlanadi\nMisol, fakt va raqamlar fikrni dalillaydi\nMaqsad: ma'lumot berish, ishontirish va harakatga undash","font":"Times New Roman","anchor":"t","box":[6604000,2413000,4889500,3937000],"lineH":381000,"ins":182880}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"2","kind":"title","chars":34,"max":40,"perLine":20.2,"lines":3,"caps":false,"sz":18.0,"paras":1,"text":"Taqdimot nutqi va oddiy nutq farqi","font":"Times New Roman","anchor":"t","box":[1484311,685800,5009357,1752599],"lineH":274320,"ins":182880,"useW":0.667},{"id":"3","kind":"label","chars":10,"max":54,"perLine":27.3,"lines":2,"caps":false,"sz":22.0,"paras":1,"text":"Oddiy nutq","font":"Times New Roman","anchor":"t","box":[1485900,2540000,4889500,508000],"lineH":335280,"ins":182880,"useW":0.269,"base":2.165,"tail":0.216,"below":[{"id":"4","gap":2.045,"cap":0.343}]},{"id":"4","kind":"text","chars":125,"max":125,"perLine":13.9,"lines":9,"caps":false,"sz":25.0,"paras":3,"text":"Faqat so'z, ohang va imo-ishora orqali yetkaziladi\nErkin tuziladi, vaqt chegarasi qat'iy emas\nKo'rgazmali vositalarsiz o'tadi","font":"Times New Roman","anchor":"t","box":[1485900,3111500,4889500,3302000],"lineH":381000,"ins":182880},{"id":"5","kind":"label","chars":14,"max":81,"perLine":40.6,"lines":2,"caps":false,"sz":22.0,"paras":1,"text":"Taqdimot nutqi","font":"Times New Roman","anchor":"t","box":[6603999,2540000,4889500,508000],"lineH":335280,"ins":182880,"useW":0.368,"base":2.165,"tail":0.216,"below":[{"id":"6","gap":2.045,"cap":0.343}]},{"id":"6","kind":"text","chars":143,"max":143,"perLine":15.9,"lines":9,"caps":false,"sz":25.0,"paras":3,"text":"So'z, slayd, diagramma va tasvir uyg'unlashadi\nReja asosida tuziladi, vaqt aniq belgilanadi\nMa'lumot ko'rgazmali bo'lgani uchun tez tushuniladi","font":"Times New Roman","anchor":"t","box":[6604000,3111500,4889500,3302000],"lineH":381000,"ins":182880}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"2","kind":"title","chars":18,"max":49,"perLine":24.5,"lines":2,"caps":false,"sz":40.0,"paras":1,"text":"Ommabop nutq nima?","font":"Times New Roman","anchor":"t","box":[1485900,889000,5334000,1397000],"lineH":609600,"ins":182880,"useW":0.882},{"id":"4","kind":"text","chars":290,"max":290,"perLine":29.0,"lines":10,"caps":false,"sz":25.0,"paras":3,"text":"Ommabop nutq keng auditoriyaga mo'ljallangan, oddiy va tushunarli tilda bayon etiladigan og'zaki nutq turidir.\nU ilmiy bilim, yangilik yoki g'oyani maxsus tayyorgarligi bo'lmagan tinglovchiga yetkazadi.\nMa'ruza, suhbat, chiqish va taqdimot – ommabop nutqning eng ko'p uchraydigan shakllari.","font":"Times New Roman","anchor":"t","box":[1485900,2413000,5715000,3937000],"lineH":381000,"ins":182880}],"photos":[{"id":"3","w":3280974,"h":4572000,"area":0.179}]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"2","kind":"title","chars":23,"max":34,"perLine":7.7,"lines":3,"caps":false,"sz":34.0,"paras":1,"text":"Asosiy tarkibiy qismlar","font":"Times New Roman","anchor":"t","box":[1484312,1600200,3209115,1371600],"lineH":518160,"ins":182880,"useW":0.876,"base":3.365,"tail":0.216,"below":[{"id":"4","gap":3.176,"cap":0.187}]},{"id":"3","kind":"text","chars":270,"max":270,"perLine":19.3,"lines":14,"caps":false,"sz":25.0,"paras":4,"text":"Kirish: salomlashish, mavzu va maqsadni aytish, e'tiborni jalb qilish.\nAsosiy qism: dalillar, faktlar va misollar mantiqiy ketma-ketlikda beriladi.\nXulosa: asosiy fikrlar umumlashtiriladi, yakuniy chaqiriq aytiladi.\nSavol-javob: tinglovchilar savollariga javob beriladi.","font":"Times New Roman","anchor":"t","box":[5257800,761999,6235700,5334000],"lineH":381000,"ins":182880},{"id":"4","kind":"text","chars":69,"max":69,"perLine":8.6,"lines":8,"caps":false,"sz":21.0,"paras":1,"text":"Odatda kirish vaqtning 10 %, asosiy qism 75 %, xulosa 15 % ini oladi.","font":"Times New Roman","anchor":"t","box":[1485900,2971800,3543300,2540000],"lineH":320040,"ins":182880}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"2","kind":"title","chars":31,"max":60,"perLine":30.0,"lines":3,"caps":false,"sz":18.0,"paras":1,"text":"Ommabop nutqning asosiy turlari","font":"Times New Roman","anchor":"t","box":[2578100,1905000,7620000,1905000],"lineH":274320,"ins":182880,"useW":0.414},{"id":"3","kind":"text","chars":254,"max":254,"perLine":36.3,"lines":7,"caps":false,"sz":25.0,"paras":2,"text":"Axborot beruvchi nutq yangi ma'lumot yetkazadi; ishontiruvchi nutq fikrni qabul qildiradi; tantanali nutq bayram va marosimlarda so'zlanadi; ko'ngil ochuvchi nutq kayfiyatni ko'taradi.\nTaqdimot nutqi asosan axborot beruvchi va ishontiruvchi nutqqa yaqin.","font":"Times New Roman","anchor":"t","box":[2578100,3937000,8928100,2540000],"lineH":381000,"ins":182880}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"end","slots":[{"id":"2","kind":"title","chars":10,"max":89,"perLine":29.5,"lines":3,"caps":false,"sz":54.0,"paras":1,"text":"Thank you!","font":"Times New Roman","anchor":"t","box":[2928401,1380068,8574622,2616199],"lineH":822960,"ins":182880,"useW":0.378,"base":3.365,"tail":0.216,"below":[{"id":"3","gap":3.815,"cap":0.134}]},{"id":"3","kind":"label","chars":24,"max":215,"perLine":53.9,"lines":4,"caps":false,"sz":24.0,"paras":1,"text":"Questions and discussion","font":"Times New Roman","anchor":"t","box":[4515377,3996267,6987645,1388534],"lineH":365760,"ins":182880,"useW":0.453}],"photos":[]}]}