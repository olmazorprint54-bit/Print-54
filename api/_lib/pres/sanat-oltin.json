":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"7","kind":"title","chars":15,"max":19,"perLine":19.5,"lines":1,"caps":false,"sz":96.0,"paras":1,"text":"Why Art History","font":"Noto Serif ExtraCondensed","anchor":"t","box":[4257893,1123950,9467415,1360170],"lineH":1341120,"ins":0},{"id":"8","kind":"label","chars":8,"max":11,"perLine":11.2,"lines":1,"caps":false,"sz":96.0,"paras":1,"text":"Matters?","font":"Noto Serif ExtraCondensed Bold Italics","anchor":"t","box":[6114005,2387600,6059990,1457325],"lineH":1462913,"ins":0},{"id":"9","kind":"label","chars":41,"max":69,"perLine":69.3,"lines":1,"caps":false,"sz":31.99,"paras":1,"text":"Understanding the Past Through Creativity","font":"Noto Serif ExtraCondensed Bold","anchor":"t","box":[2990850,4413250,12306300,537845],"lineH":568833,"ins":0},{"id":"10","kind":"text","chars":199,"max":199,"perLine":99.5,"lines":2,"caps":false,"sz":25.0,"paras":1,"text":"Every artwork tells a story beyond its appearance. By studying art history, we gain insight into cultural traditions, historical events, technological progress, and the values of different societies.","font":"Noto Serif ExtraCondensed","anchor":"t","box":[2990850,5046891,12306300,869950],"lineH":444500,"ins":0},{"id":"11","kind":"text","chars":104,"max":109,"perLine":108.5,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Rather than simply observing beautiful objects, we begin to understand the people and ideas behind them.","font":"Noto Serif ExtraCondensed","anchor":"t","box":[2266950,5993041,13754100,431800],"lineH":444500,"ins":0},{"id":"12","kind":"label","chars":10,"max":20,"perLine":20.5,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Creativity","font":"Noto Serif ExtraCondensed Bold","anchor":"t","box":[2838450,8204200,2838450,431800],"lineH":444500,"ins":0},{"id":"13","kind":"label","chars":7,"max":20,"perLine":20.5,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Culture","font":"Noto Serif ExtraCondensed Bold","anchor":"t","box":[6096000,820