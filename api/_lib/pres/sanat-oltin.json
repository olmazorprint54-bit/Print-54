{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"6","kind":"label","chars":47,"max":60,"perLine":59.7,"lines":1,"caps":false,"sz":36.0,"paras":1,"text":"A Journey Through Time, Creativity, and Culture"},{"id":"7","kind":"title","chars":11,"max":10,"perLine":10.3,"lines":1,"caps":false,"sz":144.0,"paras":1,"text":"Art History"}],"photos":[{"id":"4","w":18288000,"h":4573270,"area":0.445}]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"4","kind":"title","chars":7,"max":11,"perLine":11.3,"lines":1,"caps":false,"sz":96.0,"paras":1,"text":"What Is"},{"id":"5","kind":"text","chars":90,"max":90,"perLine":45.0,"lines":2,"caps":false,"sz":25.0,"paras":1,"text":"Art history is the study of visual art throughout different periods of human civilization."},{"id":"6","kind":"text","chars":150,"max":150,"perLine":47.7,"lines":3,"caps":false,"sz":25.0,"paras":1,"text":"It explores how artistic expression reflects culture, beliefs, technology, and society while revealing the evolution of creativity across generations."},{"id":"7","kind":"label","chars":12,"max":10,"perLine":10.1,"lines":1,"caps":false,"sz":96.0,"paras":1,"text":"Art History?"}],"photos":[{"id":"3","w":8991600,"h":10607221,"area":0.507}]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"7","kind":"title","chars":15,"max":16,"perLine":15.5,"lines":1,"caps":false,"sz":96.0,"paras":1,"text":"Why Art History"},{"id":"8","kind":"label","chars":8,"max":9,"perLine":8.9,"lines":1,"caps":false,"sz":96.0,"paras":1,"text":"Matters?"},{"id":"9","kind":"label","chars":41,"max":54,"perLine":54.1,"lines":1,"caps":false,"sz":31.99,"paras":1,"text":"Understanding the Past Through Creativity"},{"id":"10","kind":"text","chars":199,"max":199,"perLine":85.3,"lines":2,"caps":false,"sz":25.0,"paras":1,"text":"Every artwork tells a story beyond its appearance. By studying art history, we gain insight into cultural traditions, historical events, technological progress, and the values of different societies."},{"id":"11","kind":"text","chars":104,"max":104,"perLine":86.6,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Rather than simply observing beautiful objects, we begin to understand the people and ideas behind them."},{"id":"12","kind":"label","chars":10,"max":16,"perLine":16.0,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Creativity"},{"id":"13","kind":"label","chars":7,"max":16,"perLine":16.0,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Culture"},{"id":"14","kind":"label","chars":8,"max":16,"perLine":16.0,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Identity"},{"id":"15","kind":"label","chars":10,"max":16,"perLine":16.0,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Innovation"}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"9","kind":"title","chars":13,"max":16,"perLine":15.5,"lines":1,"caps":false,"sz":96.0,"paras":1,"text":"A Timeline of"},{"id":"10","kind":"label","chars":16,"max":16,"perLine":15.6,"lines":1,"caps":false,"sz":96.0,"paras":1,"text":"Human Creativity"},{"id":"11","kind":"label","chars":7,"max":16,"perLine":16.0,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Phase 1"},{"id":"12","kind":"label","chars":7,"max":16,"perLine":16.0,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Phase 2"},{"id":"13","kind":"label","chars":7,"max":16,"perLine":16.0,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Phase 3"},{"id":"14","kind":"label","chars":7,"max":16,"perLine":16.0,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Phase 4"},{"id":"15","kind":"label","chars":7,"max":16,"perLine":16.0,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Phase 5"},{"id":"16","kind":"label","chars":7,"max":16,"perLine":16.0,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Phase 6"},{"id":"17","kind":"label","chars":56,"max":56,"perLine":18.7,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"The beginning of human creativity and visual expression."},{"id":"18","kind":"label","chars":59,"max":54,"perLine":18.0,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Art became a way to share beliefs, stories, and traditions."},{"id":"19","kind":"text","chars":65,"max":65,"perLine":16.2,"lines":4,"caps":false,"sz":20.0,"paras":1,"text":"Creative ideas evolved alongside changing cultures and societies."},{"id":"20","kind":"text","chars":70,"max":70,"perLine":17.5,"lines":4,"caps":false,"sz":20.0,"paras":1,"text":"Innovation inspired new techniques, perspectives, and artistic styles."},{"id":"21","kind":"text","chars":66,"max":66,"perLine":16.5,"lines":4,"caps":false,"sz":20.0,"paras":1,"text":"Art embraced experimentation, individuality, and global influence."},{"id":"22","kind":"text","chars":78,"max":78,"perLine":19.5,"lines":4,"caps":false,"sz":20.0,"paras":1,"text":"Creativity continues to evolve through technology and limitless possibilities."}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"23","kind":"label","chars":7,"max":8,"perLine":7.1,"lines":1,"caps":false,"sz":96.0,"paras":1,"text":"How Art"},{"id":"24","kind":"title","chars":7,"max":8,"perLine":7.3,"lines":1,"caps":false,"sz":96.0,"paras":1,"text":"Evolves"},{"id":"25","kind":"text","chars":222,"max":222,"perLine":64.8,"lines":3,"caps":false,"sz":25.0,"paras":1,"text":"Art continuously evolves as societies change. New materials, technologies, beliefs, and cultural exchanges influence how artists express ideas, resulting in the emergence of different artistic movements throughout history."},{"id":"30","kind":"label","chars":16,"max":25,"perLine":12.3,"lines":2,"caps":false,"sz":25.0,"paras":1,"text":"Human Experience"},{"id":"31","kind":"label","chars":5,"max":12,"perLine":12.3,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Ideas"},{"id":"32","kind":"label","chars":9,"max":12,"perLine":12.3,"lines":1,"caps":false,"sz":25.0,"paras":1,"text":"Materials"},{"id":"33","kind":"label","chars":13,"max":19,