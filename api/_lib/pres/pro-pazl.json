     "max": 44,
     "perLine": 44.5,
     "lines": 1,
     "caps": true,
     "sz": 14,
     "paras": 1,
     "text": "03  /  MULOQOT",
     "font": "Segoe UI Semibold",
     "anchor": "t",
     "box": [
      635000,
      889000,
      4699000,
      215444
     ],
     "lineH": 213360,
     "ins": 0
    },
    {
     "id": "63",
     "kind": "title",
     "chars": 13,
     "max": 20,
     "perLine": 20.5,
     "lines": 1,
     "caps": false,
     "sz": 40,
     "paras": 1,
     "text": "Ochiq muloqot",
     "font": "Segoe UI Black",
     "anchor": "b",
     "box": [
      635000,
      1168400,
      4699000,
      615553
     ],
     "lineH": 609600,
     "ins": 0
    },
    {
     "id": "64",
     "kind": "text",
     "chars": 108,
     "max": 108,
     "perLine": 36,
     "lines": 3,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Yaxshi jamoada fikrlar ochiq aytiladi va hurmat bilan tinglanadi. Muammo yashirilmaydi — birga hal qilinadi.",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      635000,
      2565400,
      4699000,
      738664
     ],
     "lineH": 243840,
     "ins": 0
    },
    {
     "id": "65",
     "kind": "text",
     "chars": 78,
     "max": 78,
     "perLine": 19.5,
     "lines": 4,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "Muntazam qisqa uchrashuvlar\nFikrni hurmat bilan bildiring\nTinglashni o'rganing",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      635000,
      4038600,
      4699000,
      984885
     ],
     "lineH": 274320,
     "ins": 0
    }
   ],
   "photos": []
  },
  {
   "n": 5,
   "part": "ppt/slides/slide5.xml",
   "role": "content",
   "slots": [
    {
     "id": "62",
     "kind": "label",
