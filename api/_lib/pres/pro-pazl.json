     ],
     "lineH": 213360,
     "ins": 0
    },
    {
     "id": "63",
     "kind": "title",
     "chars": 18,
     "max": 20,
     "perLine": 20.5,
     "lines": 1,
     "caps": false,
     "sz": 40,
     "paras": 1,
     "text": "Bir-biriga tayanch",
     "font": "Segoe UI Black",
     "anchor": "b",
     "box": [
      635000,
      1168400,
      4699000,
      615553
     ],
     "lineH": 609600,
     "ins": 0
    },
    {
     "id": "64",
     "kind": "text",
     "chars": 116,
     "max": 116,
     "perLine": 38.7,
     "lines": 3,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Kimdir qiynalsa, jamoa yordamga keladi. O'zaro yordam ishonchni oshiradi va eng qiyin vazifani ham yengillashtiradi.",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      635000,
      2565400,
      4699000,
      738664
     ],
     "lineH": 243840,
     "ins": 0
    },
    {
     "id": "65",
     "kind": "text",
     "chars": 94,
     "max": 94,
     "perLine": 23.5,
     "lines": 4,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "Bilganingizni boshqalarga o'rgating\nYordam so'rashdan uyalmang\nMuvaffaqiyatni birga nishonlang",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      635000,
      4038600,
      4699000,
      984885
     ],
     "lineH": 274320,
     "ins": 0
    }
   ],
   "photos": []
  },
  {
