     "max": 20,
     "perLine": 20.5,
     "lines": 1,
     "caps": false,
     "sz": 40,
     "paras": 1,
     "text": "Birgalikda — kuch",
     "font": "Segoe UI Black",
     "anchor": "b",
     "box": [
      635000,
      1168400,
      4699000,
      615553
     ],
     "lineH": 609600,
     "ins": 0
    },
    {
     "id": "64",
     "kind": "text",
     "chars": 127,
     "max": 127,
     "perLine": 42.3,
     "lines": 3,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Alohida bo'laklar o'zi hech narsa emas, ammo birlashganda to'liq rasm hosil bo'ladi. Jamoa natijasi — har birimizning hissamiz.",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      635000,
      2565400,
      4699000,
      738664
     ],
     "lineH": 243840,
     "ins": 0
    },
    {
     "id": "65",
     "kind": "text",
     "chars": 76,
     "max": 76,
     "perLine": 19,
     "lines": 4,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "Natijani tahlil qiling\nXatolardan saboq oling\nKeyingi maqsadni birga tanlang",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      635000,
      4038600,
      4699000,
      984885
     ],
     "lineH": 274320,
     "ins": 0
    }
   ],
   "photos": []
