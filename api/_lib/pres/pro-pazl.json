     "caps": true,
     "sz": 14,
     "paras": 1,
     "text": "01  /  MAQSAD",
     "font": "Segoe UI Semibold",
     "anchor": "t",
     "box": [
      635000,
      889000,
      4699000,
      215444
     ],
     "lineH": 213360,
     "ins": 0
    },
    {
     "id": "63",
     "kind": "title",
     "chars": 13,
     "max": 20,
     "perLine": 20.5,
     "lines": 1,
     "caps": false,
     "sz": 40,
     "paras": 1,
     "text": "Umumiy maqsad",
     "font": "Segoe UI Black",
     "anchor": "b",
     "box": [
      635000,
      1168400,
      4699000,
      615553
     ],
     "lineH": 609600,
     "ins": 0
    },
    {
     "id": "64",
     "kind": "text",
     "chars": 123,
     "max": 123,
     "perLine": 41,
     "lines": 3,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Jamoa bitta aniq maqsad atrofida birlashadi. Har bir a'zo nimaga intilayotganini bilsa, kuchlar bir yo'nalishga sarflanadi.",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      635000,
      2565400,
      4699000,
      738664
     ],
     "lineH": 243840,
     "ins": 0
    },
    {
     "id": "65",
     "kind": "text",
     "chars": 91,
     "max": 91,
     "perLine": 22.8,
     "lines": 4,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "Maqsadni aniq va qisqa yozing\nMuddatni birga belgilang\nNatijani qanday o'lchashni kelishing",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      635000,
      4038600,
      4699000,
      984885
     ],
     "lineH": 274320,
     "ins": 0
    }
   ],
   "photos": []
  },
  {
   "n": 3,
   "part": "ppt/slides/slide3.xml",
   "role": "content",
   "slots": [
    {
     "id": "62",
     "kind": "label",
     "chars": 13,
     "max": 44,
     "perLine": 44.5,
     "lines": 1,
     "caps": true,
     "sz": 14,
     "paras": 1,
     "text": "02  /  ROLLAR",
     "font": "Segoe UI Semibold",
     "anchor": "t",
     "box": [
      635000,
      889000,
      4699000,
      215444
     ],
     "lineH": 213360,
     "ins": 0
    },
    {
     "id": "63",
     "kind": "title",
     "chars": 21,
     "max": 21,
     "perLine": 10.5,
     "lines": 2,
     "caps": false,
     "sz": 40,
     "paras": 1,
     "text": "Har kimning o'rni bor",
     "font": "Segoe UI Black",
     "anchor": "b",
     "box": [
      635000,
      1168400,
      4699000,
      1270000
     ],
     "lineH": 609600,
     "ins": 0
    },
    {
     "id": "64",
     "kind": "text",
     "chars": 124,
     "max": 124,
     "perLine": 41.3,
     "lines": 3,
     "caps": false,
     "sz": 16,
     "paras": 1,
     "text": "Pazlning har bir bo'lagi kabi, jamoada ham har bir a'zoning o'z vazifasi bor. Bir bo'lak yo'q bo'lsa, rasm to'liq bo'lmaydi.",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      635000,
      2565400,
      4699000,
      738664
     ],
     "lineH": 243840,
     "ins": 0
    },
    {
     "id": "65",
     "kind": "text",
     "chars": 100,
     "max": 100,
     "perLine": 25,
     "lines": 4,
     "caps": false,
     "sz": 18,
     "paras": 3,
     "text": "Vazifalarni kuchli tomonlarga qarab bo'ling\nMas'uliyatni aniq belgilang\nHech kimni chetda qoldirmang",
     "font": "Segoe UI",
     "anchor": "t",
     "box": [
      635000,
      4038600,
      4699000,
      984885
     ],
     "lineH": 274320,
     "ins": 0
    }
   ],
   "photos": []
  },
  {
   "n": 4,
   "part": "ppt/slides/slide4.xml",
   "role": "content",
   "slots": [
    {
     "id": "62",
     "kind": "label",
