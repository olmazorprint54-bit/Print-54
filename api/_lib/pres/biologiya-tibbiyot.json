{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"12","kind":"label","chars":12,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation"},{"id":"13","kind":"label","chars":8,"max":10,"perLine":10.4,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle"},{"id":"18","kind":"label","chars":6,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1"},{"id":"20","kind":"title","chars":7,"max":15,"perLine":14.9,"lines":1,"caps":true,"sz":96.0,"paras":1,"text":"MEDICAL"},{"id":"21","kind":"label","chars":12,"max":15,"perLine":14.9,"lines":1,"caps":true,"sz":96.0,"paras":1,"text":"PRESENTATION"},{"id":"22","kind":"label","chars":58,"max":64,"perLine":63.5,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"From Lab to Life: How New Drugs are Developed and Approved"}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"12","kind":"label","chars":12,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation"},{"id":"13","kind":"label","chars":8,"max":10,"perLine":10.4,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle"},{"id":"18","kind":"label","chars":6,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1"},{"id":"26","kind":"title","chars":19,"max":39,"perLine":38.7,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"The Discovery Phase"},{"id":"27","kind":"fixed","chars":2,"max":12,"perLine":4.8,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"01"},{"id":"28","kind":"label","chars":19,"max":39,"perLine":38.7,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"Preclinical Testing"},{"id":"29","kind":"fixed","chars":2,"max":12,"perLine":4.8,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"02"},{"id":"30","kind":"label","chars":42,"max":39,"perLine":38.7,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"Investigational New Drug (IND) Application"},{"id":"31","kind":"fixed","chars":2,"max":12,"perLine":4.8,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"03"},{"id":"32","kind":"label","chars":23,"max":39,"perLine":38.7,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"Phase I Clinical Trials"},{"id":"33","kind":"fixed","chars":2,"max":12,"perLine":4.8,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"04"},{"id":"34","kind":"label","chars":24,"max":39,"perLine":38.7,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"Phase II Clinical Trials"},{"id":"35","kind":"fixed","chars":2,"max":12,"perLine":4.8,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"05"},{"id":"36","kind":"label","chars":25,"max":39,"perLine":38.7,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"Phase III Clinical Trials"},{"id":"37","kind":"fixed","chars":2,"max":12,"perLine":4.8,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"06"},{"id":"38","kind":"label","chars":38,"max":39,"perLine":38.7,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"Post-Marketing Surveillance (Phase IV)"},{"id":"39","kind":"fixed","chars":2,"max":12,"perLine":4.8,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"07"}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"14","kind":"label","chars":12,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation"},{"id":"15","kind":"label","chars":8,"max":10,"perLine":10.4,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle"},{"id":"20","kind":"label","chars":6,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1"},{"id":"21","kind":"title","chars":19,"max":29,"perLine":14.5,"lines":2,"caps":false,"sz":72.0,"paras":2,"text":"The Discovery\nPhase"},{"id":"22","kind":"text","chars":267,"max":267,"perLine":44.5,"lines":6,"caps":false,"sz":18.0,"paras":1,"text":"This is the starting point where scientists study how diseases work and search for potential compounds that might affect them. Researchers look for biological targets like proteins or enzymes and test many chemical substances to find those with promise for treatment."}],"photos":[{"id":"10","w":7627620,"h":7627620,"area":0.309}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"11","kind":"label","chars":12,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation"},{"id":"12","kind":"label","chars":8,"max":10,"perLine":10.4,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle"},{"id":"17","kind":"label","chars":6,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1"},{"id":"18","kind":"title","chars":19,"max":22,"perLine":11.2,"lines":2,"caps":false,"sz":72.0,"paras":2,"text":"Preclinical\nTesting"},{"id":"19","kind":"text","chars":252,"max":252,"perLine":36.0,"lines":7,"caps":false,"sz":18.0,"paras":1,"text":"Before testing drugs on humans, researchers use lab tests and animal studies to understand how a drug behaves in the body. This includes examining how the drug is absorbed, distributed, metabolized, and excreted, as well as any potential toxic effects."},{"id":"20","kind":"label","chars":24,"max":29,"perLine":29.2,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"Preclinical Testing Tips"},{"id":"21","kind":"text","chars":73,"max":73,"perLine":24.3,"lines":3,"caps":false,"sz":15.99,"paras":1,"text":"Analyze how the drug is absorbed, distributed, metabolized, and excreted."}],"photos":[{"id":"7","w":6484620,"h":6484620,"area":0.224}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"3","kind":"label","chars":12,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation"},{"id":"4","kind":"label","chars":8,"max":10,"perLine":10.4,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle"},{"id":"9","kind":"label","chars":6,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1"},{"id":"10","kind":"title","chars":42,"max":42,"perLine":21.0,"lines":2,"caps":false,"sz":72.0,"paras":2,"text":"Investigational New Drug\n(IND) Application"},{"id":"11","kind":"text","chars":252,"max":252,"perLine":84.0,"lines":3,"caps":false,"sz":18.0,"paras":1,"text":"Once preclinical results look promising, scientists must apply for approval to begin clinical trials in humans. The IND application contains all the preclinical data, the proposed study design for human trials, and how patient safety will be protected."}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"11","kind":"label","chars":8,"max":10,"perLine":10.4,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle"},{"id":"18","kind":"label","chars":12,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation"},{"id":"19","kind":"label","chars":6,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1"},{"id":"20","kind":"title","chars":23,"max":23,"perLine":7.7,"lines":3,"caps":false,"sz":72.0,"paras":3,"text":"Phase I\nClinical\nTrials"},{"id":"21","kind":"text","chars":248,"max":248,"perLine":35.4,"lines":7,"caps":false,"sz":18.0,"paras":1,"text":"This is the first stage of human testing. It typically involves a small number of healthy volunteers to evaluate safety, determine a safe dosage range, and identify side effects. The main goal is to learn how the drug interacts with the human body."},{"id":"22","kind":"label","chars":27,"max":29,"perLine":29.2,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"Phase 1 Clinical Trial Tips"},{"id":"23","kind":"text","chars":84,"max":84,"perLine":28.0,"lines":3,"caps":false,"sz":15.99,"paras":1,"text":"Watch closely for side effects and study how the drug interacts with the human body."}],"photos":[{"id":"7","w":6484620,"h":6484620,"area":0.224}]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"14","kind":"label","chars":12,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation"},{"id":"15","kind":"label","chars":8,"max":10,"perLine":10.4,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle"},{"id":"20","kind":"label","chars":6,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1"},{"id":"21","kind":"title","chars":24,"max":24,"perLine":12.0,"lines":2,"caps":false,"sz":72.0,"paras":2,"text":"Phase II\nClinical Trials"},{"id":"22","kind":"text","chars":224,"max":224,"perLine":44.8,"lines":5,"caps":false,"sz":18.0,"paras":1,"text":"After confirming basic safety, the drug is given to a larger group of people who have the condition the drug is meant to treat. Researchers assess how well the drug works, monitor short-term side effects, and refine dosages."}],"photos":[{"id":"10","w":7627620,"h":7627620,"area":0.309}]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"3","kind":"label","chars":12,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation"},{"id":"4","kind":"label","chars":8,"max":10,"perLine":10.4,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle"},{"id":"9","kind":"label","chars":6,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1"},{"id":"10","kind":"title","chars":25,"max":25,"perLine":12.5,"lines":2,"caps":false,"sz":72.0,"paras":2,"text":"Phase III\nClinical Trials"},{"id":"11","kind":"text","chars":247,"max":247,"perLine":82.3,"lines":3,"caps":false,"sz":18.0,"paras":1,"text":"In this phase, the drug is tested on hundreds or even thousands of people. It’s compared to existing treatments or placebos to see if it is more effective or safer. These trials provide the strongest evidence for whether a drug should be approved."}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"12","kind":"label","chars":12,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation"},{"id":"13","kind":"label","chars":8,"max":10,"perLine":10.4,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle"},{"id":"18","kind":"label","chars":6,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1"},{"id":"19","kind":"title","chars":38,"max":38,"perLine":12.7,"lines":3,"caps":false,"sz":72.0,"paras":3,"text":"Post-Marketing\nSurveillance\n(Phase IV)"},{"id":"20","kind":"text","chars":232,"max":232,"perLine":58.0,"lines":4,"caps":false,"sz":18.0,"paras":1,"text":"Once the drug is approved and available to the public, it continues to be monitored. Doctors and patients report any unexpected side effects or long-term issues. This helps catch rare problems that might not have shown up in trials."}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"end","slots":[{"id":"12","kind":"label","chars":12,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation"},{"id":"13","kind":"label","chars":8,"max":10,"perLine":10.4,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle"},{"id":"18","kind":"label","chars":6,"max":14,"perLine":13.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1"},{"id":"20","kind":"title","chars":5,"max":15,"perLine":14.9,"lines":1,"caps":true,"sz":96.0,"paras":1,"text":"THANK"},{"id":"21","kind":"label","chars":3,"max":15,"perLine":14.9,"lines":1,"caps":true,"sz":96.0,"paras":1,"text":"YOU"},{"id":"22","kind":"label","chars":58,"max":64,"perLine":63.5,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"From Lab to Life: How New Drugs are Developed and Approved"}],"photos":[]}]}