lineH":283845,"ins":0,"useW":0.852},{"id":"13","kind":"label","chars":8,"max":11,"perLine":11.1,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle","font":"Montserrat Medium","anchor":"t","box":[604914,9623634,1180920,264243],"lineH":283845,"ins":0,"useW":0.714},{"id":"18","kind":"label","chars":6,"max":15,"perLine":14.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1","font":"Montserrat Medium","anchor":"t","box":[16113605,9623634,1560276,264243],"lineH":283845,"ins":0,"useW":0.423},{"id":"26","kind":"title","chars":19,"max":41,"perLine":41.3,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"The Discovery Phase","font":"Montserrat Medium","anchor":"t","box":[8649367,2591605,6606984,400271],"lineH":426466,"ins":0,"useW":0.484},{"id":"27","kind":"fixed","chars":2,"max":12,"perLine":5.1,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"01","font":"Montserrat Medium","anchor":"t","box":[15256351,2591605,821849,400271],"lineH":426466,"ins":0},{"id":"28","kind":"label","chars":19,"max":41,"perLine":41.3,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"Preclinical Testing","font":"Montserrat Medium","anchor":"t","box":[8649367,3357498,6606984,400271],"lineH":426466,"ins":0,"useW":0.429},{"id":"29","kind":"fixed","chars":2,"max":12,"perLine":5.1,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"02","font":"Montserrat Medium","anchor":"t","box":[15256351,3357498,821849,400271],"lineH":426466,"ins":0},{"id":"30","kind":"label","chars":42,"max":41,"perLine":41.3,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"Investigational New Drug (IND) Application","font":"Montserrat Medium","anchor":"t","box":[8649367,4123391,6606984,400271],"lineH":426466,"ins":0,"useW":0.733},{"id":"31","kind":"fixed","chars":2,"max":12,"perLine":5.1,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"03","font":"Montserrat Medium","anchor":"t","box":[15256351,4123391,821849,400271],"lineH":426466,"ins":0},{"id":"32","kind":"label","chars":23,"max":41,"perLine":41.3,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"Phase I Clinical Trials","font":"Montserrat Medium","anchor":"t","box":[8649367,4889284,6606984,400271],"lineH":426466,"ins":0,"useW":0.488},{"id":"33","kind":"fixed","chars":2,"max":12,"perLine":5.1,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"04","font":"Montserrat Medium","anchor":"t","box":[15256351,4889284,821849,400271],"lineH":426466,"ins":0},{"id":"34","kind":"label","chars":24,"max":41,"perLine":41.3,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"Phase II Clinical Trials","font":"Montserrat Medium","anchor":"t","box":[8649367,5655177,6606984,400271],"lineH":426466,"ins":0,"useW":0.502},{"id":"35","kind":"fixed","chars":2,"max":12,"perLine":5.1,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"05","font":"Montserrat Medium","anchor":"t","box":[15256351,5655177,821849,400271],"lineH":426466,"ins":0},{"id":"36","kind":"label","chars":25,"max":41,"perLine":41.3,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"Phase III Clinical Trials","font":"Montserrat Medium","anchor":"t","box":[8649367,6421070,6606984,400271],"lineH":426466,"ins":0,"useW":0.516},{"id":"37","kind":"fixed","chars":2,"max":12,"perLine":5.1,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"06","font":"Montserrat Medium","anchor":"t","box":[15256351,6421070,821849,400271],"lineH":426466,"ins":0},{"id":"38","kind":"label","chars":38,"max":41,"perLine":41.3,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"Post-Marketing Surveillance (Phase IV)","font":"Montserrat Medium","anchor":"t","box":[8649367,7186963,6606984,400271],"lineH":426466,"ins":0,"useW":0.909},{"id":"39","kind":"fixed","chars":2,"max":12,"perLine":5.1,"lines":1,"caps":false,"sz":23.98,"paras":1,"text":"07","font":"Montserrat Medium","anchor":"t","box":[15256351,7186963,821849,400271],"lineH":426466,"ins":0}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"14","kind":"label","chars":12,"max":15,"perLine":14.6,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation","font":"Montserrat Medium","anchor":"t","box":[604914,373787,1557765,264243],"lineH":283845,"ins":0,"useW":0.852},{"id":"15","kind":"label","chars":8,"max":11,"perLine":11.1,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle","font":"Montserrat Medium","anchor":"t","box":[604914,9623634,1180920,264243],"lineH":283845,"ins":0,"useW":0.714},{"id":"20","kind":"label","chars":6,"max":15,"perLine":14.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1","font":"Montserrat Medium","anchor":"t","box":[16113605,9623634,1560276,264243],"lineH":283845,"ins":0,"useW":0.423},{"id":"21","kind":"title","chars":19,"max":29,"perLine":14.7,"lines":2,"caps":false,"sz":72.0,"paras":2,"text":"The Discovery\nPhase","font":"Montserrat Ultra-Bold","anchor":"t","box":[1481849,3076409,7428833,1820037],"lineH":886968,"ins":0,"useW":0.929,"base":1.74,"tail":0.203,"below":[{"id":"22","gap":2.287,"cap":0.151}]},{"id":"22","kind":"text","chars":267,"max":267,"perLine":44.5,"lines":6,"caps":false,"sz":18.0,"paras":1,"text":"This is the starting point where scientists study how diseases work and search for potential compounds that might affect them. Researchers look for biological targets like proteins or enzymes and test many chemical substances to find those with promise for treatment.","font":"Montserrat Medium","anchor":"t","box":[1481849,5168050,6537869,2204466],"lineH":374904,"ins":0}],"photos":[{"id":"10","w":7627620,"h":7627620,"area":0.309}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"11","kind":"label","chars":12,"max":15,"perLine":14.6,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation","font":"Montserrat Medium","anchor":"t","box":[604914,373787,1557765,264243],"lineH":283845,"ins":0,"useW":0.852},{"id":"12","kind":"label","chars":8,"max":11,"perLine":11.1,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle","font":"Montserrat Medium","anchor":"t","box":[604914,9623634,1180920,264243],"lineH":283845,"ins":0,"useW":0.714},{"id":"17","kind":"label","chars":6,"max":15,"perLine":14.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1","font":"Montserrat Medium","anchor":"t","box":[16113605,9623634,1560276,264243],"lineH":283845,"ins":0,"useW":0.423},{"id":"18","kind":"title","chars":19,"max":23,"perLine":11.3,"lines":2,"caps":false,"sz":72.0,"paras":2,"text":"Preclinical\nTesting","font":"Montserrat Ultra-Bold","anchor":"t","box":[12197673,2890521,5710523,1820037],"lineH":886968,"ins":0,"useW":0.895,"base":1.74,"tail":0.203,"below":[{"id":"19","gap":2.288,"cap":0.151}]},{"id":"19","kind":"text","chars":252,"max":252,"perLine":36.0,"lines":7,"caps":false,"sz":18.0,"paras":1,"text":"Before testing drugs on humans, researchers use lab tests and animal studies to understand how a drug behaves in the body. This includes examining how the drug is absorbed, distributed, metabolized, and excreted, as well as any potential toxic effects.","font":"Montserrat Medium","anchor":"t","box":[12197673,4982463,4624632,2575941],"lineH":374904,"ins":0},{"id":"20","kind":"label","chars":24,"max":30,"perLine":30.2,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"Preclinical Testing Tips","font":"Montserrat Bold","anchor":"t","box":[2191254,3141652,4361946,356235],"lineH":373380,"ins":0,"useW":0.739},{"id":"21","kind":"text","chars":73,"max":73,"perLine":24.3,"lines":3,"caps":false,"sz":15.99,"paras":1,"text":"Analyze how the drug is absorbed, distributed, metabolized, and excreted.","font":"Montserrat Medium","anchor":"t","box":[2191254,3729557,3850288,734822],"lineH":251841,"ins":0}],"photos":[{"id":"7","w":6484620,"h":6484620,"area":0.224}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"3","kind":"label","chars":12,"max":15,"perLine":14.6,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation","font":"Montserrat Medium","anchor":"t","box":[604914,373787,1557765,264243],"lineH":283845,"ins":0,"useW":0.852},{"id":"4","kind":"label","chars":8,"max":11,"perLine":11.1,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle","font":"Montserrat Medium","anchor":"t","box":[604914,9623634,1180920,264243],"lineH":283845,"ins":0,"useW":0.714},{"id":"9","kind":"label","chars":6,"max":15,"perLine":14.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1","font":"Montserrat Medium","anchor":"t","box":[16113605,9623634,1560276,264243],"lineH":283845,"ins":0,"useW":0.423},{"id":"10","kind":"title","chars":42,"max":42,"perLine":21.0,"lines":2,"caps":false,"sz":72.0,"paras":2,"text":"Investigational New Drug\n(IND) Application","font":"Montserrat Ultra-Bold","anchor":"t","box":[2800142,3505034,12687716,1820037],"lineH":886968,"ins":0,"useW":0.986,"base":1.74,"tail":0.203,"below":[{"id":"11","gap":2.569,"cap":0.151}]},{"id":"11","kind":"text","chars":252,"max":252,"perLine":84.0,"lines":3,"caps":false,"sz":18.0,"paras":1,"text":"Once preclinical results look promising, scientists must apply for approval to begin clinical trials in humans. The IND application contains all the preclinical data, the proposed study design for human trials, and how patient safety will be protected.","font":"Montserrat Medium","anchor":"t","box":[3791571,5853850,10704858,1090041],"lineH":374904,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"11","kind":"label","chars":8,"max":11,"perLine":11.1,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle","font":"Montserrat Medium","anchor":"t","box":[604914,9623634,1180920,264243],"lineH":283845,"ins":0,"useW":0.714},{"id":"18","kind":"label","chars":12,"max":15,"perLine":14.6,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation","font":"Montserrat Medium","anchor":"t","box":[604914,373787,1557765,264243],"lineH":283845,"ins":0,"useW":0.852},{"id":"19","kind":"label","chars":6,"max":15,"perLine":14.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1","font":"Montserrat Medium","anchor":"t","box":[16113605,9623634,1560276,264243],"lineH":283845,"ins":0,"useW":0.423},{"id":"20","kind":"title","chars":23,"max":23,"perLine":7.7,"lines":3,"caps":false,"sz":72.0,"paras":3,"text":"Phase I\nClinical\nTrials","font":"Montserrat Ultra-Bold","anchor":"t","box":[12197673,2443480,5710523,2705862],"lineH":886968,"ins":0,"useW":0.626,"base":2.71,"tail":0.203,"below":[{"id":"21","gap":3.266,"cap":0.151}]},{"id":"21","kind":"text","chars":248,"max":248,"perLine":35.4,"lines":7,"caps":false,"sz":18.0,"paras":1,"text":"This is the first stage of human testing. It typically involves a small number of healthy volunteers to evaluate safety, determine a safe dosage range, and identify side effects. The main goal is to learn how the drug interacts with the human body.","font":"Montserrat Medium","anchor":"t","box":[12197673,5429504,4624632,2575941],"lineH":374904,"ins":0},{"id":"22","kind":"label","chars":27,"max":30,"perLine":30.2,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"Phase 1 Clinical Trial Tips","font":"Montserrat Bold","anchor":"t","box":[2191254,3141652,4361946,356235],"lineH":373380,"ins":0,"useW":0.792},{"id":"23","kind":"text","chars":84,"max":84,"perLine":28.0,"lines":3,"caps":false,"sz":15.99,"paras":1,"text":"Watch closely for side effects and study how the drug interacts with the human body.","font":"Montserrat Medium","anchor":"t","box":[2191254,3729557,3850288,734822],"lineH":251841,"ins":0}],"photos":[{"id":"7","w":6484620,"h":6484620,"area":0.224}]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"14","kind":"label","chars":12,"max":15,"perLine":14.6,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation","font":"Montserrat Medium","anchor":"t","box":[604914,373787,1557765,264243],"lineH":283845,"ins":0,"useW":0.852},{"id":"15","kind":"label","chars":8,"max":11,"perLine":11.1,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle","font":"Montserrat Medium","anchor":"t","box":[604914,9623634,1180920,264243],"lineH":283845,"ins":0,"useW":0.714},{"id":"20","kind":"label","chars":6,"max":15,"perLine":14.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1","font":"Montserrat Medium","anchor":"t","box":[16113605,9623634,1560276,264243],"lineH":283845,"ins":0,"useW":0.423},{"id":"21","kind":"title","chars":24,"max":24,"perLine":12.0,"lines":2,"caps":false,"sz":72.0,"paras":2,"text":"Phase II\nClinical Trials","font":"Montserrat Ultra-Bold","anchor":"t","box":[1481849,3262147,7428833,1820037],"lineH":886968,"ins":0,"useW":0.871,"base":1.74,"tail":0.203,"below":[{"id":"22","gap":2.287,"cap":0.151}]},{"id":"22","kind":"text","chars":224,"max":224,"perLine":44.8,"lines":5,"caps":false,"sz":18.0,"paras":1,"text":"After confirming basic safety, the drug is given to a larger group of people who have the condition the drug is meant to treat. Researchers assess how well the drug works, monitor short-term side effects, and refine dosages.","font":"Montserrat Medium","anchor":"t","box":[1481849,5353787,6537869,1832991],"lineH":374904,"ins":0}],"photos":[{"id":"10","w":7627620,"h":7627620,"area":0.309}]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"3","kind":"label","chars":12,"max":15,"perLine":14.6,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation","font":"Montserrat Medium","anchor":"t","box":[604914,373787,1557765,264243],"lineH":283845,"ins":0,"useW":0.852},{"id":"4","kind":"label","chars":8,"max":11,"perLine":11.1,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle","font":"Montserrat Medium","anchor":"t","box":[604914,9623634,1180920,264243],"lineH":283845,"ins":0,"useW":0.714},{"id":"9","kind":"label","chars":6,"max":15,"perLine":14.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1","font":"Montserrat Medium","anchor":"t","box":[16113605,9623634,1560276,264243],"lineH":283845,"ins":0,"useW":0.423},{"id":"10","kind":"title","chars":25,"max":25,"perLine":12.5,"lines":2,"caps":false,"sz":72.0,"paras":2,"text":"Phase III\nClinical Trials","font":"Montserrat Ultra-Bold","anchor":"t","box":[2800142,3505034,12687716,1820037],"lineH":886968,"ins":0,"useW":0.51,"base":1.74,"tail":0.203,"below":[{"id":"11","gap":2.569,"cap":0.151}]},{"id":"11","kind":"text","chars":247,"max":247,"perLine":82.3,"lines":3,"caps":false,"sz":18.0,"paras":1,"text":"In this phase, the drug is tested on hundreds or even thousands of people. It’s compared to existing treatments or placebos to see if it is more effective or safer. These trials provide the strongest evidence for whether a drug should be approved.","font":"Montserrat Medium","anchor":"t","box":[3791571,5853850,10704858,1090041],"lineH":374904,"ins":0}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"12","kind":"label","chars":12,"max":15,"perLine":14.6,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation","font":"Montserrat Medium","anchor":"t","box":[604914,373787,1557765,264243],"lineH":283845,"ins":0,"useW":0.852},{"id":"13","kind":"label","chars":8,"max":11,"perLine":11.1,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle","font":"Montserrat Medium","anchor":"t","box":[604914,9623634,1180920,264243],"lineH":283845,"ins":0,"useW":0.714},{"id":"18","kind":"label","chars":6,"max":15,"perLine":14.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1","font":"Montserrat Medium","anchor":"t","box":[16113605,9623634,1560276,264243],"lineH":283845,"ins":0,"useW":0.423},{"id":"19","kind":"title","chars":38,"max":38,"perLine":12.7,"lines":3,"caps":false,"sz":72.0,"paras":3,"text":"Post-Marketing\nSurveillance\n(Phase IV)","font":"Montserrat Ultra-Bold","anchor":"t","box":[8649367,2849105,7428833,2705862],"lineH":886968,"ins":0,"useW":1.0,"base":2.71,"tail":0.203,"below":[{"id":"20","gap":3.259,"cap":0.151}]},{"id":"20","kind":"text","chars":232,"max":232,"perLine":58.0,"lines":4,"caps":false,"sz":18.0,"paras":1,"text":"Once the drug is approved and available to the public, it continues to be monitored. Doctors and patients report any unexpected side effects or long-term issues. This helps catch rare problems that might not have shown up in trials.","font":"Montserrat Medium","anchor":"t","box":[8649367,5829174,7428833,1461516],"lineH":374904,"ins":0}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"end","slots":[{"id":"12","kind":"label","chars":12,"max":15,"perLine":14.6,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Presentation","font":"Montserrat Medium","anchor":"t","box":[604914,373787,1557765,264243],"lineH":283845,"ins":0,"useW":0.852},{"id":"13","kind":"label","chars":8,"max":11,"perLine":11.1,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Borcelle","font":"Montserrat Medium","anchor":"t","box":[604914,9623634,1180920,264243],"lineH":283845,"ins":0,"useW":0.714},{"id":"18","kind":"label","chars":6,"max":15,"perLine":14.7,"lines":1,"caps":false,"sz":15.96,"paras":1,"text":"Page 1","font":"Montserrat Medium","anchor":"t","box":[16113605,9623634,1560276,264243],"lineH":283845,"ins":0,"useW":0.423},{"id":"20","kind":"title","chars":5,"max":16,"perLine":15.8,"lines":1,"caps":true,"sz":96.0,"paras":1,"text":"THANK","font":"Montserrat Bold","anchor":"t","box":[2952646,2909608,12382708,1642110],"lineH":1706753,"ins":0,"useW":0.369,"base":1.112,"tail":0.161,"below":[{"id":"21","gap":0.972,"cap":0.412}]},{"id":"21","kind":"label","chars":3,"max":16,"perLine":15.8,"lines":1,"caps":true,"sz":96.0,"paras":1,"text":"YOU","font":"Montserrat Bold","anchor":"t","box":[2952646,4094493,12382708,1642110],"lineH":1706753,"ins":0,"useW":0.227,"base":1.112,"tail":0.161,"below":[{"id":"22","gap":1.377,"cap":0.09}]},{"id":"22","kind":"label","chars":58,"max":61,"perLine":61.5,"lines":1,"caps":false,"sz":21.0,"paras":1,"text":"From Lab to Life: How New Drugs are Developed and Approved","font":"Montserrat","anchor":"t","box":[4906960,5773407,8474081,356235],"lineH":373380,"ins":0,"useW":0.838}],"photos":[]}]}