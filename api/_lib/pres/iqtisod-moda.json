{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"5","kind":"label","chars":18,"max":70,"perLine":70.2,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"By Greta Mae Evans"},{"id":"34","kind":"label","chars":19,"max":70,"perLine":70.2,"lines":1,"caps":false,"sz":30.0,"paras":1,"text":"reallygreatsite.com"},{"id":"35","kind":"title","chars":13,"max":16,"perLine":16.2,"lines":1,"caps":true,"sz":127.15,"paras":1,"text":"BACK TO STYLE"},{"id":"36","kind":"label","chars":35,"max":38,"perLine":38.1,"lines":1,"caps":false,"sz":47.85,"paras":1,"text":"Vintage & Thrift Fashion Collection"}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"15","kind":"title","chars":33,"max":33,"perLine":16.5,"lines":2,"caps":false,"sz":54.0,"paras":2,"text":"Company Overview\nand Introduction"},{"id":"16","kind":"text","chars":240,"max":240,"perLine":60.0,"lines":4,"caps":false,"sz":20.0,"paras":1,"text":"Back to Style is a vintage and thrift fashion brand that celebrates timeless clothing pieces. We curate unique, high-quality items with a touch of nostalgia, giving old fashion a second life while promoting sustainability and individuality."},{"id":"17","kind":"label","chars":33,"max":39,"perLine":39.0,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"Industry and Market Presence 2024"},{"id":"18","kind":"label","chars":19,"max":39,"perLine":39.0,"lines":1,"caps":false,"sz":20.0,"paras":1,"text":"reallygreatsite.com"}],"photos":[{"id":"8","w":4692832,"h":4681273,"area":0.117}]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"7","kind":"title","chars":20,"max":20,"perLine":10.0,"lines":2,"caps":false,"sz":54.0,"paras":2,"text":"Our Vision\n& Mission"},{"id":"8","kind":"text","chars":110,"max":110,"perLine":36.7,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"To revive the timeless charm of classic fashion and make vintage style a meaningful part of modern lifestyles."},{"id":"9","kind":"text","chars":94,"max":94,"perLine":31.3,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Promote conscious fashion choices that reduce waste and give pre-loved clothing a second life."},{"id":"10","kind":"label","chars":19,"max":27,"perLine":27.2,"lines":1,"caps":false,"sz":24.99,"paras":1,"text":"reallygreatsite.com"}],"photos":[{"id":"4","w":4838700,"h":3530600,"area":0.091},{"id":"6","w":4838700,"h":3187700,"area":0.082}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"15","kind":"label","chars":11,"max":25,"perLine":25.2,"lines":1,"caps":false,"sz":26.99,"paras":1,"text":"Sustainable"},{"id":"21","kind":"title","chars":20,"max":20,"perLine":10.0,"lines":2,"caps":false,"sz":54.0,"paras":2,"text":"Why\nVintage Fashion?"},{"id":"22","kind":"text","chars":116,"max":116,"perLine":38.7,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Vintage fashion offers individuality with clothing that tells a story. Each piece is rare, stylish, and never fades."},{"id":"23","kind":"text","chars":84,"max":84,"perLine":28.0,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"Choosing vintage means reducing fashion waste and supporting eco-friendly practices."}],"photos":[{"id":"18","w":4975525,"h":2113549,"area":0.056},{"id":"20","w":5866389,"h":3140660,"area":0.098}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"20","kind":"text","chars":244,"max":244,"perLine":81.3,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"At Back to Style, our collection brings together timeless pieces that define the essence of vintage fashion. From elegant retro dresses and classic denim to bold leather jackets, every item is carefully curated to revive the charm of past eras."},{"id":"22","kind":"title","chars":30,"max":30,"perLine":15.0,"lines":2,"caps":false,"sz":54.0,"paras":2,"text":"Our Curated\nVintage Collection"}],"photos":[{"id":"4","w":5791161,"h":2662434,"area":0.082},{"id":"6","w":3726897,"h":2662434,"area":0.053},{"id":"8","w":3726897,"h":2662434,"area":0.053}]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"21","kind":"text","chars":248,"max":248,"perLine":49.6,"lines":5,"caps":false,"sz":20.0,"paras":1,"text":"At Back to Style, our inspirations come from the timeless elegance of past decades. From the polished silhouettes of the 50s, the bold and carefree spirit of the 70s, to the edgy street style of the 90s, each era brings its own character and charm."},{"id":"22","kind":"title","chars":26,"max":26,"perLine":13.0,"lines":2,"caps":false,"sz":54.0,"paras":2,"text":"Vintage\nStyle Inspirations"}],"photos":[{"id":"4","w":3961196,"h":6625395,"area":0.14},{"id":"6","w":3614381,"h":2885236,"area":0.055},{"id":"8","w":3614381,"h":3532874,"area":0.068}]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"17","kind":"title","chars":17,"max":31,"perLine":15.6,"lines":2,"caps":false,"sz":54.0,"paras":2,"text":"Thrift\nPhilosophy"},{"id":"18","kind":"text","chars":133,"max":89,"perLine":29.8,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"At Back to Style, our thrift philosophy is rooted in sustainability and conscious living. By giving pre-loved clothing a second life."}],"photos":[{"id":"4","w":11049000,"h":3530600,"area":0.207},{"id":"6","w":6210300,"h":3200400,"area":0.106}]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"23","kind":"title","chars":21,"max":21,"perLine":10.5,"lines":2,"caps":false,"sz":54.0,"paras":2,"text":"Customer\nTestimonials"},{"id":"24","kind":"label","chars":16,"max":20,"perLine":19.6,"lines":1,"caps":false,"sz":33.99,"paras":1,"text":"- Lars Peeters -"},{"id":"25","kind":"label","chars":17,"max":20,"perLine":19.7,"lines":1,"caps":false,"sz":33.99,"paras":1,"text":"- Juliana Silva -"},{"id":"26","kind":"text","chars":106,"max":106,"perLine":35.3,"lines":3,"caps":false,"sz":20.0,"paras":1,"text":"“I love how sustainable and stylish their collection is. Shopping vintage here makes me feel fashi