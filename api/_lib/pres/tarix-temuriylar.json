{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"5","kind":"title","chars":32,"max":32,"perLine":10.7,"lines":3,"caps":true,"sz":52.0,"paras":1,"text":"ILMIY-TEXNIKA INQILOBI FALSAFASI","font":"Times New Roman","anchor":"b","box":[965200,1396999,8636000,2349500],"lineH":792480,"ins":0,"useW":0.942},{"id":"7","kind":"label","chars":13,"max":37,"perLine":37.1,"lines":1,"caps":false,"sz":39.0,"paras":1,"text":"Fan falsafasi","font":"Times New Roman","anchor":"t","box":[1015999,4572000,7620000,711200],"lineH":594360,"ins":0,"useW":0.33},{"id":"8","kind":"label","chars":32,"max":46,"perLine":46.1,"lines":1,"caps":false,"sz":34.0,"paras":1,"text":"VII bob bo'yicha o'quv taqdimoti","font":"Times New Roman","anchor":"t","box":[1003300,5461000,8255000,635000],"lineH":518160,"ins":0,"useW":0.693},{"id":"10","kind":"label","chars":15,"max":34,"perLine":33.9,"lines":1,"caps":false,"sz":28.5,"paras":1,"text":"Bobomurodov G'.","font":"Times New Roman","anchor":"t","box":[2311399,7873999,5080000,533400],"lineH":434340,"ins":0,"useW":0.512}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"5","kind":"title","chars":4,"max":26,"perLine":13.2,"lines":2,"caps":true,"sz":64.0,"paras":1,"text":"REJA","font":"Times New Roman","anchor":"b","box":[1130300,1219200,6350000,2032000],"lineH":975360,"ins":0,"useW":0.306},{"id":"9","kind":"text","chars":244,"max":244,"perLine":20.3,"lines":12,"caps":false,"sz":31.0,"paras":7,"text":"Ilmiy-texnika inqilobi tushunchasi\nIlmiy inqiloblar va ularning bosqichlari\nFan va texnikaning o'zaro aloqasi\nTexnika falsafasidagi yondashuvlar\nIlmiy-texnika inqilobining ijtimoiy va ekologik oqibatlari\nRaqamli davr va axloqiy muammolar\nXulosa","font":"Times New Roman","anchor":"t","box":[1219199,4064000,8255000,5842000],"lineH":472440,"ins":0}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"6","kind":"title","chars":15,"max":47,"perLine":23.7,"lines":2,"caps":true,"sz":50.0,"paras":1,"text":"ASOSIY BELGILAR","font":"Times New Roman","anchor":"b","box":[990931,2452662,8890000,1415063],"lineH":762000,"ins":0,"useW":0.629},{"id":"8","kind":"text","chars":202,"max":202,"perLine":18.4,"lines":11,"caps":false,"sz":31.0,"paras":4,"text":"Atom energetikasi va kosmosni o'zlashtirish\nElektronika, hisoblash texnikasi va avtomatlashtirish\nYangi materiallar, kimyo va biotexnologiya\nKashfiyotdan amaliyotgacha bo'lgan vaqtning keskin qisqarishi","font":"Times New Roman","anchor":"t","box":[1104900,4724399,7620000,5207000],"lineH":472440,"ins":0}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"6","kind":"title","chars":14,"max":71,"perLine":23.7,"lines":3,"caps":true,"sz":50.0,"paras":1,"text":"BEKON VA METOD","font":"Times New Roman","anchor":"b","box":[573960,2177824,8890000,1931130],"lineH":762000,"ins":0,"useW":0.638},{"id":"8","kind":"text","chars":291,"max":291,"perLine":26.5,"lines":11,"caps":false,"sz":31.0,"paras":4,"text":"F. Bekon «Yangi Organon» (1620) asarida induktiv metodni asoslab berdi.\n«Bilim – kuch» g'oyasi: fan tabiatni o'zlashtirish va inson hayotini yaxshilash vositasi.\nTajriba va kuzatish ilmiy bilishning asosiy manbai deb e'lon qilindi.\nBekon g'oyalari fan va texnikaning birlashuviga yo'l ochdi.","font":"Times New Roman","anchor":"t","box":[1028700,4724400,8128000,5207000],"lineH":472440,"ins":0}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"10","kind":"title","chars":13,"max":61,"perLine":30.5,"lines":2,"caps":true,"sz":50.0,"paras":1,"text":"INQILOBCHILAR","font":"Times New Roman","anchor":"t","box":[800099,660400,11430000,1663700],"lineH":762000,"ins":0,"useW":0.434},{"id":"11","kind":"fixed","chars":2,"max":12,"perLine":6.8,"lines":1,"caps":false,"sz":64.0,"paras":1,"text":"01","font":"Times New Roman","anchor":"ctr","box":[2552699,3048000,2286000,1270000],"lineH":2085340,"ins":0},{"id":"12","kind":"text","chars":108,"max":108,"perLine":12.0,"lines":9,"caps":false,"sz":32.5,"paras":1,"text":"Kopernik (1543) geliotsentrik tizim bilan Yerni olam markazidan chiqardi – birinchi ilmiy inqilob boshlandi.","font":"Times New Roman","anchor":"t","box":[1092199,4635500,5207000,4699000],"lineH":495300,"ins":0},{"id":"13","kind":"fixed","chars":2,"max":12,"perLine":6.8,"lines":1,"caps":false,"sz":64.0,"paras":1,"text":"02","font":"Times New Roman","anchor":"ctr","box":[8864599,3048000,2286000,1270000],"lineH":2085340,"ins":0},{"id":"14","kind":"text","chars":108,"max":108,"perLine":12.0,"lines":9,"caps":false,"sz":32.5,"paras":1,"text":"Kepler, Galiley va Nyuton (1687) klassik mexanikani yaratib, tabiatning matematik manzarasini shakllantirdi.","font":"Times New Roman","anchor":"t","box":[7404099,4635500,5207000,4699000],"lineH":495300,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"4","kind":"title","chars":19,"max":106,"perLine":35.2,"lines":3,"caps":false,"sz":48.0,"paras":1,"text":"Inqilob tushunchasi","font":"Times New Roman","anchor":"b","box":[990599,888999,8890000,2222500],"lineH":731520,"ins":0,"useW":0.539},{"id":"6","kind":"text","chars":404,"max":404,"perLine":33.7,"lines":12,"caps":false,"sz":34.0,"paras":4,"text":"Ilmiy-texnika inqilobi – fan va texnikaning yaqinlashuvi natijasida ishlab chiqarish kuchlarida yuz bergan chuqur sifat o'zgarishlari majmuasi.\nUnda fan bevosita ishlab chiqaruvchi kuchga aylanadi: yangi bilim tezda texnologiyaga aylanadi.\nXX asr o'rtalarida tezlashib, mehnat, turmush va fikrlash tarzini o'zgartirdi.\nAvvalgi texnik o'zgarishlardan farqi – endi ilmiy nazariya texnikadan oldinda boradi.","font":"Times New Roman","anchor":"t","box":[965200,3809999,8953500,6096000],"lineH":518160,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"end","slots":[{"id":"5","kind":"title","chars":26,"max":26,"perLine":8.7,"lines":3,"caps":false,"sz":80.0,"paras":1,"text":"E'tiboringiz uchun rahmat!","font":"Times New Roman","anchor":"b","box":[1130300,2540000,9398000,3556000],"lineH":1219200,"ins":0,"useW":0.797}],"photos":[]}]}