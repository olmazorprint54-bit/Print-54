{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"25","kind":"title","chars":5,"max":8,"perLine":7.8,"lines":1,"caps":true,"sz":213.63,"paras":1,"text":"MATHS"},{"id":"26","kind":"label","chars":12,"max":9,"perLine":9.0,"lines":1,"caps":false,"sz":103.29,"paras":1,"text":"Presentation"},{"id":"27","kind":"label","chars":13,"max":12,"perLine":12.3,"lines":1,"caps":false,"sz":37.68,"paras":1,"text":"Claudia Alves"}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"19","kind":"title","chars":5,"max":10,"perLine":9.9,"lines":1,"caps":false,"sz":108.63,"paras":1,"text":"Index"},{"id":"20","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"1"},{"id":"21","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"2"},{"id":"22","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"3"},{"id":"23","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"4"},{"id":"24","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"5"}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"5","kind":"title","chars":12,"max":9,"perLine":9.4,"lines":1,"caps":false,"sz":113.0,"paras":1,"text":"Introduction"},{"id":"7","kind":"text","chars":243,"max":243,"perLine":60.8,"lines":4,"caps":false,"sz":32.18,"paras":1,"text":"Mathematics is an integral part of everything around us: from measuring time to understanding how stars work. In this lesson, we will learn to see numbers as tools for solving problems, identifying patterns, and making more informed decisions."}],"photos":[{"id":"4","w":16029389,"h":8411587,"area":0.717}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"12","kind":"title","chars":5,"max":8,"perLine":8.1,"lines":1,"caps":false,"sz":137.64,"paras":1,"text":"Goals"},{"id":"13","kind":"text","chars":61,"max":61,"perLine":30.5,"lines":2,"caps":false,"sz":33.94,"paras":1,"text":"To present the importance of mathematics in life and science."},{"id":"14","kind":"label","chars":49,"max":49,"perLine":24.5,"lines":2,"caps":false,"sz":33.94,"paras":1,"text":"To understand the main branches and applications."},{"id":"15","kind":"label","chars":55,"max":55,"perLine":27.5,"lines":2,"caps":false,"sz":33.94,"paras":1,"text":"To recognize key figures in its historical development."},{"id":"22","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":50.43,"paras":1,"text":"1"},{"id":"23","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":50.43,"paras":1,"text":"2"},{"id":"27","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":50.43,"paras":1,"text":"3"}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"12","kind":"title","chars":20,"max":17,"perLine":16.6,"lines":1,"caps":false,"sz":93.54,"paras":1,"text":"What is mathematics?"},{"id":"13","kind":"text","chars":142,"max":142,"perLine":47.3,"lines":3,"caps":false,"sz":40.18,"paras":1,"text":"Mathematics is the science that studies numbers, shapes, patterns, and the relationships between them using logical reasoning and abstraction."}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"3","kind":"title","chars":27,"max":23,"perLine":23.0,"lines":1,"caps":false,"sz":84.92,"paras":1,"text":"Importance in everyday life"},{"id":"16","kind":"label","chars":22,"max":26,"perLine":26.3,"lines":1,"caps":false,"sz":30.79,"paras":1,"text":"Financial calculations"},{"id":"17","kind":"label","chars":26,"max":26,"perLine":26.3,"lines":1,"caps":false,"sz":30.79,"paras":1,"text":"Technology and programming"},{"id":"18","kind":"label","chars":26,"max":26,"perLine":26.3,"lines":1,"caps":false,"sz":30.79,"paras":1,"text":"Time and resource planning"},{"id":"19","kind":"label","chars":29,"max":26,"perLine":26.3,"lines":1,"caps":false,"sz":30.79,"paras":1,"text":"Architecture and construction"},{"id":"20","kind":"text","chars":164,"max":164,"perLine":41.0,"lines":4,"caps":false,"sz":22.13,"paras":1,"text":"Mathematics helps us understand and manage money, from simple operations like adding expenses to more complex concepts such as interest, investments, and budgeting."},{"id":"21","kind":"text","chars":161,"max":161,"perLine":40.2,"lines":4,"caps":false,"sz":21.72,"paras":1,"text":"Algorithms and mathematical logic are the foundation of technological development, from mobile applications to artificial intelligence and communication systems."},{"id":"22","kind":"text","chars":149,"max":149,"perLine":37.2,"lines":4,"caps":false,"sz":22.13,"paras":1,"text":"Using numbers and operations makes it easier to organize schedules, divide tasks, and manage resources efficiently in personal and professional life."},{"id":"23","kind":"text","chars":122,"max":122,"perLine":40.5,"lines":3,"caps":false,"sz":22.13,"paras":1,"text":"Geometry and calculation are essential for designing and building safe, functional, and aesthetically pleasing structures."}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"3","kind":"title","chars":16,"max":19,"perLine":19.0,"lines":1,"caps":false,"sz":84.92,"paras":1,"text":"History timeline"},{"id":"5","kind":"label","chars":13,"max":16,"perLine":16.4,"lines":1,"caps":false,"sz":23.0,"paras":1,"text":"Ancient Times"},{"id":"6","kind":"text","chars":183,"max":183,"perLine":20.3,"lines":9,"caps":false,"sz":18.0,"paras":1,"text":"The Babylonians developed numerical systems and astronomical calculations, while the Egyptians applied geometry to agriculture and the construction of monumental temples and pyramids."},{"id":"10","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"1"},{"id":"11","kind":"label","chars":16,"max":18,"perLine":17.6,"lines":1,"caps":false,"sz":23.0,"paras":1,"text":"Classical Greece"},{"id":"12","kind":"text","chars":197,"max":197,"perLine":21.9,"lines":9,"caps":false,"sz":18.0,"paras":1,"text":"The Greeks gave mathematics a more logical and structured approach. Pythagoras studied numbers and proportions; Euclid systematized geometry in The Elements, influencing its teaching for centuries."},{"id":"16","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"2"},{"id":"17","kind":"label","chars":11,"max":18,"perLine":18.0,"lines":1,"caps":false,"sz":23.0,"paras":1,"text":"Middle Ages"},{"id":"18","kind":"text","chars":175,"max":175,"perLine":21.9,"lines":8,"caps":false,"sz":18.0,"paras":1,"text":"In the Islamic world, Al-Khwarizmi developed algebra and popularized the Hindu-Arabic numeral system, replacing Roman numerals and facilitating calculations throughout Europe."},{"id":"22","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"3"},{"id":"23","kind":"label","chars":10,"max":18,"perLine":17.7,"lines":1,"caps":false,"sz":23.0,"paras":1,"text":"Modern Age"},{"id":"24","kind":"text","chars":178,"max":178,"perLine":22.2,"lines":8,"caps":false,"sz":18.0,"paras":1,"text":"Descartes united algebra and geometry with analytic geometry. Newton and Leibniz independently developed calculus, an essential tool for modern science, physics, and engineering."},{"id":"28","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"4"},{"id":"29","kind":"label","chars":12,"max":20,"perLine":19.8,"lines":1,"caps":false,"sz":23.0,"paras":1,"text":"20th Century"},{"id":"30","kind":"text","chars":162,"max":162,"perLine":23.1,"lines":7,"caps":false,"sz":18.0,"paras":1,"text":"Statistics, probability, and applied mathematics expanded. With the invention of computers, new branches related to computing and artificial intelligence emerged."},{"id":"34","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"5"}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"24","kind":"title","chars":17,"max":13,"perLine":13.1,"lines":1,"caps":false,"sz":113.0,"paras":1,"text":"How do we use it?"},{"id":"26","kind":"text","chars":207,"max":207,"perLine":51.8,"lines":4,"caps":false,"sz":32.18,"paras":1,"text":"Mathematics is fascinating because it allows us to discover the hidden order in the world. Through numbers, patterns, and shapes, it reveals surprising connections between nature, science, and everyday life."}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"3","kind":"title","chars":19,"max":20,"perLine":9.9,"lines":2,"caps":false,"sz":93.54,"paras":1,"text":"Great personalities"},{"id":"14","kind":"label","chars":14,"max":19,"perLine":18.7,"lines":1,"caps":false,"sz":26.78,"paras":1,"text":"Leonhard Euler"},{"id":"15","kind":"text","chars":194,"max":194,"perLine":38.8,"lines":5,"caps":false,"sz":16.99,"paras":1,"text":"One of the most prolific mathematicians in history, Euler made foundational contributions to calculus, graph theory, and complex analysis. He introduced much of the modern mathematical notation."},{"id":"23","kind":"label","chars":20,"max":23,"perLine":23.2,"lines":1,"caps":false,"sz":26.78,"paras":1,"text":"Carl Friedrich Gauss"},{"id":"24","kind":"text","chars":252,"max":252,"perLine":42.0,"lines":6,"caps":false,"sz":16.99,"paras":1,"text":"Often called the “Prince of Mathematicians,” Gauss made groundbreaking contributions to number theory, statistics, algebra, and magnetism. He developed the method of least squares and made significant advances in the study of prime and complex numbers."},{"id":"29","kind":"text","chars":210,"max":210,"perLine":42.0,"lines":5,"caps":false,"sz":16.99,"paras":1,"text":"Best known for the Pythagorean theorem, which relates the sides of a right triangle. He and his followers also explored the relationship between numbers and harmony, influencing both mathematics and philosophy."},{"id":"30","kind":"label","chars":10,"max":19,"perLine":18.7,"lines":1,"caps":false,"sz":26.78,"paras":1,"text":"Pythagoras"},{"id":"32","kind":"text","chars":230,"max":230,"perLine":38.3,"lines":6,"caps":false,"sz":16.99,"paras":1,"text":"Co-inventor of calculus, Newton developed key concepts such as derivatives and integrals. His work laid the mathematical foundation for classical mechanics and greatly influenced the development of physics and applied mathematics."},{"id":"33","kind":"label","chars":12,"max":19,"perLine":18.7,"lines":1,"caps":false,"sz":26.78,"paras":1,"text":"Isaac Newton"},{"id":"41","kind":"text","chars":195,"max":195,"perLine":39.0,"lines":5,"caps":false,"sz":16.99,"paras":1,"text":"Known as the “Father of Geometry,” Euclid wrote Elements, a comprehensive compilation of the knowledge of geometry of his time. His axiomatic approach shaped mathematical reasoning for centuries."},{"id":"42","kind":"label","chars":6,"max":19,"perLine":18.7,"lines":1,"caps":false,"sz":26.78,"paras":1,"text":"Euclid"},{"id":"44","kind":"text","chars":197,"max":197,"perLine":39.4,"lines":5,"caps":false,"sz":16.99,"paras":1,"text":"A pioneering figure in abstract algebra, Noether revolutionized the study of rings and fields. Her theorem linking symmetries and conservation laws is fundamental in modern physics and mathematics."},{"id":"45","kind":"label","chars":12,"max":19,"perLine":18.7,"lines":1,"caps":false,"sz":26.78,"paras":1,"text":"Emmy Noether"},{"id":"48","kind":"label","chars":8,"max":12,"perLine":12.3,"lines":1,"caps":false,"sz":34.84,"paras":1,"text":"Mind map"}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"14","kind":"title","chars":13,"max":13,"perLine":12.9,"lines":1,"caps":false,"sz":108.63,"paras":1,"text":"Main branches"},{"id":"15","kind":"text","chars":82,"max":82,"perLine":13.7,"lines":6,"caps":false,"sz":49.17,"paras":6,"text":"Arithmetic.\nAlgebra.\nGeometry.\nTrigonometry.\nCalculus.\nStatistics and probability."}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"content","slots":[{"id":"18","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":65.92,"paras":1,"text":"1"},{"id":"19","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":65.92,"paras":1,"text":"2"},{"id":"20","kind":"text","chars":145,"max":145,"perLine":24.2,"lines":6,"caps":false,"sz":23.73,"paras":1,"text":"Prime numbers are only divisible by 1 and themselves, and they are infinite. Their distributions and properties remain subjects of ongoing study."},{"id":"21","kind":"text","chars":148,"max":148,"perLine":24.7,"lines":6,"caps":false,"sz":23.73,"paras":1,"text":"Mathematics has many open problems, such as the Collatz conjecture and the Goldbach conjecture, which are easy to state but lack a definitive proof."},{"id":"22","kind":"label","chars":22,"max":22,"perLine":11.0,"lines":2,"caps":false,"sz":29.68,"paras":1,"text":"Infinite prime numbers"},{"id":"23","kind":"label","chars":22,"max":22,"perLine":11.0,"lines":2,"caps":false,"sz":29.68,"paras":1,"text":"Unresolved conjectures"},{"id":"27","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":65.92,"paras":1,"text":"3"},{"id":"28","kind":"text","chars":157,"max":157,"perLine":26.2,"lines":6,"caps":false,"sz":23.73,"paras":1,"text":"Infinity presents surprising ideas, such as some infinities being larger than others, challenging intuition and showing how mathematics explores the unknown."},{"id":"29","kind":"label","chars":23,"max":23,"perLine":11.5,"lines":2,"caps":false,"sz":29.68,"paras":1,"text":"The paradox of infinity"},{"id":"30","kind":"title","chars":26,"max":16,"perLine":16.2,"lines":1,"caps":false,"sz":100.48,"paras":1,"text":"Challenges and curiosities"}],"photos":[]},{"n":12,"part":"ppt/slides/slide12.xml","role":"content","slots":[{"id":"13","kind":"title","chars":11,"max":8,"perLine":8.1,"lines":1,"caps":false,"sz":143.01,"paras":1,"text":"Conclusions"},{"id":"14","kind":"text","chars":196,"max":196,"perLine":32.7,"lines":6,"caps":false,"sz":32.18,"paras":1,"text":"Mathematics is universal and constitutes the common language that connects all sciences. Thanks to it, it is possible to describe phenomena, formulate theories, and understand how the world works."},{"id":"15","kind":"text","chars":171,"max":171,"perLine":28.5,"lines":6,"caps":false,"sz":32.18,"paras":1,"text":"At the same time, it is present in everyday life: in the simplest calculations, in the technology we use daily, and in the great discoveries that are transforming history."}],"photos":[]},{"n":13,"part":"ppt/slides/slide13.xml","role":"content","slots":[{"id":"6","kind":"title","chars":9,"max":12,"perLine":11.7,"lines":1,"caps":true,"sz":133.69,"paras":1,"text":"QUESTIONS"}],"photos":[{"id":"4","w":16029389,"h":8411587,"area":0.717}]}]}