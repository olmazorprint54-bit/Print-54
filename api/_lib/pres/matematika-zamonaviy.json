{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"25","kind":"title","chars":5,"max":9,"perLine":8.7,"lines":1,"caps":true,"sz":213.63,"paras":1,"text":"MATHS","font":"Georgia Pro Condensed","anchor":"t","box":[2556729,3233560,13174543,3574471],"lineH":3662807,"ins":0,"useW":0.688},{"id":"26","kind":"label","chars":12,"max":14,"perLine":14.2,"lines":1,"caps":false,"sz":103.29,"paras":1,"text":"Presentation","font":"Holiday","anchor":"t","box":[6195205,6637092,5897590,1156040],"lineH":1036320,"ins":0,"useW":0.79},{"id":"27","kind":"label","chars":13,"max":14,"perLine":14.2,"lines":1,"caps":false,"sz":37.68,"paras":1,"text":"Claudia Alves","font":"Glacial Indifference","anchor":"t","box":[7675688,3205685,2936624,424999],"lineH":377952,"ins":0,"useW":0.96}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"19","kind":"title","chars":5,"max":16,"perLine":15.7,"lines":1,"caps":false,"sz":108.63,"paras":1,"text":"Index","font":"Holiday","anchor":"t","box":[1347253,1385099,6845674,1337831],"lineH":1241679,"ins":0,"useW":0.339},{"id":"20","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"1","font":"Georgia Pro Condensed Bold","anchor":"t","box":[1589748,3590968,289288,560182],"lineH":533908,"ins":0},{"id":"21","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"2","font":"Georgia Pro Condensed Bold","anchor":"t","box":[1589748,4713578,289288,560182],"lineH":533908,"ins":0},{"id":"22","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"3","font":"Georgia Pro Condensed Bold","anchor":"t","box":[1589748,5873741,289288,560182],"lineH":533908,"ins":0},{"id":"23","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"4","font":"Georgia Pro Condensed Bold","anchor":"t","box":[1589748,6954744,289288,560182],"lineH":533908,"ins":0},{"id":"24","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"5","font":"Georgia Pro Condensed Bold","anchor":"t","box":[1589748,8160712,289288,560182],"lineH":533908,"ins":0}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"5","kind":"title","chars":12,"max":15,"perLine":14.8,"lines":1,"caps":false,"sz":113.0,"paras":1,"text":"Introduction","font":"Holiday","anchor":"t","box":[5788940,2785675,6710119,1279570],"lineH":1133729,"ins":0,"useW":0.706},{"id":"7","kind":"text","chars":243,"max":243,"perLine":60.8,"lines":4,"caps":false,"sz":32.18,"paras":1,"text":"Mathematics is an integral part of everything around us: from measuring time to understanding how stars work. In this lesson, we will learn to see numbers as tools for solving problems, identifying patterns, and making more informed decisions.","font":"Glacial Indifference","anchor":"t","box":[3317325,4393409,11653351,2262760],"lineH":580263,"ins":0}],"photos":[{"id":"4","w":16029389,"h":8411587,"area":0.717}]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"12","kind":"title","chars":5,"max":13,"perLine":12.8,"lines":1,"caps":false,"sz":137.64,"paras":1,"text":"Goals","font":"Holiday","anchor":"t","box":[1028700,1527571,7042287,1548894],"lineH":1380871,"ins":0,"useW":0.385},{"id":"13","kind":"text","chars":61,"max":61,"perLine":30.5,"lines":2,"caps":false,"sz":33.94,"paras":1,"text":"To present the importance of mathematics in life and science.","font":"Glacial Indifference","anchor":"t","box":[2244306,3912157,8117526,1079257],"lineH":551815,"ins":0},{"id":"14","kind":"label","chars":49,"max":49,"perLine":24.5,"lines":2,"caps":false,"sz":33.94,"paras":1,"text":"To understand the main branches and applications.","font":"Glacial Indifference","anchor":"t","box":[2244306,5481776,8117526,1079257],"lineH":551815,"ins":0,"useW":0.861},{"id":"15","kind":"label","chars":55,"max":55,"perLine":27.5,"lines":2,"caps":false,"sz":33.94,"paras":1,"text":"To recognize key figures in its historical development.","font":"Glacial Indifference","anchor":"t","box":[2244306,7054949,8117526,1079257],"lineH":551815,"ins":0,"useW":0.89},{"id":"22","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":50.43,"paras":1,"text":"1","font":"Georgia Pro Condensed","anchor":"t","box":[1274691,4036873,467977,842416],"lineH":864616,"ins":0},{"id":"23","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":50.43,"paras":1,"text":"2","font":"Georgia Pro Condensed","anchor":"t","box":[1274691,5606492,467977,842416],"lineH":864616,"ins":0},{"id":"27","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":50.43,"paras":1,"text":"3","font":"Georgia Pro Condensed","anchor":"t","box":[1274691,7179665,467977,842416],"lineH":864616,"ins":0}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"12","kind":"title","chars":20,"max":26,"perLine":26.2,"lines":1,"caps":false,"sz":93.54,"paras":1,"text":"What is mathematics?","font":"Holiday","anchor":"t","box":[4228638,3495407,9830723,1058574],"lineH":938403,"ins":0,"useW":0.827},{"id":"13","kind":"text","chars":142,"max":142,"perLine":47.3,"lines":3,"caps":false,"sz":40.18,"paras":1,"text":"Mathematics is the science that studies numbers, shapes, patterns, and the relationships between them using logical reasoning and abstraction.","font":"Glacial Indifference","anchor":"t","box":[3368484,4970089,11551032,2145159],"lineH":724535,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"3","kind":"title","chars":27,"max":36,"perLine":36.4,"lines":1,"caps":false,"sz":84.92,"paras":1,"text":"Importance in everyday life","font":"Holiday","anchor":"t","box":[3104240,954017,12385419,1047452],"lineH":970534,"ins":0,"useW":0.733},{"id":"16","kind":"label","chars":22,"max":31,"perLine":31.1,"lines":1,"caps":false,"sz":30.79,"paras":1,"text":"Financial calculations","font":"Glacial Indifference Bold","anchor":"t","box":[2726557,2940113,5767093,529342],"lineH":547497,"ins":0,"useW":0.692},{"id":"17","kind":"label","chars":26,"max":31,"perLine":31.1,"lines":1,"caps":false,"sz":30.79,"paras":1,"text":"Technology and programming","font":"Glacial Indifference Bold","anchor":"t","box":[2726557,6692242,5767093,529342],"lineH":547497,"ins":0,"useW":0.946},{"id":"18","kind":"label","chars":26,"max":31,"perLine":31.1,"lines":1,"caps":false,"sz":30.79,"paras":1,"text":"Time and resource planning","font":"Glacial Indifference Bold","anchor":"t","box":[9794351,3082988,5767093,385748],"lineH":359791,"ins":0,"useW":0.88},{"id":"19","kind":"label","chars":29,"max":31,"perLine":31.1,"lines":1,"caps":false,"sz":30.79,"paras":1,"text":"Architecture and construction","font":"Glacial Indifference Bold","anchor":"t","box":[9794351,6712179,5767093,529342],"lineH":547497,"ins":0,"useW":0.941},{"id":"20","kind":"text","chars":164,"max":164,"perLine":41.0,"lines":4,"caps":false,"sz":22.13,"paras":1,"text":"Mathematics helps us understand and manage money, from simple operations like adding expenses to more complex concepts such as interest, investments, and budgeting.","font":"Glacial Indifference","anchor":"t","box":[2841560,3621446,5537086,1522054],"lineH":393573,"ins":0},{"id":"21","kind":"text","chars":161,"max":161,"perLine":40.2,"lines":4,"caps":false,"sz":21.72,"paras":1,"text":"Algorithms and mathematical logic are the foundation of technological development, from mobile applications to artificial intelligence and communication systems.","font":"Glacial Indifference","anchor":"t","box":[3071567,7258123,5077071,1532634],"lineH":386207,"ins":0},{"id":"22","kind":"text","chars":149,"max":149,"perLine":37.2,"lines":4,"caps":false,"sz":22.13,"paras":1,"text":"Using numbers and operations makes it easier to organize schedules, divide tasks, and manage resources efficiently in personal and professional life.","font":"Glacial Indifference","anchor":"t","box":[10090074,3621446,5175646,1522054],"lineH":393573,"ins":0},{"id":"23","kind":"text","chars":122,"max":122,"perLine":40.7,"lines":3,"caps":false,"sz":22.13,"paras":1,"text":"Geometry and calculation are essential for designing and building safe, functional, and aesthetically pleasing structures.","font":"Glacial Indifference","anchor":"t","box":[10090074,7367743,5175646,1137009],"lineH":393573,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"3","kind":"title","chars":16,"max":30,"perLine":30.1,"lines":1,"caps":false,"sz":84.92,"paras":1,"text":"History timeline","font":"Holiday","anchor":"t","box":[4022437,1786734,10243126,1047452],"lineH":970534,"ins":0,"useW":0.495},{"id":"5","kind":"label","chars":13,"max":19,"perLine":19.4,"lines":1,"caps":false,"sz":23.0,"paras":1,"text":"Ancient Times","font":"Glacial Indifference Bold","anchor":"t","box":[775802,4790202,2685245,316357],"lineH":300863,"ins":0,"useW":0.715},{"id":"6","kind":"text","chars":183,"max":183,"perLine":20.3,"lines":9,"caps":false,"sz":18.0,"paras":1,"text":"The Babylonians developed numerical systems and astronomical calculations, while the Egyptians applied geometry to agriculture and the construction of monumental temples and pyramids.","font":"Glacial Indifference","anchor":"t","box":[808736,5277255,2619375,3156204],"lineH":356616,"ins":0},{"id":"10","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"1","font":"Georgia Pro Condensed Bold","anchor":"t","box":[1973780,3787632,289288,560182],"lineH":533908,"ins":0},{"id":"11","kind":"label","chars":16,"max":21,"perLine":20.7,"lines":1,"caps":false,"sz":23.0,"paras":1,"text":"Classical Greece","font":"Glacial Indifference Bold","anchor":"t","box":[3981446,4791308,2877494,316357],"lineH":300863,"ins":0,"useW":0.816},{"id":"12","kind":"text","chars":197,"max":197,"perLine":21.9,"lines":9,"caps":false,"sz":18.0,"paras":1,"text":"The Greeks gave mathematics a more logical and structured approach. Pythagoras studied numbers and proportions; Euclid systematized geometry in The Elements, influencing its teaching for centuries.","font":"Glacial Indifference","anchor":"t","box":[4117813,5277255,2604758,3156204],"lineH":356616,"ins":0},{"id":"16","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"2","font":"Georgia Pro Condensed Bold","anchor":"t","box":[5275549,3787632,289288,560182],"lineH":533908,"ins":0},{"id":"17","kind":"label","chars":11,"max":21,"perLine":21.2,"lines":1,"caps":false,"sz":23.0,"paras":1,"text":"Middle Ages","font":"Glacial Indifference Bold","anchor":"t","box":[7379339,4791308,2944140,316357],"lineH":300863,"ins":0,"useW":0.586},{"id":"18","kind":"text","chars":175,"max":175,"perLine":21.9,"lines":8,"caps":false,"sz":18.0,"paras":1,"text":"In the Islamic world, Al-Khwarizmi developed algebra and popularized the Hindu-Arabic numeral system, replacing Roman numerals and facilitating calculations throughout Europe.","font":"Glacial Indifference","anchor":"t","box":[7541722,5277255,2619375,2803779],"lineH":356616,"ins":0},{"id":"22","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"3","font":"Georgia Pro Condensed Bold","anchor":"t","box":[8706765,3787632,289288,560182],"lineH":533908,"ins":0},{"id":"23","kind":"label","chars":10,"max":21,"perLine":20.9,"lines":1,"caps":false,"sz":23.0,"paras":1,"text":"Modern Age","font":"Glacial Indifference Bold","anchor":"t","box":[10843879,4795734,2901285,316357],"lineH":300863,"ins":0,"useW":0.578},{"id":"24","kind":"text","chars":178,"max":178,"perLine":22.2,"lines":8,"caps":false,"sz":18.0,"paras":1,"text":"Descartes united algebra and geometry with analytic geometry. Newton and Leibniz independently developed calculus, an essential tool for modern science, physics, and engineering.","font":"Glacial Indifference","anchor":"t","box":[10984834,5277255,2619375,2803779],"lineH":356616,"ins":0},{"id":"28","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"4","font":"Georgia Pro Condensed Bold","anchor":"t","box":[12149877,3787632,289288,560182],"lineH":533908,"ins":0},{"id":"29","kind":"label","chars":12,"max":23,"perLine":23.4,"lines":1,"caps":false,"sz":23.0,"paras":1,"text":"20th Century","font":"Glacial Indifference Bold","anchor":"t","box":[14265563,4795734,3246635,316357],"lineH":300863,"ins":0,"useW":0.535},{"id":"30","kind":"text","chars":162,"max":162,"perLine":23.1,"lines":7,"caps":false,"sz":18.0,"paras":1,"text":"Statistics, probability, and applied mathematics expanded. With the invention of computers, new branches related to computing and artificial intelligence emerged.","font":"Glacial Indifference","anchor":"t","box":[14579193,5277255,2619375,2451354],"lineH":356616,"ins":0},{"id":"34","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":39.29,"paras":1,"text":"5","font":"Georgia Pro Condensed Bold","anchor":"t","box":[15744237,3787632,289288,560182],"lineH":533908,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"24","kind":"title","chars":17,"max":21,"perLine":20.7,"lines":1,"caps":false,"sz":113.0,"paras":1,"text":"How do we use it?","font":"Holiday","anchor":"t","box":[4460602,3038550,9366796,1279570],"lineH":1133729,"ins":0,"useW":0.829},{"id":"26","kind":"text","chars":207,"max":207,"perLine":51.8,"lines":4,"caps":false,"sz":32.18,"paras":1,"text":"Mathematics is fascinating because it allows us to discover the hidden order in the world. Through numbers, patterns, and shapes, it reveals surprising connections between nature, science, and everyday life.","font":"Glacial Indifference","anchor":"t","box":[3614219,4747564,11059562,2262760],"lineH":580263,"ins":0}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"3","kind":"title","chars":19,"max":31,"perLine":15.6,"lines":2,"caps":false,"sz":93.54,"paras":1,"text":"Great personalities","font":"Holiday","anchor":"t","box":[6204036,4116927,5860271,2146990],"lineH":1021588,"ins":0,"useW":0.651},{"id":"14","kind":"label","chars":14,"max":22,"perLine":22.1,"lines":1,"caps":false,"sz":26.78,"paras":1,"text":"Leonhard Euler","font":"Georgia Pro Condensed Bold","anchor":"t","box":[13193197,7315295,3555316,341206],"lineH":278892,"ins":0,"useW":0.689},{"id":"15","kind":"text","chars":194,"max":194,"perLine":38.8,"lines":5,"caps":false,"sz":16.99,"paras":1,"text":"One of the most prolific mathematicians in history, Euler made foundational contributions to calculus, graph theory, and complex analysis. He introduced much of the modern mathematical notation.","font":"Glacial Indifference","anchor":"t","box":[12757200,7854462,4427309,1454626],"lineH":302133,"ins":0},{"id":"23","kind":"label","chars":20,"max":28,"perLine":27.5,"lines":1,"caps":false,"sz":26.78,"paras":1,"text":"Carl Friedrich Gauss","font":"Georgia Pro Condensed Bold","anchor":"t","box":[12630798,887871,4422917,341206],"lineH":278892,"ins":0,"useW":0.727},{"id":"24","kind":"text","chars":252,"max":252,"perLine":42.0,"lines":6,"caps":false,"sz":16.99,"paras":1,"text":"Often called the “Prince of Mathematicians,” Gauss made groundbreaking contributions to number theory, statistics, algebra, and magnetism. He developed the method of least squares and made significant advances in the study of prime and complex numbers.","font":"Glacial Indifference","anchor":"t","box":[12500003,1450198,4684507,1749902],"lineH":302133,"ins":0},{"id":"29","kind":"text","chars":210,"max":210,"perLine":42.0,"lines":5,"caps":false,"sz":16.99,"paras":1,"text":"Best known for the Pythagorean theorem, which relates the sides of a right triangle. He and his followers also explored the relationship between numbers and harmony, influencing both mathematics and philosophy.","font":"Glacial Indifference","anchor":"t","box":[1280301,1450198,4334179,1454626],"lineH":302133,"ins":0},{"id":"30","kind":"label","chars":10,"max":22,"perLine":22.1,"lines":1,"caps":false,"sz":26.78,"paras":1,"text":"Pythagoras","font":"Georgia Pro Condensed Bold","anchor":"t","box":[1669732,887871,3555315,341206],"lineH":278892,"ins":0,"useW":0.49},{"id":"32","kind":"text","chars":230,"max":230,"perLine":38.3,"lines":6,"caps":false,"sz":16.99,"paras":1,"text":"Co-inventor of calculus, Newton developed key concepts such as derivatives and integrals. His work laid the mathematical foundation for classical mechanics and greatly influenced the development of physics and applied mathematics.","font":"Glacial Indifference","anchor":"t","box":[1280301,7831302,4334179,1749902],"lineH":302133,"ins":0},{"id":"33","kind":"label","chars":12,"max":22,"perLine":22.1,"lines":1,"caps":false,"sz":26.78,"paras":1,"text":"Isaac Newton","font":"Georgia Pro Condensed Bold","anchor":"t","box":[1669732,7292135,3555315,341206],"lineH":278892,"ins":0,"useW":0.591},{"id":"41","kind":"text","chars":195,"max":195,"perLine":39.0,"lines":5,"caps":false,"sz":16.99,"paras":1,"text":"Known as the “Father of Geometry,” Euclid wrote Elements, a comprehensive compilation of the knowledge of geometry of his time. His axiomatic approach shaped mathematical reasoning for centuries.","font":"Glacial Indifference","anchor":"t","box":[648425,4660150,4427348,1454626],"lineH":302133,"ins":0},{"id":"42","kind":"label","chars":6,"max":22,"perLine":22.1,"lines":1,"caps":false,"sz":26.78,"paras":1,"text":"Euclid","font":"Georgia Pro Condensed Bold","anchor":"t","box":[1084441,4069177,3555316,341206],"lineH":278892,"ins":0,"useW":0.28},{"id":"44","kind":"text","chars":197,"max":197,"perLine":39.4,"lines":5,"caps":false,"sz":16.99,"paras":1,"text":"A pioneering figure in abstract algebra, Noether revolutionized the study of rings and fields. Her theorem linking symmetries and conservation laws is fundamental in modern physics and mathematics.","font":"Glacial Indifference","anchor":"t","box":[13212228,4636990,4427348,1454626],"lineH":302133,"ins":0},{"id":"45","kind":"label","chars":12,"max":22,"perLine":22.1,"lines":1,"caps":false,"sz":26.78,"paras":1,"text":"Emmy Noether","font":"Georgia Pro Condensed Bold","anchor":"t","box":[13648244,4069177,3555316,341206],"lineH":278892,"ins":0,"useW":0.655},{"id":"48","kind":"label","chars":8,"max":14,"perLine":14.2,"lines":1,"caps":false,"sz":34.84,"paras":1,"text":"Mind map","font":"Glacial Indifference","anchor":"t","box":[7776159,3425638,2716025,391865],"lineH":349631,"ins":0,"useW":0.694}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"content","slots":[{"id":"14","kind":"title","chars":13,"max":20,"perLine":20.4,"lines":1,"caps":false,"sz":108.63,"paras":1,"text":"Main branches","font":"Holiday","anchor":"t","box":[8297149,1539089,8887295,1337831],"lineH":1241679,"ins":0,"useW":0.74},{"id":"15","kind":"text","chars":82,"max":82,"perLine":13.7,"lines":6,"caps":false,"sz":49.17,"paras":6,"text":"Arithmetic.\nAlgebra.\nGeometry.\nTrigonometry.\nCalculus.\nStatistics and probability.","font":"Glacial Indifference","anchor":"t","box":[7978595,3435517,8706543,5505327],"lineH":930402,"ins":0}],"photos":[]},{"n":11,"part":"ppt/slides/slide11.xml","role":"content","slots":[{"id":"18","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":65.92,"paras":1,"text":"1","font":"Georgia Pro Condensed","anchor":"t","box":[3436716,3240854,951965,822671],"lineH":753491,"ins":0},{"id":"19","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":65.92,"paras":1,"text":"2","font":"Georgia Pro Condensed","anchor":"t","box":[8636278,3201212,951965,822671],"lineH":753491,"ins":0},{"id":"20","kind":"text","chars":145,"max":145,"perLine":24.2,"lines":6,"caps":false,"sz":23.73,"paras":1,"text":"Prime numbers are only divisible by 1 and themselves, and they are infinite. Their distributions and properties remain subjects of ongoing study.","font":"Glacial Indifference","anchor":"t","box":[2127689,5797373,3570020,2175197],"lineH":367665,"ins":0},{"id":"21","kind":"text","chars":148,"max":148,"perLine":24.7,"lines":6,"caps":false,"sz":23.73,"paras":1,"text":"Mathematics has many open problems, such as the Collatz conjecture and the Goldbach conjecture, which are easy to state but lack a definitive proof.","font":"Glacial Indifference","anchor":"t","box":[7353926,5797373,3580147,2175197],"lineH":367665,"ins":0},{"id":"22","kind":"label","chars":22,"max":22,"perLine":11.0,"lines":2,"caps":false,"sz":29.68,"paras":1,"text":"Infinite prime numbers","font":"Glacial Indifference Bold","anchor":"t","box":[2187230,4736925,3379271,778455],"lineH":388239,"ins":0,"useW":0.689},{"id":"23","kind":"label","chars":22,"max":22,"perLine":11.0,"lines":2,"caps":false,"sz":29.68,"paras":1,"text":"Unresolved conjectures","font":"Glacial Indifference Bold","anchor":"t","box":[7454364,4736925,3379271,778455],"lineH":388239,"ins":0,"useW":0.608},{"id":"27","kind":"fixed","chars":1,"max":12,"perLine":4,"lines":1,"caps":false,"sz":65.92,"paras":1,"text":"3","font":"Georgia Pro Condensed","anchor":"t","box":[13899319,3201212,951965,822671],"lineH":753491,"ins":0},{"id":"28","kind":"text","chars":157,"max":157,"perLine":26.2,"lines":6,"caps":false,"sz":23.73,"paras":1,"text":"Infinity presents surprising ideas, such as some infinities being larger than others, challenging intuition and showing how mathematics explores the unknown.","font":"Glacial Indifference","anchor":"t","box":[12511339,5797373,3799592,2175197],"lineH":367665,"ins":0},{"id":"29","kind":"label","chars":23,"max":23,"perLine":11.5,"lines":2,"caps":false,"sz":29.68,"paras":1,"text":"The paradox of infinity","font":"Glacial Indifference Bold","anchor":"t","box":[12721499,4736925,3379271,778455],"lineH":388239,"ins":0,"useW":0.786},{"id":"30","kind":"title","chars":26,"max":26,"perLine":25.7,"lines":1,"caps":false,"sz":100.48,"paras":1,"text":"Challenges and curiosities","font":"Holiday","anchor":"t","box":[3967215,936175,10353570,1240112],"lineH":1148461,"ins":0,"useW":0.94}],"photos":[]},{"n":12,"part":"ppt/slides/slide12.xml","role":"content","slots":[{"id":"13","kind":"title","chars":11,"max":13,"perLine":12.8,"lines":1,"caps":false,"sz":143.01,"paras":1,"text":"Conclusions","font":"Holiday","anchor":"t","box":[5485487,1036146,7317025,1611452],"lineH":1434846,"ins":0,"useW":0.782},{"id":"14","kind":"text","chars":196,"max":196,"perLine":32.7,"lines":6,"caps":false,"sz":32.18,"paras":1,"text":"Mathematics is universal and constitutes the common language that connects all sciences. Thanks to it, it is possible to describe phenomena, formulate theories, and understand how the world works.","font":"Glacial Indifference","anchor":"t","box":[1928471,3242992,6862198,3405760],"lineH":580263,"ins":0},{"id":"15","kind":"text","chars":171,"max":171,"perLine":28.5,"lines":6,"caps":false,"sz":32.18,"paras":1,"text":"At the same time, it is present in everyday life: in the simplest calculations, in the technology we use daily, and in the great discoveries that are transforming history.","font":"Glacial Indifference","anchor":"t","box":[9824872,3242992,6534657,3405760],"lineH":580263,"ins":0}],"photos":[]},{"n":13,"part":"ppt/slides/slide13.xml","role":"content","slots":[{"id":"6","kind":"title","chars":9,"max":13,"perLine":12.9,"lines":1,"caps":true,"sz":133.69,"paras":1,"text":"QUESTIONS","font":"Georgia Pro Condensed","anchor":"t","box":[2977211,4288803,12333578,2231329],"lineH":2292223,"ins":0,"useW":0.746}],"photos":[{"id":"4","w":16029389,"h":8411587,"area":0.717}]}]}