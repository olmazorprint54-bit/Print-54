{"size":[12192000,6858000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"2","kind":"title","chars":42,"max":60,"perLine":21.0,"lines":2,"caps":false,"sz":42.0,"paras":1,"text":"Raqamli texnologiyalar va zamonaviy ta'lim","font":"Times New Roman","anchor":"t","box":[680322,2733709,8144134,1373070],"lineH":640080,"ins":182880,"useW":0.71},{"id":"3","kind":"label","chars":42,"max":90,"perLine":68.7,"lines":2,"caps":false,"sz":22.0,"paras":2,"text":"Tayyorladi: talaba F.I.Sh.\nFan: Pedagogika","font":"Times New Roman","anchor":"t","box":[680322,4394039,8144134,1117687],"lineH":335280,"ins":182880,"useW":0.359}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"2","kind":"title","chars":4,"max":48,"perLine":99.5,"lines":2,"caps":false,"sz":18.0,"paras":1,"text":"Reja","font":"Times New Roman","anchor":"t","box":[680321,753228,9613861,1080938],"lineH":274320,"ins":182880,"useW":0.044},{"id":"3","kind":"text","chars":189,"max":189,"perLine":17.2,"lines":11,"caps":false,"sz":22.0,"paras":6,"text":"Raqamli texnologiyalar tushunchasi\nTa'limda raqamli vositalarning o'rni\nOnlayn va aralash ta'lim shakllari\nO'qituvchining raqamli kompetensiyasi\nAfzalliklar va muammolar\nXulosa va takliflar","font":"Times New Roman","anchor":"t","box":[680321,2336873,9613861,3599316],"lineH":335280,"ins":182880}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"2","kind":"title","chars":39,"max":48,"perLine":99.5,"lines":2,"caps":false,"sz":18.0,"paras":1,"text":"Raqamli ta'limning asosiy yo'nalishlari","font":"Times New Roman","anchor":"t","box":[680321,753228,9613861,1080938],"lineH":274320,"ins":182880,"useW":0.377},{"id":"4","kind":"label","chars":18,"max":18,"perLine":18.0,"lines":1,"caps":false,"sz":16.5,"paras":1,"text":"Elektron resurslar","font":"Times New Roman","anchor":"t","box":[858121,2717873,2662754,381000],"lineH":251460,"ins":182880,"useW":0.602,"base":2.165,"tail":0.216,"below":[{"id":"6","gap":2.424,"cap":0.311}]},{"id":"6","kind":"text","chars":160,"max":160,"perLine":16.0,"lines":10,"caps":false,"sz":17.0,"paras":1,"text":"Elektron darsliklar, video darslar va interaktiv mashqlar o'quvchiga istalgan vaqtda va istalgan joyda bilim olish imkonini beradi. Materiallar tez yangilanadi.","font":"Times New Roman","anchor":"t","box":[858121,3225873,2662754,2481716],"lineH":259080,"ins":182880},{"id":"12","kind":"label","chars":19,"max":18,"perLine":18.0,"lines":1,"caps":false,"sz":17.0,"paras":1,"text":"Onlayn platformalar","font":"Times New Roman","anchor":"t","box":[4155875,2717873,2662754,381000],"lineH":259080,"ins":182880,"useW":0.707},{"id":"14","kind":"text","chars":148,"max":148,"perLine":14.8,"lines":10,"caps":false,"sz":17.0,"paras":1,"text":"Moodle, Google Classroom kabi tizimlar topshiriq berish, tekshirish va baholashni bir joyda jamlaydi. O'qituvchi va o'quvchi doimiy aloqada bo'ladi.","font":"Times New Roman","anchor":"t","box":[4155875,3225873,2662754,2481716],"lineH":259080,"ins":182880},{"id":"20","kind":"label","chars":16,"max":18,"perLine":18.0,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Sun'iy intellekt","font":"Times New Roman","anchor":"t","box":[7453629,2717873,2662754,381000],"lineH":274320,"ins":182880,"useW":0.558},{"id":"22","kind":"text","chars":128,"max":128,"perLine":12.8,"lines":10,"caps":false,"sz":17.0,"paras":1,"text":"Har bir o'quvchi uchun shaxsiy o'quv yo'nalishini tuzadi, xatolarni tahlil qiladi va o'qituvchiga vaqtni tejashda yordam beradi.","font":"Times New Roman","anchor":"t","box":[7453629,3225873,2662754,2481716],"lineH":259080,"ins":182880}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"2","kind":"title","chars":33,"max":48,"perLine":99.5,"lines":2,"caps":false,"sz":18.0,"paras":1,"text":"Raqamli vositalar dars jarayonida","font":"Times New Roman","anchor":"t","box":[680321,753228,9613861,1080938],"lineH":274320,"ins":182880,"useW":0.326},{"id":"10","kind":"text","chars":316,"max":316,"perLine":28.7,"lines":11,"caps":false,"sz":20.0,"paras":5,"text":"Interaktiv doska va proyektor darsni ko'rgazmali va qiziqarli qiladi.\nPlanshet va kompyuterlar mustaqil ishlash imkonini beradi.\nElektron testlar natijani darhol ko'rsatadi va xatolarni tushuntiradi.\nVideo darslar murakkab mavzuni sodda tushuntiradi.\nRaqamli kutubxonalar manbalarni bir zumda topishga yordam beradi.","font":"Times New Roman","anchor":"t","box":[5239621,2387673,5054561,3497716],"lineH":304800,"ins":182880}],"photos":[{"id":"5","w":4000500,"h":3167516,"area":0.152}]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"2","kind":"title","chars":27,"max":48,"perLine":99.5,"lines":2,"caps":false,"sz":18.0,"paras":1,"text":"An'anaviy va raqamli ta'lim","font":"Times New Roman","anchor":"t","box":[680319,753229,9613863,1080937],"lineH":274320,"ins":182880,"useW":0.268},{"id":"3","kind":"label","chars":16,"max":30,"perLine":37.0,"lines":1,"caps":false,"sz":22.0,"paras":1,"text":"An'anaviy ta'lim","font":"Times New Roman","anchor":"t","box":[906350,2336873,4472327,693135],"lineH":335280,"ins":182880,"useW":0.427,"base":2.165,"tail":0.216,"below":[{"id":"4","gap":2.481,"cap":0.261}]},{"id":"4","kind":"text","chars":131,"max":131,"perLine":13.1,"lines":10,"caps":false,"sz":19.0,"paras":3,"text":"Bilim asosan o'qituvchi va darslikdan olinadi.\nDars vaqti va joyi qat'iy belgilangan.\nNatija oy yoki chorak oxirida ma'lum bo'ladi.","font":"Times New Roman","anchor":"t","box":[680322,3030008,4698355,2906179],"lineH":289560,"ins":182880},{"id":"5","kind":"label","chars":14,"max":40,"perLine":37.1,"lines":1,"caps":false,"sz":22.0,"paras":1,"text":"Raqamli ta'lim","font":"Times New Roman","anchor":"t","box":[5820154,2336873,4474028,692076],"lineH":335280,"ins":182880,"useW":0.383,"base":2.165,"tail":0.216,"below":[{"id":"6","gap":2.481,"cap":0.261}]},{"id":"6","kind":"text","chars":133,"max":133,"perLine":13.3,"lines":10,"caps":false,"sz":19.0,"paras":3,"text":"Bilim manbalari ko'p: video, platforma, ma'lumotlar bazasi.\nIstalgan vaqt va joyda o'qish mumkin.\nNatija va xatolar darhol ko'rinadi.","font":"Times New Roman","anchor":"t","box":[5594123,3030008,4700059,2906179],"lineH":289560,"ins":182880}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"2","kind":"title","chars":28,"max":48,"perLine":99.5,"lines":2,"caps":false,"sz":18.0,"paras":1,"text":"Raqamli kompetensiya tarkibi","font":"Times New Roman","anchor":"t","box":[680321,753228,9613861,1080938],"lineH":274320,"ins":182880,"useW":0.292},{"id":"4","kind":"label","chars":20,"max":24,"perLine":24.0,"lines":1,"caps":false,"sz":17.0,"paras":1,"text":"Axborot savodxonligi","font":"Times New Roman","anchor":"t","box":[858121,2692473,4286231,381000],"lineH":259080,"ins":182880,"useW":0.46},{"id":"6","kind":"text","chars":98,"max":98,"perLine":32.7,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Ishonchli manbani topish, ma'lumotni tekshirish, saralash va undan to'g'ri foydalanish ko'nikmasi.","font":"Times New Roman","anchor":"t","box":[858121,3200473,4286231,694758],"lineH":243840,"ins":182880},{"id":"12","kind":"label","chars":7,"max":20,"perLine":19.7,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Muloqot","font":"Times New Roman","anchor":"t","box":[5830151,2692473,4286231,381000],"lineH":274320,"ins":182880,"useW":0.192},{"id":"14","kind":"text","chars":88,"max":72,"perLine":24.0,"lines":3,"caps":false,"sz":15.5,"paras":1,"text":"Onlayn hamkorlik, elektron xat yozish, videomuloqot va guruhda birgalikda ishlash odobi.","font":"Times New Roman","anchor":"t","box":[5830151,3200473,4286231,694758],"lineH":236220,"ins":182880},{"id":"20","kind":"label","chars":16,"max":20,"perLine":19.7,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Kontent yaratish","font":"Times New Roman","anchor":"t","box":[858121,4581031,4286231,381000],"lineH":274320,"ins":182880,"useW":0.369},{"id":"22","kind":"text","chars":88,"max":72,"perLine":24.0,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Taqdimot, video, test va interaktiv mashq kabi o'quv materiallarini mustaqil tayyorlash.","font":"Times New Roman","anchor":"t","box":[858121,5089031,4286231,694758],"lineH":243840,"ins":182880},{"id":"28","kind":"label","chars":10,"max":20,"perLine":19.7,"lines":1,"caps":false,"sz":18.0,"paras":1,"text":"Xavfsizlik","font":"Times New Roman","anchor":"t","box":[5830151,4581031,4286231,381000],"lineH":274320,"ins":182880,"useW":0.232},{"id":"30","kind":"text","chars":87,"max":71,"perLine":23.8,"lines":3,"caps":false,"sz":16.0,"paras":1,"text":"Shaxsiy ma'lumotlarni himoya qilish, kuchli parol tanlash va kiberxavflardan saqlanish.","font":"Times New Roman","anchor":"t","box":[5830151,5089031,4286231,694758],"lineH":243840,"ins":182880}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"2","kind":"title","chars":30,"max":48,"perLine":99.5,"lines":2,"caps":false,"sz":18.0,"paras":1,"text":"Onlayn ta'limning afzalliklari","font":"Times New Roman","anchor":"t","box":[680321,753228,9613861,1080938],"lineH":274320,"ins":182880,"useW":0.286},{"id":"3","kind":"text","chars":212,"max":212,"perLine":19.3,"lines":11,"caps":false,"sz":20.0,"paras":5,"text":"Masofa va vaqt chegarasi yo'qoladi.\nDarslarni qayta ko'rib, mustahkamlash mumkin.\nO'quvchi o'z tezligida o'rganadi.\nTa'lim xarajatlari kamayadi.\nTajribali mutaxassislar darslariga qatnashish imkoni paydo bo'ladi.","font":"Times New Roman","anchor":"t","box":[680321,2387673,5245061,3497716],"lineH":304800,"ins":182880}],"photos":[{"id":"6","w":3810000,"h":3167516,"area":0.144}]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"2","kind":"title","chars":22,"max":48,"perLine":99.5,"lines":2,"caps":false,"sz":18.0,"paras":1,"text":"Muammolar va yechimlar","font":"Times New Roman","anchor":"t","box":[680321,753228,9613861,1080938],"lineH":274320,"ins":182880,"useW":0.251},{"id":"11","kind":"label","chars":16,"max":24,"perLine":24.0,"lines":1,"caps":false,"sz":17.0,"paras":1,"text":"Asosiy muammolar","font":"Times New Roman","anchor":"t","box":[5969851,2717873,4146531,381000],"lineH":259080,"ins":182880,"useW":0.428},{"id":"13","kind":"text","chars":153,"max":153,"perLine":15.3,"lines":10,"caps":false,"sz":17.0,"paras":1,"text":"Internet sifati, qurilmalar yetishmasligi va o'qituvchilarning raqamli tayyorgarligi. Yechim — infratuzilmani rivojlantirish va muntazam malaka oshirish.","font":"Times New Roman","anchor":"t","box":[5969851,3225873,4146531,2507116],"lineH":259080,"ins":182880}],"photos":[{"id":"5","w":4578330,"h":3218316,"area":0.176}]},{"n":9,"part":"ppt/slides/slide9.xml","role":"end","slots":[{"id":"2","kind":"title","chars":26,"max":60,"perLine":31.5,"lines":2,"caps":false,"sz":48.0,"paras":1,"text":"E'tiboringiz uchun rahmat!","font":"Times New Roman","anchor":"t","box":[680322,2733709,8144134,1373070],"lineH":731520,"ins":182880,"useW":0.821,"base":2.165,"tail":0.216,"below":[{"id":"3","gap":2.724,"cap":0.139}]},{"id":"3","kind":"label","chars":52,"max":90,"perLine":68.7,"lines":2,"caps":false,"sz":22.0,"paras":1,"text":"Savollaringiz bo'lsa, mamnuniyat bilan javob beraman","font":"Times New Roman","anchor":"t","box":[680322,4394039,8144134,1117687],"lineH":335280,"ins":182880,"useW":0.764}],"photos":[]}]}