{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"13","kind":"title","chars":14,"max":16,"perLine":7.9,"lines":2,"caps":true,"sz":138.08,"paras":1,"text":"DAY IN MY LIFE"},{"id":"14","kind":"label","chars":13,"max":27,"perLine":26.7,"lines":1,"caps":false,"sz":41.55,"paras":1,"text":"Olivia Wilson"}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"10","kind":"title","chars":8,"max":10,"perLine":10.0,"lines":1,"caps":true,"sz":138.08,"paras":1,"text":"WELCOME!"},{"id":"11","kind":"text","chars":74,"max":74,"perLine":18.5,"lines":4,"caps":false,"sz":64.2,"paras":1,"text":"My name is Nica and let me share with you how my daily routine looks like."}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"9","kind":"title","chars":14,"max":20,"perLine":10.0,"lines":2,"caps":true,"sz":138.08,"paras":1,"text":"ARE YOU READY?"},{"id":"10","kind":"label","chars":13,"max":21,"perLine":21.0,"lines":1,"caps":false,"sz":41.55,"paras":1,"text":"I am excited!"}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"8","kind":"title","chars":8,"max":10,"perLine":10.0,"lines":1,"caps":true,"sz":138.08,"paras":1,"text":"WAKE UP!"},{"id":"9","kind":"text","chars":111,"max":111,"perLine":25.5,"lines":4,"caps":false,"sz":41.55,"paras":1,"text":"Everyday, I wake up at 7AM. First thing I do is fix my bed and stretch my body. I also thank God for a new day."}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"7","kind":"title","chars":9,"max":10,"perLine":10.0,"lines":1,"caps":true,"sz":138.08,"paras":1,"text":"BREAKFAST"},{"id":"8","kind":"text","chars":111,"max":111,"perLine":25.5,"lines":4,"caps":false,"sz":41.55,"paras":1,"text":"This is my favorite meal of the day. I usually eat french toast and a cup to tea to nourish me for the morning."}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"7","kind":"title","chars":11,"max":14,"perLine":6.8,"lines":2,"caps":true,"sz":138.08,"paras":1,"text":"READ A BOOK"},{"id":"8","kind":"label","chars":47,"max":47,"perLine":23.5,"lines":2,"caps":false,"sz":41.55,"paras":1,"text":"Reading a new book brings me to a new universe."},{"id":"9","kind":"text","chars":119,"max":119,"perLine":29.8,"lines":4,"caps":false,"sz":41.55,"paras":1,"text":"Each page turned is like stepping through a portal, where unfamiliar landscapes and intriguing characters come to life."}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"10","kind":"title","chars":11,"max":14,"perLine":6.8,"lines":2,"caps":true,"sz":118.65,"paras":1,"text":"WALK MY PET"},{"id":"11","kind":"text","chars":122,"max":122,"perLine":29.3,"lines":4,"caps":false,"sz":41.55,"paras":1,"text":"For some exercise, I make sure to walk my poodle to the park. She is my best friend and this is our bonding time everyday."}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"8","kind":"title","chars":13,"max":14,"perLine":7.1,"lines":2,"caps":true,"sz":118.65,"paras":1,"text":"OTHER HOBBIES"},{"id":"9","kind":"text","chars":103,"max":103,"perLine":25.8,"lines":4,"caps":false,"sz":41.55,"paras":1,"text":"I make sure to expand my hobbies by exploring new things like crocheting, painting, and baking cookies."}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"6","kind":"title","chars":13,"max":12,"perLine":12.0,"lines":1,"caps":true,"sz":118.65,"paras":1,"text":"TIME TO SLEEP"},{"id":"7","kind":"text","chars":118,"max":118,"perLine":29.3,"lines":4,"caps":false,"sz":41.55,"paras":1,"text":"I go to sleep every 10PM. I always greet my parents goodnight before going to bed to regain my energy for another day."}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"end","slots":[{"id":"7","kind":"title","chars":24,"max":24,"perLine":12.0,"lines":2,"caps":true,"sz":118.65,"paras":1,"text":"THANK YOU FOR LISTENING!"},{"id":"8","kind":"label","chars":24,"max":27,"perLine":26.7,"lines":1,"caps":false,"sz":41.55,"paras":1,"text":"See you again next week!"}],"photos":[]}]}