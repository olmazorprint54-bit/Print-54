{"size":[18288000,10287000],"slides":[{"n":1,"part":"ppt/slides/slide1.xml","role":"title","slots":[{"id":"13","kind":"title","chars":14,"max":17,"perLine":8.3,"lines":2,"caps":true,"sz":138.08,"paras":1,"text":"DAY IN MY LIFE","font":"Cooper BT Bold","anchor":"t","box":[4429452,943106,9429096,3888606],"lineH":1911477,"ins":0},{"id":"14","kind":"label","chars":13,"max":34,"perLine":34.4,"lines":1,"caps":false,"sz":41.55,"paras":1,"text":"Olivia Wilson","font":"Gaegu Bold","anchor":"t","box":[5202364,4708484,7883272,679229],"lineH":553974,"ins":0}],"photos":[]},{"n":2,"part":"ppt/slides/slide2.xml","role":"content","slots":[{"id":"10","kind":"title","chars":8,"max":10,"perLine":10.4,"lines":1,"caps":true,"sz":138.08,"paras":1,"text":"WELCOME!","font":"Cooper BT Bold","anchor":"t","box":[3205537,1400888,11876927,1969319],"lineH":1911477,"ins":0},{"id":"11","kind":"text","chars":74,"max":74,"perLine":18.5,"lines":4,"caps":false,"sz":64.2,"paras":1,"text":"My name is Nica and let me share with you how my daily routine looks like.","font":"Gaegu Bold","anchor":"t","box":[4999952,3408306,8288095,3080312],"lineH":717423,"ins":0}],"photos":[]},{"n":3,"part":"ppt/slides/slide3.xml","role":"content","slots":[{"id":"9","kind":"title","chars":14,"max":21,"perLine":10.4,"lines":2,"caps":true,"sz":138.08,"paras":1,"text":"ARE YOU READY?","font":"Cooper BT Bold","anchor":"t","box":[3205537,1479520,11876927,3888606],"lineH":1911477,"ins":0},{"id":"10","kind":"label","chars":13,"max":27,"perLine":27.1,"lines":1,"caps":false,"sz":41.55,"paras":1,"text":"I am excited!","font":"Gaegu Bold","anchor":"t","box":[6040645,5216492,6206710,820578],"lineH":738759,"ins":0}],"photos":[]},{"n":4,"part":"ppt/slides/slide4.xml","role":"content","slots":[{"id":"8","kind":"title","chars":8,"max":10,"perLine":10.4,"lines":1,"caps":true,"sz":138.08,"paras":1,"text":"WAKE UP!","font":"Cooper BT Bold","anchor":"t","box":[3205537,1502601,11876927,1969319],"lineH":1911477,"ins":0},{"id":"9","kind":"text","chars":111,"max":111,"perLine":27.8,"lines":4,"caps":false,"sz":41.55,"paras":1,"text":"Everyday, I wake up at 7AM. First thing I do is fix my bed and stretch my body. I also thank God for a new day.","font":"Gaegu Bold","anchor":"t","box":[5715267,3700491,6857466,2336579],"lineH":553974,"ins":0}],"photos":[]},{"n":5,"part":"ppt/slides/slide5.xml","role":"content","slots":[{"id":"7","kind":"title","chars":9,"max":10,"perLine":10.4,"lines":1,"caps":true,"sz":138.08,"paras":1,"text":"BREAKFAST","font":"Cooper BT Bold","anchor":"t","box":[3205537,1502601,11876927,1969319],"lineH":1911477,"ins":0},{"id":"8","kind":"text","chars":111,"max":111,"perLine":27.8,"lines":4,"caps":false,"sz":41.55,"paras":1,"text":"This is my favorite meal of the day. I usually eat french toast and a cup to tea to nourish me for the morning.","font":"Gaegu Bold","anchor":"t","box":[5715267,3700491,6857466,2336579],"lineH":553974,"ins":0}],"photos":[]},{"n":6,"part":"ppt/slides/slide6.xml","role":"content","slots":[{"id":"7","kind":"title","chars":11,"max":14,"perLine":7.1,"lines":2,"caps":true,"sz":138.08,"paras":1,"text":"READ A BOOK","font":"Cooper BT Bold","anchor":"t","box":[697124,1402908,8058917,3888606],"lineH":1911477,"ins":0},{"id":"8","kind":"label","chars":47,"max":47,"perLine":23.5,"lines":2,"caps":false,"sz":41.55,"paras":1,"text":"Reading a new book brings me to a new universe.","font":"Gaegu Bold","anchor":"t","box":[9147162,1297387,7883272,1231679],"lineH":553974,"ins":0},{"id":"9","kind":"text","chars":119,"max":119,"perLine":29.8,"lines":4,"caps":false,"sz":41.55,"paras":1,"text":"Each page turned is like stepping through a portal, where unfamiliar landscapes and intriguing characters come to life.","font":"Gaegu Bold","anchor":"t","box":[9147162,2633818,8112138,2336579],"lineH":553974,"ins":0}],"photos":[]},{"n":7,"part":"ppt/slides/slide7.xml","role":"content","slots":[{"id":"10","kind":"title","chars":11,"max":14,"perLine":7.1,"lines":2,"caps":true,"sz":118.65,"paras":1,"text":"WALK MY PET","font":"Cooper BT Bold","anchor":"t","box":[1438338,1152525,6924669,3340248],"lineH":1642491,"ins":0},{"id":"11","kind":"text","chars":122,"max":122,"perLine":30.5,"lines":4,"caps":false,"sz":41.55,"paras":1,"text":"For some exercise, I make sure to walk my poodle to the park. She is my best friend and this is our bonding time everyday.","font":"Gaegu Bold","anchor":"t","box":[8966390,1297387,7883272,2336579],"lineH":553974,"ins":0}],"photos":[]},{"n":8,"part":"ppt/slides/slide8.xml","role":"content","slots":[{"id":"8","kind":"title","chars":13,"max":15,"perLine":7.5,"lines":2,"caps":true,"sz":118.65,"paras":1,"text":"OTHER HOBBIES","font":"Cooper BT Bold","anchor":"t","box":[9653833,1383858,7315200,3340248],"lineH":1642491,"ins":0},{"id":"9","kind":"text","chars":103,"max":103,"perLine":25.8,"lines":4,"caps":false,"sz":41.55,"paras":1,"text":"I make sure to expand my hobbies by exploring new things like crocheting, painting, and baking cookies.","font":"Gaegu Bold","anchor":"t","box":[1318967,1568634,7883272,2336579],"lineH":553974,"ins":0}],"photos":[]},{"n":9,"part":"ppt/slides/slide9.xml","role":"content","slots":[{"id":"6","kind":"title","chars":13,"max":12,"perLine":12.5,"lines":1,"caps":true,"sz":118.65,"paras":1,"text":"TIME TO SLEEP","font":"Cooper BT Bold","anchor":"t","box":[3018690,1439097,12250621,1691089],"lineH":1642491,"ins":0},{"id":"7","kind":"text","chars":118,"max":118,"perLine":29.5,"lines":4,"caps":false,"sz":41.55,"paras":1,"text":"I go to sleep every 10PM. I always greet my parents goodnight before going to bed to regain my energy for another day.","font":"Gaegu Bold","anchor":"t","box":[5202364,3391526,7883272,2336579],"lineH":553974,"ins":0}],"photos":[]},{"n":10,"part":"ppt/slides/slide10.xml","role":"end","slots":[{"id":"7","kind":"title","chars":24,"max":24,"perLine":12.0,"lines":2,"caps":true,"sz":118.65,"paras":1,"text":"THANK YOU FOR LISTENING!","font":"Cooper BT Bold","anchor":"t","box":[2371668,1409003,13544664,3347106],"lineH":1642491,"ins":0},{"id":"8","kind":"label","chars":24,"max":34,"perLine":34.4,"lines":1,"caps":false,"sz":41.55,"paras":1,"text":"See you again next week!","font":"Gaegu Bold","anchor":"t","box":[5202364,4708484,7883272,679229],"lineH":553974,"ins":0}],"photos":[]}]}